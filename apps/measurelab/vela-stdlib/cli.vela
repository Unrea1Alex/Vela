pub struct Spec {
    name: String,
    takes_value: Bool
}
pub struct Arguments {
    options: Dict<String, String>,
    positional: List<String>
}
pub enum Error {
    Unknown(String),
    Duplicate(String),
    MissingValue(String),
    UnexpectedValue(String),
    InvalidSpec(String),
    System(String)
}
fn name_valid(name: String) -> Bool {
    if str_len(name) == 0 || str_byte(name, 0) == 45 {
        return false;
    }
    for i in 0 .. str_len(name) {
        let b = str_byte(name, i);
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45) {
            return false;
        }
    }
    return true;
}
pub fn parse(values: List<String>, specs: List<Spec>) -> Result<Arguments, Error> effects { state } {
    let known = dict_new<String, Bool>();
    for spec in specs {
        if !name_valid(spec.name) || dict_has(known, spec.name) {
            return Result<Arguments, Error>::Err(Error::InvalidSpec(spec.name));
        }
        dict_set(known, spec.name, spec.takes_value);
    }
    let parsed = Arguments(options: dict_new<String, String>(), positional: list_new<String>());
    var i = 0;
    var options = true;
    while i < list_len(values) {
        let value = list_get(values, i);
        i = i + 1;
        if options && value == "--" {
            options = false;
            continue;
        }
        if !options || str_len(value) < 2 || str_slice(value, 0, 2) != "--" {
            list_push(parsed.positional, value);
            continue;
        }
        var end = 2;
        while end < str_len(value) && str_byte(value, end) != 61 {
            end = end + 1;
        }
        let name = str_slice(value, 2, end);
        if !dict_has(known, name) {
            return Result<Arguments, Error>::Err(Error::Unknown(name));
        }
        if dict_has(parsed.options, name) {
            return Result<Arguments, Error>::Err(Error::Duplicate(name));
        }
        var supplied = "true";
        if dict_get(known, name) {
            if end < str_len(value) {
                supplied = str_slice(value, end + 1, str_len(value));
            } else {
                if i == list_len(values) {
                    return Result<Arguments, Error>::Err(Error::MissingValue(name));
                }
                supplied = list_get(values, i);
                if str_len(supplied) >= 2 && str_slice(supplied, 0, 2) == "--" {
                    return Result<Arguments, Error>::Err(Error::MissingValue(name));
                }
                i = i + 1;
            }
        } else if end < str_len(value) {
            return Result<Arguments, Error>::Err(Error::UnexpectedValue(name));
        }
        dict_set(parsed.options, name, supplied);
    }
    return Result<Arguments, Error>::Ok(parsed);
}
pub fn current(specs: List<Spec>) -> Result<Arguments, Error> effects { args, state } {
    let values = list_new<String>();
    for i in 0 .. arg_count() {
        match arg(i) {
            StringResult::Ok(s) => {
                list_push(values, s);
            }
            StringResult::Err(message) => {
                return Result<Arguments, Error>::Err(Error::System(message));
            }
        }
    }
    return parse(values, specs);
}
