import "@config" as config;
import "@json" as json;
import "@text" as text;
pub struct Scenario {
    name: String,
    unit: String,
    baseline: Float64,
    budget: Float64,
    samples: List<Float64>
}
pub struct Document {
    title: String,
    scenarios: List<Scenario>
}
pub fn explain<T, E>(value: Result<T, E>, message: String) -> Result<T, String> {
    return match value {
        Result::Ok(v) => Result<T, String>::Ok(v),
        Result::Err(_) => Result<T, String>::Err(message)
    };
}
fn names(a: String, b: String) -> List<String> effects { state } {
    let fields = list_new<String>();
    list_push(fields, a);
    list_push(fields, b);
    return fields;
}
pub fn number(value: json::Value) -> Result<Float64, String> {
    return decoded(json::as_number(json::root(value), json::IntegerMode::Exact));
}
fn decoded<T>(outcome: Result<T, json::At<json::DecodeCause>>) -> Result<T, String> {
    return match outcome {
        Result::Ok(value) => Result<T, String>::Ok(value),
        Result::Err(error) => Result<T, String>::Err(json::describe(error))
    };
}
fn label(value: String, limit: Int) -> Result<String, String> {
    let trimmed = explain(text::trim(text::Text(data: value)), "Invalid UTF-8 text")?.data;
    if str_len(trimmed) == 0 || str_len(trimmed) > limit {
        return Result<String, String>::Err("Text is empty or too long");
    }
    for i in 0 .. str_len(trimmed) {
        if str_byte(trimmed, i) < 32 {
            return Result<String, String>::Err("Control characters are not allowed in labels");
        }
    }
    return Result<String, String>::Ok(trimmed);
}
fn scenario(c: json::Cursor) -> Result<Scenario, String> effects { state } {
    let cfg = explain(config::from_value(c.value), c.path + ": expected scenario object")?;
    let fields = names("name", "unit");
    list_push(fields, "baseline");
    list_push(fields, "budget");
    list_push(fields, "samples");
    let allowed = explain(config::allow_only(cfg, fields), c.path + ": unknown scenario field")?;
    let name = label(decoded(json::as_string(decoded(json::field(c, "name"))?))?, 160)?;
    let unit = label(decoded(json::as_string(decoded(json::field(c, "unit"))?))?, 24)?;
    let baseline = decoded(json::as_number(decoded(json::field(c, "baseline"))?,
        json::IntegerMode::Exact))?;
    let budget = decoded(json::as_number(decoded(json::field(c, "budget"))?,
        json::IntegerMode::Exact))?;
    if baseline < 0.000001 || baseline > 1000000000.0 || budget < 0.000001 || budget
        > 1000000000.0 {
        return Result<Scenario, String>::Err("baseline and budget must be in 1e-6..1e9");
    }
    let sample_cursor = decoded(json::field(c, "samples"))?;
    let values = decoded(json::as_array(sample_cursor))?;
    if list_len(values) == 0 || list_len(values) > 256 {
        return Result<Scenario, String>::Err("Expected 1..256 samples");
    }
    let samples = list_new<Float64>();
    for i in 0 .. list_len(values) {
        let sample = decoded(json::item(sample_cursor, i))?;
        let n = decoded(json::as_number(sample, json::IntegerMode::Exact))?;
        if n < 0.0 || n > 1000000000.0 {
            return Result<Scenario, String>::Err(sample.path + ": samples must be in 0..1e9");
        }
        list_push(samples, n);
    }
    return Result<Scenario, String>::Ok(Scenario(name: name, unit: unit, baseline: baseline,
        budget: budget, samples: samples));
}
pub fn parse(data: String) -> Result<Document, String> effects { state } {
    let c = decoded(json::decode(data))?;
    let cfg = explain(config::from_value(c.value), "$: expected document object")?;
    let allowed = explain(config::allow_only(cfg, names("title", "scenarios")),
        "Unknown document field")?;
    let title = label(decoded(json::as_string(decoded(json::field(c, "title"))?))?, 240)?;
    let scenario_cursor = decoded(json::field(c, "scenarios"))?;
    let values = decoded(json::as_array(scenario_cursor))?;
    if list_len(values) == 0 || list_len(values) > 12 {
        return Result<Document, String>::Err("Expected 1..12 scenarios");
    }
    let scenarios = list_new<Scenario>();
    let seen = dict_new<String, Bool>();
    for i in 0 .. list_len(values) {
        let s = scenario(decoded(json::item(scenario_cursor, i))?)?;
        if dict_has(seen, s.name) {
            return Result<Document, String>::Err("Duplicate scenario name: " + s.name);
        }
        dict_set(seen, s.name, true);
        list_push(scenarios, s);
    }
    return Result<Document, String>::Ok(Document(title: title, scenarios: scenarios));
}
