import "../../std/directory.vela" as directory;
import "../../std/path.vela" as path;
import "../../std/fs.vela" as fs;
import "../../std/text.vela" as text;
import "../../std/collections.vela" as collections;
import "../../std/json.vela" as json;
import "../../std/cli_schema.vela" as cli;
import "../../std/result.vela" as result;
struct Options {
    root: String,
    output: String,
    query: String,
    suffix: String,
    repeat: Int
}
fn cli_result<T>(value: Result<T, cli::Error>) -> Result<T, String> {
    return result::map_error(value, cli::describe);
}
fn options() -> Result<Option<Options>, String> effects { args, state, io } {
    let parameters = list_new<cli::Parameter>();
    list_push(parameters, cli::positional("root", "Directory to index", Option<String>::None));
    list_push(parameters, cli::positional("output", "JSON destination", Option<String>::None));
    list_push(parameters, cli::text("query", "Path substring", Option<String>::Some("")));
    list_push(parameters, cli::text("extension", "Path suffix", Option<String>::Some("")));
    list_push(parameters, cli::integer("repeat", "Repetitions", 1, 1000, Option<Int>::Some(1)));
    let schema = cli_result(cli::create("tree-index", "Build a deterministic file index.",
        parameters, list_new<cli::LessEqual>()))?;
    let parsed = cli_result(cli::current(schema))?;
    if cli::is_help(parsed) {
        print(cli::help(parsed));
        return Result<Option<Options>, String>::Ok(Option<Options>::None);
    }
    return Result<Option<Options>, String>::Ok(Option<Options>::Some(Options(root: cli_result(
        cli::text_value(parsed, "root"))?, output: cli_result(cli::text_value(parsed, "output"))?,
        query: cli_result(cli::text_value(parsed, "query"))?, suffix: cli_result(cli::text_value(
        parsed, "extension"))?, repeat: cli_result(cli::int_value(parsed, "repeat"))?)));
}
fn contains(value: String, query: String) -> Bool {
    if str_len(query) > str_len(value) {
        return false;
    }
    for i in 0 .. str_len(value) - str_len(query) + 1 {
        if str_slice(value, i, i + str_len(query)) == query {
            return true;
        }
    }
    return false;
}
fn suffix(value: String, ending: String) -> Bool {
    return str_len(ending) <= str_len(value) && str_slice(value, str_len(value) - str_len(ending),
        str_len(value)) == ending;
}
fn quote(value: String) -> Result<String, String> effects { state } {
    return match json::stringify(json::Value::StringValue(value)) {
        Result::Ok(data) => Result<String, String>::Ok(data),
        Result::Err(_) => Result<String, String>::Err("cannot encode path")
    };
}
fn iteration(config: Options) -> Result<String, String> effects { state, io } {
    let walked = match directory::walk(path::Path(value: config.root), directory::Limits(
        depth: 1024, entries: 1000000)) {
        Result::Ok(found) => Result<List<directory::WalkEntry>, String>::Ok(found),
        Result::Err(e) => Result<List<directory::WalkEntry>, String>::Err(e.operation + ": "
            + e.path + ": " + e.reason)
    };
    let paths = list_new<String>();
    let records = dict_new<String, String>();
    var total_bytes = 0;
    var total_lines = 0;
    for item in walked? {
        if item.entry.kind != directory::Kind::File {
            continue;
        }
        if !contains(item.relative, config.query) || !suffix(item.relative, config.suffix) {
            continue;
        }
        var data = "";
        match fs::read_bytes(item.entry.path, 1048576) {
            Result::Err(_) => {
                return Result<String, String>::Err("cannot read: " + item.entry.path.value);
            }
            Result::Ok(bytes) => {
                data = bytes.data;
            }
        }
        let size = str_len(data);
        if size > 16777216 - total_bytes {
            return Result<String, String>::Err("16 MiB selected input limit");
        }
        var lines = 0;
        for i in 0 .. size {
            if str_byte(data, i) == 10 {
                lines = lines + 1;
            }
        }
        if size > 0 && str_byte(data, size - 1) != 10 {
            lines = lines + 1;
        }
        total_bytes = total_bytes + size;
        total_lines = total_lines + lines;
        list_push(paths, item.relative);
        dict_set(records, item.relative, "{\"path\":" + quote(item.relative)? + ",\"bytes\":"
            + to_string(size) + ",\"lines\":" + to_string(lines) + "}");
    }
    let parts = strings_new();
    strings_push(parts, "{\"files\":[");
    var first = true;
    for relative in collections::sort_strings(paths) {
        if !first {
            strings_push(parts, ",");
        }
        first = false;
        strings_push(parts, dict_get(records, relative));
    }
    strings_push(parts, "],\"total_bytes\":" + to_string(total_bytes) + ",\"total_lines\":"
        + to_string(total_lines) + "}");
    return Result<String, String>::Ok(strings_join(parts, ""));
}
fn run(config: Options) -> Result<Bool, String> effects { state, io } {
    var output = "";
    for i in 0 .. config.repeat {
        output = iteration(config)?;
    }
    return match fs::write_atomic(path::Path(value: config.output), text::Bytes(data: output)) {
        Result::Ok(value) => Result<Bool, String>::Ok(value),
        Result::Err(_) => Result<Bool, String>::Err("cannot publish output")
    };
}
fn main() -> Int effects { args, state, io } {
    match options() {
        Result::Err(message) => {
            eprint(message);
            return 2;
        }
        Result::Ok(value) => {
            match value {
                Option::None => {
                    return 0;
                }
                Option::Some(config) => {
                    match run(config) {
                        Result::Ok(_) => {
                            return 0;
                        }
                        Result::Err(message) => {
                            eprint(message);
                            return 1;
                        }
                    }
                }
            }
        }
    }
}
