import "../../std/json_decode.vela" as decode;
import "../../std/cli_schema.vela" as cli;
import "../../std/result.vela" as result;
import "../../std/json_stream.vela" as stream;
import "../../std/json.vela" as json;
import "../../std/fs.vela" as fs;
import "../../std/path.vela" as path;
import "../../std/text.vela" as text;
import "../../std/collections.vela" as collections;
import "../../std/algorithms.vela" as algorithms;
struct Options {
    input: String,
    output: String,
    minimum: Int,
    maximum: Int,
    repeat: Int
}
struct Record {
    service: String,
    level: Int,
    value: Int
}
struct Group {
    count: Int,
    sum: Int,
    minimum: Int,
    maximum: Int
}
fn cli_result<T>(value: Result<T, cli::Error>) -> Result<T, String> {
    return result::map_error(value, cli::describe);
}
fn options() -> Result<Option<Options>, String> effects { args, state, io } {
    let parameters = list_new<cli::Parameter>();
    list_push(parameters, cli::positional("input", "NDJSON input", Option<String>::None));
    list_push(parameters, cli::positional("output", "JSON destination", Option<String>::None));
    list_push(parameters, cli::integer("min-level", "Minimum level", 0, 5, Option<Int>::Some(0)));
    list_push(parameters, cli::integer("max-level", "Maximum level", 0, 5, Option<Int>::Some(5)));
    list_push(parameters, cli::integer("repeat", "Repetitions", 1, 1000, Option<Int>::Some(1)));
    let relations = list_new<cli::LessEqual>();
    list_push(relations, cli::LessEqual(minimum: "min-level", maximum: "max-level"));
    let schema = cli_result(cli::create("log-summary", "Aggregate bounded NDJSON records.",
        parameters, relations))?;
    let parsed = cli_result(cli::current(schema))?;
    if cli::is_help(parsed) {
        print(cli::help(parsed));
        return Result<Option<Options>, String>::Ok(Option<Options>::None);
    }
    return Result<Option<Options>, String>::Ok(Option<Options>::Some(Options(input: cli_result(
        cli::text_value(parsed, "input"))?, output: cli_result(cli::text_value(parsed, "output"))?,
        minimum: cli_result(cli::int_value(parsed, "min-level"))?, maximum: cli_result(
        cli::int_value(parsed, "max-level"))?, repeat: cli_result(cli::int_value(parsed,
        "repeat"))?)));
}
fn record_schema() -> Result<decode::Decoder<Record>, decode::Error> effects { state } {
    let names = list_new<String>();
    list_push(names, "service");
    list_push(names, "level");
    list_push(names, "value");
    let level = decode::integer(0, 5)?;
    let amount = decode::integer(-1000000, 1000000)?;
    return decode::object(names, decode::Unknown::Ignore, fn [ level, amount ](
        fields: decode::Fields) -> Result<Record, decode::Error> effects { state } {
        return Result<Record, decode::Error>::Ok(Record(service: decode::required(fields, "service",
            decode::string())?, level: decode::required(fields, "level", level)?,
            value: decode::required(fields, "value", amount)?));
    });
}
fn record(schema: decode::Decoder<Record>, data: String) -> Result<Record,
    String> effects { state } {
    return result::map_error(decode::decode(schema, data, stream::Limits(bytes: 4096, depth: 4096,
        nodes: 8192)), decode::describe);
}
fn blank(line: String) -> Bool {
    for i in 0 .. str_len(line) {
        let byte = str_byte(line, i);
        if byte != 32 && byte != 9 && byte != 13 {
            return false;
        }
    }
    return true;
}
fn quote(value: String) -> Result<String, String> effects { state } {
    return match json::stringify(json::Value::StringValue(value)) {
        Result::Ok(data) => Result<String, String>::Ok(data),
        Result::Err(_) => Result<String, String>::Err("cannot encode service")
    };
}
fn iteration(config: Options) -> Result<String, String> effects { io, state } {
    var content = text::Text(data: "");
    match fs::read_text(path::Path(value: config.input), 1048576) {
        Result::Err(_) => {
            return Result<String, String>::Err("cannot read UTF-8 input");
        }
        Result::Ok(data) => {
            content = data;
        }
    }
    let lines = match text::split(content, text::Text(data: "\n")) {
        Result::Ok(parts) => Result<List<text::Text>, String>::Ok(parts),
        Result::Err(_) => Result<List<text::Text>, String>::Err("invalid input text")
    };
    let schema = result::map_error(record_schema(), decode::describe)?;
    let groups = dict_new<String, Group>();
    let names = list_new<String>();
    var count = 0;
    var sum = 0;
    for line in lines? {
        if blank(line.data) {
            continue;
        }
        let item = record(schema, line.data)?;
        // Every record is fully validated before either filter applies.
        if item.level < config.minimum || item.level > config.maximum {
            continue;
        }
        count = count + 1;
        sum = sum + item.value;
        var group = Group(count: 0, sum: 0, minimum: item.value, maximum: item.value);
        if dict_has(groups, item.service) {
            group = dict_get(groups, item.service);
        } else {
            list_push(names, item.service);
        }
        group.count = group.count + 1;
        group.sum = group.sum + item.value;
        if item.value < group.minimum {
            group.minimum = item.value;
        }
        if item.value > group.maximum {
            group.maximum = item.value;
        }
        dict_set(groups, item.service, group);
    }
    let prefix = strings_new();
    strings_push(prefix, "{\"count\":" + to_string(count) + ",\"sum\":" + to_string(sum)
        + ",\"services\":[");
    let parts = algorithms::try_fold(collections::sort_strings(names), prefix, fn [ groups ](
        output: StringList, name: String) -> Result<StringList, String> effects { state } {
        let group = dict_get(groups, name);
        if strings_len(output) > 1 {
            strings_push(output, ",");
        }
        strings_push(output, "{\"name\":" + quote(name)? + ",\"count\":" + to_string(group.count)
            + ",\"sum\":" + to_string(group.sum) + ",\"min\":" + to_string(group.minimum)
            + ",\"max\":" + to_string(group.maximum) + "}");
        return Result<StringList, String>::Ok(output);
    })?;
    strings_push(parts, "]}");
    return Result<String, String>::Ok(strings_join(parts, ""));
}
fn run(config: Options) -> Result<Bool, String> effects { io, state } {
    var output = "";
    for i in 0 .. config.repeat {
        output = iteration(config)?;
    }
    return match fs::write_atomic(path::Path(value: config.output), text::Bytes(data: output)) {
        Result::Ok(value) => Result<Bool, String>::Ok(value),
        Result::Err(_) => Result<Bool, String>::Err("cannot publish output")
    };
}
fn main() -> Int effects { args, state, io } {
    match options() {
        Result::Err(message) => {
            eprint(message);
            return 2;
        }
        Result::Ok(value) => {
            match value {
                Option::None => {
                    return 0;
                }
                Option::Some(config) => {
                    match run(config) {
                        Result::Ok(_) => {
                            return 0;
                        }
                        Result::Err(message) => {
                            eprint(message);
                            return 1;
                        }
                    }
                }
            }
        }
    }
}
