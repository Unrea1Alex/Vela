import "model.vela" as model;
import "analyze.vela" as analyze;
import "../../std/result.vela" as result;
import "../../std/text.vela" as text;
pub fn fixed(value: Float64) -> String {
    return match float_to_fixed(value, 2) {
        StringResult::Ok(formatted) => formatted,
        StringResult::Err(_) => "unavailable"
    };
}
fn escaped(value: String) -> Result<String, String> effects { state } {
    let safe = result::explain(text::html(text::Text(data: value)), "Invalid report text")?;
    return Result<String, String>::Ok(safe.data);
}
fn add(builder: text::Builder, value: String) -> Result<Bool, String> effects { state } {
    return result::explain(text::append(builder, text::Bytes(data: value)), "Report exceeds 1 MiB");
}
pub fn summary(data: analyze::Analysis) -> String {
    return f"Accepted {data.stats.count:d} | excluded {data.excluded:d} | alerts {data.stats.alerts:d} | mean "
        + fixed(data.stats.mean);
}
pub fn html(data: analyze::Analysis, settings: model::Settings, timestamp: Int,
    run_id: Int) -> Result<String, String> effects { state } {
    let builder = result::explain(text::builder(1048576), "Cannot create report builder")?;
    defer {
        text::reset(builder);
    }
    let started = add(builder, """<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="generator" content="Vela FieldDesk 1"><title>FieldDesk · журнал измерений</title>
<style>
:root{color-scheme:light;--ink:#153c39;--muted:#617b76;--paper:#f1f4ed;--edge:#d8e1d6;--alert:#a04928}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 system-ui,sans-serif}
main{max-width:1160px;margin:auto;padding:35px 40px 50px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--edge);padding-bottom:22px}
.logo{font-size:22px;font-weight:750;letter-spacing:-1px}.logo b{background:var(--ink);color:white;padding:5px 10px;border-radius:10px;margin-right:10px;font-size:17px}
.tag,.eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted)}.tag{border:1px solid #c5d4c0;border-radius:20px;padding:5px 12px;letter-spacing:1px}
.hero{padding:36px 0 25px}h1{font-size:38px;line-height:1.15;letter-spacing:-1.5px;margin:12px 0 14px}p{margin:0;color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:4px 0 32px}.card{padding:19px 23px;background:#fff;border:1px solid var(--edge);border-radius:14px}.card strong{display:block;font-size:35px;letter-spacing:-1px;line-height:1.3}.card span{font-size:12px;color:var(--muted)}.card.alert{background:#fbefe1;border-color:#ebd8bd;color:var(--alert)}
.panel{padding:24px;border:1px solid var(--edge);background:#fff;border-radius:16px;margin-bottom:20px}h2{font-size:19px;margin:0 0 5px}h3{font-size:15px;margin:0}small{color:var(--muted);font-size:12px}.stations{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}.station{border-left:3px solid #8bab6c;padding:1px 15px}.station strong{font-size:27px}.station .bar{height:5px;border-radius:4px;background:#edf0e8;margin:12px 0}.fill{height:5px;border-radius:4px;background:#85a669}.warn .fill{background:#c07945}.warn{border-color:#c07945}
.controls{display:flex;justify-content:space-between;gap:12px;align-items:center;margin:8px 0 18px}input[type=search]{border:1px solid var(--edge);border-radius:8px;padding:9px 12px;background:#f8faf5;color:var(--ink);width:230px}label{font-size:13px;color:var(--muted)}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:14px}th{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);text-align:left;background:#f6f8f2}td,th{padding:11px 12px;border-bottom:1px solid #edf0e8}.num{text-align:right;font-variant-numeric:tabular-nums}.badge{display:inline-block;border-radius:12px;padding:2px 9px;font-size:11px;background:#edf3e4;color:#527143}.badge.hot{background:#f9e9dc;color:var(--alert)}footer{display:flex;justify-content:space-between;gap:15px;font-size:11px;color:var(--muted);padding-top:5px}#empty{padding:15px 0}details{margin-top:18px;font-size:12px;color:var(--muted)}
@media(max-width:720px){main{padding:20px}.cards{grid-template-columns:repeat(2,1fr)}.stations{grid-template-columns:1fr}h1{font-size:30px}.controls,footer{flex-direction:column;align-items:flex-start}input[type=search]{width:100%}.panel{padding:18px}.tag{font-size:9px}}
</style></head><body><main><header><div class="logo"><b>F</b>FieldDesk</div><span class="tag">Полевой журнал · локально</span></header><section class="hero"><div class="eyebrow">Наблюдения / аналитический отчёт</div><h1>""")?;
    let heading = add(builder, escaped(settings.title())?
        + "</h1><p>Калиброванные измерения, состояние станций и превышения установленного порога.</p></section><section class=\"cards\">")?;
    let count = add(builder,
        f"<div class=\"card\"><span>Принято измерений</span><strong>{data.stats.count:d}</strong><span>Исключено: {data.excluded:d}</span></div>")?;
    let mean = add(builder,
        "<div class=\"card\"><span>Среднее значение</span><strong>" + fixed(
        data.stats.mean) + "</strong><span>После калибровки</span></div>")?;
    let deviation = add(builder,
        "<div class=\"card\"><span>Стандартное отклонение</span><strong>"
        + fixed(data.stats.deviation)
        + "</strong><span>По всей совокупности</span></div>")?;
    let alerts = add(builder,
        f"<div class=\"card alert\"><span>Превышения порога</span><strong>{data.stats.alerts:d}</strong><span>Порог: "
        + fixed(settings.limit()) + "</span></div></section>")?;
    let stations_heading = add(builder,
        "<section class=\"panel\"><h2>Станции</h2><small>Среднее и диапазон по каждой станции. Полоса показывает долю превышений.</small><div class=\"stations\">")?;
    for station in data.stations {
        var class_name = "station";
        if station.stats.alerts > 0 {
            class_name = "station warn";
        }
        let fraction = fixed(100.0 * float_from_int(station.stats.alerts) / float_from_int(
            station.stats.count));
        let item = add(builder, "<article class=\"" + class_name + "\"><h3>" + escaped(
            station.name)? + "</h3><strong>" + fixed(station.stats.mean)
            + "</strong><div class=\"bar\"><div class=\"fill\" style=\"width:" + fraction
            + "%\"></div></div><small>" + fixed(station.stats.minimum) + " — " + fixed(
            station.stats.maximum)
            + f" · {station.stats.count:d} измерения</small></article>")?;
    }
    let table = add(builder,
        """</div></section><section class="panel"><h2>Журнал наблюдений</h2><div class="controls"><input id="search" type="search" placeholder="Найти станцию…" aria-label="Найти станцию"><label><input id="alerts" type="checkbox"> Только превышения</label></div><div class="scroll"><table><thead><tr><th>ID</th><th>Станция</th><th class="num">Значение</th><th>Состояние</th></tr></thead><tbody>""")?;
    for entry in data.records {
        var badge = "<span class=\"badge\">В пределах</span>";
        var flag = "no";
        match settings.band(entry.value()) {
            model::Band::Normal => {}
            model::Band::Alert => {
                badge = "<span class=\"badge hot\">Превышение</span>";
                flag = "yes";
            }
        }
        let id = entry.id();
        let row = add(builder, f"<tr data-alert=\"{flag:s}\"><td>{id:display}</td><td>" + escaped(
            entry.station())? + "</td><td class=\"num\">" + fixed(entry.value()) + "</td><td>"
            + badge + "</td></tr>")?;
    }
    let end_table = add(builder,
        "</tbody></table></div><p id=\"empty\" hidden>Нет подходящих наблюдений.</p><details><summary>Как рассчитан отчёт</summary>Значение = исходное × gain + offset. Превышение строго больше порога. Исключённые записи не входят в статистику. Поиск и фильтр меняют только отображение таблицы.</details></section>")?;
    let metadata = add(builder,
        f"<footer><span>FieldDesk · Vela 0.10.0 · без внешних ресурсов</span><span>Run {run_id:d} · Unix ms {timestamp:d}</span></footer>")?;
    let end = add(builder, """</main><script>
const rows=[...document.querySelectorAll('tbody tr')],search=document.querySelector('#search'),alerts=document.querySelector('#alerts');
function filter(){let shown=0;for(const row of rows){row.hidden=!row.cells[1].textContent.toLocaleLowerCase().includes(search.value.toLocaleLowerCase())||(alerts.checked&&row.dataset.alert!=='yes');if(!row.hidden)shown++}document.querySelector('#empty').hidden=shown!==0}
search.addEventListener('input',filter);alerts.addEventListener('change',filter);
</script><!-- fielddesk-complete --></body></html>
""")?;
    let output = result::explain(text::finish_text(builder), "Invalid UTF-8 report")?;
    return Result<String, String>::Ok(output.data);
}
