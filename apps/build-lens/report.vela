import "model.vela" as model;
import "../../std/json.vela" as json;
import "../../std/text.vela" as text;
import "../../std/algorithms.vela" as algorithms;
fn number(fields: List<json::Member>, name: String, value: Int) -> Unit effects { state } {
    list_push(fields, json::Member(name: name, value: json::Value::Integer(value)));
}
fn string(fields: List<json::Member>, name: String, value: String) -> Unit effects { state } {
    list_push(fields, json::Member(name: name, value: json::Value::StringValue(value)));
}
fn row(item: model::TestRun) -> json::Value effects { state } {
    let fields = list_new<json::Member>();
    string(fields, "suite", item.suite);
    string(fields, "name", item.name);
    string(fields, "latest", item.latest);
    list_push(fields, json::Member(name: "flaky", value: json::Value::Boolean(model::flaky(item))));
    number(fields, "attempts", item.attempts);
    number(fields, "passed", item.passed);
    number(fields, "failed", item.failed);
    number(fields, "skipped", item.skipped);
    number(fields, "total_ms", item.total_ms);
    number(fields, "max_ms", item.max_ms);
    return json::Value::Object(fields);
}
fn first(report: model::Report, top: Int) -> List<model::TestRun> effects { state } {
    let items = list_new<model::TestRun>();
    var count = list_len(report.tests);
    if count > top {
        count = top;
    }
    for i in 0 .. count {
        list_push(items, list_get(report.tests, i));
    }
    return items;
}
pub fn as_json(report: model::Report, top: Int) -> Result<String, String> effects { state } {
    let sum = report.summary;
    let fields = list_new<json::Member>();
    number(fields, "events", sum.events);
    number(fields, "duplicates", sum.duplicates);
    number(fields, "selected", sum.selected);
    number(fields, "tests", sum.tests);
    number(fields, "failed", sum.failed);
    number(fields, "flaky", sum.flaky);
    number(fields, "skipped", sum.skipped);
    number(fields, "total_ms", sum.total_ms);
    let root = list_new<json::Member>();
    number(root, "schema_version", 1);
    list_push(root, json::Member(name: "summary", value: json::Value::Object(fields)));
    list_push(root, json::Member(name: "tests", value: json::Value::Array(algorithms::map(first(
        report, top), row))));
    match json::stringify(json::Value::Object(root)) {
        Result::Ok(value) => {
            return Result<String, String>::Ok(value + "\n");
        }
        Result::Err(_) => {
            return Result<String, String>::Err("cannot encode report JSON");
        }
    }
}
pub fn escape(value: String) -> String effects { state } {
    // Only decoded UTF-8 reaches the renderer. This also escapes quotes.
    match text::html(text::Text(data: value)) {
        Result::Ok(safe) => {
            return safe.data;
        }
        Result::Err(_) => {
            return "[invalid UTF-8]";
        }
    }
}
fn card(label: String, value: Int, note: String, class_name: String) -> String {
    return "<article class='card " + class_name + "'><span>" + label + "</span><strong>"
        + to_string(value) + "</strong><small>" + note + "</small></article>";
}
pub fn as_html(report: model::Report, top: Int) -> String effects { state } {
    let parts = strings_new();
    strings_push(parts,
        "<!doctype html><html lang='ru'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta http-equiv='Content-Security-Policy' content=\"default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'\"><title>BuildLens — качество тестов</title><style>");
    strings_push(parts,
        "*{box-sizing:border-box}body{margin:0;background:#f4f5f7;color:#172230;font:15px system-ui,sans-serif}header{background:#172230;color:#fff;padding:22px 5vw;display:flex;justify-content:space-between;align-items:center}header b{font-size:22px;letter-spacing:-1px}header span{color:#b7c5d4;font-size:12px;letter-spacing:2px}main{max-width:1280px;margin:45px auto;padding:0 28px}h1{font-size:38px;letter-spacing:-1.5px;margin:0 0 10px}p{color:#647181;line-height:1.7}.eyebrow{color:#376de0;font-size:12px;font-weight:700;letter-spacing:2px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:28px 0}.card{background:white;border:1px solid #e0e5eb;padding:23px;border-radius:12px;display:flex;flex-direction:column;gap:8px}.card span{font-size:13px;color:#596778}.card strong{font-size:36px;letter-spacing:-1px}.card small{color:#7b8591}.red strong{color:#bd3948}.amber strong{color:#aa6b14}.panel{background:#fff;border:1px solid #e0e5eb;border-radius:12px;overflow:hidden}.toolbar{padding:20px;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.toolbar b{font-size:18px}.toolbar label{color:#596778;font-size:13px}input[type=search]{padding:10px 12px;border:1px solid #ccd4df;border-radius:6px;width:240px;font:inherit}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;white-space:nowrap}th{text-align:left;color:#647181;background:#f8f9fb;font-size:11px;letter-spacing:1px;text-transform:uppercase}th,td{padding:15px 20px;border-top:1px solid #e8ecf1}td small{display:block;color:#7b8591;font-size:12px;margin-top:5px}.badge{font-size:11px;border-radius:20px;padding:5px 9px;font-weight:700;display:inline-block}.failed{background:#fbe9ec;color:#ad2e3c}.passed{background:#e5f4ee;color:#257557}.skipped{background:#eef0f4;color:#617083}.flaky{background:#fff0d9;color:#916015;margin-left:5px}.bar{height:4px;background:#e7edf8;width:110px;margin-top:7px;border-radius:5px;overflow:hidden}.bar i{display:block;height:100%;background:#7d9ee7}.footer{font-size:12px;margin:20px 2px;color:#7b8591;line-height:1.8}.empty{padding:30px;text-align:center;color:#647181}[hidden]{display:none!important}@media(max-width:750px){.cards{grid-template-columns:repeat(2,1fr)}main{padding:0 14px;margin-top:25px}h1{font-size:29px}header span{letter-spacing:0}th,td{padding:12px}.toolbar{align-items:flex-start}input[type=search]{width:100%}}");
    strings_push(parts,
        "</style><header><b>◈ BuildLens</b><span>VELA 1.2 / TEST INTELLIGENCE</span></header><main><div class='eyebrow'>ОТЧЁТ О ПРОГОНАХ</div><h1>Что требует внимания</h1><p>Сбои, нестабильность и время выполнения — по истории запусков тестов.</p><section class='cards'>");
    let sum = report.summary;
    strings_push(parts, card("Уникальных тестов", sum.tests,
        "после фильтра по набору", ""));
    strings_push(parts, card("Последний запуск — failed", sum.failed,
        "нужно проверить в первую очередь", "red"));
    strings_push(parts, card("Нестабильных тестов", sum.flaky,
        "встречались и passed, и failed", "amber"));
    strings_push(parts, card("Учтено запусков", sum.selected, to_string(
        sum.duplicates) + " повторов id исключено во всём файле", ""));
    strings_push(parts,
        "</section><section class='panel'><div class='toolbar'><b>Приоритет проверки</b><label><input id='problems' type='checkbox'> Только проблемы</label><input id='search' type='search' aria-label='Поиск по тестам' placeholder='Набор или имя теста'></div><div class='scroll'><table><thead><tr><th>Тест / набор</th><th>Последний статус</th><th>Запусков</th><th>Максимум, мс</th><th>Всего, мс</th></tr></thead><tbody>");
    let items = first(report, top);
    let max_ms = algorithms::fold(items, 1, fn [ ](maximum: Int, item: model::TestRun) -> Int {
        if item.max_ms > maximum {
            return item.max_ms;
        }
        return maximum;
    });
    for item in items {
        var unstable = "";
        if model::flaky(item) {
            unstable = "<span class='badge flaky'>FLAKY</span>";
        }
        let problem = item.latest == "failed" || model::flaky(item);
        strings_push(parts, "<tr data-problem='" + to_string(problem) + "'><td><b>" + escape(
            item.name) + "</b><small>" + escape(item.suite) + "</small></td><td><span class='badge "
            + item.latest + "'>" + item.latest + "</span>" + unstable + "</td><td>" + to_string(
            item.attempts) + "<small>" + to_string(item.passed) + " pass / " + to_string(
            item.failed) + " fail / " + to_string(item.skipped) + " skip</small></td><td>"
            + to_string(item.max_ms) + "<div class='bar'><i style='width:" + to_string(item.max_ms
            * 100 / max_ms) + "%'></i></div></td><td>" + to_string(item.total_ms) + "</td></tr>");
    }
    strings_push(parts,
        "</tbody></table></div><div id='empty' class='empty' hidden>Нет подходящих тестов</div></section><div class='footer'>В таблице: "
        + to_string(list_len(items)) + " из " + to_string(sum.tests)
        + " тестов. Поиск и переключатель фильтруют только показанные строки.<br>Суммарное время запусков: "
        + to_string(sum.total_ms)
        + " мс (не длительность CI при параллельном выполнении). Событий во входе: "
        + to_string(sum.events)
        + ". Порядок запусков соответствует порядку строк файла.<br>BuildLens · локальный отчёт · без внешних ресурсов</div></main><script>const rows=[...document.querySelectorAll('tbody tr')],search=document.getElementById('search'),problems=document.getElementById('problems');function filter(){const q=search.value.toLocaleLowerCase();let n=0;for(const row of rows){row.hidden=!(row.cells[0].textContent.toLocaleLowerCase().includes(q)&&(!problems.checked||row.dataset.problem==='true'));if(!row.hidden)n++;}document.getElementById('empty').hidden=n!==0;}search.addEventListener('input',filter);problems.addEventListener('change',filter);filter();</script></html>\n");
    return strings_join(parts, "");
}
