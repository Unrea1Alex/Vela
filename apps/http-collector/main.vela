import "../../std/json_decode.vela" as decode;
import "../../std/cli_schema.vela" as cli;
import "../../std/result.vela" as result;
import "../../std/http.vela" as http;
import "../../std/json_stream.vela" as stream;
import "../../std/json.vela" as json;
import "../../std/fs.vela" as fs;
import "../../std/path.vela" as path;
import "../../std/text.vela" as text;
import "../../std/parallel.vela" as parallel;
import "../../std/task_group.vela" as group;
import "../../std/async_io.vela" as aio;
struct Options {
    input: String,
    output: String,
    fail: Bool,
    repeat: Int
}
struct Config {
    urls: List<String>,
    requests: List<http::Request>,
    concurrency: Int,
    timeout: Int
}
struct Row {
    output: String,
    failed: Bool
}
struct Collected {
    output: String,
    failed: Bool
}
fn cli_result<T>(value: Result<T, cli::Error>) -> Result<T, String> {
    return result::map_error(value, cli::describe);
}
fn options() -> Result<Option<Options>, String> effects { args, state, io } {
    let parameters = list_new<cli::Parameter>();
    list_push(parameters, cli::positional("input", "JSON configuration", Option<String>::None));
    list_push(parameters, cli::positional("output", "JSON destination", Option<String>::None));
    list_push(parameters, cli::flag("fail-on-error", "Exit 1 if a request fails", false));
    list_push(parameters, cli::integer("repeat", "Repetitions", 1, 1000, Option<Int>::Some(1)));
    let schema = cli_result(cli::create("http-collector", "Collect bounded HTTP requests.",
        parameters, list_new<cli::LessEqual>()))?;
    let parsed = cli_result(cli::current(schema))?;
    if cli::is_help(parsed) {
        print(cli::help(parsed));
        return Result<Option<Options>, String>::Ok(Option<Options>::None);
    }
    return Result<Option<Options>, String>::Ok(Option<Options>::Some(Options(input: cli_result(
        cli::text_value(parsed, "input"))?, output: cli_result(cli::text_value(parsed, "output"))?,
        fail: cli_result(cli::flag_value(parsed, "fail-on-error"))?, repeat: cli_result(
        cli::int_value(parsed, "repeat"))?)));
}
struct InputConfig {
    urls: List<String>,
    concurrency: Int,
    timeout: Int
}
fn config_schema() -> Result<decode::Decoder<InputConfig>, decode::Error> effects { state } {
    let names = list_new<String>();
    list_push(names, "urls");
    list_push(names, "concurrency");
    list_push(names, "timeout_ms");
    let urls = decode::array(decode::string(), 0, 128)?;
    let concurrency = decode::integer(1, 8)?;
    let timeout = decode::integer(50, 5000)?;
    return decode::object(names, decode::Unknown::Ignore, fn [ urls, concurrency, timeout ](
        fields: decode::Fields) -> Result<InputConfig, decode::Error> effects { state } {
        return Result<InputConfig, decode::Error>::Ok(InputConfig(urls: decode::required(fields,
            "urls", urls)?, concurrency: decode::required(fields, "concurrency", concurrency)?,
            timeout: decode::required(fields, "timeout_ms", timeout)?));
    });
}
fn config(file: String) -> Result<Config, String> effects { state, io } {
    var data = "";
    match fs::read_text(path::Path(value: file), 1048576) {
        Result::Ok(value) => {
            data = value.data;
        }
        Result::Err(_) => {
            return Result<Config, String>::Err("cannot read UTF-8 configuration");
        }
    }
    let schema = result::map_error(config_schema(), decode::describe)?;
    let input = result::map_error(decode::decode(schema, data, stream::Limits(bytes: 1048576,
        depth: 4096, nodes: 1000000)), decode::describe)?;
    let requests = list_new<http::Request>();
    for url in input.urls {
        if str_len(url) < 7 || str_slice(url, 0, 7) != "http://" {
            return Result<Config, String>::Err("plain HTTP URL required");
        }
        match http::from_url(url, input.timeout, 1048576) {
            Result::Ok(request) => {
                list_push(requests, request);
            }
            Result::Err(_) => {
                return Result<Config, String>::Err("invalid URL");
            }
        }
    }
    return Result<Config, String>::Ok(Config(urls: input.urls, requests: requests,
        concurrency: input.concurrency, timeout: input.timeout));
}
fn clock() -> Int effects { io } {
    match monotonic_millis() {
        IntResult::Ok(value) => {
            return value;
        }
        IntResult::Err(message) => {
            assert_true(false, message);
        }
    }
    return 0;
}
fn quote(value: String) -> String effects { state } {
    return match json::stringify(json::Value::StringValue(value)) {
        Result::Ok(data) => data,
        Result::Err(_) => "null"
    };
}
fn error_label(error: http::Error) -> String {
    return match error {
        http::Error::TimedOut => "timeout",
        http::Error::Storage(_) => "storage",
        http::Error::InvalidEndpoint => "network",
        http::Error::InvalidLimit => "network",
        http::Error::InvalidTransport => "network",
        http::Error::InvalidHeaders => "network",
        http::Error::InvalidBody => "network",
        http::Error::Schedule(_) => "network",
        http::Error::Connect(_) => "network",
        http::Error::Tls(_) => "network",
        http::Error::Transfer(_) => "network",
        http::Error::Protocol => "network",
        http::Error::Limit => "network",
        http::Error::Cancelled => "network",
        http::Error::Pending => "network",
        http::Error::Closed => "network"
    };
}
fn response_row(url: String, answer: Result<http::Response, aio::Error<http::Error>>) -> Result<Row,
    String> effects { state } {
    var status = 0;
    var bytes = 0;
    var label = "";
    var failed = false;
    match answer {
        Result::Ok(response) => {
            status = response.status;
            bytes = str_len(response.body.data);
            failed = status >= 400;
        }
        Result::Err(error) => {
            failed = true;
            match error {
                aio::Error::Operation(cause) => {
                    label = error_label(cause);
                    if label == "storage" {
                        return Result<Row, String>::Err("HTTP helper storage/launch failure");
                    }
                }
                aio::Error::TimedOut => {
                    label = "timeout";
                }
                aio::Error::Cancelled => {
                    label = "network";
                }
                aio::Error::Queue(_) => {
                    return Result<Row, String>::Err("cannot schedule HTTP exchange");
                }
                aio::Error::Cleanup(_) => {
                    return Result<Row, String>::Err("HTTP cleanup failure");
                }
                aio::Error::Driver(_) => {
                    return Result<Row, String>::Err("HTTP driver failure");
                }
            }
        }
    }
    var error = "null";
    if label != "" {
        error = quote(label);
    }
    return Result<Row, String>::Ok(Row(output: "{\"url\":" + quote(url) + ",\"status\":"
        + to_string(status) + ",\"bytes\":" + to_string(bytes) + ",\"error\":" + error + "}",
        failed: failed));
}
fn perform(values: Config, directory: path::Path,
    transport: dyn http::Transport) -> Result<Collected, String> effects { state, io, process } {
    let urls = values.urls;
    let timeout = values.timeout + 3000;
    let action = async fn [ urls, timeout, directory, transport ](scope: group::Scope,
        request: http::Request, index: Int) -> Result<Row, String> effects { state } {
        return response_row(list_get(urls, index), await aio::fetch(scope, transport, request,
            directory, timeout));
    };
    let mapped = parallel::create(values.requests, values.concurrency, clock(), timeout * (list_len(
        values.requests) + 1), parallel::Policy::FailFast, action);
    let job = result::map_error(mapped, fn [ ](e: parallel::Error) -> String {
        return "cannot create parallel job";
    })?;
    var ready = false;
    while !ready {
        match parallel::tick(job, clock()) {
            Result::Ok(done) => {
                ready = done;
            }
            Result::Err(_) => {
                assert_true(false, "invalid parallel host clock");
            }
        }
        if !ready {
            let slept = host_sleep(1);
        }
    }
    return match parallel::outcome(job) {
        Option::Some(value) => render(value),
        Option::None => Result<Collected, String>::Err("missing parallel completion")
    };
}
fn render(collected: parallel::Completion<Row, String>) -> Result<Collected,
    String> effects { state } {
    if list_len(collected.cleanup) > 0 {
        return Result<Collected, String>::Err("HTTP cleanup failure");
    }
    let parts = strings_new();
    var failed = false;
    for item in collected.items {
        match item {
            parallel::Item::Value(row) => {
                strings_push(parts, row.output);
                failed = failed || row.failed;
            }
            parallel::Item::Error(message) => {
                return Result<Collected, String>::Err(message);
            }
            parallel::Item::Cancelled => {
                return Result<Collected, String>::Err("HTTP job cancelled");
            }
            parallel::Item::TimedOut => {
                return Result<Collected, String>::Err("HTTP job deadline");
            }
            parallel::Item::Driver(_) => {
                return Result<Collected, String>::Err("HTTP driver failure");
            }
            parallel::Item::NotStarted => {
                return Result<Collected, String>::Err("HTTP job stopped before admission");
            }
        }
    }
    if collected.reason != parallel::Finish::Complete {
        return Result<Collected, String>::Err("HTTP job did not complete");
    }
    return Result<Collected, String>::Ok(Collected(output: "{\"results\":[" + strings_join(parts,
        ",") + "]}", failed: failed));
}
fn iteration(options: Options) -> Result<Collected, String> effects { state, io, process } {
    let values = config(options.input)?;
    let configured = http::curl_transfer(path::Path(value: env("SystemRoot")
        + "\\System32\\curl.exe"), Option<path::Path>::None);
    let transport = match configured {
        Result::Ok(value) => Result<http::Curl, String>::Ok(value),
        Result::Err(_) => Result<http::Curl, String>::Err("trusted Windows curl 8.4+ is required")
    };
    let ready = transport?;
    let absolute = match absolute_path(options.output) {
        StringResult::Ok(value) => value,
        StringResult::Err(_) => ""
    };
    let parent = match path::parent(path::Path(value: absolute)) {
        Result::Ok(value) => Result<path::Path, String>::Ok(value),
        Result::Err(_) => Result<path::Path, String>::Err("invalid output path")
    };
    let directory = match temp_dir(parent?.value) {
        StringResult::Ok(value) => Result<String, String>::Ok(value),
        StringResult::Err(_) => Result<String, String>::Err("cannot create HTTP work directory")
    };
    let work = directory?;
    let collected = perform(values, path::Path(value: work), dyn http::Transport(ready));
    match remove_dir(work) {
        WriteResult::Err(_) => {
            return Result<Collected, String>::Err("cannot remove HTTP work directory");
        }
        WriteResult::Ok => {}
    }
    return collected;
}
fn run(options: Options) -> Result<Bool, String> effects { state, io, process } {
    var output = "";
    var failed = false;
    for i in 0 .. options.repeat {
        let value = iteration(options)?;
        output = value.output;
        failed = failed || value.failed;
    }
    match fs::write_atomic(path::Path(value: options.output), text::Bytes(data: output)) {
        Result::Err(_) => {
            return Result<Bool, String>::Err("cannot publish output");
        }
        Result::Ok(_) => {}
    }
    return Result<Bool, String>::Ok(options.fail && failed);
}
fn main() -> Int effects { args, state, io, process } {
    match options() {
        Result::Err(message) => {
            eprint(message);
            return 2;
        }
        Result::Ok(value) => {
            match value {
                Option::None => {
                    return 0;
                }
                Option::Some(config) => {
                    match run(config) {
                        Result::Err(message) => {
                            eprint(message);
                            return 2;
                        }
                        Result::Ok(failed) => {
                            if failed {
                                return 1;
                            }
                            return 0;
                        }
                    }
                }
            }
        }
    }
}
