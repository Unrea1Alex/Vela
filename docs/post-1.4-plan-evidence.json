  "application_criteria": [
    {
      "id": "D1",
      "acceptance": "Хранение/CRUD и импорт Unicode-путей, пустого/повторного/некорректного документа; транзакция оставляет согласованную БД, данные переживают restart."
    },
    {
      "id": "D2",
      "acceptance": "Миграция двух заранее подготовленных старых схем, отказ в середине, повторный запуск и восстановление копии; проверка всех строк/полей по независимому oracle."
    },
    {
      "id": "D3",
      "acceptance": "Поиск по корпусу 10 000 документов, обновление/удаление индекса, фильтры и устойчивый порядок; ожидаемые ID вычислены независимо от приложения."
    },
    {
      "id": "D4",
      "acceptance": "Реальный GUI Windows/Linux: поиск/выбор/редактирование, keyboard/Unicode, индикация фоновой работы и ошибки; состояние после действий соответствует БД."
    },
    {
      "id": "D5",
      "acceptance": "Индексация, отмена и закрытие окна под нагрузкой; UI heartbeat p95 ≤100 ms на фиксированной машине, нет обращения к закрытому владельцу/оставшихся workers."
    },
    {
      "id": "D6",
      "acceptance": "Установка/перенос без compiler/SDK, работа offline, явные config/log paths и восстановление данных; package manifest соответствует фактическим зависимостям."
    },
    {
      "id": "J1",
      "acceptance": "API submit/status/cancel, параметры/ошибки/лимиты, параллельная очередь; принятые задания учитываются в БД, API не обещает преждевременное выполнение."
    },
    {
      "id": "J2",
      "acceptance": "Ограничение активных jobs, backpressure, retry/backoff/budgets и отмена; журнал независимого исполнителя подтверждает реальные попытки и соблюдение лимита."
    },
    {
      "id": "J3",
      "acceptance": "Не менее 100 crash/restart по фиксированному набору границ переходов; committed результат сохранён, pending/uncertain восстановлены по контракту."
    },
    {
      "id": "J4",
      "acceptance": "Повторный запрос с idempotency key и окно потери подтверждения; идемпотентный sink применяет действие один раз, прочие действия получают честный uncertain/manual outcome."
    },
    {
      "id": "J5",
      "acceptance": "Обновление схемы БД/истории и активного workflow, несовместимая версия, отказ/restore; версия и назначение записанных событий сохранены."
    },
    {
      "id": "J6",
      "acceptance": "Не менее 30 минут нагрузки с отказами БД/сети, лимитами и graceful shutdown; переносимые пакеты обеих ОС, наблюдаемые логи/ресурсы и независимые client/server проверки."
    },
    {
      "id": "P1",
      "acceptance": "Не менее 10 GiB NDJSON фиксированного seed; точные записи/агрегаты совпадают с независимым потоковым oracle, вход целиком в память не читается."
    },
    {
      "id": "P2",
      "acceptance": "Малые chunks/UTF-8 границы, плохая последняя строка, Int overflow, большой элемент и высокая кардинальность; атомарный output либо явная документированная частичность."
    },
    {
      "id": "P3",
      "acceptance": "Одинаковый результат у 1/N workers; ordered режим сохраняет порядок, unordered — полное мультимножество элементов без потерь/дубликатов."
    },
    {
      "id": "P4",
      "acceptance": "Медленный sink, очередь по count/bytes, остановка/ошибка worker и отмена; backpressure достигает источника, живые буферы ограничены."
    },
    {
      "id": "P5",
      "acceptance": "Зафиксированный bounded-cardinality вход: Windows — peak job private commit всего дерева ≤256 MiB; Linux — весь запуск в отдельной cgroup v2 с memory.max=256 MiB и memory.swap.max=0, успешно завершён без OOM, записан memory.peak (включает page cache). Генератор входа и oracle работают вне измеряемой группы. Эти разные OS-метрики не отождествляются; unavailable не заменяется нулём."
    },
    {
      "id": "P6",
      "acceptance": "На заранее выбранной CPU-нагрузке медианное ускорение 4 workers ≥1.5× относительно 1, минимум 10 перемежающихся запусков после warmup; корректность каждого вывода, пакетный перенос и штатное завершение подтверждены."
    }
  ],
