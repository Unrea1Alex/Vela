import "test.vela" as test;
fn main() -> Int effects { state, io, process } {
    if platform() != "windows" || env("VELA_CC_KIND") != "msvc" { return 2; }
    let root = test::value(absolute_path("."));
    let dir = root + "/build/stage07/prototypes";
    test::done(make_dir(dir));
    var suite = test::Suite(root: root, compiler: root + "/bin/velac.exe", dir: dir, passed: 0, failed: 0);
    for name in test::split("network|gui", 124) {
        var library = "vela-net-prototype.dll";
        var link = "winhttp.lib";
        if name == "gui" { library = "vela-gui-prototype.dll"; link = "user32.lib"; }
        let args = test::command(env("VELA_CC"));
        for flag in test::split("/nologo|/std:c11|/LD|/MT|/O2|/fp:strict|/utf-8", 124) { strings_push(args, flag); }
        strings_push(args, "/Fo" + dir + "/" + name + ".obj");
        strings_push(args, "/Fe" + dir + "/" + library);
        strings_push(args, root + "/prototypes/windows/" + name + ".c");
        strings_push(args, "/link"); strings_push(args, link);
        strings_push(args, "/IMPLIB:" + dir + "/" + name + ".lib");
        let native = test::invoke(suite, args, 30000);
        suite = test::record(suite, name + "_adapter", native.code == 0, native.out + native.err);
        let built = test::build(suite, root + "/prototypes/windows/" + name + ".vela", dir + "/" + name + ".exe");
        suite = test::record(suite, name + "_application", built.code == 0, built.out + built.err);
    }
    print(f"Prototype build: {suite.passed:d} passed; {suite.failed:d} failed");
    if suite.failed > 0 { return 1; }
    return 0;
}
