import "json_tokens.vela" as tokens;
import "text.vela" as text;
pub enum Value {
    Null,
    Boolean(Bool),
    Integer(Int),
    Number(Float64),
    StringValue(String),
    Array(List<Value>),
    Object(List<Member>)
}
pub struct Member {
    name: String,
    value: Value
}
pub enum Error {
    Syntax(Int, String),
    Encoding(Int),
    Limit,
    NonFinite,
    Duplicate(String)
}
pub struct Limits {
    bytes: Int,
    depth: Int,
    nodes: Int
}
pub enum ParseError {
    InvalidLimits,
    ByteLimit(Int),
    DepthLimit(Int),
    NodeLimit(Int),
    Input(Error)
}
struct Reader {
    data: String,
    cursor: List<Int>,
    nodes: List<Int>,
    limits: Limits,
    exhausted: List<ParseError>
}
struct Writer {
    output: text::Builder,
    nodes: List<Int>
}
fn position(r: Reader) -> Int effects { state } {
    return list_get(r.cursor, 0);
}
fn move(r: Reader, n: Int) -> Unit effects { state } {
    list_set(r.cursor, 0, n);
}
fn failure<T>(r: Reader, message: String) -> Result<T, Error> effects { state } {
    return Result<T, Error>::Err(Error::Syntax(position(r), message));
}
fn peek(r: Reader) -> Int effects { state } {
    if position(r) >= str_len(r.data) {
        return -1;
    }
    return str_byte(r.data, position(r));
}

fn skip(r: Reader) -> Unit effects { state } {
    move(r, tokens::whitespace_at(r.data, position(r)));
}
fn take_byte(r: Reader, expected: Int) -> Bool effects { state } {
    if peek(r) != expected {
        return false;
    }
    move(r, position(r) + 1);
    return true;
}

fn scanned<T>(result_value: Result<T, tokens::ScanError>) -> Result<T, Error> {
    return match result_value {
        Result::Ok(value) => Result<T, Error>::Ok(value),
        Result::Err(error) => Result<T, Error>::Err(Error::Syntax(error.consumed, error.message))
    };
}
fn string_value(r: Reader) -> Result<String, Error> effects { state } {
    let parsed = scanned(tokens::string(r.data, position(r)))?;
    move(r, parsed.end);
    return Result<String, Error>::Ok(parsed.value);
}
fn number(r: Reader) -> Result<Value, Error> effects { state } {
    let start = position(r);
    let parsed = scanned(tokens::number(r.data, start))?;
    move(r, parsed.end);
    if parsed.end - start > 4096 {
        return Result<Value, Error>::Err(Error::Limit);
    }
    let token = str_slice(r.data, start, parsed.end);
    if parsed.integral {
        match parse_int(token) {
            IntResult::Ok(n) => { return Result<Value, Error>::Ok(Value::Integer(n)); }
            IntResult::Err(_) => {}
        }
    }
    match parse_float(token) {
        FloatResult::Ok(n) => { return Result<Value, Error>::Ok(Value::Number(n)); }
        FloatResult::Err(_) => { return failure<Value>(r, "number outside Float64 range"); }
    }
}
fn keyword_value(r: Reader, word: String, value: Value) -> Result<Value, Error> effects { state } {
    let start = position(r);
    if start + str_len(word) > str_len(r.data) {
        return failure<Value>(r, "incomplete keyword");
    }
    if tokens::literal_end(r.data, start, word) != start + str_len(word) {
        return failure<Value>(r, "invalid keyword");
    }
    move(r, start + str_len(word));
    return Result<Value, Error>::Ok(value);
}
fn read_value(r: Reader, depth: Int) -> Result<Value, Error> effects { state } {
    if depth > r.limits.depth {
        list_push(r.exhausted, ParseError::DepthLimit(r.limits.depth));
        return Result<Value, Error>::Err(Error::Limit);
    }
    if list_get(r.nodes, 0) >= r.limits.nodes {
        list_push(r.exhausted, ParseError::NodeLimit(r.limits.nodes));
        return Result<Value, Error>::Err(Error::Limit);
    }
    list_set(r.nodes, 0, list_get(r.nodes, 0) + 1);
    skip(r);
    let b = peek(r);
    if b == 34 {
        return Result<Value, Error>::Ok(Value::StringValue(string_value(r)?));
    }
    if b == 110 {
        return keyword_value(r, "null", Value::Null);
    }
    if b == 116 {
        return keyword_value(r, "true", Value::Boolean(true));
    }
    if b == 102 {
        return keyword_value(r, "false", Value::Boolean(false));
    }
    if b == 45 || tokens::digit(b) {
        return number(r);
    }
    if take_byte(r, 91) {
        let values = list_new<Value>();
        skip(r);
        if take_byte(r, 93) {
            return Result<Value, Error>::Ok(Value::Array(values));
        }
        while true {
            list_push(values, read_value(r, depth + 1)?);
            skip(r);
            if take_byte(r, 93) {
                return Result<Value, Error>::Ok(Value::Array(values));
            }
            if !take_byte(r, 44) {
                return failure<Value>(r, "expected comma or closing bracket");
            }
        }
    }
    if take_byte(r, 123) {
        let members = list_new<Member>();
        let seen = dict_new<String, Bool>();
        skip(r);
        if take_byte(r, 125) {
            return Result<Value, Error>::Ok(Value::Object(members));
        }
        while true {
            skip(r);
            let name = string_value(r)?;
            skip(r);
            if dict_has(seen, name) {
                return Result<Value, Error>::Err(Error::Duplicate(name));
            }
            dict_set(seen, name, true);
            if !take_byte(r, 58) {
                return failure<Value>(r, "expected colon");
            }
            list_push(members, Member(name: name, value: read_value(r, depth + 1)?));
            skip(r);
            if take_byte(r, 125) {
                return Result<Value, Error>::Ok(Value::Object(members));
            }
            if !take_byte(r, 44) {
                return failure<Value>(r, "expected comma or closing brace");
            }
        }
    }
    return failure<Value>(r, "expected JSON value");
}
fn parse_bounded(data: String, limits: Limits, exhausted: List<ParseError>) -> Result<Value,
    Error> effects { state } {
    let invalid = text::invalid_offset(data);
    if invalid >= 0 {
        return Result<Value, Error>::Err(Error::Encoding(invalid));
    }
    let cursor = list_new<Int>();
    list_push(cursor, 0);
    let nodes = list_new<Int>();
    list_push(nodes, 0);
    let reader = Reader(data: data, cursor: cursor, nodes: nodes, limits: limits,
        exhausted: exhausted);
    let parsed = read_value(reader, 0)?;
    skip(reader);
    if position(reader) != str_len(data) {
        return failure<Value>(reader, "trailing data");
    }
    return Result<Value, Error>::Ok(parsed);
}
pub fn default_limits() -> Limits {
    return Limits(bytes: 16777216, depth: 128, nodes: 65536);
}
pub fn parse_with_limits(data: String, limits: Limits) -> Result<Value,
    ParseError> effects { state } {
    if !tokens::valid_limits(limits.bytes, limits.depth, limits.nodes, 128, 131072) {
        return Result<Value, ParseError>::Err(ParseError::InvalidLimits);
    }
    if str_len(data) > limits.bytes {
        return Result<Value, ParseError>::Err(ParseError::ByteLimit(limits.bytes));
    }
    let exhausted = list_new<ParseError>();
    match parse_bounded(data, limits, exhausted) {
        Result::Ok(value) => {
            return Result<Value, ParseError>::Ok(value);
        }
        Result::Err(error) => {
            if list_len(exhausted) > 0 {
                return Result<Value, ParseError>::Err(list_get(exhausted, 0));
            }
            return Result<Value, ParseError>::Err(ParseError::Input(error));
        }
    }
}
pub fn parse(data: String) -> Result<Value, Error> effects { state } {
    match parse_with_limits(data, default_limits()) {
        Result::Ok(value) => {
            return Result<Value, Error>::Ok(value);
        }
        Result::Err(error) => {
            match error {
                ParseError::Input(cause) => {
                    return Result<Value, Error>::Err(cause);
                }
                ParseError::InvalidLimits => {}
                ParseError::ByteLimit(_) => {}
                ParseError::DepthLimit(_) => {}
                ParseError::NodeLimit(_) => {}
            }
            return Result<Value, Error>::Err(Error::Limit);
        }
    }
}
fn put(w: Writer, data: String) -> Result<Bool, Error> effects { state } {
    return match text::append(w.output, text::Bytes(data: data)) {
        Result::Ok(value) => Result<Bool, Error>::Ok(value),
        Result::Err(_) => Result<Bool, Error>::Err(Error::Limit)
    };
}
fn quoted(w: Writer, data: String) -> Result<Bool, Error> effects { state } {
    let invalid = text::invalid_offset(data);
    if invalid >= 0 {
        return Result<Bool, Error>::Err(Error::Encoding(invalid));
    }
    let opened = put(w, "\"")?;
    var start = 0;
    for i in 0 .. str_len(data) {
        let b = str_byte(data, i);
        if b < 32 || b == 34 || b == 92 {
            let chunk = put(w, str_slice(data, start, i))?;

            let escaped = put(w, tokens::escaped_byte(b))?;
            start = i + 1;
        }
    }
    let tail = put(w, str_slice(data, start, str_len(data)))?;
    return put(w, "\"");
}
fn emit_value(w: Writer, value: Value, depth: Int) -> Result<Bool, Error> effects { state } {
    if depth > 128 || list_get(w.nodes, 0) >= 65536 {
        return Result<Bool, Error>::Err(Error::Limit);
    }
    list_set(w.nodes, 0, list_get(w.nodes, 0) + 1);
    match value {
        Value::Null => {
            return put(w, "null");
        }
        Value::Boolean(b) => {
            return put(w, to_string(b));
        }
        Value::Integer(n) => {
            return put(w, to_string(n));
        }
        Value::Number(n) => {
            if !float_is_finite(n) {
                return Result<Bool, Error>::Err(Error::NonFinite);
            }
            var token = float_to_string(n);
            var decimal = false;
            for i in 0 .. str_len(token) {
                let b = str_byte(token, i);
                if b == 46 || b == 101 {
                    decimal = true;
                }
            }
            if !decimal {
                token = token + ".0";
            }
            return put(w, token);
        }
        Value::StringValue(data) => {
            return quoted(w, data);
        }
        Value::Array(values) => {
            let opened = put(w, "[")?;
            var first = true;
            for item in values {
                if !first {
                    let comma = put(w, ",")?;
                }
                first = false;
                let emitted = emit_value(w, item, depth + 1)?;
            }
            return put(w, "]");
        }
        Value::Object(members) => {
            let opened = put(w, "{")?;
            var first = true;
            let seen = dict_new<String, Bool>();
            for member in members {
                if dict_has(seen, member.name) {
                    return Result<Bool, Error>::Err(Error::Duplicate(member.name));
                }
                dict_set(seen, member.name, true);
                if !first {
                    let comma = put(w, ",")?;
                }
                first = false;
                let name = quoted(w, member.name)?;
                let colon = put(w, ":")?;
                let emitted = emit_value(w, member.value, depth + 1)?;
            }
            return put(w, "}");
        }
    }
}
pub fn stringify(value: Value) -> Result<String, Error> effects { state } {
    match text::builder(16777216) {
        Result::Ok(output) => {
            let nodes = list_new<Int>();
            list_push(nodes, 0);
            let writer = Writer(output: output, nodes: nodes);
            let success = emit_value(writer, value, 0)?;
            return Result<String, Error>::Ok(text::finish_bytes(output).data);
        }
        Result::Err(_) => { return Result<String, Error>::Err(Error::Limit); }
    }
}
pub struct At<E> {
    path: String,
    cause: E
}
pub enum DecodeCause {
    Parse(Error),
    Selector(Error),
    Expected(String),
    Missing,
    Index,
    NonFinite,
    IntegerPrecision
}
pub enum IntegerMode {
    Exact,
    Round
}
pub struct Cursor {
    value: Value,
    path: String
}
pub fn with_path<T, E>(outcome: Result<T, E>, path: String) -> Result<T, At<E>> {
    return match outcome {
        Result::Ok(value) => Result<T, At<E>>::Ok(value),
        Result::Err(cause) => Result<T, At<E>>::Err(At<E>(path: path, cause: cause))
    };
}
fn decode_error<T>(path: String, cause: DecodeCause) -> Result<T, At<DecodeCause>> {
    return Result<T, At<DecodeCause>>::Err(At<DecodeCause>(path: path, cause: cause));
}
pub fn root(value: Value) -> Cursor {
    return Cursor(value: value, path: "$");
}
pub fn decode(data: String) -> Result<Cursor, At<DecodeCause>> effects { state } {
    return match parse(data) {
        Result::Ok(value) => Result<Cursor, At<DecodeCause>>::Ok(root(value)),
        Result::Err(cause) => decode_error<Cursor>("$", DecodeCause::Parse(cause))
    };
}
pub fn as_object(c: Cursor) -> Result<List<Member>, At<DecodeCause>> {
    match c.value {
        Value::Object(items) => {
            return Result<List<Member>, At<DecodeCause>>::Ok(items);
        }
        Value::Null => {}
        Value::Boolean(_) => {}
        Value::Integer(_) => {}
        Value::Number(_) => {}
        Value::StringValue(_) => {}
        Value::Array(_) => {}
    }
    return decode_error<List<Member>>(c.path, DecodeCause::Expected("object"));
}
pub fn as_array(c: Cursor) -> Result<List<Value>, At<DecodeCause>> {
    match c.value {
        Value::Array(items) => {
            return Result<List<Value>, At<DecodeCause>>::Ok(items);
        }
        Value::Null => {}
        Value::Boolean(_) => {}
        Value::Integer(_) => {}
        Value::Number(_) => {}
        Value::StringValue(_) => {}
        Value::Object(_) => {}
    }
    return decode_error<List<Value>>(c.path, DecodeCause::Expected("array"));
}
pub fn as_string(c: Cursor) -> Result<String, At<DecodeCause>> {
    match c.value {
        Value::StringValue(value) => {
            return Result<String, At<DecodeCause>>::Ok(value);
        }
        Value::Null => {}
        Value::Boolean(_) => {}
        Value::Integer(_) => {}
        Value::Number(_) => {}
        Value::Array(_) => {}
        Value::Object(_) => {}
    }
    return decode_error<String>(c.path, DecodeCause::Expected("string"));
}
pub fn as_int(c: Cursor) -> Result<Int, At<DecodeCause>> {
    match c.value {
        Value::Integer(value) => {
            return Result<Int, At<DecodeCause>>::Ok(value);
        }
        Value::Null => {}
        Value::Boolean(_) => {}
        Value::Number(_) => {}
        Value::StringValue(_) => {}
        Value::Array(_) => {}
        Value::Object(_) => {}
    }
    return decode_error<Int>(c.path, DecodeCause::Expected("integer"));
}
pub fn as_bool(c: Cursor) -> Result<Bool, At<DecodeCause>> {
    match c.value {
        Value::Boolean(value) => {
            return Result<Bool, At<DecodeCause>>::Ok(value);
        }
        Value::Null => {}
        Value::Integer(_) => {}
        Value::Number(_) => {}
        Value::StringValue(_) => {}
        Value::Array(_) => {}
        Value::Object(_) => {}
    }
    return decode_error<Bool>(c.path, DecodeCause::Expected("boolean"));
}
pub fn as_number(c: Cursor, integer_mode: IntegerMode) -> Result<Float64, At<DecodeCause>> {
    match c.value {
        Value::Integer(value) => {
            let converted = float_from_int(value);
            match integer_mode {
                IntegerMode::Round => {
                    return Result<Float64, At<DecodeCause>>::Ok(converted);
                }
                IntegerMode::Exact => {
                    match float_to_int(converted) {
                        IntResult::Ok(back) => {
                            if back == value {
                                return Result<Float64, At<DecodeCause>>::Ok(converted);
                            }
                        }
                        IntResult::Err(_) => {}
                    }
                }
            }
            return decode_error<Float64>(c.path, DecodeCause::IntegerPrecision);
        }
        Value::Number(value) => {
            if !float_is_finite(value) {
                return decode_error<Float64>(c.path, DecodeCause::NonFinite);
            }
            return Result<Float64, At<DecodeCause>>::Ok(value);
        }
        Value::Null => {}
        Value::Boolean(_) => {}
        Value::StringValue(_) => {}
        Value::Array(_) => {}
        Value::Object(_) => {}
    }
    return decode_error<Float64>(c.path, DecodeCause::Expected("number"));
}
fn identifier_path(name: String) -> Bool {
    if str_len(name) == 0 {
        return false;
    }
    for i in 0 .. str_len(name) {
        let b = str_byte(name, i);
        if !(b == 95 || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (i > 0 && b >= 48 && b
            <= 57)) {
            return false;
        }
    }
    return true;
}
pub fn field(c: Cursor, name: String) -> Result<Cursor, At<DecodeCause>> effects { state } {
    let members = as_object(c)?;
    var path = c.path;
    if identifier_path(name) {
        path = path + "." + name;
    } else {
        match stringify(Value::StringValue(name)) {
            Result::Ok(quoted) => {
                path = path + "[" + quoted + "]";
            }
            Result::Err(error) => {
                return decode_error<Cursor>(path, DecodeCause::Selector(error));
            }
        }
    }
    for member in members {
        if member.name == name {
            return Result<Cursor, At<DecodeCause>>::Ok(Cursor(value: member.value, path: path));
        }
    }
    return decode_error<Cursor>(path, DecodeCause::Missing);
}
pub fn item(c: Cursor, index: Int) -> Result<Cursor, At<DecodeCause>> effects { state } {
    let values = as_array(c)?;
    let path = c.path + "[" + to_string(index) + "]";
    if index < 0 || index >= list_len(values) {
        return decode_error<Cursor>(path, DecodeCause::Index);
    }
    return Result<Cursor, At<DecodeCause>>::Ok(Cursor(value: list_get(values, index), path: path));
}
fn error_detail(error: Error) -> String {
    return match error {
        Error::Syntax(offset, message) => "JSON byte " + to_string(offset) + ": " + message,
        Error::Encoding(offset) => "invalid UTF-8 at byte " + to_string(offset),
        Error::Limit => "JSON limit exceeded",
        Error::NonFinite => "expected a finite number",
        Error::Duplicate(name) => "duplicate JSON field: " + name
    };
}
pub fn describe_parse_error(error: ParseError) -> String {
    return match error {
        ParseError::InvalidLimits => "Invalid JSON limits",
        ParseError::ByteLimit(limit) => "JSON byte limit exceeded (" + to_string(limit) + ")",
        ParseError::DepthLimit(limit) => "JSON depth limit exceeded (" + to_string(limit) + ")",
        ParseError::NodeLimit(limit) => "JSON node limit exceeded (" + to_string(limit) + ")",
        ParseError::Input(cause) => error_detail(cause)
    };
}
pub fn describe(error: At<DecodeCause>) -> String {
    let detail = match error.cause {
        DecodeCause::Parse(cause) => error_detail(cause),
        DecodeCause::Selector(cause) => error_detail(cause),
        DecodeCause::Expected(kind) => "expected " + kind,
        DecodeCause::Missing => "missing field",
        DecodeCause::Index => "array index out of range",
        DecodeCause::NonFinite => "expected a finite number",
        DecodeCause::IntegerPrecision => "integer is not exactly representable as Float64"
    };
    return error.path + ": " + detail;
}
