pub fn copy<T>(values: List<T>) -> List<T> effects { state } {
    let out = list_new<T>();
    for value in values {
        list_push(out, value);
    }
    return out;
}
pub fn reverse<T>(values: List<T>) -> List<T> effects { state } {
    let out = list_new<T>();
    var i = list_len(values);
    while i > 0 {
        i = i - 1;
        list_push(out, list_get(values, i));
    }
    return out;
}
pub fn sort_ints(values: List<Int>) -> List<Int> effects { state } {
    let out = copy(values);
    for i in 1 .. list_len(out) {
        let value = list_get(out, i);
        var j = i;
        while j > 0 && list_get(out, j - 1) > value {
            list_set(out, j, list_get(out, j - 1));
            j = j - 1;
        }
        list_set(out, j, value);
    }
    return out;
}
fn float_after(a: Float64, b: Float64) -> Bool {
    return (float_is_nan(a) && !float_is_nan(b)) || (!float_is_nan(a) && !float_is_nan(b) && a > b);
}
pub fn sort_floats(values: List<Float64>) -> List<Float64> effects { state } {
    let out = copy(values);
    for i in 1 .. list_len(out) {
        let value = list_get(out, i);
        var j = i;
        while j > 0 && float_after(list_get(out, j - 1), value) {
            list_set(out, j, list_get(out, j - 1));
            j = j - 1;
        }
        list_set(out, j, value);
    }
    return out;
}
pub fn compare(a: String, b: String) -> Int {
    var i = 0;
    while i < str_len(a) && i < str_len(b) {
        if str_byte(a, i) < str_byte(b, i) {
            return -1;
        }
        if str_byte(a, i) > str_byte(b, i) {
            return 1;
        }
        i = i + 1;
    }
    if str_len(a) < str_len(b) {
        return -1;
    }
    if str_len(a) > str_len(b) {
        return 1;
    }
    return 0;
}
pub fn sort_strings(values: List<String>) -> List<String> effects { state } {
    let out = copy(values);
    for i in 1 .. list_len(out) {
        let value = list_get(out, i);
        var j = i;
        while j > 0 && compare(list_get(out, j - 1), value) > 0 {
            list_set(out, j, list_get(out, j - 1));
            j = j - 1;
        }
        list_set(out, j, value);
    }
    return out;
}
