import "algorithms.vela" as algorithms;
pub fn copy<T>(values: List<T>) -> List<T> effects { state } {
    let out = list_new<T>();
    for value in values {
        list_push(out, value);
    }
    return out;
}
pub fn reverse<T>(values: List<T>) -> List<T> effects { state } {
    let out = list_new<T>();
    var i = list_len(values);
    while i > 0 {
        i = i - 1;
        list_push(out, list_get(values, i));
    }
    return out;
}
pub fn sort_ints(values: List<Int>) -> List<Int> effects { state } {
    return algorithms::sort(values, fn [ ](a: Int, b: Int) -> Int {
        if a < b {
            return -1;
        }
        if a > b {
            return 1;
        }
        return 0;
    });
}
pub fn sort_floats(values: List<Float64>) -> List<Float64> effects { state } {
    return algorithms::sort(values, fn [ ](a: Float64, b: Float64) -> Int {
        if float_is_nan(a) {
            if float_is_nan(b) {
                return 0;
            }
            return 1;
        }
        if float_is_nan(b) {
            return -1;
        }
        if a < b {
            return -1;
        }
        if a > b {
            return 1;
        }
        return 0;
    });
}
pub fn compare(a: String, b: String) -> Int {
    var i = 0;
    while i < str_len(a) && i < str_len(b) {
        if str_byte(a, i) < str_byte(b, i) {
            return -1;
        }
        if str_byte(a, i) > str_byte(b, i) {
            return 1;
        }
        i = i + 1;
    }
    if str_len(a) < str_len(b) {
        return -1;
    }
    if str_len(a) > str_len(b) {
        return 1;
    }
    return 0;
}
pub fn sort_strings(values: List<String>) -> List<String> effects { state } {
    return algorithms::sort(values, compare);
}
