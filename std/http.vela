import "event_loop.vela" as loop;
import "path.vela" as path;
import "process.vela" as process;
import "text.vela" as text;
import "cell.vela" as cell;
pub enum Scheme {
    Http,
    Https
}
pub enum Method {
    Get,
    Head,
    Post,
    Put,
    Delete
}
pub struct Header {
    name: String,
    value: String
}
pub enum Error {
    InvalidEndpoint,
    InvalidLimit,
    InvalidTransport,
    InvalidHeaders,
    InvalidBody,
    Schedule(process::ScheduleError),
    Connect(Int),
    Tls(Int),
    Transfer(Int),
    Protocol,
    Limit,
    TimedOut,
    Cancelled,
    Pending,
    Closed,
    Storage(String)
}
pub opaque struct Request {
    url: String,
    timeout_ms: Int,
    body_limit: Int,
    method: Method,
    headers: String,
    upload: String,
    remaining: Option<Int>
}
pub struct Response {
    status: Int,
    headers: text::Bytes,
    body: text::Bytes
}
struct Files {
    directory: String,
    status: String,
    errors: String,
    headers: String,
    body: String,
    upload: String
}
struct Work {
    task: loop::Task<process::Completed>,
    files: Files,
    body_limit: Int,
    head: Bool
}
enum Source {
    Process(Work),
    Scripted(Result<Response, Error>),
    Multi(MultiExchange)
}
pub opaque struct Exchange {
    source: Source,
    closed: List<Bool>
}
pub opaque struct Curl {
    executable: path::Path,
    ca_file: Option<path::Path>,
    transfer_deadline: Bool
}
pub opaque struct Scripted {
    result_value: Result<Response, Error>
}
pub struct MultiLimits {
    connections: Int,
    per_origin: Int,
    queue: Int,
    idle_seconds: Int,
    connect_ms: Int
}
pub enum MultiOpenError {
    Unsupported,
    Limits,
    Trust(Error),
    Dependency(String)
}
pub fn describe_multi_open(error: MultiOpenError) -> String {
    return match error {
        MultiOpenError::Unsupported => "HTTP multi requires Windows x64",
        MultiOpenError::Limits => "Invalid HTTP multi limits",
        MultiOpenError::Trust(_) => "Invalid HTTP multi CA file",
        MultiOpenError::Dependency(message) => "HTTP multi dependency: " + message
    };
}
enum MultiPhase {
    Queued,
    Active(ForeignHandle),
    Done(Result<Response, Error>),
    Released
}
struct MultiItem {
    request: Request,
    origin: String,
    deadline: Int,
    phase: cell::Cell<MultiPhase>,
    cancelled: cell::Cell<Bool>
}
pub opaque struct CurlMulti {
    owner: ForeignHandle,
    limits: MultiLimits,
    items: List<MultiItem>,
    closing: cell::Cell<Bool>,
    closed: cell::Cell<Bool>
}
struct MultiExchange {
    pool: CurlMulti,
    item: MultiItem
}
pub struct MultiStats {
    active: Int,
    queued: Int,
    slots: Int,
    reserved_body: Int
}
pub interface Transport {
    fn start(self: Self, scheduler: loop::Loop<process::Completed>, request: Request,
        directory: path::Path) -> Result<Exchange, Error> effects { io, state };
}
fn alphanumeric(value: Int) -> Bool {
    return (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value
        <= 122);
}
fn valid_host(value: String) -> Bool {
    let size = str_len(value);
    if size == 0 || size > 253 {
        return false;
    }
    var label = 0;
    var previous = 0;
    for i in 0 .. size {
        let byte = str_byte(value, i);
        if byte == 46 {
            if label == 0 || previous == 45 {
                return false;
            }
            label = 0;
        } else {
            if !alphanumeric(byte) && (byte != 45 || label == 0) {
                return false;
            }
            label = label + 1;
            if label > 63 {
                return false;
            }
        }
        previous = byte;
    }
    return label > 0 && previous != 45;
}
fn hex(byte: Int) -> Bool {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102);
}
pub fn valid_target(value: String) -> Bool {
    let size = str_len(value);
    if size < 1 || size > 2048 || str_byte(value, 0) != 47 {
        return false;
    }
    var i = 0;
    while i < size {
        let byte = str_byte(value, i);
        if byte < 33 || byte > 126 || byte == 35 || byte == 92 {
            return false;
        }
        if byte == 37 {
            if i + 2 >= size || !hex(str_byte(value, i + 1)) || !hex(str_byte(value, i + 2)) {
                return false;
            }
            i = i + 2;
        }
        i = i + 1;
    }
    return true;
}
pub fn get(scheme: Scheme, host: String, port: Int, target: String, timeout_ms: Int,
    body_limit: Int) -> Result<Request, Error> {
    if !valid_host(host) || port < 1 || port > 65535 || !valid_target(target) {
        return Result<Request, Error>::Err(Error::InvalidEndpoint);
    }
    if timeout_ms < 1 || timeout_ms > 120000 || body_limit < 1 || body_limit > 1048576 {
        return Result<Request, Error>::Err(Error::InvalidLimit);
    }
    let protocol = match scheme {
        Scheme::Http => "http",
        Scheme::Https => "https"
    };
    let url = protocol + "://" + host + ":" + to_string(port) + target;
    return Result<Request, Error>::Ok(Request(url: url, timeout_ms: timeout_ms,
        body_limit: body_limit, method: Method::Get, headers: "", upload: "", remaining: Option<Int>::None));
}
pub fn url(request: Request) -> String {
    return request.url;
}
pub fn with_remaining_budget(request: Request, remaining: Int) -> Request {
    var changed = request;
    changed.remaining = Option<Int>::Some(remaining);
    return changed;
}
pub fn from_url(value: String, timeout_ms: Int, body_limit: Int) -> Result<Request, Error> {
    let size = str_len(value);
    if size < 8 || size > 4096 {
        return Result<Request, Error>::Err(Error::InvalidEndpoint);
    }
    var start = 7;
    var scheme = Scheme::Http;
    var port = 80;
    if str_slice(value, 0, 7) != "http://" {
        if size < 9 || str_slice(value, 0, 8) != "https://" {
            return Result<Request, Error>::Err(Error::InvalidEndpoint);
        }
        start = 8;
        scheme = Scheme::Https;
        port = 443;
    }
    var end = start;
    while end < size && str_byte(value, end) != 47 && str_byte(value, end) != 63 {
        end = end + 1;
    }
    var colon = start;
    while colon < end && str_byte(value, colon) != 58 {
        colon = colon + 1;
    }
    let host = str_slice(value, start, colon);
    if colon < end {
        if end - colon < 2 || end - colon > 6 {
            return Result<Request, Error>::Err(Error::InvalidEndpoint);
        }
        port = 0;
        for i in colon + 1 .. end {
            let byte = str_byte(value, i);
            if byte < 48 || byte > 57 {
                return Result<Request, Error>::Err(Error::InvalidEndpoint);
            }
            port = port * 10 + byte - 48;
        }
    }
    var target = "/";
    if end < size {
        target = str_slice(value, end, size);
        if str_byte(value, end) == 63 {
            target = "/" + target;
        }
    }
    return get(scheme, host, port, target, timeout_ms, body_limit);
}
pub fn with_method(request: Request, method: Method, body: text::Bytes) -> Result<Request, Error> {
    if str_len(body.data) > 1048576 {
        return Result<Request, Error>::Err(Error::InvalidLimit);
    }
    let empty = match method {
        Method::Get => true,
        Method::Head => true,
        Method::Post => false,
        Method::Put => false,
        Method::Delete => false
    };
    if empty && body.data != "" {
        return Result<Request, Error>::Err(Error::InvalidBody);
    }
    var changed = request;
    changed.method = method;
    changed.upload = body.data;
    return Result<Request, Error>::Ok(changed);
}
fn header_name(value: String) -> String {
    if str_len(value) < 1 || str_len(value) > 64 {
        return "";
    }
    var name = "";
    for i in 0 .. str_len(value) {
        var byte = str_byte(value, i);
        if !alphanumeric(byte) && byte != 45 {
            return "";
        }
        if byte >= 65 && byte <= 90 {
            byte = byte + 32;
        }
        name = name + str_from_byte(byte);
    }
    return name;
}
pub fn with_headers(request: Request, headers: List<Header>) -> Result<Request,
    Error> effects { state } {
    if list_len(headers) > 32 {
        return Result<Request, Error>::Err(Error::InvalidLimit);
    }
    var encoded = "";
    for i in 0 .. list_len(headers) {
        let item = list_get(headers, i);
        let name = header_name(item.name);
        if name == "" || name == "host" || name == "content-length" || name == "transfer-encoding"
            || name == "connection" || name == "expect" || name == "upgrade" || name
            == "authorization" || name == "proxy-authorization" || name == "cookie" {
            return Result<Request, Error>::Err(Error::InvalidHeaders);
        }
        for j in 0 .. i {
            if name == header_name(list_get(headers, j).name) {
                return Result<Request, Error>::Err(Error::InvalidHeaders);
            }
        }
        if str_len(item.value) > 1024 {
            return Result<Request, Error>::Err(Error::InvalidLimit);
        }
        for j in 0 .. str_len(item.value) {
            let byte = str_byte(item.value, j);
            if byte < 32 || byte > 126 {
                return Result<Request, Error>::Err(Error::InvalidHeaders);
            }
        }
        if str_len(encoded) + str_len(name) + str_len(item.value) + 3 > 8192 {
            return Result<Request, Error>::Err(Error::InvalidLimit);
        }
        encoded = encoded + name + ": " + item.value + "\n";
    }
    var changed = request;
    changed.headers = encoded;
    return Result<Request, Error>::Ok(changed);
}
fn absolute(value: path::Path) -> Bool {
    return match path::absolute(value) {
        Result::Ok(yes) => yes,
        Result::Err(_) => false
    };
}
pub fn curl(executable: path::Path, ca_file: Option<path::Path>) -> Result<Curl, Error> {
    if !absolute(executable) {
        return Result<Curl, Error>::Err(Error::InvalidTransport);
    }
    match ca_file {
        Option::Some(file) => {
            if !absolute(file) {
                return Result<Curl, Error>::Err(Error::InvalidTransport);
            }
        }
        Option::None => {}
    }
    return Result<Curl, Error>::Ok(Curl(executable: executable, ca_file: ca_file,
        transfer_deadline: false));
}
pub fn curl_transfer(executable: path::Path, ca_file: Option<path::Path>) -> Result<Curl, Error> {
    var transport = curl(executable, ca_file)?;
    transport.transfer_deadline = true;
    return Result<Curl, Error>::Ok(transport);
}
pub fn scripted(result_value: Result<Response, Error>) -> Scripted {
    return Scripted(result_value: result_value);
}
fn exchange(source: Source) -> Exchange effects { state } {
    let closed = list_new<Bool>();
    list_push(closed, false);
    return Exchange(source: source, closed: closed);
}
impl Transport for Scripted {
    fn start(self: Scripted, scheduler: loop::Loop<process::Completed>, request: Request,
        directory: path::Path) -> Result<Exchange, Error> effects { state } {
        return Result<Exchange, Error>::Ok(exchange(Source::Scripted(self.result_value)));
    }
}
fn timeout_text(ms: Int) -> String {
    let digits = to_string(1000 + ms % 1000);
    return to_string(ms / 1000) + "." + str_slice(digits, 1, 4);
}
fn arguments(transport: Curl, request: Request, files: Files) -> List<String> effects { state } {
    let args = list_new<String>();
    list_push(args, transport.executable.value);
    list_push(args, "--disable");
    list_push(args, "--silent");
    list_push(args, "--show-error");
    list_push(args, "--globoff");
    list_push(args, "--path-as-is");
    list_push(args, "--no-ssl-auto-client-cert");
    list_push(args, "--noproxy");
    list_push(args, "*");
    list_push(args, "--proto");
    list_push(args, "=http,https");
    list_push(args, "--max-time");
    list_push(args, timeout_text(request.timeout_ms));
    let head = match request.method {
        Method::Head => true,
        Method::Get => false,
        Method::Post => false,
        Method::Put => false,
        Method::Delete => false
    };
    if head {
        list_push(args, "--head");
    } else {
        list_push(args, "--max-filesize");
        list_push(args, to_string(request.body_limit));
        list_push(args, "--request");
        list_push(args, match request.method {
            Method::Get => "GET",
            Method::Head => "HEAD",
            Method::Post => "POST",
            Method::Put => "PUT",
            Method::Delete => "DELETE"
        });
    }
    var start = 0;
    var content_type = false;
    for i in 0 .. str_len(request.headers) {
        if str_byte(request.headers, i) == 10 {
            var header = str_slice(request.headers, start, i);
            if str_len(header) >= 13 && str_slice(header, 0, 13) == "content-type:" {
                content_type = true;
            }
            if str_len(header) >= 2 && str_slice(header, str_len(header) - 2, str_len(header))
                == ": " {
                header = str_slice(header, 0, str_len(header) - 2) + ";";
            }
            list_push(args, "--header");
            list_push(args, header);
            start = i + 1;
        }
    }
    let upload = match request.method {
        Method::Get => false,
        Method::Head => false,
        Method::Post => true,
        Method::Put => true,
        Method::Delete => true
    };
    if upload {
        list_push(args, "--header");
        list_push(args, "Expect:");
        if !content_type {
            list_push(args, "--header");
            list_push(args, "Content-Type: application/octet-stream");
        }
        list_push(args, "--data-binary");
        list_push(args, "@" + files.upload);
    }
    list_push(args, "--dump-header");
    list_push(args, files.headers);
    list_push(args, "--output");
    list_push(args, files.body);
    list_push(args, "--write-out");
    list_push(args, "%{http_code}");
    match transport.ca_file {
        Option::None => {}
        Option::Some(file) => {
            list_push(args, "--cacert");
            list_push(args, file.value);
        }
    }
    list_push(args, "--url");
    list_push(args, request.url);
    return args;
}
impl Transport for Curl {
    fn start(self: Curl, scheduler: loop::Loop<process::Completed>, request: Request,
        directory: path::Path) -> Result<Exchange, Error> effects { io, state } {
        if !absolute(directory) {
            return Result<Exchange, Error>::Err(Error::InvalidTransport);
        }
        match temp_dir(directory.value) {
            StringResult::Err(message) => {
                return Result<Exchange, Error>::Err(Error::Storage(message));
            }
            StringResult::Ok(base) => {
                let files = Files(directory: base, status: base + "/status", errors: base
                    + "/errors", headers: base + "/headers", body: base + "/body", upload: base
                    + "/upload");
                let upload = match request.method {
                    Method::Get => false,
                    Method::Head => false,
                    Method::Post => true,
                    Method::Put => true,
                    Method::Delete => true
                };
                if upload {
                    match write_file(files.upload, request.upload) {
                        WriteResult::Ok => {}
                        WriteResult::Err(message) => {
                            let removed = remove_owned(files.upload)?;
                            match remove_dir(base) {
                                WriteResult::Ok => {}, WriteResult::Err(error) => {
                                    return Result<Exchange, Error>::Err(Error::Storage(error));
                                }
                            }
                            return Result<Exchange, Error>::Err(Error::Storage(message));
                        }
                    }
                }
                var supervisor_ms = request.timeout_ms;
                if self.transfer_deadline {
                    // curl's --max-time is still the exact request timeout. Only
                    // helper startup/drain gets overhead; the 1.0 factory is unchanged.
                    supervisor_ms = supervisor_ms + 1000;
                }
                match process::schedule(scheduler, arguments(self, request, files), path::Path(
                    value: base), path::Path(value: files.status), path::Path(value: files.errors),
                    supervisor_ms) {
                    Result::Ok(task) => {
                        let head = match request.method {
                            Method::Head => true,
                            Method::Get => false,
                            Method::Post => false,
                            Method::Put => false,
                            Method::Delete => false
                        };
                        let work = Work(task: task, files: files, body_limit: request.body_limit,
                            head: head);
                        return Result<Exchange, Error>::Ok(exchange(Source::Process(work)));
                    }
                    Result::Err(error) => {
                        let removed = remove_owned(files.upload)?;
                        match remove_dir(base) {
                            WriteResult::Err(message) => {
                                return Result<Exchange, Error>::Err(Error::Storage(message));
                            }
                            WriteResult::Ok => {
                                return Result<Exchange, Error>::Err(Error::Schedule(error));
                            }
                        }
                    }
                }
            }
        }
    }
}
pub fn cancel(request: Exchange) -> Bool effects { state } {
    if list_get(request.closed, 0) {
        return false;
    }
    return match request.source {
        Source::Process(work) => loop::cancel(work.task),
        Source::Scripted(_) => false,
        Source::Multi(work) => multi_cancel(work.item)
    };
}
pub fn pending(request: Exchange) -> Bool effects { state } {
    return match request.source {
        Source::Scripted(_) => false,
        Source::Multi(work) => multi_pending(work.item),
        Source::Process(work) => match loop::outcome(work.task) {
            Option::None => true,
            Option::Some(_) => false
        }
    };
}
fn exit_error(code: Int) -> Error {
    if code == 5 || code == 6 || code == 7 {
        return Error::Connect(code);
    }
    if code == 28 {
        return Error::TimedOut;
    }
    if code == 63 {
        return Error::Limit;
    }
    if code == 35 || code == 51 || code == 58 || code == 59 || code == 60 || code == 77 || code
        == 83 || code == 90 || code == 91 {
        return Error::Tls(code);
    }
    return Error::Transfer(code);
}
fn read(path_value: String, limit: Int) -> Result<String, Error> effects { io } {
    return match read_file_bounded(path_value, limit) {
        ReadResult::Ok(bytes) => Result<String, Error>::Ok(bytes),
        ReadResult::Limit => Result<String, Error>::Err(Error::Limit),
        ReadResult::Err(message) => Result<String, Error>::Err(Error::Storage(message))
    };
}
fn response(work: Work, code: Int) -> Result<Response, Error> effects { io } {
    if code != 0 {
        return Result<Response, Error>::Err(exit_error(code));
    }
    let status = read(work.files.status, 3)?;
    if str_len(status) != 3 {
        return Result<Response, Error>::Err(Error::Protocol);
    }
    match parse_int(status) {
        IntResult::Err(_) => {
            return Result<Response, Error>::Err(Error::Protocol);
        }
        IntResult::Ok(number) => {
            if number < 100 || number > 599 {
                return Result<Response, Error>::Err(Error::Protocol);
            }
            let headers = read(work.files.headers, 32768)?;
            var body = "";
            if !work.head {
                body = read(work.files.body, work.body_limit)?;
            }
            return Result<Response, Error>::Ok(Response(status: number, headers: text::Bytes(
                data: headers), body: text::Bytes(data: body)));
        }
    }
}
fn ready(value: Result<Response, Error>) -> Result<Option<Response>, Error> {
    return match value {
        Result::Ok(found) => Result<Option<Response>, Error>::Ok(Option<Response>::Some(found)),
        Result::Err(error) => Result<Option<Response>, Error>::Err(error)
    };
}
pub fn poll(request: Exchange) -> Result<Option<Response>, Error> effects { state, io } {
    if list_get(request.closed, 0) {
        return Result<Option<Response>, Error>::Err(Error::Closed);
    }
    match request.source {
        Source::Scripted(value) => {
            return ready(value);
        }
        Source::Multi(work) => { return multi_poll(work); }
        Source::Process(work) => {
            match loop::outcome(work.task) {
                Option::None => {
                    return Result<Option<Response>, Error>::Ok(Option<Response>::None);
                }
                Option::Some(value) => {
                    return match value {
                        loop::Outcome::Done(done) => ready(response(work, done.code)),
                        loop::Outcome::Cancelled => Result<Option<Response>, Error>::Err(
                            Error::Cancelled),
                        loop::Outcome::TimedOut => Result<Option<Response>, Error>::Err(
                            Error::TimedOut),
                        loop::Outcome::Failed(message) => Result<Option<Response>, Error>::Err(
                            Error::Storage(message))
                    };
                }
            }
        }
    }
}
fn remove_owned(file: String) -> Result<Bool, Error> effects { io } {
    match file_identity(file) {
        StringResult::Err(message) => {
            return Result<Bool, Error>::Err(Error::Storage(message));
        }
        StringResult::Ok(identity) => {
            if identity == "" {
                return Result<Bool, Error>::Ok(true);
            }
        }
    }
    return match remove_file(file) {
        WriteResult::Ok => Result<Bool, Error>::Ok(true),
        WriteResult::Err(message) => Result<Bool, Error>::Err(Error::Storage(message))
    };
}
pub fn release(request: Exchange) -> Result<Bool, Error> effects { state, io } {
    if list_get(request.closed, 0) {
        return Result<Bool, Error>::Ok(true);
    }
    match request.source {
        Source::Scripted(_) => {}
        Source::Multi(work) => { let released = multi_release(work)?; }
        Source::Process(work) => {
            match loop::outcome(work.task) {
                Option::None => {
                    return Result<Bool, Error>::Err(Error::Pending);
                }
                Option::Some(_) => {}
            }
            let status = remove_owned(work.files.status)?;
            let errors = remove_owned(work.files.errors)?;
            let headers = remove_owned(work.files.headers)?;
            let body = remove_owned(work.files.body)?;
            let upload = remove_owned(work.files.upload)?;
            match remove_dir(work.files.directory) {
                WriteResult::Err(message) => {
                    return Result<Bool, Error>::Err(Error::Storage(message));
                }
                WriteResult::Ok => {}
            }
        }
    }
    list_set(request.closed, 0, true);
    return Result<Bool, Error>::Ok(true);
}

pub fn multi_limits() -> MultiLimits {
    return MultiLimits(connections: 8, per_origin: 4, queue: 32, idle_seconds: 30, connect_ms: 5000);
}
pub fn curl_multi(limits: MultiLimits, ca_file: Option<path::Path>) -> Result<CurlMulti, MultiOpenError> effects { state, io } {
    if platform() != "windows" {
        return Result<CurlMulti, MultiOpenError>::Err(MultiOpenError::Unsupported);
    }
    if limits.connections < 1 || limits.connections > 16 || limits.per_origin < 1
        || limits.per_origin > limits.connections || limits.queue < 0 || limits.queue > 112
        || limits.idle_seconds < 1 || limits.idle_seconds > 3600 || limits.connect_ms < 1 || limits.connect_ms > 120000 {
        return Result<CurlMulti, MultiOpenError>::Err(MultiOpenError::Limits);
    }
    var ca = "";
    match ca_file {
        Option::None => {}
        Option::Some(file) => {
            if !absolute(file) {
                return Result<CurlMulti, MultiOpenError>::Err(MultiOpenError::Trust(Error::InvalidTransport));
            }
            match read(file.value, 1048576) {
                Result::Err(error) => { return Result<CurlMulti, MultiOpenError>::Err(MultiOpenError::Trust(error)); }
                Result::Ok(bytes) => {
                    if bytes == "" {
                        return Result<CurlMulti, MultiOpenError>::Err(MultiOpenError::Trust(Error::InvalidTransport));
                    }
                    ca = bytes;
                }
            }
        }
    }
    match http_native_open(limits.connections, limits.per_origin, limits.idle_seconds, ca) {
        SpawnResult::Err(reason) => {
            return Result<CurlMulti, MultiOpenError>::Err(MultiOpenError::Dependency(reason));
        }
        SpawnResult::Ok(owner) => {
            return Result<CurlMulti, MultiOpenError>::Ok(CurlMulti(owner: owner, limits: limits,
                items: list_new<MultiItem>(), closing: cell::create(false), closed: cell::create(false)));
        }
    }
}
fn multi_pending(item: MultiItem) -> Bool effects { state } {
    return match cell::get(item.phase) {
        MultiPhase::Queued => true,
        MultiPhase::Active(_) => true,
        MultiPhase::Done(_) => false,
        MultiPhase::Released => false
    };
}
fn multi_cancel(item: MultiItem) -> Bool effects { state } {
    if !multi_pending(item) || cell::get(item.cancelled) { return false; }
    cell::set(item.cancelled, true);
    return true;
}
pub fn multi_stats(pool: CurlMulti) -> MultiStats effects { state } {
    var out = MultiStats(active: 0, queued: 0, slots: 0, reserved_body: 0);
    for item in pool.items {
        match cell::get(item.phase) {
            MultiPhase::Queued => { out.queued = out.queued + 1; }
            MultiPhase::Active(_) => { out.active = out.active + 1; }
            MultiPhase::Done(_) => {}
            MultiPhase::Released => { continue; }
        }
        out.slots = out.slots + 1;
        out.reserved_body = out.reserved_body + item.request.body_limit;
    }
    return out;
}
fn multi_available(pool: CurlMulti, origin: String) -> Bool effects { state } {
    var active = 0;
    var host = 0;
    for item in pool.items {
        match cell::get(item.phase) {
            MultiPhase::Active(_) => {
                active = active + 1;
                if item.origin == origin { host = host + 1; }
            }
            MultiPhase::Queued => {}
            MultiPhase::Done(_) => {}
            MultiPhase::Released => {}
        }
    }
    return active < pool.limits.connections && host < pool.limits.per_origin;
}
fn multi_origin(url_value: String) -> String effects { state } {
    var end = 7;
    if str_slice(url_value, 0, 5) == "https" { end = 8; }
    while str_byte(url_value, end) != 47 { end = end + 1; }
    let parts = strings_new();
    for i in 0 .. end {
        var byte = str_byte(url_value, i);
        if byte >= 65 && byte <= 90 { byte = byte + 32; }
        strings_push(parts, str_from_byte(byte));
    }
    return strings_join(parts, "");
}
fn multi_clock() -> Result<Int, Error> effects { io } {
    return match monotonic_millis() {
        IntResult::Ok(now) => Result<Int, Error>::Ok(now),
        IntResult::Err(message) => Result<Int, Error>::Err(Error::Storage(message))
    };
}
fn multi_finish(item: MultiItem, result_value: Result<Response, Error>) -> Unit effects { state } {
    cell::set(item.phase, MultiPhase::Done(result_value));
}
fn multi_failure(item: MultiItem, error: Error) -> Unit effects { state } {
    multi_finish(item, Result<Response, Error>::Err(error));
}
fn multi_admit(pool: CurlMulti, item: MultiItem) -> Unit effects { state, io } {
    let method = match item.request.method {
        Method::Get => 0, Method::Head => 1, Method::Post => 2, Method::Put => 3, Method::Delete => 4
    };
    match http_native_start(pool.owner, item.request.url, item.request.headers, item.request.upload,
        method, item.request.body_limit, item.deadline, pool.limits.connect_ms) {
        SpawnResult::Ok(request) => { cell::set(item.phase, MultiPhase::Active(request)); }
        SpawnResult::Err(reason) => {
            if reason == "timeout" { multi_failure(item, Error::TimedOut); }
            else if reason == "limit" { multi_failure(item, Error::Limit); }
            else { multi_failure(item, Error::Storage(reason)); }
        }
    }
}
fn native_bytes(request: ForeignHandle, part: Int) -> Result<String, Error> effects { state, io } {
    return match http_native_read(request, part) {
        StringResult::Ok(data) => Result<String, Error>::Ok(data),
        StringResult::Err(message) => Result<String, Error>::Err(Error::Storage(message))
    };
}
fn multi_result(request: ForeignHandle, outcome: Int) -> Result<Response, Error> effects { state, io } {
    if outcome == 1 {
        let status = http_native_call(request, 5);
        if status < 100 || status > 599 { return Result<Response, Error>::Err(Error::Protocol); }
        return Result<Response, Error>::Ok(Response(status: status, headers: text::Bytes(data: native_bytes(request, 0)?),
            body: text::Bytes(data: native_bytes(request, 1)?)));
    }
    if outcome == 2 { return Result<Response, Error>::Err(Error::Cancelled); }
    if outcome == 3 { return Result<Response, Error>::Err(Error::TimedOut); }
    if outcome == 4 { return Result<Response, Error>::Err(Error::Connect(28)); }
    if outcome == 5 { return Result<Response, Error>::Err(Error::Limit); }
    if outcome == 6 { return Result<Response, Error>::Err(exit_error(http_native_call(request, 6))); }
    let reason = native_bytes(request, 2)?;
    return Result<Response, Error>::Err(Error::Storage(reason));
}
pub fn multi_tick(pool: CurlMulti) -> Result<Bool, Error> effects { state, io } {
    if cell::get(pool.closed) { return Result<Bool, Error>::Ok(false); }
    let now = multi_clock()?;
    for item in pool.items {
        let cancelled = cell::get(item.cancelled);
        match cell::get(item.phase) {
            MultiPhase::Queued => {
                if cancelled { multi_failure(item, Error::Cancelled); }
                else if now >= item.deadline { multi_failure(item, Error::TimedOut); }
            }
            MultiPhase::Active(request) => {
                if cancelled { let accepted = http_native_call(request, 2); }
            }
            MultiPhase::Done(_) => {}
            MultiPhase::Released => {}
        }
    }
    let driven = http_native_call(pool.owner, 0);
    for item in pool.items {
        match cell::get(item.phase) {
            MultiPhase::Active(request) => {
                let outcome = http_native_call(request, 4);
                if outcome != 0 {
                    let result_value = multi_result(request, outcome);
                    if http_native_call(request, 3) != 1 {
                        return Result<Bool, Error>::Err(Error::Storage("cannot release native HTTP request"));
                    }
                    multi_finish(item, result_value);
                }
            }
            MultiPhase::Queued => {}
            MultiPhase::Done(_) => {}
            MultiPhase::Released => {}
        }
    }
    if driven != 1 {
        return Result<Bool, Error>::Err(Error::Storage("native HTTP driver failed"));
    }
    for item in pool.items {
        match cell::get(item.phase) {
            MultiPhase::Queued => {
                if multi_available(pool, item.origin) { multi_admit(pool, item); }
            }
            MultiPhase::Active(_) => {}
            MultiPhase::Done(_) => {}
            MultiPhase::Released => {}
        }
    }
    return Result<Bool, Error>::Ok(true);
}
pub fn multi_wait(pool: CurlMulti, milliseconds: Int) -> Result<Bool, Error> effects { state, io, process } {
    if milliseconds < 1 || milliseconds > 10 { return Result<Bool, Error>::Err(Error::InvalidLimit); }
    if cell::get(pool.closed) { return Result<Bool, Error>::Err(Error::Closed); }
    if http_native_wait(pool.owner, milliseconds) != 1 {
        return Result<Bool, Error>::Err(Error::Storage("native HTTP wait failed"));
    }
    return Result<Bool, Error>::Ok(true);
}
fn multi_poll(work: MultiExchange) -> Result<Option<Response>, Error> effects { state, io } {
    let progress = multi_tick(work.pool);
    match cell::get(work.item.phase) {
        MultiPhase::Done(value) => { return ready(value); }
        MultiPhase::Released => { return Result<Option<Response>, Error>::Err(Error::Closed); }
        MultiPhase::Queued => {}
        MultiPhase::Active(_) => {}
    }
    let driven = progress?;
    return Result<Option<Response>, Error>::Ok(Option<Response>::None);
}
fn multi_compact(pool: CurlMulti) -> Unit effects { state } {
    var next = 0;
    for i in 0 .. list_len(pool.items) {
        let item = list_get(pool.items, i);
        match cell::get(item.phase) {
            MultiPhase::Released => { continue; }
            MultiPhase::Queued => {}
            MultiPhase::Active(_) => {}
            MultiPhase::Done(_) => {}
        }
        if next != i { list_set(pool.items, next, item); }
        next = next + 1;
    }
    list_truncate(pool.items, next);
}
fn multi_release(work: MultiExchange) -> Result<Bool, Error> effects { state, io } {
    if multi_pending(work.item) && cell::get(work.item.cancelled) {
        let driven = multi_tick(work.pool)?;
    }
    if multi_pending(work.item) { return Result<Bool, Error>::Err(Error::Pending); }
    cell::set(work.item.phase, MultiPhase::Released);
    multi_compact(work.pool);
    return Result<Bool, Error>::Ok(true);
}
pub fn close_multi(pool: CurlMulti) -> Result<Bool, Error> effects { state, io } {
    if cell::get(pool.closed) { return Result<Bool, Error>::Ok(true); }
    cell::set(pool.closing, true);
    for item in pool.items { let cancelled = multi_cancel(item); }
    let progress = multi_tick(pool);
    let current = multi_stats(pool);
    if current.active > 0 || current.queued > 0 {
        let driven = progress?;
        return Result<Bool, Error>::Err(Error::Pending);
    }
    if http_native_call(pool.owner, 1) != 1 {
        return Result<Bool, Error>::Err(Error::Storage("cannot close native HTTP pool"));
    }
    for item in pool.items { cell::set(item.phase, MultiPhase::Released); }
    list_truncate(pool.items, 0);
    cell::set(pool.closed, true);
    return Result<Bool, Error>::Ok(true);
}
impl Transport for CurlMulti {
    fn start(self: CurlMulti, scheduler: loop::Loop<process::Completed>, request: Request,
        directory: path::Path) -> Result<Exchange, Error> effects { state, io } {
        if cell::get(self.closing) { return Result<Exchange, Error>::Err(Error::Closed); }
        var timeout = request.timeout_ms;
        match request.remaining {
            Option::Some(limit) => { if limit < timeout { timeout = limit; } }
            Option::None => {}
        }
        if timeout < 1 { return Result<Exchange, Error>::Err(Error::TimedOut); }
        let now = multi_clock()?;
        if now > 9223372036854775807 - timeout {
            return Result<Exchange, Error>::Err(Error::InvalidLimit);
        }
        let origin = multi_origin(request.url);
        let driven = multi_tick(self)?;
        let stats = multi_stats(self);
        let available = multi_available(self, origin);
        if stats.slots >= 128 || request.body_limit > 67108864 - stats.reserved_body
            || (!available && stats.queued >= self.limits.queue) {
            return Result<Exchange, Error>::Err(Error::Limit);
        }
        let item = MultiItem(request: request, origin: origin, deadline: now + timeout,
            phase: cell::create(MultiPhase::Queued), cancelled: cell::create(false));
        list_push(self.items, item);
        if available { multi_admit(self, item); }
        return Result<Exchange, Error>::Ok(exchange(Source::Multi(MultiExchange(pool: self, item: item))));
    }
}
