pub fn builtin_source() -> String { return "# Vela builtin catalog v1. UTF-8, pipe-delimited; no quoting. Empty columns are significant.\n# kind|name|type variables|parameter types separated by ;|return type|effects separated by ;|ABI|since\nenum|IntResult||Ok:Int;Err:String||||0.2\nenum|StringResult||Ok:String;Err:String||||0.2\nenum|WriteResult||Ok:;Err:String||||0.2\nenum|FloatResult||Ok:Float64;Err:String||||0.7\nenum|Int32Result||Ok:Int32;Err:String||||0.7\nenum|ReadResult||Ok:String;Limit:;Err:String||||0.7\nenum|StreamResult||Ok:ForeignHandle;Limit:;Err:String||||0.10\nenum|CallbackResult||Ok:CallbackHandle;Err:String||||0.10\nenum|ProcessResult||Exited:Int;TimedOut:;Err:String||||0.7\nenum|Option|T|Some:T;None:||||0.5\nenum|Result|T;E|Ok:T;Err:E||||0.5\nfn|arg_count|||Int|args|plain|0.2\nfn|arg_int||Int|IntResult|args|int_result|0.2\nfn|parse_int||String|IntResult||int_result|0.2\nfn|str_len||String|Int||located|0.2\nfn|str_byte||String;Int|Int||located|0.2\nfn|str_slice||String;Int;Int|String||located|0.2\nfn|str_concat||String;String|String||located|0.2\nfn|str_from_byte||Int|String||located|0.2\nfn|int_to_string||Int|String||located|0.2\nfn|ints_new|||IntList|state|located|0.2\nfn|ints_len||IntList|Int|state|located|0.2\nfn|ints_get||IntList;Int|Int|state|located|0.2\nfn|ints_set||IntList;Int;Int|Unit|state|located|0.2\nfn|ints_push||IntList;Int|Unit|state|located|0.2\nfn|ints_truncate||IntList;Int|Unit|state|located|0.2\nfn|strings_new|||StringList|state|located|0.2\nfn|strings_len||StringList|Int|state|located|0.2\nfn|strings_get||StringList;Int|String|state|located|0.2\nfn|strings_set||StringList;Int;String|Unit|state|located|0.2\nfn|strings_push||StringList;String|Unit|state|located|0.2\nfn|strings_truncate||StringList;Int|Unit|state|located|0.2\nfn|strings_join||StringList;String|String|state|located|0.2\nfn|arg||Int|StringResult|args|string_result|0.2\nfn|read_file||String|StringResult|io|string_result|0.2\nfn|absolute_path||String|StringResult|io|string_result|0.2\nfn|temp_dir||String|StringResult|io|string_result|0.2\nfn|write_file||String;String|WriteResult|io|write_result|0.2\nfn|remove_file||String|WriteResult|io|write_result|0.2\nfn|replace_file||String;String|WriteResult|io|write_result|0.2\nfn|remove_dir||String|WriteResult|io|write_result|0.2\nfn|eprint||String|Unit|io|located|0.2\nfn|exit||Int|Unit|process|located|0.2\nfn|env||String|String|process|located|0.2\nfn|process_run||StringList|Int|process;state|located|0.2\nfn|process_run_to_stderr||StringList|Int|process;state|located|0.2\nfn|platform|||String||located|0.2\nfn|print|T|T|Unit|io|print|0.3\nfn|to_string|T|T|String||format|0.3\nfn|list_new|T||List<T>|state|list_new|0.3\nfn|list_len|T|List<T>|Int|state|list_len|0.3\nfn|list_get|T|List<T>;Int|T|state|list_get|0.3\nfn|list_set|T|List<T>;Int;T|Unit|state|list_set|0.3\nfn|list_push|T|List<T>;T|Unit|state|list_push|0.3\nfn|list_truncate|T|List<T>;Int|Unit|state|list_truncate|0.3\nfn|dict_new|K;V||Dict<K,V>|state|dict_new|0.3\nfn|dict_len|K;V|Dict<K,V>|Int|state|dict_len|0.3\nfn|dict_has|K;V|Dict<K,V>;K|Bool|state|dict_has|0.3\nfn|dict_get|K;V|Dict<K,V>;K|V|state|dict_get|0.3\nfn|dict_get_or|K;V|Dict<K,V>;K;V|V|state|dict_get_or|0.3\nfn|dict_set|K;V|Dict<K,V>;K;V|Unit|state|dict_set|0.3\nfn|dict_remove|K;V|Dict<K,V>;K|Bool|state|dict_remove|0.3\nfn|process_run_files||StringList;String;String;Int|Int|process;state;io|located|0.3\nfn|make_dir||String|WriteResult|io|write_result|0.3\nfn|set_env||String;String|Unit|process|located|0.3\nfn|set_current_dir||String|WriteResult|io;process|write_result|0.3\nfn|file_identity||String|StringResult|io|string_result|0.4\nfn|write_stdout||String|Unit|io|located|0.4\nfn|sha256||String|String||located|0.6\nfn|parse_float||String|FloatResult||float_result|0.7\nfn|float_text_valid||String|Bool||located|0.7\nfn|float_from_int||Int|Float64||plain|0.7\nfn|float_to_int||Float64|IntResult||int_result|0.7\nfn|float_to_string||Float64|String||located|0.7\nfn|float_to_fixed|