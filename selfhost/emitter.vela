import "model.vela";
import "core.vela";
import "parser.vela";
import "types.vela";
import "intrinsics.vela";
import "driver.vela";
import "embedded.vela";
// Backend APIs accept checked IDs/records, never syntax IDs.
pub fn emit(c: Context, line: String) -> Unit effects { state } {
    strings_push(c.output, line + "\n");
}
pub fn ctype(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == int32_type() { return "int32_t"; }
    if t == foreign_handle_type() { return "v_foreign_handle*"; }
    if t == callback_handle_type() { return "v_callback_entry*"; }
    if t == float_type() {
        return "double";
    }
    if t == int_type() {
        return "int64_t";
    }
    if t == bool_type() {
        return "int";
    }
    if t == string_type() {
        return "v_string";
    }
    if t == unit_type() {
        return "uint8_t";
    }
    if t == ints_type() {
        return "v_int_list*";
    }
    if t == strings_type() {
        return "v_string_list*";
    }
    let info = type_info(c, t);
    if info.kind == 80 { return "v_callable"; }
    if info.kind == 82 { return "v_dynamic"; }
    if info.kind == 75 {
        if list_len(info.arguments) == 1 {
            return "v_list*";
        }
        return "v_dict*";
    }
    if info.template_index >= 0 {
        return "v_g_type_" + num(type_number(t));
    }
    if str_len(info.name) > 0 && str_byte(info.name, 0) == 64 {
        return "v_m_type_" + num(type_number(t));
    }
    return "v_e_" + info.name;
}
pub fn cquote(value: String) -> String effects { state } {
    let parts = strings_new();
    strings_push(parts, "\"");
    var i = 0;
    while i < str_len(value) {
        if i > 0 && i % 512 == 0 {
            strings_push(parts, "\" \"");
        }
        let b = str_byte(value, i);
        strings_push(parts, "\\" + num(b / 64) + num(b / 8 % 8) + num(b % 8));
        i = i + 1;
    }
    strings_push(parts, "\"");
    return strings_join(parts, "");
}
pub fn location(c: Context, span: Span) -> String effects { state } {
    return cquote(filename_at(c, span.start)) + ", " + num(line_at(c, span.start)) + ", " + num(column_at(c, span.start));
}
pub fn emit_debug_line(c: Context, span: Span) -> Unit effects { state } {
    if !c.debug_codegen { return; }
    let path = filename_at(c, span.start);
    let parts = strings_new();
    strings_push(parts, "\"");
    for i in 0 .. str_len(path) {
        let byte = str_byte(path, i);
        if byte < 32 || byte == 127 {
            strings_push(parts, "\\" + num(byte / 64) + num(byte / 8 % 8) + num(byte % 8));
        } else {
            if byte == 34 || byte == 92 { strings_push(parts, "\\"); }
            strings_push(parts, str_from_byte(byte));
        }
    }
    strings_push(parts, "\"");
    emit(c, "#line " + num(line_at(c, span.start)) + " " + strings_join(parts, ""));
}
pub fn emit_debug_leave(c: Context) -> Unit effects { state } {
    if c.debug_codegen { emit(c, "v_debug_leave(&v_frame);"); }
}
pub fn local_name(binding: SymbolId) -> String {
    return "v_l_" + num(symbol_number(binding));
}
pub fn gc_visitor(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == string_type() { return "v_gc_string"; }
    if t == ints_type() { return "v_gc_ints_value"; }
    if t == strings_type() { return "v_gc_strings_value"; }
    if t == foreign_handle_type() { return "v_gc_handle_value"; }
    let info = type_info(c, t);
    if info.kind == 80 { return "v_gc_callable"; }
    if info.kind == 82 { return "v_gc_dynamic"; }
    if info.kind == 75 {
        if list_len(info.arguments) == 1 { return "v_gc_list_value"; }
        return "v_gc_dict_value";
    }
    if info.kind != 0 { return "v_trace_" + num(type_number(t)); }
    return "NULL";
}
pub fn gc_root(c: Context, name: String, visit: String) -> Unit effects { state } {
    if visit != "NULL" {
        emit(c, "v_gc_root v_root_" + name + "; v_gc_push(&v_root_" + name + ", &" + name + ", " + visit + ");");
    }
}
pub fn next_temporary(c: Context) -> String effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.temporary = ctl.temporary + 1;
    list_set(c.control, 0, ctl);
    return "v_t_" + num(ctl.temporary);
}
pub fn gc_scope(c: Context) -> String effects { state } {
    let mark = next_temporary(c);
    emit(c, "v_gc_root *const " + mark + " = v_gc_roots;");
    return mark;
}
pub fn gc_restore(c: Context, mark: String) -> Unit effects { state } {
    emit(c, "v_gc_roots = " + mark + ";");
}
pub fn temp(c: Context, t: TypeId, value: String) -> String effects { state, io, process } {
    emit(c, "v_gc_poll();");
    let name = raw_temp(c, ctype(c, t), value);
    gc_root(c, name, gc_visitor(c, t));
    return name;
}
pub fn raw_temp(c: Context, type_name: String, value: String) -> String effects { state } {
    let name = next_temporary(c);
    emit(c, type_name + " " + name + " = " + value +";");
    return name;
}
pub fn signature(c: Context, f: CheckedFunction) -> String effects { state, io, process } {
    let sig = symbol_info(c, f.symbol);
    let parts = strings_new();
    strings_push(parts, "void *v_environment");
    var i = 0;
    while i < list_len(f.parameters) {
        let id = list_get(f.parameters, i);
        strings_push(parts, ctype(c, symbol_info(c, id).type_id) + " " + local_name(id));
        i = i + 1;
    }
    return "static " + ctype(c, sig.type_id) + " " + function_name(c, f.symbol) + "(" + strings_join(parts, ", ") + ")";
}
pub fn zero_value(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == string_type() {
        return "v_text(\"\", 0)";
    }
    let kind = type_kind(c, t);
    if kind == 0 || kind == 75 {
        return "0";
    }
    return "("+ ctype(c, t) + "){0}";
}
pub fn emit_arguments(c: Context, args: List<ExprId>) -> StringList effects { state, io, process } {
    let parts = strings_new();
    for i in 0 .. list_len(args) {
        strings_push(parts, emit_expr(c, list_get(args, i)));
    }
    return parts;
}
pub fn emit_expr(c: Context, id: ExprId) -> String effects { state, io, process } {
    let n = checked_expr(c, id);
    let k = n.kind;
    let t = n.type_id;
    let value = n.text;
    if k == 123 || k == 124 {
        let operand = emit_expr(c, n.left);
        if k == 124 {
            emit(c, "v_fiber_suspend(" + operand + ", " + location(c, n.span) + ");");
        }
        emit(c, "if (v_fiber_cancelled()) {");
        emit_cleanups(c, 0);
        let function = list_get(c.functions, list_get(c.control, 0).function_index);
        let return_type = symbol_info(c, function.symbol).type_id;
        gc_restore(c, "v_gc_frame");
        emit_debug_leave(c);
        emit(c, "return " + zero_value(c, return_type) + "; }");
        if k == 124 { return temp(c, t, "0"); }
        return operand;
    }
    if k == 117 {
        return temp(c, t, value);
    }
    if k == 101 {
        if value == "-9223372036854775808" {
            return temp(c, t, "INT64_MIN");
        }
        if str_byte(value, 0) == 45 {
            return temp(c, t, "(-INT64_C(" + str_slice(value, 1, str_len(value)) + "))");
        }
        return temp(c, t, "INT64_C(" + value +")");
    }
    if k == 102 {
        if value == "true" {
            return temp(c, t, "1");
        }
        return temp(c, t, "0");
    }
    if k == 103 {
        return temp(c, t, "v_text(" + cquote(value) + ", " + num(str_len(value)) +")");
    }
    if k == 109 {
        return temp(c, t, "0");
    }
    if k == 104 {
        return temp(c, t, local_name(n.symbol));
    }
    if k == 118 || k == 119 || k == 120 { return emit_callable(c, n); }
    if k == 121 || k == 122 { return emit_dynamic(c, n); }
    if k == 110 {
        return temp(c, t, emit_expr(c, n.left) + ".v_m_" + symbol_info(c, n.symbol).name);
    }
    if k == 115 {
        return emit_interpolation(c, n);
    }
    if k == 116 {
        return emit_formatted_value(c, n);
    }
    if k == 113 {
        return emit_match_expression(c, n);
    }
    if k == 114 {
        return emit_propagation(c, n);
    }
    if k == 112 {
        let args = emit_arguments(c, n.arguments);
        let r = temp(c, t, "{0}");
        var i = 0;
        while i < list_len(n.arguments) {
            emit(c, r + ".v_m_" + symbol_info(c, list_get(n.fields, i)).name + " = " + strings_get(args, i) +";");
            i = i + 1;
        }
        return r;
    }
    if k == 105 {
        let arg = emit_expr(c, n.left);
        if value == "-" {
            if t == float_type() {
                return temp(c, t, "(-" + arg +")");
            }
            return temp(c, t, "v_neg(" + arg + ", " + location(c, n.span) +")");
        }
        return temp(c, t, "(!" + arg +")");
    }
    if k == 106 {
        var left = emit_expr(c, n.left);
        if value == "&&" || value == "||" {
            let r = temp(c, t, left);
            var test = r;
            if value == "||" {
                test = "!"+ r;
            }
            emit(c, "if (" + test + ") {");
            let mark = gc_scope(c);
            let right = emit_expr(c, n.right);
            emit(c, r + " = " + right +";");
            gc_restore(c, mark);
            emit(c, "}");
            return r;
        }
        var right = emit_expr(c, n.right);
        var arithmetic = "";
        let operand_type = checked_expr(c, n.left).type_id;
        if type_kind(c, operand_type) == 70 {
            return temp(c, t, "(" + left + ".tag " + value + " " + right + ".tag)");
        }
        if operand_type == float_type() {
            return temp(c, t,"("+ left + " " + value + " " + right +")");
        }
        if type_kind(c, operand_type) == 77 {
            left = left + ".v_m_value";
            right = right + ".v_m_value";
        }
        if value == "+" && t == string_type() {
            return temp(c, t, "v_str_concat(" + left + ", " + right + ", " + location(c, n.span) +")");
        }
        if value == "+" {
            arithmetic = "add";
        } else if value == "-" {
            arithmetic = "sub";
        } else if value == "*" {
            arithmetic = "mul";
        } else if value == "/" {
            arithmetic = "div";
        } else if value == "%" {
            arithmetic = "rem";
        }
        if arithmetic != "" {
            return temp(c, t, "v_" + arithmetic + "("+ left + ", " + right + ", " + location(c, n.span) +")");
        }
        if scalar_type(c, operand_type) == string_type() {
            var code = "v_string_eq(" + left + ", " + right +")";
            if value == "!=" {
                code = "!"+ code;
            }
            return temp(c, t, code);
        }
        return temp(c, t,"("+ left + " " + value + " " + right +")");
    }
    if k == 107 {
        let args = emit_arguments(c, n.arguments);
        let sig = symbol_info(c, n.symbol);
        if sig.builtin {
            return temp(c, t, emit_builtin(c, n, args));
        }
        if sig.foreign_library != "" { return emit_foreign(c, n, args); }
        let operands = strings_new();
        strings_push(operands, "NULL");
        for i in 0 .. strings_len(args) { strings_push(operands, strings_get(args, i)); }
        return temp(c, t, cc_call(function_name(c, n.symbol), operands));
    }
    if k == 108 {
        let args = emit_arguments(c, n.arguments);
        let tag = symbol_info(c, n.symbol).tag;
        let r = temp(c, t, "{0}");
        emit(c, r + ".tag = " + num(tag) +";");
        var i = 0;
        while i < strings_len(args) {
            emit(c, r + ".data.k" + num(tag) + ".f" + num(i) + " = " + strings_get(args, i) +";");
            i = i + 1;
        }
        return r;
    }
    eprint("velac: internal error: invalid checked expression kind");
    exit(70);
    return "";
}
fn emit_callable(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let k = n.kind;
    let t = n.type_id;
    if k == 118 {
        return temp(c, t, "{(void (*)(void))" + function_name(c, n.symbol) + ", NULL}");
    }
    if k == 120 {
        let args = emit_arguments(c, n.arguments);
        let code = "(void (*)(void))" + function_name(c, n.symbol);
        if strings_len(args) == 0 { return temp(c, t, "{" + code + ", NULL}"); }
        let environment = closure_environment(n.symbol);
        emit(c, "v_gc_poll();");
        let payload = raw_temp(c, environment + "*", "(" + environment + "*)v_allocate(sizeof(" + environment + "), " + location(c, n.span) + ")");
        emit(c, "v_gc_describe(" + payload + ", v_trace_" + environment + ");");
        for i in 0 .. strings_len(args) {
            emit(c, payload + "->v_capture_" + num(i) + " = " + strings_get(args, i) + ";");
        }
        let callable = raw_temp(c, "v_callable", "{" + code + ", " + payload + "}");
        gc_root(c, callable, "v_gc_callable");
        return callable;
    }
    let callee = emit_expr(c, n.left);
    let arguments = emit_arguments(c, n.arguments);
    let types = strings_new();
    strings_push(types, "void *");
    let signature = type_info(c, checked_expr(c, n.left).type_id).arguments;
    for i in 1 .. list_len(signature) { strings_push(types, ctype(c, list_get(signature, i))); }
    let operands = strings_new();
    strings_push(operands, callee + ".environment");
    for i in 0 .. strings_len(arguments) { strings_push(operands, strings_get(arguments, i)); }
    let code = "((" + ctype(c, t) + " (*)(" + strings_join(types, ", ") + "))" + callee + ".code)";
    return temp(c, t, code + "(" + strings_join(operands, ", ") + ")");
}
fn dynamic_table_name(target: TypeId, concrete: TypeId) -> String {
    return "v_dynamic_" + num(type_number(target)) + "_" + num(type_number(concrete));
}
fn emit_dynamic(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    if n.kind == 121 {
        let value = emit_expr(c, n.left);
        let concrete = checked_expr(c, n.left).type_id;
        let value_type = ctype(c, concrete);
        let table = dynamic_table_name(n.type_id, concrete);
        emit(c, "v_gc_poll();");
        let payload = raw_temp(c, value_type + " *", "(" + value_type + " *)v_allocate(sizeof(" + value_type + "), " + location(c, n.span) + ")");
        emit(c, "v_gc_describe(" + payload + ", " + gc_visitor(c, concrete) + ");");
        emit(c, "*" + payload + " = " + value + ";");
        let wrapper = raw_temp(c, "v_dynamic", "{" + payload + ", " + table + "}");
        gc_root(c, wrapper, "v_gc_dynamic");
        return wrapper;
    }
    let values = emit_arguments(c, n.arguments);
    let receiver = strings_get(values, 0);
    let signature = symbol_info(c, n.symbol);
    let types = strings_new();
    strings_push(types, "void *");
    let operands = strings_new();
    strings_push(operands, receiver + ".payload");
    for i in 1 .. list_len(signature.parameters) {
        strings_push(types, ctype(c, symbol_info(c, list_get(signature.parameters, i)).type_id));
        strings_push(operands, strings_get(values, i));
    }
    let code = "((" + ctype(c, n.type_id) + " (*)(" + strings_join(types, ", ") + "))" + receiver + ".operations[" + num(signature.tag) + "])";
    return temp(c, n.type_id, cc_call(code, operands));
}
fn emit_dynamic_tables(c: Context) -> Unit effects { state, io, process } {
    let seen = dict_new<String, Bool>();
    for n in c.expressions {
        if n.kind != 121 { continue; }
        let concrete = checked_expr(c, n.left).type_id;
        let table = dynamic_table_name(n.type_id, concrete);
        if dict_has(seen, table) { continue; }
        dict_set(seen, table, true);
        let entries = strings_new();
        for i in 0 .. list_len(n.fields) {
            let method = list_get(n.fields, i);
            let signature = symbol_info(c, method);
            let thunk = table + "_method_" + num(i);
            let parameters = strings_new();
            let operands = strings_new();
            strings_push(parameters, "void *payload");
            strings_push(operands, "NULL");
            strings_push(operands, "*(const " + ctype(c, concrete) + " *)payload");
            for j in 1 .. list_len(signature.parameters) {
                let type_id = symbol_info(c, list_get(signature.parameters, j)).type_id;
                let parameter = "arg_" + num(j);
                strings_push(parameters, ctype(c, type_id) + " " + parameter);
                strings_push(operands, parameter);
            }
            emit(c, "static " + ctype(c, signature.type_id) + " " + cc_call(thunk, parameters) + " {");
            emit(c, "return " + cc_call(function_name(c, method), operands) + "; }");
            strings_push(entries, "(void (*)(void))" + thunk);
        }
        if strings_len(entries) == 0 { strings_push(entries, "NULL"); }
        emit(c, "static void (*const " + table + "[])(void) = {" + strings_join(entries, ", ") + "};");
    }
}
pub fn emit_contracts(c: Context, items: List<ExprId>, kind: String) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(items) {
        let id = list_get(items, i);
        let n = checked_expr(c, id);
        let value = emit_expr(c, id);
        let message = cquote(kind + " failed: " + str_slice(c.source_text, n.span.start, n.span.end));
        emit(c, "if (!" + value + ") v_panic(" + location(c, n.span) + ", " + message + ");");
    }
}
pub fn emit_block(c: Context, items: List<StmtId>) -> Unit effects { state, io, process } {
    emit(c, "{");
    let mark = gc_scope(c);
    let cleanup_depth = list_len(c.cleanup_blocks);
    for i in 0 .. list_len(items) {
        emit_statement(c, list_get(items, i));
    }
    emit_cleanups(c, cleanup_depth);
    list_truncate(c.cleanup_blocks, cleanup_depth);
    gc_restore(c, mark);
    emit(c, "}");
}
pub fn emit_cleanups(c: Context, depth: Int) -> Unit effects { state, io, process } {
    var i = list_len(c.cleanup_blocks);
    while i > depth {
        i = i - 1;
        emit_block(c, checked_stmt(c, list_get(c.cleanup_blocks, i)).yes);
    }
}
pub fn emit_statement(c: Context, id: StmtId) -> Unit effects { state, io, process } {
    let n = checked_stmt(c, id);
    if n.kind == 142 {
        list_push(c.cleanup_blocks, id);
        return;
    }
    emit_debug_line(c, n.span);
    if n.kind == 130 {
        let t = symbol_info(c, n.binding).type_id;
        let name = local_name(n.binding);
        emit(c, ctype(c, t) + " " + name + " = " + zero_value(c, t) + ";");
        gc_root(c, name, gc_visitor(c, t));
    }
    emit(c, "{");
    let mark = gc_scope(c);
    emit_statement_inner(c, n);
    gc_restore(c, mark);
    emit(c, "}");
}
pub fn emit_statement_inner(c: Context, n: CheckedStmt) -> Unit effects { state, io, process } {
    let k = n.kind;
    if k == 130 || k == 131 {
        let value = emit_expr(c, n.value);
        emit(c, local_name(n.binding) + " = " + value +";");
    } else if k == 138 {
        let value = emit_expr(c, n.value);
        emit(c, emit_lvalue(c, n.target) + " = " + value +";");
    } else if k == 133 {
        let value = emit_expr(c, n.value);
        emit(c, "(void)" + value +";");
    } else if k == 132 {
        emit(c, "{");
        let value = emit_expr(c, n.value);
        emit_return_value(c, value);
        emit(c, "}");
    } else if k == 134 {
        let cond = emit_expr(c, n.value);
        emit(c, "if (" + cond + ") {");
        emit_block(c, n.yes);
        if list_len(n.no) > 0 {
            emit(c, "} else {");
            emit_block(c, n.no);
        }
        emit(c, "}");
    } else if k == 135 {
        let label = enter_emitted_loop(c);
        emit(c, "v_gc_root *const " + label + "_roots = v_gc_roots;");
        emit(c, "for (;;) {");
        let cond = emit_expr(c, n.value);
        emit(c, "if (!" + cond + ") break;");
        emit_block(c, n.yes);
        emit(c, label + "_continue:;");
        gc_restore(c, label + "_roots");
        emit(c, "}");
        leave_emitted_loop(c, label);
    } else if k == 139 || k == 140 {
        let label = list_get(c.loop_labels, list_len(c.loop_labels) - 1);
        emit_cleanups(c, list_get(c.loop_cleanup_depths, list_len(c.loop_cleanup_depths) - 1));
        if k == 139 {
            emit(c, "goto " + label + "_break;");
        } else {
            emit(c, "goto " + label + "_continue;");
        }
    } else if k == 141 {
        emit_for(c, n);
    } else if k == 143 {
        emit_block(c, n.yes);
    } else if k == 136 {
        let value = emit_expr(c, n.value);
        emit(c, "switch (" + value + ".tag) {");
        var i = 0;
        while i < list_len(n.arms) {
            let arm = list_get(n.arms, i);
            let tag = symbol_info(c, arm.variant).tag;
            emit(c, "case " + num(tag) + ": {");
            let mark = gc_scope(c);
            emit_arm_bindings(c, arm, value);
            emit_block(c, arm.body);
            gc_restore(c, mark);
            emit(c, "break; }");
            i = i + 1;
        }
        emit(c, "default: v_panic(" + location(c, n.span) + ", \"invalid enum tag\");");
        emit(c, "}");
    } else {
        eprint("velac: internal error: invalid checked statement kind");
        exit(70);
    }
}
pub fn emit_types(c: Context) -> Unit effects { state, io, process } {
    var i = 0;
    while i < list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        let t = type_info(c, id);
        if t.kind == 76 || t.kind == 77 {
            emit(c, "typedef struct {");
            if list_len(t.fields) == 0 {
                emit(c, "uint8_t empty;");
            }
            var j = 0;
            while j < list_len(t.fields) {
                let field = symbol_info(c, list_get(t.fields, j));
                emit(c, ctype(c, field.type_id) + " v_m_" + field.name +";");
                j = j + 1;
            }
            emit(c, "} " + ctype(c, id) +";");
        } else {
            emit(c, "typedef struct { int tag; union {");
            var j = 0;
            while j < list_len(t.variants) {
                let v = symbol_info(c, list_get(t.variants, j));
                emit(c, "struct {");
                if list_len(v.parameters) == 0 {
                    emit(c, "uint8_t empty;");
                }
                var k = 0;
                while k < list_len(v.parameters) {
                    emit(c, ctype(c, symbol_info(c, list_get(v.parameters, k)).type_id) + " f" + num(k) +";");
                    k = k + 1;
                }
                emit(c, "} k" + num(v.tag) +";");
                j = j + 1;
            }
            emit(c, "} data; } " + ctype(c, id) +";");
        }
        i = i + 1;
    }
}
pub fn emit_gc_field(c: Context, t: TypeId, field: String) -> Unit effects { state, io, process } {
    let visit = gc_visitor(c, t);
    if visit != "NULL" { emit(c, visit + "(&value->" + field + ");"); }
}
pub fn emit_gc_types(c: Context) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        emit(c, "static void " + gc_visitor(c, id) + "(const void *slot);");
    }
    for i in 0 .. list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        let t = type_info(c, id);
        let name = ctype(c, id);
        emit(c, "static void " + gc_visitor(c, id) + "(const void *slot) {");
        emit(c, "const " + name + " *value = (const " + name + "*)slot; (void)value;");
        if t.kind == 76 || t.kind == 77 {
            for j in 0 .. list_len(t.fields) {
                let field = symbol_info(c, list_get(t.fields, j));
                emit_gc_field(c, field.type_id, "v_m_" + field.name);
            }
        } else {
            emit(c, "switch (value->tag) {");
            for j in 0 .. list_len(t.variants) {
                let variant = symbol_info(c, list_get(t.variants, j));
                let tag = num(variant.tag);
                emit(c, "case " + tag + ":");
                for k in 0 .. list_len(variant.parameters) {
                    let field = symbol_info(c, list_get(variant.parameters, k));
                    emit_gc_field(c, field.type_id, "data.k" + tag + ".f" + num(k));
                }
                emit(c, "break;");
            }
            emit(c, "}");
        }
        emit(c, "}");
    }
}
pub fn generate(c: Context) -> String effects { state, io, process } {
    let entry = find_symbol(c, c.signatures, "main");
    if !has_symbol(entry) {
        bad(c, "E207", "build/run requires main; use vela test for test-only modules.", empty_span());
    }
    return generate_entry(c, entry);
}
pub fn closure_environment(symbol: SymbolId) -> String {
    return "v_env_" + num(symbol_number(symbol));
}
pub fn emit_closure_environments(c: Context) -> Unit effects { state, io, process } {
    for f in c.functions {
        if list_len(f.captures) == 0 { continue; }
        let name = closure_environment(f.symbol);
        emit(c, "typedef struct {");
        for i in 0 .. list_len(f.captures) {
            let captured = symbol_info(c, list_get(f.captures, i));
            emit(c, ctype(c, captured.type_id) + " v_capture_" + num(i) + ";");
        }
        emit(c, "} " + name + ";");
        emit(c, "static void v_trace_" + name + "(const void *slot) {");
        emit(c, "const " + name + " *value = (const " + name + "*)slot; (void)value;");
        for i in 0 .. list_len(f.captures) {
            emit_gc_field(c, symbol_info(c, list_get(f.captures, i)).type_id, "v_capture_" + num(i));
        }
        emit(c, "}");
    }
}
pub fn generate_entry(c: Context, entry: SymbolId) -> String effects { state, io, process } {
    strings_truncate(c.output, 0);
    var initial = list_get(c.control, 0);
    initial.temporary = 0;
    list_set(c.control, 0, initial);
    emit(c, "/* Generated by the Vela typed self-hosted compiler. */");
    emit(c, "#ifdef _MSC_VER\n#pragma comment(linker, \"/STACK:33554432\")\n#endif");
    if c.debug_codegen { emit(c, "#define VELA_DEBUG_INSTRUMENTED 1"); }
    emit(c, runtime_source());
    emit(c, "#if !defined(VELA_RUNTIME_ABI) || VELA_RUNTIME_ABI != 2");
    emit(c, "#error incompatible Vela internal runtime ABI");
    emit(c, "#endif");
    emit(c, "typedef struct { void (*code)(void); void *environment; } v_callable;");
    emit(c, "static void v_gc_callable(const void *slot) { v_gc_mark(((const v_callable *)slot)->environment); }");
    emit(c, "typedef struct { void *payload; void (*const *operations)(void); } v_dynamic;");
    emit(c, "static void v_gc_dynamic(const void *slot) { v_gc_mark(((const v_dynamic *)slot)->payload); }");
    emit_types(c);
    emit_gc_types(c);
    emit_closure_environments(c);
    emit(c, "static v_e_IntResult v_result(v_parse_result p) { v_e_IntResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_Int32Result v_int32_result(v_parse_result p) { v_e_Int32Result r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = (int32_t)p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_FloatResult v_float_result(v_float_parse p) { v_e_FloatResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_ReadResult v_read_result(v_bounded_read p) { v_e_ReadResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.value; else if (p.kind == 2) r.data.k2.f0 = p.value; return r; }");
    emit(c, "static v_e_StreamResult v_stream_open_result(v_stream_result p) { v_e_StreamResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.handle; else if (p.kind == 2) r.data.k2.f0 = p.error; return r; }");
    emit(c, "static v_e_SpawnResult v_spawn_result_value(v_spawn_result p) { v_e_SpawnResult r = {0}; r.tag = p.handle ? 0 : 1; if (p.handle) r.data.k0.f0 = p.handle; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_CallbackResult v_callback_result_value(v_callback_result p) { v_e_CallbackResult r = {0}; r.tag = p.entry ? 0 : 1; if (p.entry) r.data.k0.f0 = p.entry; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_ProcessResult v_process_result_value(v_process_result p) { v_e_ProcessResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.code; else if (p.kind == 2) r.data.k2.f0 = p.message; return r; }");
    emit(c, "static v_e_StringResult v_string_result(v_io_result p) { v_e_StringResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.value; return r; }");
    emit(c, "static v_e_WriteResult v_write_result(v_io_result p) { v_e_WriteResult r = {0}; r.tag = p.ok ? 0 : 1; if (!p.ok) r.data.k1.f0 = p.value; return r; }");
    var i = 0;
    var main_index = 0;
    while i < list_len(c.functions) {
        emit(c, signature(c, list_get(c.functions, i)) +";");
        i = i + 1;
    }
    emit_dynamic_tables(c);
    i = 0;
    while i < list_len(c.functions) {
        let f = list_get(c.functions, i);
        let sig = symbol_info(c, f.symbol);
        if f.symbol == entry {
            main_index = i;
        }
        var ctl = list_get(c.control, 0);
        ctl.function_index = i;
        list_set(c.control, 0, ctl);
        emit_debug_line(c, f.span);
        emit(c, signature(c, f) + " {");
        emit(c, "(void)v_environment;");
        emit(c, "v_gc_root *const v_gc_frame = v_gc_roots;");
        if c.debug_codegen {
            emit(c, "static v_debug_record v_profile = {" + cquote(sig.name) + ", " + location(c, f.span) + ", 0, 0, 0, NULL};");
            emit(c, "v_debug_frame v_frame; v_debug_enter(&v_frame, &v_profile);");
        }
        for j in 0 .. list_len(f.captures) {
            let capture = list_get(f.captures, j);
            let type_id = symbol_info(c, capture).type_id;
            let name = local_name(capture);
            emit(c, ctype(c, type_id) + " " + name + " = ((" + closure_environment(f.symbol) + "*)v_environment)->v_capture_" + num(j) + ";");
            gc_root(c, name, gc_visitor(c, type_id));
        }
        for j in 0 .. list_len(f.parameters) {
            let parameter = list_get(f.parameters, j);
            gc_root(c, local_name(parameter), gc_visitor(c, symbol_info(c, parameter).type_id));
        }
        emit_contracts(c, f.preconditions, "precondition");
        emit_block(c, f.body);
        emit(c, "v_panic(" + location(c, f.span) + ", \"unreachable function end\");");
        emit(c, "return " + zero_value(c, sig.type_id) +";");
        emit(c, "}");
        i = i + 1;
    }
    if c.debug_codegen { emit(c, "#line 1 \"<vela-generated>\""); }
    let main_func = list_get(c.functions, main_index);
    emit(c, "int main(int argc, char **argv) { v_argc = argc; v_argv = argv; v_runtime_init(); v_gc_enable(); int code = 0;");
    if symbol_info(c, main_func.symbol).type_id == int_type() {
        emit(c, "code = v_exit_code(" + function_name(c, entry) + "(NULL), " + location(c, main_func.span) + ");");
    } else {
        emit(c, "(void)" + function_name(c, entry) + "(NULL);");
    }
    emit(c, "if (fflush(stdout) == EOF) v_panic(" + location(c, main_func.span) + ", \"failed to flush standard output\");");
    emit(c, "return code; }");
    return strings_join(c.output, "");
}
pub fn function_name(c: Context, id: SymbolId) -> String effects { state, io, process } {
    let sig = symbol_info(c, id);
    if sig.template_index >= 0 {
        return "v_g_f_" + num(symbol_number(id));
    }
    if sig.method_span.end > 0 || str_len(sig.name) > 0 && str_byte(sig.name, 0) == 64 {
        return "v_m_f_" + num(symbol_number(id));
    }
    return "v_f_" + sig.name;
}
pub fn emit_return_value(c: Context, value: String) -> Unit effects { state, io, process } {
    let f = list_get(c.functions, list_get(c.control, 0).function_index);
    let name = local_name(f.result_binding);
    let t = symbol_info(c, f.result_binding).type_id;
    emit(c, ctype(c, t) + " " + name + " = " + value +";");
    gc_root(c, name, gc_visitor(c, t));
    emit_cleanups(c, 0);
    emit_contracts(c, f.postconditions, "postcondition");
    gc_restore(c, "v_gc_frame");
    emit_debug_leave(c);
    emit(c, "return " + name +";");
}
pub fn emit_arm_bindings(c: Context, arm: CheckedArm, value: String) -> Unit effects { state, io, process } {
    let tag = symbol_info(c, arm.variant).tag;
    var i = 0;
    while i < list_len(arm.bindings) {
        let b = list_get(arm.bindings, i);
        if has_symbol(b) {
            let t = symbol_info(c, b).type_id;
            let name = local_name(b);
            emit(c, ctype(c, t) + " " + name + " = " + value + ".data.k" + num(tag) + ".f" + num(i) +";");
            gc_root(c, name, gc_visitor(c, t));
        }
        i = i + 1;
    }
}
pub fn emit_match_expression(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let value = emit_expr(c, n.left);
    let result_value = temp(c, n.type_id, zero_value(c, n.type_id));
    emit(c, "switch (" + value + ".tag) {");
    var i = 0;
    while i < list_len(n.arms) {
        let arm = list_get(n.arms, i);
        emit(c, "case " + num(symbol_info(c, arm.variant).tag) + ": {");
        let mark = gc_scope(c);
        emit_arm_bindings(c, arm, value);
        let selected = emit_expr(c, arm.value);
        emit(c, result_value + " = " + selected + ";");
        gc_restore(c, mark);
        emit(c, "break; }");
        i = i + 1;
    }
    emit(c, "default: v_panic(" + location(c, n.span) + ", \"invalid enum tag\"); }");
    return result_value;
}
pub fn emit_propagation(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let value = emit_expr(c, n.left);
    let failure = symbol_info(c, n.symbol);
    emit(c, "if (" + value + ".tag == 1) {");
    let propagated = temp(c, failure.owner, "{0}");
    emit(c, propagated + ".tag = 1;");
    if list_len(failure.parameters) == 1 {
        emit(c, propagated + ".data.k1.f0 = " + value + ".data.k1.f0;");
    }
    emit_return_value(c, propagated);
    emit(c, "}");
    return temp(c, n.type_id, value + ".data.k0.f0");
}
pub fn enter_emitted_loop(c: Context) -> String effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.temporary = ctl.temporary + 1;
    list_set(c.control, 0, ctl);
    let label = "v_loop_" + num(ctl.temporary);
    list_push(c.loop_labels, label);
    list_push(c.loop_cleanup_depths, list_len(c.cleanup_blocks));
    return label;
}
pub fn leave_emitted_loop(c: Context, label: String) -> Unit effects { state } {
    emit(c, label + "_break:;");
    gc_restore(c, label + "_roots");
    list_truncate(c.loop_labels, list_len(c.loop_labels) - 1);
    list_truncate(c.loop_cleanup_depths, list_len(c.loop_cleanup_depths) - 1);
}
pub fn emit_for(c: Context, n: CheckedStmt) -> Unit effects { state, io, process } {
    let value = emit_expr(c, n.value);
    let label = enter_emitted_loop(c);
    let element_type = symbol_info(c, n.binding).type_id;
    let element = ctype(c, element_type);
    let loc = location(c, n.span);
    var counter = "";
    var end_value = "";
    var condition_text = "";
    var item = "";
    if n.mode != 0 {
        end_value = emit_expr(c, n.target);
        counter = temp(c, int_type(), value);
        condition_text = counter + " < " + end_value;
        if n.mode == 2 {
            condition_text = counter + " <= " + end_value;
        }
        item = counter;
    } else {
        end_value = temp(c, int_type(), value + "->length");
        let snapshot = label + "_items";
        emit(c, element + " *" + snapshot + " = (" + element + "*)v_copy_items(" + value + "->data, " + end_value + ", sizeof(" + element + "), " + loc + ");");
        let root = label + "_snapshot";
        emit(c, "v_gc_snapshot " + root + " = {" + snapshot + ", (size_t)" + end_value + ", sizeof(" + element + "), " + gc_visitor(c, element_type) + "};");
        gc_root(c, root, "v_gc_snapshot_value");
        counter = temp(c, int_type(), "0");
        condition_text = counter + " < " + end_value;
        item = snapshot + "[" + counter + "]";
    }
    emit(c, "v_gc_root *const " + label + "_roots = v_gc_roots;");
    emit(c, "while (" + condition_text + ") {");
    emit(c, element + " " + local_name(n.binding) + " = " + item +";");
    gc_root(c, local_name(n.binding), gc_visitor(c, element_type));
    emit_block(c, n.yes);
    emit(c, label + "_continue:;");
    gc_restore(c, label + "_roots");
    if n.mode == 2 {
        emit(c, "if (" + counter + " == " + end_value + ") break;");
    }
    emit(c, counter + " = v_add(" + counter + ", 1, " + loc + "); }");
    leave_emitted_loop(c, label);
}
pub fn emit_formatted_value(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    var value = emit_expr(c, n.left);
    let original = checked_expr(c, n.left).type_id;
    let scalar = scalar_type(c, original);
    if type_kind(c, original) == 77 {
        value = value + ".v_m_value";
    }
    if scalar == string_type() {
        return temp(c, string_type(), value);
    }
    if scalar == bool_type() {
        return temp(c, string_type(),"("+ value + " ? v_text(\"true\", 4) : v_text(\"false\", 5))");
    }
    if scalar == float_type() {
        return temp(c, string_type(), "v_float_to_string(" + value + ", " + location(c, n.span) +")");
    }
    return temp(c, string_type(), "v_int_to_string(" + value + ", " + location(c, n.span) +")");
}
pub fn emit_interpolation(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let loc = location(c, n.span);
    let parts = temp(c, strings_type(), "v_strings_new(" + loc +")");
    for i in 0 .. list_len(n.arguments) {
        let value = emit_expr(c, list_get(n.arguments, i));
        emit(c, "v_strings_push(" + parts + ", " + value + ", " + loc + ");");
    }
    return temp(c, string_type(), "v_strings_join(" + parts + ", v_text(\"\", 0), " + loc +")");
}
