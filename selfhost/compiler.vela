// Typed per-compilation tables. Only this module unwraps arena IDs.
type AstExprId = distinct Int;
type AstStmtId = distinct Int;
type ExprId = distinct Int;
type StmtId = distinct Int;
type TypeId = distinct Int;
type SymbolId = distinct Int;
struct Span {
    start: Int,
    end: Int
}
struct ProjectDependency {
    alias: String,
    path: String,
    relative: String
}
struct RelatedLocation {
    message: String,
    span: Span
}
struct DiagnosticDetails {
    expected_type: String,
    actual_type: String,
    callee: String,
    required_effects: Int,
    allowed_effects: Int,
    missing_effects: Int,
    missing_variants: List<String>,
    related: List<RelatedLocation>
}
struct Token {
    kind: Int,
    text: String,
    span: Span
}
struct SyntaxArgument {
    label: String,
    value: AstExprId
}
struct SyntaxExpr {
    arms: List<SyntaxArm>,
    kind: Int,
    span: Span,
    text: String,
    qualifier: String,
    left: AstExprId,
    right: AstExprId,
    arguments: List<SyntaxArgument>,
    type_arguments: List<String>
}
struct SyntaxName {
    name: String,
    span: Span
}
struct SyntaxArm {
    value: AstExprId,
    owner: String,
    variant: String,
    names: List<SyntaxName>,
    body: List<AstStmtId>,
    span: Span
}
struct SyntaxStmt {
    mode: Int,
    kind: Int,
    span: Span,
    name: String,
    annotation: String,
    mutable: Bool,
    value: AstExprId,
    target: AstExprId,
    yes: List<AstStmtId>,
    no: List<AstStmtId>,
    arms: List<SyntaxArm>
}
struct SyntaxField {
    name: String,
    annotation: String,
    span: Span
}
struct SyntaxVariant {
    name: String,
    fields: List<String>,
    span: Span
}
struct TypeParameter {
    name: String,
    bound: String,
    span: Span
}
struct SyntaxType {
    type_parameters: List<TypeParameter>,
    kind: Int,
    name: String,
    base: String,
    fields: List<SyntaxField>,
    variants: List<SyntaxVariant>,
    span: Span
}
struct SyntaxFunction {
    foreign_library: String,
    foreign_name: String,
    test_name: String,
    type_parameters: List<TypeParameter>,
    name: String,
    parameters: List<SyntaxField>,
    return_name: String,
    effect_mask: Int,
    preconditions: List<AstExprId>,
    postconditions: List<AstExprId>,
    body: List<AstStmtId>,
    span: Span
}
struct TypeInfo {
    template_index: Int,
    kind: Int,
    name: String,
    fields: List<SymbolId>,
    variants: List<SymbolId>,
    arguments: List<TypeId>,
    base: TypeId,
    base_name: String,
    span: Span,
    visit: Int
}
struct Symbol {
    foreign_library: String,
    foreign_name: String,
    template_index: Int,
    kind: Int,
    name: String,
    type_id: TypeId,
    owner: TypeId,
    span: Span,
    parameters: List<SymbolId>,
    effect_mask: Int,
    mutable: Bool,
    tag: Int,
    builtin: Bool,
    abi: String,
    variables: List<String>,
    patterns: List<String>,
    return_pattern: String
}
struct CheckedExpr {
    arms: List<CheckedArm>,
    kind: Int,
    span: Span,
    type_id: TypeId,
    text: String,
    left: ExprId,
    right: ExprId,
    arguments: List<ExprId>,
    symbol: SymbolId,
    fields: List<SymbolId>
}
struct CheckedArm {
    value: ExprId,
    variant: SymbolId,
    bindings: List<SymbolId>,
    body: List<StmtId>,
    span: Span
}
struct CheckedStmt {
    mode: Int,
    exits: Bool,
    kind: Int,
    span: Span,
    binding: SymbolId,
    value: ExprId,
    target: ExprId,
    yes: List<StmtId>,
    no: List<StmtId>,
    arms: List<CheckedArm>,
    returns: Bool
}
struct CheckedFunction {
    symbol: SymbolId,
    parameters: List<SymbolId>,
    result_binding: SymbolId,
    preconditions: List<ExprId>,
    postconditions: List<ExprId>,
    body: List<StmtId>,
    span: Span
}
struct FunctionInstance {
    depth: Int,
    signature: SymbolId,
    syntax_index: Int,
    mapping: Dict<String, TypeId>
}
struct Control {
    loop_depth: Int,
    in_contract: Bool,
    instance_depth: Int,
    type_mapping: Dict<String, TypeId>,
    type_depth: Int,
    type_instances: Int,
    cursor: Int,
    previous_end: Int,
    depth: Int,
    return_type: TypeId,
    allowed_effects: Int,
    temporary: Int,
    function_index: Int
}
struct Context {
    source_units: List<SourceUnit>,
    imports: List<ModuleImport>,
    declarations: List<ModuleDeclaration>,
    bound_types: List<SyntaxType>,
    bound_functions: List<SyntaxFunction>,
    loop_labels: List<String>,
    instances: List<FunctionInstance>,
    generic_functions: Dict<String, SymbolId>,
    source_text: String,
    source_name: String,
    json_mode: Bool,
    lines: List<Int>,
    output: StringList,
    tokens: List<Token>,
    comments: List<Token>,
    syntax_exprs: List<SyntaxExpr>,
    syntax_stmts: List<SyntaxStmt>,
    syntax_types: List<SyntaxType>,
    syntax_functions: List<SyntaxFunction>,
    expressions: List<CheckedExpr>,
    statements: List<CheckedStmt>,
    types: List<TypeInfo>,
    symbols: List<Symbol>,
    functions: List<CheckedFunction>,
    signatures: List<SymbolId>,
    scopes: List<List<SymbolId>>,
    type_order: List<TypeId>,
    control: List<Control>
}
struct SourceUnit {
    path: String,
    name: String,
    identity: String,
    code: String,
    start: Int,
    end: Int,
    line_base: Int
}
struct ImportSpec {
    path: String,
    alias: String,
    span: Span
}
struct ModuleImport {
    owner: Int,
    target: Int,
    alias: String,
    span: Span
}
struct ModuleDeclaration {
    owner: Int,
    name: String,
    canonical: String,
    exported: Bool,
    span: Span
}
fn empty_span() -> Span {
    return Span(start: 0, end: 0);
}
fn no_ast_expr() -> AstExprId {
    return AstExprId(0);
}
fn no_ast_stmt() -> AstStmtId {
    return AstStmtId(0);
}
fn no_expr() -> ExprId {
    return ExprId(0);
}
fn no_stmt() -> StmtId {
    return StmtId(0);
}
fn no_type() -> TypeId {
    return TypeId(0);
}
fn no_symbol() -> SymbolId {
    return SymbolId(0);
}
fn has_ast_expr(id: AstExprId) -> Bool {
    return id.value != 0;
}
fn has_expr(id: ExprId) -> Bool {
    return id.value != 0;
}
fn has_type(id: TypeId) -> Bool {
    return id.value != 0;
}
fn has_symbol(id: SymbolId) -> Bool {
    return id.value != 0;
}
fn int_type() -> TypeId {
    return TypeId(1);
}
fn bool_type() -> TypeId {
    return TypeId(2);
}
fn string_type() -> TypeId {
    return TypeId(3);
}
fn unit_type() -> TypeId {
    return TypeId(4);
}
fn ints_type() -> TypeId {
    return TypeId(5);
}
fn strings_type() -> TypeId {
    return TypeId(6);
}
fn float_type() -> TypeId {
    return TypeId(7);
}
fn foreign_handle_type() -> TypeId { return TypeId(8); }
fn int32_type() -> TypeId { return TypeId(9); }
fn primitive_type_id(index: Int) -> TypeId {
    return TypeId(index);
}
fn symbol_number(id: SymbolId) -> Int {
    return id.value;
}
fn type_number(id: TypeId) -> Int {
    return id.value;
}
fn table_index(id: Int, length: Int, category: String) -> Int effects { io, process } {
    if id <= 0 || id > length {
        eprint("velac: internal error: invalid " + category + " ID " + to_string(id));
        exit(70);
    }
    return id - 1;
}
fn ast_expr(c: Context, id: AstExprId) -> SyntaxExpr effects { state, io, process } {
    return table_get(c.syntax_exprs, id.value, "AST expression");
}
fn ast_stmt(c: Context, id: AstStmtId) -> SyntaxStmt effects { state, io, process } {
    return table_get(c.syntax_stmts, id.value, "AST statement");
}
fn checked_expr(c: Context, id: ExprId) -> CheckedExpr effects { state, io, process } {
    return table_get(c.expressions, id.value, "HIR expression");
}
fn checked_stmt(c: Context, id: StmtId) -> CheckedStmt effects { state, io, process } {
    return table_get(c.statements, id.value, "HIR statement");
}
fn type_info(c: Context, id: TypeId) -> TypeInfo effects { state, io, process } {
    return table_get(c.types, id.value, "type");
}
fn symbol_info(c: Context, id: SymbolId) -> Symbol effects { state, io, process } {
    return table_get(c.symbols, id.value, "symbol");
}
fn add_ast_expr(c: Context, value: SyntaxExpr) -> AstExprId effects { state } {
    list_push(c.syntax_exprs, value);
    return AstExprId(list_len(c.syntax_exprs));
}
fn add_ast_stmt(c: Context, value: SyntaxStmt) -> AstStmtId effects { state } {
    list_push(c.syntax_stmts, value);
    return AstStmtId(list_len(c.syntax_stmts));
}
fn add_expr(c: Context, value: CheckedExpr) -> ExprId effects { state } {
    list_push(c.expressions, value);
    return ExprId(list_len(c.expressions));
}
fn add_stmt(c: Context, value: CheckedStmt) -> StmtId effects { state } {
    list_push(c.statements, value);
    return StmtId(list_len(c.statements));
}
fn add_type(c: Context, value: TypeInfo) -> TypeId effects { state } {
    list_push(c.types, value);
    return TypeId(list_len(c.types));
}
fn add_symbol(c: Context, value: Symbol) -> SymbolId effects { state } {
    list_push(c.symbols, value);
    return SymbolId(list_len(c.symbols));
}
fn set_type(c: Context, id: TypeId, value: TypeInfo) -> Unit effects { state, io, process } {
    list_set(c.types, table_index(id.value, list_len(c.types), "type"), value);
}
fn set_symbol(c: Context, id: SymbolId, value: Symbol) -> Unit effects { state, io, process } {
    list_set(c.symbols, table_index(id.value, list_len(c.symbols), "symbol"), value);
}
fn syntax_expression(kind: Int, span: Span, text: String) -> SyntaxExpr effects { state } {
    return SyntaxExpr(arms: list_new<SyntaxArm>(), kind: kind, span: span, text: text, qualifier: "", left: no_ast_expr(), right: no_ast_expr(), arguments: list_new<SyntaxArgument>(), type_arguments: list_new<String>());
}
fn syntax_statement(kind: Int, span: Span) -> SyntaxStmt effects { state } {
    return SyntaxStmt(mode: 0, kind: kind, span: span, name: "", annotation: "", mutable: false, value: no_ast_expr(), target: no_ast_expr(), yes: list_new<AstStmtId>(), no: list_new<AstStmtId>(), arms: list_new<SyntaxArm>());
}
fn expression_record(kind: Int, span: Span, type_id: TypeId) -> CheckedExpr effects { state } {
    return CheckedExpr(arms: list_new<CheckedArm>(), kind: kind, span: span, type_id: type_id, text: "", left: no_expr(), right: no_expr(), arguments: list_new<ExprId>(), symbol: no_symbol(), fields: list_new<SymbolId>());
}
fn statement_record(kind: Int, span: Span) -> CheckedStmt effects { state } {
    return CheckedStmt(mode: 0, exits: false, kind: kind, span: span, binding: no_symbol(), value: no_expr(), target: no_expr(), yes: list_new<StmtId>(), no: list_new<StmtId>(), arms: list_new<CheckedArm>(), returns: false);
}
fn type_record(kind: Int, name: String, span: Span) -> TypeInfo effects { state } {
    return TypeInfo(template_index: -1, kind: kind, name: name, fields: list_new<SymbolId>(), variants: list_new<SymbolId>(), arguments: list_new<TypeId>(), base: no_type(), base_name: "", span: span, visit: 0);
}
fn symbol_record(kind: Int, name: String, type_id: TypeId, span: Span) -> Symbol effects { state } {
    return Symbol(foreign_library: "", foreign_name: "", template_index: -1, kind: kind, name: name, type_id: type_id, owner: no_type(), span: span, parameters: list_new<SymbolId>(), effect_mask: 0, mutable: false, tag: 0, builtin: false, abi: "", variables: list_new<String>(), patterns: list_new<String>(), return_pattern: "");
}
fn table_get<T>(items: List<T>, id: Int, category: String) -> T effects { state, io, process } {
    return list_get(items, table_index(id, list_len(items), category));
}
fn last<T>(items: List<T>) -> Option<T> effects { state } {
    if list_len(items) == 0 {
        return Option<T>::None;
    }
    return Option<T>::Some(list_get(items, list_len(items) - 1));
}


// Source coordinates and diagnostics shared by typed compiler phases.
fn cat(a: String, b: String) -> String {
    return str_concat(a, b);
}
fn num(value: Int) -> String {
    return int_to_string(value);
}
fn source(c: Context) -> String {
    return c.source_text;
}
fn filename(c: Context) -> String {
    return c.source_name;
}
fn global_line_at(c: Context, position: Int) -> Int effects { state } {
    var low = 0;
    var high = list_len(c.lines);
    while low + 1 < high {
        let middle = low + (high - low) / 2;
        if list_get(c.lines, middle) <= position {
            low = middle;
        } else {
            high = middle;
        }
    }
    return low + 1;
}
fn source_unit_at(c: Context, position: Int) -> Int effects { state } {
    var found = 0;
    for i in 0 .. list_len(c.source_units) {
        if list_get(c.source_units, i).start <= position {
            found = i;
        } else {
            break;
        }
    }
    return found;
}
fn filename_at(c: Context, position: Int) -> String effects { state } {
    return list_get(c.source_units, source_unit_at(c, position)).name;
}
fn line_at(c: Context, position: Int) -> Int effects { state } {
    return global_line_at(c, position) - list_get(c.source_units, source_unit_at(c, position)).line_base;
}
fn column_at(c: Context, position: Int) -> Int effects { state } {
    var i = list_get(c.lines, global_line_at(c, position) - 1);
    var column = 1;
    while i < position {
        let b = str_byte(c.source_text, i);
        if b < 128 || b >= 192 {
            column = column + 1;
        }
        i = i + 1;
    }
    return column;
}
fn codepoint_at(c: Context, position: Int) -> Int effects { state } {
    var i = list_get(c.source_units, source_unit_at(c, position)).start;
    var count = 0;
    while i < position {
        let b = str_byte(c.source_text, i);
        if b < 128 || b >= 192 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
fn json_string(value: String) -> String effects { state } {
    let parts = strings_new();
    strings_push(parts, "\"");
    var i = 0;
    while i < str_len(value) {
        let b = str_byte(value, i);
        if b == 34 {
            strings_push(parts, "\\\"");
        } else if b == 92 {
            strings_push(parts, "\\\\");
        } else if b < 32 {
            let hex = "0123456789abcdef";
            strings_push(parts, "\\u00");
            strings_push(parts, str_slice(hex, b / 16, b / 16 + 1));
            strings_push(parts, str_slice(hex, b % 16, b % 16 + 1));
        } else {
            strings_push(parts, str_slice(value, i, i + 1));
        }
        i = i + 1;
    }
    strings_push(parts, "\"");
    return strings_join(parts, "");
}
fn empty_details() -> DiagnosticDetails effects { state } {
    return DiagnosticDetails(expected_type: "", actual_type: "", callee: "", required_effects: 0, allowed_effects: 0, missing_effects: 0, missing_variants: list_new<String>(), related: list_new<RelatedLocation>());
}
fn effect_names(mask: Int) -> StringList effects { state } {
    let items = strings_new();
    if mask / 2 % 2 == 1 {
        strings_push(items, "args");
    }
    if mask % 2 == 1 {
        strings_push(items, "io");
    }
    if mask / 8 % 2 == 1 {
        strings_push(items, "process");
    }
    if mask / 4 % 2 == 1 {
        strings_push(items, "state");
    }
    return items;
}
fn effect_json(mask: Int) -> String effects { state } {
    let names = effect_names(mask);
    var i = 0;
    while i < strings_len(names) {
        strings_set(names, i, json_string(strings_get(names, i)));
        i = i + 1;
    }
    return "[" + strings_join(names,",") + "]";
}
fn span_json(c: Context, span: Span) -> String effects { state } {
    return f"{{\"start\":{codepoint_at(c, span.start):d},\"end\":{codepoint_at(c, span.end):d},\"line\":{line_at(c, span.start):d},\"column\":{column_at(c, span.start):d},\"end_line\":{line_at(c, span.end):d},\"end_column\":{column_at(c, span.end):d}}}";
}
fn details_json(details: DiagnosticDetails) -> String effects { state } {
    let items = strings_new();
    if details.expected_type != "" {
        strings_push(items, "\"expected_type\":" + json_string(details.expected_type));
        strings_push(items, "\"actual_type\":" + json_string(details.actual_type));
    }
    if details.callee != "" {
        strings_push(items, "\"callee\":" + json_string(details.callee));
        strings_push(items, "\"required_effects\":" + effect_json(details.required_effects));
        strings_push(items, "\"allowed_effects\":" + effect_json(details.allowed_effects));
        strings_push(items, "\"missing_effects\":" + effect_json(details.missing_effects));
    }
    if list_len(details.missing_variants) > 0 {
        let names = strings_new();
        var i = 0;
        while i < list_len(details.missing_variants) {
            strings_push(names, json_string(list_get(details.missing_variants, i)));
            i = i + 1;
        }
        strings_push(items, "\"missing_variants\":[" + strings_join(names,",") + "]");
    }
    return "{" + strings_join(items,",") + "}";
}
fn fail_details(c: Context, code: String, message: String, span: Span, details: DiagnosticDetails) -> Unit effects { state, io, process } {
    let related = strings_new();
    var i = 0;
    while i < list_len(details.related) {
        let item = list_get(details.related, i);
        strings_push(related, f"{{\"message\":{json_string(item.message):s},\"source\":{json_string(filename_at(c, item.span.start)):s},\"span\":{span_json(c, item.span):s}}}");
        i = i + 1;
    }
    if c.json_mode {
        print(f"{{\"schema_version\":1,\"ok\":false,\"source\":{json_string(filename_at(c, span.start)):s},\"diagnostics\":[{{\"severity\":\"error\",\"code\":{json_string(code):s},\"message\":{json_string(message):s},\"source\":{json_string(filename_at(c, span.start)):s},\"span\":{span_json(c, span):s},\"notes\":[],\"details\":{details_json(details):s},\"related\":[{strings_join(related,","):s}]}}]}}");
    } else {
        eprint(f"{filename_at(c, span.start):s}:{line_at(c, span.start):d}:{column_at(c, span.start):d}: {code:s}: {message:s}");
        i = 0;
        while i < list_len(details.related) {
            let item = list_get(details.related, i);
            eprint(f"{filename_at(c, item.span.start):s}:{line_at(c, item.span.start):d}:{column_at(c, item.span.start):d}: note: {item.message:s}");
            i = i + 1;
        }
    }
    exit(1);
}
fn fail(c: Context, code: String, message: String, start: Int, end: Int) -> Unit effects { state, io, process } {
    fail_details(c, code, message, Span(start: start, end: end), empty_details());
}
fn bad(c: Context, code: String, message: String, span: Span) -> Unit effects { state, io, process } {
    fail_details(c, code, message, span, empty_details());
}
fn duplicate(c: Context, message: String, span: Span, previous: Span) -> Unit effects { state, io, process } {
    let details = empty_details();
    if previous.end > previous.start {
        list_push(details.related, RelatedLocation(message: "Previous declaration is here.", span: previous));
    }
    fail_details(c, "E202", message, span, details);
}
fn enter(c: Context, span: Span) -> Unit effects { state, io, process } {
    var control = list_get(c.control, 0);
    control.depth = control.depth + 1;
    list_set(c.control, 0, control);
    if control.depth > 200 {
        bad(c, "E101", "Source nesting exceeds the compiler limit.", span);
    }
}
fn leave(c: Context) -> Unit effects { state } {
    var control = list_get(c.control, 0);
    control.depth = control.depth - 1;
    list_set(c.control, 0, control);
}
fn make_context(code: String, name: String, json_mode: Bool) -> Context effects { state } {
    let lines = list_new<Int>();
    list_push(lines, 0);
    var i = 0;
    while i < str_len(code) {
        if str_byte(code, i) == 10 {
            list_push(lines, i + 1);
        }
        i = i + 1;
    }
    let control = list_new<Control>();
    list_push(control, Control(loop_depth: 0, in_contract: false, instance_depth: 0, type_mapping: dict_new<String, TypeId>(), type_depth: 0, type_instances: 0, cursor: 0, previous_end: 0, depth: 0, return_type: no_type(), allowed_effects: 0, temporary: 0, function_index: 0));
    let units = list_new<SourceUnit>();
    list_push(units, SourceUnit(path: name, name: name, identity: "", code: code, start: 0, end: str_len(code), line_base: 0));
    return Context(source_units: units, imports: list_new<ModuleImport>(), declarations: list_new<ModuleDeclaration>(), bound_types: list_new<SyntaxType>(), bound_functions: list_new<SyntaxFunction>(), loop_labels: list_new<String>(), instances: list_new<FunctionInstance>(), generic_functions: dict_new<String, SymbolId>(), source_text: code, source_name: name, json_mode: json_mode, lines: lines, output: strings_new(), tokens: list_new<Token>(), comments: list_new<Token>(), syntax_exprs: list_new<SyntaxExpr>(), syntax_stmts: list_new<SyntaxStmt>(), syntax_types: list_new<SyntaxType>(), syntax_functions: list_new<SyntaxFunction>(), expressions: list_new<CheckedExpr>(), statements: list_new<CheckedStmt>(), types: list_new<TypeInfo>(), symbols: list_new<Symbol>(), functions: list_new<CheckedFunction>(), signatures: list_new<SymbolId>(), scopes: list_new<List<SymbolId>>(), type_order: list_new<TypeId>(), control: control);
}


fn utf8_width(byte: Int) -> Int {
    if byte < 128 {
        return 1;
    }
    if byte >= 194 && byte <= 223 {
        return 2;
    }
    if byte >= 224 && byte <= 239 {
        return 3;
    }
    if byte >= 240 && byte <= 244 {
        return 4;
    }
    return 0;
}
fn utf8_valid(s: String) -> Bool {
    var i = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        let width = utf8_width(b);
        if width == 0 || i + width > str_len(s) {
            return false;
        }
        var j = 1;
        while j < width {
            let tail = str_byte(s, i + j);
            if tail < 128 || tail > 191 {
                return false;
            }
            j = j + 1;
        }
        if width >= 3 {
            let second = str_byte(s, i + 1);
            if b == 224 && second < 160 || b == 237 && second > 159 || b == 240 && second < 144 || b == 244 && second > 143 {
                return false;
            }
        }
        i = i + width;
    }
    return true;
}
fn codepoint(s: String, i: Int) -> Int {
    let b = str_byte(s, i);
    let width = utf8_width(b);
    if width == 1 {
        return b;
    }
    var value = b % 32;
    if width == 3 {
        value = b % 16;
    }
    if width == 4 {
        value = b % 8;
    }
    var j = 1;
    while j < width {
        value = value * 64 + str_byte(s, i + j) % 64;
        j = j + 1;
    }
    return value;
}
fn whitespace(s: String, i: Int) -> Bool {
    let cp = codepoint(s, i);
    return cp >= 9 && cp <= 13 || cp >= 28 && cp <= 32 || cp == 133 || cp == 160 || cp == 5760 || cp >= 8192 && cp <= 8202 || cp == 8232 || cp == 8233 || cp == 8239 || cp == 8287 || cp == 12288;
}
fn normalized(s: String) -> String effects { state, io, process } {
    if !utf8_valid(s) {
        eprint("velac: E900: source is not valid UTF-8");
        exit(2);
    }
    let parts = strings_new();
    var start = 0;
    if str_len(s) >= 3 && str_byte(s, 0) == 239 && str_byte(s, 1) == 187 && str_byte(s, 2) == 191 {
        start = 3;
    }
    var i = start;
    while i < str_len(s) {
        if str_byte(s, i) == 13 {
            strings_push(parts, str_slice(s, start, i));
            strings_push(parts, "\n");
            i = i + 1;
            if i < str_len(s) && str_byte(s, i) == 10 {
                i = i + 1;
            }
            start = i;
        } else {
            i = i + 1;
        }
    }
    strings_push(parts, str_slice(s, start, i));
    return strings_join(parts, "");
}
fn source_error(message: String, json_mode: Bool) -> Unit effects { state, io, process } {
    if json_mode {
        print(cat(cat("{\"schema_version\":1,\"ok\":false,\"diagnostics\":[{\"code\":\"E900\",\"severity\":\"error\",\"message\":", json_string(message)), "}]}"));
    } else {
        eprint(cat("velac: E900: ", message));
    }
    exit(2);
}
fn source_text_result(path: String) -> Result<String, String> effects { state, io, process } {
    let boundary = env("VELA_SOURCE_ROOT");
    if boundary != "" {
        let root = path_key(io_value(absolute_path(boundary)));
        let absolute = path_key(io_value(absolute_path(path)));
        var prefix = root + "/";
        if platform() == "windows" {
            prefix = root + "\\";
        }
        if str_len(absolute) <= str_len(prefix) || str_slice(absolute, 0, str_len(prefix)) != prefix {
            return Result<String, String>::Err("Source path escapes VELA_SOURCE_ROOT.");
        }
    }
    let code = from_string(read_file(path))?;
    if !utf8_valid(code) {
        return Result<String, String>::Err("Source is not valid UTF-8.");
    }
    return Result<String, String>::Ok(normalized(code));
}
fn load_source(path: String, json_mode: Bool) -> String effects { state, io, process } {
    match source_text_result(path) {
        Result::Ok(code) => {
            return code;
        }
        Result::Err(message) => {
            source_error(message, json_mode);
            return "";
        }
    }
}


fn is_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}
fn is_alpha(b: Int) -> Bool {
    return b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95;
}
fn keyword(s: String) -> Bool {
    return s == "import" || s == "as" || s == "pub" || s == "for" || s == "in" || s == "break" || s == "continue" || s == "fn" || s == "enum" || s == "let" || s == "var" || s == "return" || s == "if" || s == "else" || s == "while" || s == "match" || s == "effects" || s == "requires" || s == "ensures" || s == "true" || s == "false" || s == "struct" || s == "type" || s == "distinct";
}
fn contains_byte(s: String, b: Int) -> Bool {
    var i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == b {
            return true;
        }
        i = i + 1;
    }
    return false;
}
fn lex(c: Context) -> Unit effects { state, io, process } {
    lex_range(c, 0, str_len(c.source_text));
}
fn lex_range(c: Context, begin: Int, limit: Int) -> Unit effects { state, io, process } {
    let s = source(c);
    var i = begin;
    while i < limit {
        let start = i;
        let b = str_byte(s, i);
        var kind = 0;
        var value = "";
        if whitespace(s, i) {
            i = i + utf8_width(b);
        } else if b == 47 && i + 1 < limit && str_byte(s, i + 1) == 47 {
            while i < limit && str_byte(s, i) != 10 {
                i = i + 1;
            }
            list_push(c.comments, Token(kind: 55, text: str_slice(s, start, i), span: Span(start: start, end: i)));
        } else if b == 102 && i + 1 < limit && str_byte(s, i + 1) == 34 {
            i = interpolation_end(c, i);
            kind = 56;
            value = str_slice(s, start, i);
        } else if is_alpha(b) {
            i = i + 1;
            while i < limit && (is_alpha(str_byte(s, i)) || is_digit(str_byte(s, i))) {
                i = i + 1;
            }
            kind = 50;
            value = str_slice(s, start, i);
        } else if is_digit(b) {
            i = i + 1;
            while i < limit && is_digit(str_byte(s, i)) {
                i = i + 1;
            }
            kind = 51;
            if i + 1 < limit && str_byte(s, i) == 46 && is_digit(str_byte(s, i + 1)) {
                kind = 57;
                i = i + 1;
                while i < limit && is_digit(str_byte(s, i)) { i = i + 1; }
            }
            if i < limit && (str_byte(s, i) == 101 || str_byte(s, i) == 69) {
                kind = 57;
                i = i + 1;
                if i < limit && (str_byte(s, i) == 43 || str_byte(s, i) == 45) { i = i + 1; }
                let exponent_start = i;
                while i < limit && is_digit(str_byte(s, i)) { i = i + 1; }
                if i == exponent_start { fail(c, "E001", "Expected exponent digits.", start, i); }
            }
            value = str_slice(s, start, i);
        } else if b == 34 {
            i = i + 1;
            let parts = strings_new();
            while i < limit && str_byte(s, i) != 34 {
                var ch = str_byte(s, i);
                if ch == 10 || ch == 13 {
                    fail(c, "E001", "Newline in string literal.", start, i);
                }
                if ch == 92 {
                    i = i + 1;
                    if i >= limit {
                        fail(c, "E001", "Incomplete string escape.", start, i);
                    }
                    ch = str_byte(s, i);
                    if ch == 110 {
                        ch = 10;
                    } else if ch == 114 {
                        ch = 13;
                    } else if ch == 116 {
                        ch = 9;
                    } else if ch == 48 {
                        ch = 0;
                    } else if ch != 34 && ch != 92 {
                        fail(c, "E001", "Unknown string escape.", start, i);
                    }
                }
                strings_push(parts, str_from_byte(ch));
                i = i + 1;
            }
            if i == limit {
                fail(c, "E001", "Unterminated string literal.", start, i);
            }
            i = i + 1;
            kind = 52;
            value = strings_join(parts, "");
        } else {
            var pair = "";
            if i + 1 < limit {
                pair = str_slice(s, i, i + 2);
            }
            if i + 2 < limit && str_slice(s, i, i + 3) == "..=" {
                i = i + 3;
                kind = 53;
                value = "..=";
            } else if pair == ".." || pair == "->" || pair == "=>" || pair =="::"|| pair == "==" || pair == "!=" || pair == "<=" || pair == ">=" || pair == "&&" || pair == "||" {
                i = i + 2;
                kind = 53;
                value = pair;
            } else if contains_byte("(){}:.,;=+-*/%!<>?", b) {
                i = i + 1;
                kind = 53;
                value = str_slice(s, start, i);
            } else {
                fail(c, "E001", "Unexpected character.", start, start + utf8_width(b));
            }
        }
        if kind != 0 {
            list_push(c.tokens, Token(kind: kind, text: value, span: Span(start: start, end: i)));
        }
    }
    list_push(c.tokens, Token(kind: 54, text: "<eof>", span: Span(start: i, end: i)));
}
fn quoted_end(c: Context, start: Int) -> Int effects { state, io, process } {
    let s = c.source_text;
    var i = start + 1;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 10 || b == 13 {
            fail(c, "E001", "Newline in interpolation.", start, i);
        }
        if b == 34 {
            return i + 1;
        }
        if b == 92 {
            i = i + 1;
        }
        i = i + 1;
    }
    fail(c, "E001", "Unterminated string in interpolation.", start, i);
    return i;
}
fn interpolation_hole_end(c: Context, start: Int) -> Int effects { state, io, process } {
    let s = c.source_text;
    var i = start;
    var braces = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 10 || b == 13 {
            fail(c, "E001", "Newline in interpolation.", start, i);
        }
        if b == 47 && i + 1 < str_len(s) && str_byte(s, i + 1) == 47 {
            fail(c, "E001", "Comments are not allowed in interpolation holes.", i, i + 2);
        }
        if b == 102 && i + 1 < str_len(s) && str_byte(s, i + 1) == 34 {
            i = interpolation_end(c, i);
        } else if b == 34 {
            i = quoted_end(c, i);
        } else {
            if b == 123 {
                braces = braces + 1;
            }
            if b == 125 {
                if braces == 0 {
                    return i;
                }
                braces = braces - 1;
            }
            i = i + 1;
        }
    }
    fail(c, "E001", "Unterminated interpolation hole.", start, i);
    return i;
}
fn interpolation_end(c: Context, start: Int) -> Int effects { state, io, process } {
    enter(c, Span(start: start, end: start + 2));
    let s = c.source_text;
    var i = start + 2;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 10 || b == 13 {
            fail(c, "E001", "Newline in interpolation.", start, i);
        }
        if b == 34 {
            leave(c);
            return i + 1;
        }
        if b == 92 {
            i = i + 2;
        } else if (b == 123 || b == 125) && i + 1 < str_len(s) && str_byte(s, i + 1) == b {
            i = i + 2;
        } else if b == 123 {
            i = interpolation_hole_end(c, i + 1) + 1;
        } else if b == 125 {
            fail(c, "E001", "Unmatched closing interpolation brace.", i, i + 1);
        } else {
            i = i + 1;
        }
    }
    fail(c, "E001", "Unterminated interpolation.", start, str_len(s));
    leave(c);
    return i;
}


fn current(c: Context) -> Token effects { state } {
    return list_get(c.tokens, list_get(c.control, 0).cursor);
}
fn at(c: Context, value: String) -> Bool effects { state } {
    let t = current(c);
    return (t.kind == 50 || t.kind == 53 || t.kind == 54) && t.text == value;
}
fn take(c: Context) -> Token effects { state } {
    let t = current(c);
    var ctl = list_get(c.control, 0);
    if t.kind != 54 {
        ctl.cursor = ctl.cursor + 1;
    }
    ctl.previous_end = t.span.end;
    list_set(c.control, 0, ctl);
    return t;
}
fn accept(c: Context, value: String) -> Bool effects { state } {
    if at(c, value) {
        let ignored = take(c);
        return true;
    }
    return false;
}
fn expect(c: Context, value: String) -> Token effects { state, io, process } {
    if !at(c, value) {
        bad(c, "E100", "Expected " + value, current(c).span);
    }
    return take(c);
}
fn identifier(c: Context) -> Token effects { state, io, process } {
    let t = current(c);
    if t.kind != 50 || keyword(t.text) {
        bad(c, "E100", "Expected an identifier.", t.span);
    }
    return take(c);
}
fn through_previous(c: Context, start: Int) -> Span effects { state } {
    return Span(start: start, end: list_get(c.control, 0).previous_end);
}
fn precedence(op: String) -> Int {
    if op == "||" {
        return 1;
    }
    if op == "&&" {
        return 2;
    }
    if op == "==" || op == "!=" {
        return 3;
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        return 4;
    }
    if op == "+" || op == "-" {
        return 5;
    }
    if op == "*" || op == "/" || op == "%" {
        return 6;
    }
    return -1;
}
fn parse_type(c: Context) -> String effects { state, io, process } {
    let token = identifier(c);
    enter(c, token.span);
    var name = token.text;
    while accept(c,"::") {
        name = name +"::"+ identifier(c).text;
    }
    if accept(c, "<") {
        let parts = strings_new();
        var more = true;
        while more {
            strings_push(parts, parse_type(c));
            more = accept(c,",");
        }
        let close = expect(c, ">");
        name = name + "<" + strings_join(parts,",") + ">";
    }
    leave(c);
    return name;
}
fn type_list(c: Context, end: String) -> List<String> effects { state, io, process } {
    let items = list_new<String>();
    var more = !at(c, end);
    while more {
        list_push(items, parse_type(c));
        more = accept(c,",") && !at(c, end);
    }
    let close = expect(c, end);
    return items;
}
fn generic_call_ahead(c: Context) -> Bool effects { state } {
    if !at(c, "<") {
        return false;
    }
    var i = list_get(c.control, 0).cursor;
    var depth = 0;
    while i < list_len(c.tokens) {
        let t = list_get(c.tokens, i);
        if t.kind == 54 {
            return false;
        }
        if t.text == "<" {
            depth = depth + 1;
        } else if t.text == ">" {
            depth = depth - 1;
            if depth == 0 {
                return list_get(c.tokens, i + 1).text == "("|| list_get(c.tokens, i + 1).text =="::";
            }
        } else if t.kind != 50 && t.text !="," && t.text !="::" {
            return false;
        }
        i = i + 1;
    }
    return false;
}
fn expressions(c: Context) -> List<SyntaxArgument> effects { state, io, process } {
    let items = list_new<SyntaxArgument>();
    var more = !at(c,")");
    while more {
        var label = "";
        if current(c).kind == 50 && list_get(c.tokens, list_get(c.control, 0).cursor + 1).text ==":" {
            label = identifier(c).text;
            let colon = expect(c,":");
        }
        let value = expression(c, 0);
        list_push(items, SyntaxArgument(label: label, value: value));
        more = accept(c,",") && !at(c,")");
    }
    let close = expect(c,")");
    return items;
}
fn expression(c: Context, minimum: Int) -> AstExprId effects { state, io, process } {
    let t = take(c);
    enter(c, t.span);
    var n = syntax_expression(0, t.span, t.text);
    var left = no_ast_expr();
    if t.kind == 51 {
        n.kind = 1;
    } else if t.kind == 57 {
        n.kind = 12;
    } else if t.kind == 56 {
        left = parse_interpolation(c, t);
    } else if t.kind == 52 {
        n.kind = 3;
    } else if t.kind == 50 && (t.text == "true" || t.text == "false") {
        n.kind = 2;
    } else if t.kind == 53 && (t.text == "-"|| t.text == "!") {
        n.kind = 5;
        n.left = expression(c, 7);
        n.span = through_previous(c, t.span.start);
    } else if t.kind == 53 && t.text == "(" {
        left = expression(c, 0);
        let close = expect(c,")");
    } else if t.kind == 50 && t.text == "match" {
        n.kind = 9;
        n.left = expression(c, 0);
        n.arms = parse_arms(c, true);
        n.span = through_previous(c, t.span.start);
    } else if t.kind == 50 && !keyword(t.text) {
        n.kind = 4;
        var path = n.text;
        var reading = true;
        while reading {
            if generic_call_ahead(c) {
                let open = expect(c, "<");
                n.type_arguments = type_list(c, ">");
            }
            if accept(c,"::") {
                if list_len(n.type_arguments) > 0 {
                    path = path + "<" + join_text(n.type_arguments,",") + ">";
                    n.type_arguments = list_new<String>();
                }
                n.qualifier = path;
                n.text = identifier(c).text;
                path = path +"::"+ n.text;
            } else {
                reading = false;
            }
        }
        n.span = through_previous(c, t.span.start);
        left = add_ast_expr(c, n);
        if generic_call_ahead(c) {
            let open = expect(c, "<");
            n.type_arguments = type_list(c, ">");
        }
        if accept(c,"(") {
            n.kind = 7;
            n.left = left;
            n.arguments = expressions(c);
            n.span = through_previous(c, t.span.start);
            left = add_ast_expr(c, n);
        }
    } else {
        bad(c, "E100", "Expected an expression.", t.span);
    }
    if !has_ast_expr(left) {
        left = add_ast_expr(c, n);
    }
    while at(c,".") || at(c,"?") {
        if accept(c,"?") {
            var propagation = syntax_expression(10, through_previous(c, ast_expr(c, left).span.start),"?");
            propagation.left = left;
            left = add_ast_expr(c, propagation);
        } else {
            let dot = expect(c,".");
            let field = identifier(c);
            var access = syntax_expression(8, Span(start: ast_expr(c, left).span.start, end: field.span.end), field.text);
            access.left = left;
            left = add_ast_expr(c, access);
        }
    }
    while current(c).kind == 53 && precedence(current(c).text) >= minimum {
        let op = take(c);
        let right = expression(c, precedence(op.text) + 1);
        var binary = syntax_expression(6, Span(start: ast_expr(c, left).span.start, end: ast_expr(c, right).span.end), op.text);
        binary.left = left;
        binary.right = right;
        left = add_ast_expr(c, binary);
    }
    leave(c);
    return left;
}
fn name_fields(c: Context, end: String) -> List<SyntaxField> effects { state, io, process } {
    let items = list_new<SyntaxField>();
    var more = !at(c, end);
    while more {
        let name = identifier(c);
        let colon = expect(c,":");
        let annotation = parse_type(c);
        list_push(items, SyntaxField(name: name.text, annotation: annotation, span: through_previous(c, name.span.start)));
        more = accept(c,",") && !at(c, end);
    }
    let close = expect(c, end);
    return items;
}
fn block(c: Context) -> List<AstStmtId> effects { state, io, process } {
    let open = expect(c, "{");
    enter(c, open.span);
    let body = list_new<AstStmtId>();
    while !at(c, "}") {
        list_push(body, statement(c));
    }
    let close = expect(c, "}");
    leave(c);
    return body;
}
fn statement(c: Context) -> AstStmtId effects { state, io, process } {
    let start = current(c).span;
    enter(c, start);
    var n = syntax_statement(0, start);
    if at(c, "let") || at(c, "var") {
        n.mutable = take(c).text == "var";
        n.kind = 30;
        n.name = identifier(c).text;
        if accept(c,":") {
            n.annotation = parse_type(c);
        }
        let equal = expect(c, "=");
        n.value = expression(c, 0);
        let semi = expect(c,";");
    } else if accept(c, "return") {
        n.kind = 32;
        if !at(c,";") {
            n.value = expression(c, 0);
        }
        let semi = expect(c,";");
    } else if accept(c, "if") {
        n.kind = 34;
        n.value = expression(c, 0);
        n.yes = block(c);
        if accept(c, "else") {
            if at(c, "if") {
                list_push(n.no, statement(c));
            } else {
                n.no = block(c);
            }
        }
    } else if at(c, "break") || at(c, "continue") {
        n.kind = 39;
        if take(c).text == "continue" {
            n.kind = 40;
        }
        let semi = expect(c,";");
    } else if accept(c, "for") {
        n.kind = 41;
        n.name = identifier(c).text;
        let in_token = expect(c, "in");
        n.value = expression(c, 0);
        if at(c, "..") || at(c, "..=") {
            n.mode = 1;
            if take(c).text == "..=" {
                n.mode = 2;
            }
            n.target = expression(c, 0);
        }
        n.yes = block(c);
    } else if accept(c, "while") {
        n.kind = 35;
        n.value = expression(c, 0);
        n.yes = block(c);
    } else if accept(c, "match") {
        n.kind = 36;
        n.value = expression(c, 0);
        n.arms = parse_arms(c, false);
    } else if current(c).kind == 50 && list_get(c.tokens, list_get(c.control, 0).cursor + 1).text == "=" {
        n.kind = 31;
        n.name = identifier(c).text;
        let equal = expect(c, "=");
        n.value = expression(c, 0);
        let semi = expect(c,";");
    } else {
        let value = expression(c, 0);
        if accept(c, "=") {
            n.kind = 38;
            n.target = value;
            n.value = expression(c, 0);
        } else {
            n.kind = 33;
            n.value = value;
        }
        let semi = expect(c,";");
    }
    n.span = through_previous(c, start.start);
    leave(c);
    return add_ast_stmt(c, n);
}
fn effect_bit(name: String) -> Int {
    if name == "io" {
        return 1;
    }
    if name == "args" {
        return 2;
    }
    if name == "state" {
        return 4;
    }
    if name == "process" {
        return 8;
    }
    return 0;
}
fn has_bit(mask: Int, bit: Int) -> Bool {
    return mask / bit % 2 == 1;
}
fn parse_module(c: Context) -> Unit effects { state, io, process } {
    let declared = dict_new<Int, Bool>();
    while current(c).kind != 54 {
        let start = current(c).span.start;
        let owner = source_unit_at(c, start);
        if at(c, "import") {
            if dict_has(declared, owner) {
                bad(c, "E221", "Imports must precede declarations.", current(c).span);
            }
            let spec = parse_import(c);
            continue;
        }
        dict_set(declared, owner, true);
        let exported = accept(c, "pub");
        if at(c, "enum") || at(c, "struct") || at(c, "type") {
            let word = take(c).text;
            let name = identifier(c);
            declare_module_name(c, name.text, exported, name.span);
            var decl = SyntaxType(type_parameters: parse_type_parameters(c), kind: 70, name: name.text, base: "", fields: list_new<SyntaxField>(), variants: list_new<SyntaxVariant>(), span: name.span);
            if word == "enum" {
                let open = expect(c, "{");
                var more = !at(c, "}");
                while more {
                    let v = identifier(c);
                    var fields = list_new<String>();
                    if accept(c,"(") {
                        fields = type_list(c,")");
                    }
                    list_push(decl.variants, SyntaxVariant(name: v.text, fields: fields, span: through_previous(c, v.span.start)));
                    more = accept(c,",") && !at(c, "}");
                }
                let close = expect(c, "}");
            } else if word == "struct" {
                decl.kind = 76;
                let open = expect(c, "{");
                decl.fields = name_fields(c, "}");
            } else {
                decl.kind = 77;
                let equal = expect(c, "=");
                let distinct_token = expect(c, "distinct");
                decl.base = parse_type(c);
                let semi = expect(c,";");
            }
            var declaration_start = start;
            if word != "enum" {
                declaration_start = name.span.start;
            }
            decl.span = through_previous(c, declaration_start);
            list_push(c.syntax_types, decl);
        } else if accept(c, "extern") {
            let library = take(c);
            if library.kind != 52 || !foreign_library_name(library.text) {
                bad(c, "E228", "extern requires an ASCII DLL basename (1..128 bytes).", library.span);
            }
            let keyword = expect(c, "fn");
            let name = identifier(c);
            if name.text == "main" || name.text == "vela_ffi_abi_version" {
                bad(c, "E228", "Reserved foreign function name.", name.span);
            }
            declare_module_name(c, name.text, exported, name.span);
            if at(c, "<") { bad(c, "E228", "Foreign functions cannot be generic.", current(c).span); }
            let open = expect(c, "(");
            let params = name_fields(c, ")");
            let arrow = expect(c, "->");
            let return_name = parse_type(c);
            let mask = parse_test_effects(c);
            if !at(c, ";") { bad(c, "E228", "Foreign declarations end with ';' and have no contracts or body.", current(c).span); }
            let semi = expect(c, ";");
            list_push(c.syntax_functions, SyntaxFunction(foreign_library: library.text, foreign_name: name.text, test_name: "", type_parameters: list_new<TypeParameter>(), name: name.text, parameters: params, return_name: return_name, effect_mask: mask, preconditions: list_new<AstExprId>(), postconditions: list_new<AstExprId>(), body: list_new<AstStmtId>(), span: through_previous(c, start)));
        } else if accept(c, "fn") {
            let name = identifier(c);
            declare_module_name(c, name.text, exported, name.span);
            let type_parameters = parse_type_parameters(c);
            let open = expect(c,"(");
            let params = name_fields(c,")");
            let arrow = expect(c, "->");
            let return_name = parse_type(c);
            var mask = 0;
            if accept(c, "effects") {
                let opening = expect(c, "{");
                var more = !at(c, "}");
                while more {
                    let e = identifier(c);
                    let bit = effect_bit(e.text);
                    if bit == 0 {
                        bad(c, "E206", "Unknown effect.", e.span);
                    }
                    if has_bit(mask, bit) {
                        bad(c, "E100", "Duplicate effect.", e.span);
                    }
                    mask = mask + bit;
                    more = accept(c,",") && !at(c, "}");
                }
                let close = expect(c, "}");
            }
            let pre = list_new<AstExprId>();
            let post = list_new<AstExprId>();
            while at(c, "requires") || at(c, "ensures") {
                let word = take(c).text;
                let value = expression(c, 0);
                let semi = expect(c,";");
                if word == "requires" {
                    list_push(pre, value);
                } else {
                    list_push(post, value);
                }
            }
            let body = block(c);
            list_push(c.syntax_functions, SyntaxFunction(foreign_library: "", foreign_name: "", test_name: "", type_parameters: type_parameters, name: name.text, parameters: params, return_name: return_name, effect_mask: mask, preconditions: pre, postconditions: post, body: body, span: through_previous(c, start)));
        } else if accept(c, "test") {
            let name = take(c);
            if exported || name.kind != 52 || str_len(name.text) == 0 || str_len(name.text) > 256 || contains_byte(name.text, 0) {
                bad(c, "E227", "test requires a private, nonempty string name of at most 256 bytes without NUL.", name.span);
            }
            var count = 0;
            for previous in c.syntax_functions {
                if previous.test_name != ""&& source_unit_at(c, previous.span.start) == owner {
                    count = count + 1;
                    if previous.test_name == name.text {
                        bad(c, "E227", "Duplicate test name.", name.span);
                    }
                }
            }
            if count >= 256 {
                bad(c, "E227", "At most 256 tests per module.", name.span);
            }
            let internal = "@test" + to_string(list_len(c.syntax_functions));
            declare_module_name(c, internal, false, name.span);
            let mask = parse_test_effects(c);
            let body = block(c);
            list_push(c.syntax_functions, SyntaxFunction(foreign_library: "", foreign_name: "", test_name: name.text, type_parameters: list_new<TypeParameter>(), name: internal, parameters: list_new<SyntaxField>(), return_name: "Unit", effect_mask: mask, preconditions: list_new<AstExprId>(), postconditions: list_new<AstExprId>(), body: body, span: through_previous(c, start)));
        } else {
            bad(c, "E100", "Expected fn, enum, struct, type or test.", current(c).span);
        }
    }
}
fn parse_test_effects(c: Context) -> Int effects { state, io, process } {
    var mask = 0;
    if accept(c, "effects") {
        let opening = expect(c, "{");
        var more = !at(c, "}");
        while more {
            let e = identifier(c);
            let bit = effect_bit(e.text);
            if bit == 0 {
                bad(c, "E206", "Unknown effect.", e.span);
            }
            if has_bit(mask, bit) {
                bad(c, "E100", "Duplicate effect.", e.span);
            }
            mask = mask + bit;
            more = accept(c,",") && !at(c, "}");
        }
        let close = expect(c, "}");
    }
    return mask;
}
fn foreign_library_name(name: String) -> Bool {
    let n = str_len(name);
    if n < 5 || n > 128 || str_slice(name, n - 4, n) != ".dll" { return false; }
    for i in 0 .. n - 4 {
        let b = str_byte(name, i);
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 95 || b == 45) { return false; }
    }
    return true;
}
fn parse_type_parameters(c: Context) -> List<TypeParameter> effects { state, io, process } {
    let items = list_new<TypeParameter>();
    if accept(c, "<") {
        var more = true;
        while more {
            let name = identifier(c);
            var bound = "Any";
            if accept(c,":") {
                bound = identifier(c).text;
            }
            list_push(items, TypeParameter(name: name.text, bound: bound, span: name.span));
            more = accept(c,",");
        }
        let close = expect(c, ">");
    }
    return items;
}
fn parse_arms(c: Context, value_mode: Bool) -> List<SyntaxArm> effects { state, io, process } {
    let arms = list_new<SyntaxArm>();
    let open = expect(c, "{");
    while !at(c, "}") {
        let owner = identifier(c);
        let sep = expect(c,"::");
        var owner_name = owner.text;
        var variant = identifier(c);
        while accept(c,"::") {
            owner_name = owner_name +"::"+ variant.text;
            variant = identifier(c);
        }
        let names = list_new<SyntaxName>();
        if accept(c,"(") {
            var more = !at(c,")");
            while more {
                let name = identifier(c);
                list_push(names, SyntaxName(name: name.text, span: name.span));
                more = accept(c,",") && !at(c,")");
            }
            let close = expect(c,")");
        }
        let arrow = expect(c, "=>");
        var body = list_new<AstStmtId>();
        var value = no_ast_expr();
        if value_mode {
            value = expression(c, 0);
        } else {
            body = block(c);
        }
        list_push(arms, SyntaxArm(value: value, owner: owner_name, variant: variant.text, names: names, body: body, span: through_previous(c, owner.span.start)));
        let comma = accept(c,",");
        if value_mode && !comma && !at(c, "}") {
            bad(c, "E100", "Expected comma between expression arms.", current(c).span);
        }
    }
    let close = expect(c, "}");
    return arms;
}
fn interpolation_literal(c: Context, parts: List<SyntaxArgument>, text: String, start: Int, end: Int) -> Unit effects { state } {
    list_push(parts, SyntaxArgument(label: "", value: add_ast_expr(c, syntax_expression(3, Span(start: start, end: end), text))));
}
fn interpolation_hole(c: Context, start: Int, end: Int) -> SyntaxArgument effects { state, io, process } {
    var inner = c;
    inner.tokens = list_new<Token>();
    inner.comments = list_new<Token>();
    inner.control = list_new<Control>();
    var ctl = list_get(c.control, 0);
    ctl.cursor = 0;
    ctl.previous_end = start;
    list_push(inner.control, ctl);
    lex_range(inner, start, end);
    let value = expression(inner, 0);
    let colon = expect(inner,":");
    let format = identifier(inner);
    if current(inner).kind != 54 {
        bad(inner, "E100", "Unexpected token after interpolation format.", current(inner).span);
    }
    return SyntaxArgument(label: format.text, value: value);
}
fn parse_interpolation(c: Context, token: Token) -> AstExprId effects { state, io, process } {
    var n = syntax_expression(11, token.span, "");
    let s = c.source_text;
    var i = token.span.start + 2;
    var start = i;
    let literal = strings_new();
    while i + 1 < token.span.end {
        var b = str_byte(s, i);
        if b == 92 {
            i = i + 1;
            b = str_byte(s, i);
            if b == 110 {
                b = 10;
            } else if b == 114 {
                b = 13;
            } else if b == 116 {
                b = 9;
            } else if b == 48 {
                b = 0;
            } else if b != 34 && b != 92 {
                fail(c, "E001", "Unknown string escape.", i - 1, i + 1);
            }
            strings_push(literal, str_from_byte(b));
            i = i + 1;
        } else if (b == 123 || b == 125) && str_byte(s, i + 1) == b {
            strings_push(literal, str_from_byte(b));
            i = i + 2;
        } else if b == 123 {
            interpolation_literal(c, n.arguments, strings_join(literal, ""), start, i);
            strings_truncate(literal, 0);
            let end = interpolation_hole_end(c, i + 1);
            list_push(n.arguments, interpolation_hole(c, i + 1, end));
            i = end + 1;
            start = i;
        } else {
            strings_push(literal, str_from_byte(b));
            i = i + 1;
        }
    }
    interpolation_literal(c, n.arguments, strings_join(literal, ""), start, i);
    return add_ast_expr(c, n);
}


// Source graph and binding. Syntax remains immutable; declarations are bound separately.
fn parse_import(c: Context) -> ImportSpec effects { state, io, process } {
    let start = expect(c, "import").span.start;
    let path = take(c);
    if path.kind != 52 || path.text == ""|| contains_byte(path.text, 0) || contains_byte(path.text, 10) || contains_byte(path.text, 13) {
        bad(c, "E221", "Import requires a nonempty file path.", path.span);
    }
    if str_byte(path.text, 0) == 47 || str_byte(path.text, 0) == 92 || contains_byte(path.text, 58) {
        bad(c, "E221", "Import path must be relative.", path.span);
    }
    var alias = "";
    if accept(c, "as") {
        alias = identifier(c).text;
    }
    let end = expect(c,";");
    return ImportSpec(path: path.text, alias: alias, span: Span(start: start, end: end.span.end));
}
fn collect_module(units: List<SourceUnit>, imports: List<ModuleImport>, path: String, name: String, code: String, identity: String, json_mode: Bool, depth: Int, dependencies: List<ProjectDependency>) -> Int effects { state, io, process } {
    for i in 0 .. list_len(units) {
        if identity != ""&& list_get(units, i).identity == identity {
            return i;
        }
    }
    let local = make_context(code, name, json_mode);
    if list_len(units) >= 256 || depth >= 128 {
        bad(local, "E221", "Module graph limit exceeded.", empty_span());
    }
    var start = 0;
    var line_base = 0;
    for unit in units {
        start = unit.end + 1;
        for i in 0 .. str_len(unit.code) {
            if str_byte(unit.code, i) == 10 {
                line_base = line_base + 1;
            }
        }
        line_base = line_base + 1;
    }
    if start + str_len(code) > 16777216 {
        bad(local, "E221", "Module graph exceeds 16 MiB.", empty_span());
    }
    let owner = list_len(units);
    list_push(units, SourceUnit(path: path, name: name, identity: identity, code: code, start: start, end: start + str_len(code), line_base: line_base));
    lex(local);
    while at(local, "import") {
        let spec = parse_import(local);
        for previous in imports {
            if spec.alias != ""&& previous.owner == owner && previous.alias == spec.alias {
                bad(local, "E222", "Duplicate import alias.", spec.span);
            }
        }
        var imported_path = io_value(absolute_path(parent_path(path) + "/" + spec.path));
        if str_byte(spec.path, 0) == 64 {
            imported_path = "";
            for dep in dependencies {
                if spec.path == "@" + dep.alias {
                    imported_path = dep.path;
                }
            }
            if imported_path == "" {
                bad(local, "E221", "Unknown project dependency: " + spec.path, spec.span);
            }
        }
        var imported_code = "";
        match source_text_result(imported_path) {
            Result::Ok(text) => {
                imported_code = text;
            }
            Result::Err(message) => {
                bad(local, "E221", "Cannot import " + spec.path + ": " + message, spec.span);
            }
        }
        let target_identity = io_value(file_identity(imported_path));
        // Register the edge before recursion so aliases are checked through cycles.
        let edge = list_len(imports);
        let span = Span(start: start + spec.span.start, end: start + spec.span.end);
        list_push(imports, ModuleImport(owner: owner, target: -1, alias: spec.alias, span: span));
        let target = collect_module(units, imports, imported_path, imported_path, imported_code, target_identity, json_mode, depth + 1, dependencies);
        list_set(imports, edge, ModuleImport(owner: owner, target: target, alias: spec.alias, span: span));
    }
    return owner;
}
fn module_context(path: String, name: String, code: String, json_mode: Bool) -> Context effects { state, io, process } {
    return project_module_context(path, name, code, json_mode, list_new<ProjectDependency>());
}
fn project_module_context(path: String, name: String, code: String, json_mode: Bool, dependencies: List<ProjectDependency>) -> Context effects { state, io, process } {
    let units = list_new<SourceUnit>();
    let imports = list_new<ModuleImport>();
    let entry = collect_module(units, imports, path, name, code, io_value(file_identity(path)), json_mode, 0, dependencies);
    let parts = strings_new();
    for unit in units {
        strings_push(parts, unit.code + "\n");
    }
    var c = make_context(strings_join(parts, ""), name, json_mode);
    c.source_units = units;
    c.imports = imports;
    return c;
}
fn parse_program(c: Context) -> Unit effects { state, io, process } {
    for unit in c.source_units {
        var local = c;
        local.tokens = list_new<Token>();
        local.comments = list_new<Token>();
        local.control = list_new<Control>();
        var control = list_get(c.control, 0);
        control.cursor = 0;
        control.previous_end = unit.start;
        list_push(local.control, control);
        lex_range(local, unit.start, unit.end);
        parse_module(local);
    }
}
fn module_canonical(owner: Int, name: String) -> String {
    if owner == 0 {
        return name;
    }
    return "@" + to_string(owner) +"::"+ name;
}
fn declare_module_name(c: Context, name: String, exported: Bool, span: Span) -> Unit effects { state, io, process } {
    let owner = source_unit_at(c, span.start);
    list_push(c.declarations, ModuleDeclaration(owner: owner, name: name, canonical: module_canonical(owner, name), exported: exported, span: span));
}
fn module_declaration(c: Context, owner: Int, name: String) -> Int effects { state } {
    for i in 0 .. list_len(c.declarations) {
        let d = list_get(c.declarations, i);
        if d.owner == owner && d.name == name {
            return i;
        }
    }
    return -1;
}
fn module_alias(c: Context, name: String, span: Span) -> Int effects { state } {
    let owner = source_unit_at(c, span.start);
    for edge in c.imports {
        if edge.owner == owner && edge.alias == name && name != "" {
            return edge.target;
        }
    }
    return -1;
}
fn module_global_name(c: Context, name: String, span: Span) -> String effects { state, io, process } {
    if name == "" {
        return name;
    }
    if str_byte(name, 0) == 64 {
        return name;
    }
    let owner = source_unit_at(c, span.start);
    for i in 0 .. str_len(name) - 1 {
        if str_byte(name, i) == 58 && str_byte(name, i + 1) == 58 {
            let alias = str_slice(name, 0, i);
            let target = module_alias(c, alias, span);
            if target < 0 {
                bad(c, "E222", "Unknown module alias: " + alias, span);
            }
            let index = module_declaration(c, target, str_slice(name, i + 2, str_len(name)));
            if index < 0 {
                bad(c, "E222", "Unknown module member: " + name, span);
            }
            let d = list_get(c.declarations, index);
            if !d.exported {
                bad(c, "E223", "Private module member: " + name, span);
            }
            return d.canonical;
        }
    }
    let own = module_declaration(c, owner, name);
    if own >= 0 {
        return list_get(c.declarations, own).canonical;
    }
    var found = "";
    for edge in c.imports {
        if edge.owner == owner && edge.alias == "" {
            let index = module_declaration(c, edge.target, name);
            if index >= 0 {
                let d = list_get(c.declarations, index);
                if d.exported {
                    if found != ""&& found != d.canonical {
                        bad(c, "E222", "Ambiguous imported name: " + name, span);
                    }
                    found = d.canonical;
                }
            }
        }
    }
    if found != "" {
        return found;
    }
    if name == "List" || name == "Dict" || name == "Option" || name == "Result" {
        return name;
    }
    let builtin_type = find_type(c, name);
    if has_type(builtin_type) && type_info(c, builtin_type).span.end == 0 {
        return name;
    }
    let builtin_function = find_symbol(c, c.signatures, name);
    if has_symbol(builtin_function) && symbol_info(c, builtin_function).builtin {
        return name;
    }
    return module_canonical(owner, name);
}
fn module_type_name(c: Context, name: String, parameters: List<TypeParameter>, span: Span, public_api: Bool) -> String effects { state, io, process } {
    if name == "" {
        return name;
    }
    for parameter in parameters {
        if parameter.name == name {
            return name;
        }
    }
    let parts = type_parts(name);
    let base = module_global_name(c, list_get(parts, 0), span);
    if public_api {
        for d in c.declarations {
            if d.canonical == base && !d.exported {
                bad(c, "E224", "Public API exposes private type: " + name, span);
            }
        }
    }
    if list_len(parts) == 1 {
        return base;
    }
    let args = list_new<String>();
    for i in 1 .. list_len(parts) {
        list_push(args, module_type_name(c, list_get(parts, i), parameters, span, public_api));
    }
    return base + "<" + join_text(args,",") + ">";
}
fn bind_modules(c: Context) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(c.declarations) {
        let d = list_get(c.declarations, i);
        for j in 0 .. i {
            let previous = list_get(c.declarations, j);
            if previous.owner == d.owner && previous.name == d.name {
                duplicate(c, "Duplicate declaration '" + d.name + "'.", d.span, previous.span);
            }
        }
        if has_type(find_type(c, d.name)) || has_symbol(find_symbol(c, c.signatures, d.name)) || d.name == "List" || d.name == "Dict" {
            bad(c, "E202", "Reserved declaration: " + d.name, d.span);
        }
        if module_alias(c, d.name, d.span) >= 0 {
            bad(c, "E222", "Declaration conflicts with import alias.", d.span);
        }
    }
    for syntax in c.syntax_types {
        let owner = source_unit_at(c, syntax.span.start);
        let d = list_get(c.declarations, module_declaration(c, owner, syntax.name));
        var bound = syntax;
        bound.name = d.canonical;
        bound.base = module_type_name(c, syntax.base, syntax.type_parameters, syntax.span, d.exported);
        bound.fields = list_new<SyntaxField>();
        for field in syntax.fields {
            var f = field;
            f.annotation = module_type_name(c, field.annotation, syntax.type_parameters, field.span, d.exported);
            list_push(bound.fields, f);
        }
        bound.variants = list_new<SyntaxVariant>();
        for variant in syntax.variants {
            var v = variant;
            v.fields = list_new<String>();
            for field in variant.fields {
                list_push(v.fields, module_type_name(c, field, syntax.type_parameters, variant.span, d.exported));
            }
            list_push(bound.variants, v);
        }
        list_push(c.bound_types, bound);
    }
    for syntax in c.syntax_functions {
        let owner = source_unit_at(c, syntax.span.start);
        let d = list_get(c.declarations, module_declaration(c, owner, syntax.name));
        var bound = syntax;
        bound.name = d.canonical;
        bound.return_name = module_type_name(c, syntax.return_name, syntax.type_parameters, syntax.span, d.exported);
        bound.parameters = list_new<SyntaxField>();
        for parameter in syntax.parameters {
            var p = parameter;
            p.annotation = module_type_name(c, parameter.annotation, syntax.type_parameters, parameter.span, d.exported);
            list_push(bound.parameters, p);
        }
        list_push(c.bound_functions, bound);
    }
}


struct NativeDependency {
    name: String,
    path: String,
    relative: String
}
struct Project {
    manifest: String,
    text: String,
    name: String,
    entry: String,
    dependencies: List<ProjectDependency>,
    natives: List<NativeDependency>,
    tests: List<String>
}
fn project_split(text: String, separator: Int) -> List<String> effects { state } {
    let parts = list_new<String>();
    var start = 0;
    for i in 0 .. str_len(text) {
        if str_byte(text, i) == separator {
            list_push(parts, str_slice(text, start, i));
            start = i + 1;
        }
    }
    list_push(parts, str_slice(text, start, str_len(text)));
    return parts;
}
fn project_identifier(text: String) -> Bool {
    if text == "" {
        return false;
    }
    for i in 0 .. str_len(text) {
        let b = str_byte(text, i);
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95 || i > 0 && b >= 48 && b <= 57) {
            return false;
        }
    }
    return true;
}
fn project_fail(path: String, code: String, message: String, json_mode: Bool) -> Unit effects { state, io, process } {
    bad(make_context("", path, json_mode), code, message, empty_span());
}
fn project_relative(path: String, owned: Bool) -> Bool effects { state } {
    if path == "" {
        return false;
    }
    if str_byte(path, 0) == 47 || str_byte(path, 0) == 92 {
        return false;
    }
    for i in 0 .. str_len(path) {
        let b = str_byte(path, i);
        if b < 32 || b == 58 || b == 92 {
            return false;
        }
    }
    if owned {
        for part in project_split(path, 47) {
            if part == ".." {
                return false;
            }
        }
    }
    return true;
}
fn project_is_manifest(path: String) -> Bool {
    let n = str_len(path);
    return n >= 6 && str_slice(path, n - 6, n) == ".vproj" || n >= 12 && str_slice(path, n - 12, n) == "vela.project" && (n == 12 || str_byte(path, n - 13) == 47 || str_byte(path, n - 13) == 92);
}
fn project_load(input: String, json_mode: Bool) -> Project effects { state, io, process } {
    var p = Project(manifest: "", text: "", name: "", entry: input, dependencies: list_new<ProjectDependency>(), natives: list_new<NativeDependency>(), tests: list_new<String>());
    if !project_is_manifest(input) {
        return p;
    }
    p.manifest = input;
    p.text = load_source(input, json_mode);
    p.entry = "";
    if str_len(p.text) > 1048576 {
        project_fail(input, "E225", "Manifest exceeds 1 MiB.", json_mode);
    }
    var header = false;
    for line in project_split(p.text, 10) {
        if line != ""&& str_byte(line, 0) != 35 {
            let fields = project_split(line, 124);
            let kind = list_get(fields, 0);
            if !header {
                if line != "vela-project|1" {
                    project_fail(input, "E225", "Expected vela-project|1.", json_mode);
                }
                header = true;
            } else if kind == "name" && list_len(fields) == 2 && p.name == "" {
                p.name = list_get(fields, 1);
                if !project_identifier(p.name) {
                    project_fail(input, "E225", "Invalid project name.", json_mode);
                }
            } else if kind == "entry" && list_len(fields) == 2 && p.entry == "" {
                let path = list_get(fields, 1);
                if !project_relative(path, true) {
                    project_fail(input, "E225", "Invalid entry path.", json_mode);
                }
                p.entry = io_value(absolute_path(parent_path(input) + "/" + path));
            } else if kind == "dep" && list_len(fields) == 3 {
                let alias = list_get(fields, 1);
                let path = list_get(fields, 2);
                if !project_identifier(alias) || !project_relative(path, false) || list_len(p.dependencies) >= 128 {
                    project_fail(input, "E225", "Invalid dependency.", json_mode);
                }
                for dep in p.dependencies {
                    if dep.alias == alias {
                        project_fail(input, "E225", "Duplicate dependency alias.", json_mode);
                    }
                }
                list_push(p.dependencies, ProjectDependency(alias: alias, path: io_value(absolute_path(parent_path(input) + "/" + path)), relative: path));
            } else if kind == "native" && list_len(fields) == 3 {
                let name = list_get(fields, 1);
                let path = list_get(fields, 2);
                if !foreign_library_name(name) || !project_relative(path, false) || list_len(p.natives) >= 128 {
                    project_fail(input, "E225", "Invalid native dependency.", json_mode);
                }
                for previous in p.natives {
                    if path_key(previous.name) == path_key(name) { project_fail(input, "E225", "Duplicate native library.", json_mode); }
                }
                list_push(p.natives, NativeDependency(name: name, path: io_value(absolute_path(parent_path(input) + "/" + path)), relative: path));
            } else if kind == "test" && list_len(fields) == 2 {
                let path = list_get(fields, 1);
                if !project_relative(path, true) || list_len(p.tests) >= 128 {
                    project_fail(input, "E225", "Invalid test path.", json_mode);
                }
                let absolute = io_value(absolute_path(parent_path(input) + "/" + path));
                for previous in p.tests {
                    if path_key(previous) == path_key(absolute) {
                        project_fail(input, "E225", "Duplicate test.", json_mode);
                    }
                }
                list_push(p.tests, absolute);
            } else {
                project_fail(input, "E225", "Unknown, duplicate or malformed manifest field: " + kind, json_mode);
            }
        }
    }
    if !header || p.name == ""|| p.entry == "" {
        project_fail(input, "E225", "Manifest requires header, name and entry.", json_mode);
    }
    return p;
}
fn project_lock_text(p: Project, json_mode: Bool) -> String effects { state, io, process } {
    let lines = strings_new();
    strings_push(lines, "vela-lock|1\nmanifest|" + sha256(p.text) + "\n");
    for dep in p.dependencies {
        let c = project_module_context(dep.path, dep.path, load_source(dep.path, json_mode), json_mode, p.dependencies);
        let graph = strings_new();
        for unit in c.source_units {
            strings_push(graph, sha256(unit.code) + "\n");
        }
        for edge in c.imports {
            strings_push(graph, to_string(edge.owner) + "|" + to_string(edge.target) + "|" + edge.alias + "\n");
        }
        strings_push(lines, "dep|" + dep.alias + "|" + dep.relative + "|" + sha256(strings_join(graph, "")) + "\n");
    }
    for native in p.natives {
        strings_push(lines, "native|" + native.name + "|" + native.relative + "|" + sha256(io_value(read_file(native.path))) + "\n");
    }
    return strings_join(lines, "");
}
fn project_verify_lock(p: Project, json_mode: Bool) -> Unit effects { state, io, process } {
    if list_len(p.dependencies) == 0 && list_len(p.natives) == 0 {
        return;
    }
    let expected = project_lock_text(p, json_mode);
    match source_text_result(p.manifest + ".lock") {
        Result::Ok(actual) => {
            if actual == expected {
                return;
            }
        }
        Result::Err(_) => {}
    }
    project_fail(p.manifest, "E226", "Missing or stale lock; run vela lock PROJECT after reviewing dependencies.", json_mode);
}
fn project_write_lock(p: Project, json_mode: Bool) -> Int effects { state, io, process } {
    if p.manifest == "" {
        project_fail(p.entry, "E225", "lock requires a project manifest.", json_mode);
    }
    let lock = p.manifest + ".lock";
    let identity = io_value(file_identity(lock));
    let c = project_module_context(p.entry, p.entry, load_source(p.entry, json_mode), json_mode, p.dependencies);
    for unit in c.source_units {
        if path_key(lock) == path_key(unit.path) || identity != ""&& identity == unit.identity {
            project_fail(lock, "E226", "Lock must not overwrite source.", json_mode);
        }
    }
    for dep in p.dependencies {
        let graph = project_module_context(dep.path, dep.path, load_source(dep.path, json_mode), json_mode, p.dependencies);
        for unit in graph.source_units {
            if path_key(lock) == path_key(unit.path) || identity != ""&& identity == unit.identity {
                project_fail(lock, "E226", "Lock must not overwrite dependency source.", json_mode);
            }
        }
    }
    for test in p.tests {
        if path_key(lock) == path_key(test) || identity != ""&& identity == io_value(file_identity(test)) {
            project_fail(lock, "E226", "Lock must not overwrite test source.", json_mode);
        }
    }
    if identity != ""&& identity == io_value(file_identity(p.manifest)) {
        project_fail(lock, "E226", "Lock must not overwrite manifest.", json_mode);
    }
    for native in p.natives {
        if path_key(lock) == path_key(native.path) || identity != "" && identity == io_value(file_identity(native.path)) {
            project_fail(lock, "E226", "Lock must not overwrite native input.", json_mode);
        }
    }
    write_atomic(lock, project_lock_text(p, json_mode));
    if json_mode {
        print("{\"schema_version\":1,\"ok\":true,\"lock\":" + json_string(lock) + "}");
    } else {
        print("Locked: " + p.manifest);
    }
    return 0;
}
fn stage_native(natives: List<NativeDependency>, directory: String) -> Result<Bool, String> effects { state, io, process } {
    // Preflight every destination before writing any companion.
    for native in natives {
        let destination = directory + "/" + native.name;
        let identity = from_string(file_identity(destination))?;
        let data = from_string(read_file(native.path))?;
        if identity != "" {
            if from_string(read_file(destination))? != data {
                return Result<Bool, String>::Err("Conflicting native output: " + destination);
            }
        }
    }
    for native in natives {
        let destination = directory + "/" + native.name;
        if from_string(file_identity(destination))? == "" {
            let saved = write_atomic_result(destination, from_string(read_file(native.path))?)?;
        }
    }
    return Result<Bool, String>::Ok(true);
}


fn capture_data(data: String) -> String effects { state } {
    if utf8_valid(data) {
        return data;
    }
    let parts = strings_new();
    let digits = "0123456789abcdef";
    for i in 0 .. str_len(data) {
        let b = str_byte(data, i);
        strings_push(parts, str_slice(digits, b / 16, b / 16 + 1));
        strings_push(parts, str_slice(digits, b % 16, b % 16 + 1));
    }
    return strings_join(parts, "");
}
fn capture_encoding(data: String) -> String {
    if utf8_valid(data) {
        return "utf8";
    }
    return "hex";
}
fn project_test(p: Project, json_mode: Bool) -> Int effects { state, io, process } {
    let paths = list_new<String>();
    if p.manifest == "" {
        list_push(paths, p.entry);
    } else {
        if list_len(p.tests) == 0 {
            project_fail(p.entry, "E225", "Project has no test entries.", json_mode);
        }
        for path in p.tests {
            list_push(paths, path);
        }
    }
    let reports = strings_new();
    var passed = 0;
    var failed = 0;
    var infrastructure = false;
    for path in paths {
        let c = project_module_context(path, path, load_source(path, json_mode), json_mode, p.dependencies);
        parse_program(c);
        analyze(c);
        let entries = list_new<SymbolId>();
        let names = list_new<String>();
        for declaration in c.bound_functions {
            if declaration.test_name != ""&& source_unit_at(c, declaration.span.start) == 0 {
                list_push(entries, find_symbol(c, c.signatures, declaration.name));
                list_push(names, declaration.test_name);
            }
        }
        if list_len(entries) == 0 {
            list_push(entries, find_symbol(c, c.signatures, "main"));
            list_push(names, "main");
        }
        for index in 0 .. list_len(entries) {
            let entry = list_get(entries, index);
            let name = list_get(names, index);
            let generated = generate_entry(c, entry);
            let dir = io_value(temp_dir(""));
            let exe = dir + "/test.exe";
            var exit_code = build_or_run_native(generated, exe, strings_new(), false, p.natives);
            var status = "build_error";
            var out = "";
            var err = "";
            if exit_code == 0 {
                let args = strings_new();
                strings_push(args, exe);
                match process_run_at(args, dir, dir + "/stdout", dir + "/stderr", 30000) {
                    ProcessResult::Exited(code) => {
                        exit_code = code;
                        status = "failed";
                        if code == 0 {
                            status = "passed";
                        }
                    }
                    ProcessResult::TimedOut => {
                        exit_code = 124;
                        status = "timeout";
                    }
                    ProcessResult::Err(message) => {
                        exit_code = 2;
                        err = message;
                    }
                }
                match read_file_bounded(dir + "/stdout", 4194304) {
                    ReadResult::Ok(data) => {
                        out = data;
                    }
                    ReadResult::Limit => {
                        status = "failed";
                        err = err + "stdout capture exceeds 4 MiB";
                    }
                    ReadResult::Err(_) => {}
                }
                match read_file_bounded(dir + "/stderr", 4194304) {
                    ReadResult::Ok(data) => {
                        err = err + data;
                    }
                    ReadResult::Limit => {
                        status = "failed";
                        err = err + "stderr capture exceeds 4 MiB";
                    }
                    ReadResult::Err(_) => {}
                }
            }
            if status == "build_error" {
                infrastructure = true;
            }
            ignored_write(remove_file(dir + "/stdout"));
            ignored_write(remove_file(dir + "/stderr"));
            ignored_write(remove_file(exe));
            for native in p.natives { ignored_write(remove_file(dir + "/" + native.name)); }
            var artifact = "";
            match remove_dir(dir) {
                WriteResult::Ok => {}
                WriteResult::Err(_) => {
                    artifact = dir;
                }
            }
            if status == "passed" {
                passed = passed + 1;
            } else {
                failed = failed + 1;
            }
            strings_push(reports, "{\"name\":" + json_string(name) + ",\"source\":" + json_string(path) + ",\"span\":" + span_json(c, symbol_info(c, entry).span) + ",\"status\":" + json_string(status) + ",\"exit_code\":" + to_string(exit_code) + ",\"stdout\":" + json_string(capture_data(out)) + ",\"stderr\":" + json_string(capture_data(err)) + ",\"stdout_encoding\":" + json_string(capture_encoding(out)) + ",\"stderr_encoding\":" + json_string(capture_encoding(err)) + ",\"artifact_dir\":" + json_string(artifact) + "}");
            if !json_mode {
                print(path + " [" + name + "]: " + status + " (exit " + to_string(exit_code) +")");
                if out != "" {
                    write_stdout(out);
                }
                if err != "" {
                    eprint(err);
                }
                if artifact != "" {
                    print("Artifacts: " + artifact);
                }
            }
        }
    }
    if json_mode {
        print("{\"schema_version\":2,\"ok\":" + to_string(failed == 0) + ",\"passed\":" + to_string(passed) + ",\"failed\":" + to_string(failed) + ",\"tests\":[" + strings_join(reports,",") + "]}");
    }
    if infrastructure {
        return 2;
    }
    if failed != 0 {
        return 1;
    }
    return 0;
}
fn project_format(p: Project, checking: Bool, writing: Bool, json_mode: Bool) -> Int effects { state, io, process } {
    if !checking && !writing {
        eprint("fmt PROJECT requires --check or --write.");
        return 2;
    }
    let excluded = list_new<String>();
    for dep in p.dependencies {
        let c = project_module_context(dep.path, dep.path, load_source(dep.path, json_mode), json_mode, p.dependencies);
        for unit in c.source_units {
            list_push(excluded, unit.identity);
        }
    }
    let entries = list_new<String>();
    list_push(entries, p.entry);
    for test in p.tests {
        list_push(entries, test);
    }
    let visited = list_new<String>();
    let root = path_key(parent_path(p.manifest));
    var status = 0;
    for entry in entries {
        let c = project_module_context(entry, entry, load_source(entry, json_mode), json_mode, p.dependencies);
        for unit in c.source_units {
            var selected = true;
            for id in excluded {
                if unit.identity == id {
                    selected = false;
                }
            }
            for id in visited {
                if unit.identity == id {
                    selected = false;
                }
            }
            let path = path_key(unit.path);
            if str_len(path) < str_len(root) || str_slice(path, 0, str_len(root)) != root {
                selected = false;
            }
            if selected {
                list_push(visited, unit.identity);
                let local = make_context(unit.code, unit.path, json_mode);
                lex(local);
                parse_module(local);
                let formatted = format_source(local);
                if io_value(read_file(unit.path)) != formatted {
                    if checking {
                        eprint("Needs formatting: " + unit.path);
                        status = 1;
                    } else {
                        write_atomic(unit.path, formatted);
                    }
                }
            }
        }
    }
    return status;
}


// Canonical semantic types and signatures; syntax never reaches the backend.
fn split_text(s: String, delimiter: Int) -> List<String> effects { state } {
    let parts = list_new<String>();
    var start = 0;
    var i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == delimiter {
            list_push(parts, str_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    list_push(parts, str_slice(s, start, i));
    return parts;
}
fn join_text(items: List<String>, separator: String) -> String effects { state } {
    let parts = strings_new();
    for i in 0 .. list_len(items) {
        strings_push(parts, list_get(items, i));
    }
    return strings_join(parts, separator);
}
fn find_type(c: Context, name: String) -> TypeId effects { state } {
    for i in 0 .. list_len(c.types) {
        if list_get(c.types, i).name == name {
            return primitive_type_id(i + 1);
        }
    }
    return no_type();
}
fn type_name(c: Context, id: TypeId) -> String effects { state, io, process } {
    return type_info(c, id).name;
}
fn type_kind(c: Context, id: TypeId) -> Int effects { state, io, process } {
    if !has_type(id) {
        return 0;
    }
    return type_info(c, id).kind;
}
fn scalar_type(c: Context, id: TypeId) -> TypeId effects { state, io, process } {
    if type_kind(c, id) == 77 {
        let t = type_info(c, id);
        if has_type(t.base) {
            return t.base;
        }
        return find_type(c, t.base_name);
    }
    return id;
}
fn is_scalar(id: TypeId) -> Bool {
    return id == int_type() || id == bool_type() || id == string_type() || id == float_type();
}
fn find_symbol(c: Context, items: List<SymbolId>, name: String) -> SymbolId effects { state, io, process } {
    for i in 0 .. list_len(items) {
        let id = list_get(items, i);
        if symbol_info(c, id).name == name {
            return id;
        }
    }
    return no_symbol();
}
fn require_type(c: Context, actual: TypeId, expected: TypeId, span: Span) -> Unit effects { state, io, process } {
    require_type_at(c, actual, expected, span, type_info(c, expected).span);
}
fn require_type_at(c: Context, actual: TypeId, expected: TypeId, span: Span, declaration: Span) -> Unit effects { state, io, process } {
    if actual != expected {
        var details = empty_details();
        details.expected_type = type_name(c, expected);
        details.actual_type = type_name(c, actual);
        if declaration.end > declaration.start {
            list_push(details.related, RelatedLocation(message: "Expected type is declared here.", span: declaration));
        }
        fail_details(c, "E201", "Expected " + details.expected_type + ", found " + details.actual_type +".", span, details);
    }
}
fn type_parts(name: String) -> List<String> effects { state } {
    let parts = list_new<String>();
    var i = 0;
    while i < str_len(name) && str_byte(name, i) != 60 {
        i = i + 1;
    }
    list_push(parts, str_slice(name, 0, i));
    if i == str_len(name) {
        return parts;
    }
    i = i + 1;
    var start = i;
    var depth = 0;
    while i + 1 < str_len(name) {
        let b = str_byte(name, i);
        if b == 60 {
            depth = depth + 1;
        } else if b == 62 {
            depth = depth - 1;
        } else if b == 44 && depth == 0 {
            list_push(parts, str_slice(name, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    list_push(parts, str_slice(name, start, i));
    return parts;
}
fn collection_type(c: Context, name: String, args: List<TypeId>, span: Span) -> TypeId effects { state, io, process } {
    if (name == "List" && list_len(args) != 1) || (name == "Dict" && list_len(args) != 2) || (name != "List" && name != "Dict") {
        bad(c, "E200", "Invalid generic type or argument count.", span);
    }
    if name == "Dict" && (!is_scalar(scalar_type(c, list_get(args, 0))) || scalar_type(c, list_get(args, 0)) == float_type()) {
        bad(c, "E201", "Dictionary keys must be Int, Bool, String or a distinct primitive.", span);
    }
    let names = list_new<String>();
    var i = 0;
    while i < list_len(args) {
        list_push(names, type_name(c, list_get(args, i)));
        i = i + 1;
    }
    let canonical = name + "<" + join_text(names,",") + ">";
    let found = find_type(c, canonical);
    if has_type(found) {
        return found;
    }
    var t = type_record(75, canonical, span);
    t.arguments = args;
    return add_type(c, t);
}
fn resolve_pattern(c: Context, name: String, mapping: Dict<String, TypeId>, span: Span) -> TypeId effects { state, io, process } {
    enter(c, span);
    var t = no_type();
    if dict_has(mapping, name) {
        t = dict_get(mapping, name);
        if !has_type(t) {
            bad(c, "E201", "Cannot infer type argument; provide explicit <Types>.", span);
        }
    } else {
        let parts = type_parts(name);
        if list_len(parts) == 1 {
            t = find_type(c, module_global_name(c, name, span));
            if type_kind(c, t) == 78 {
                bad(c, "E210", "Generic type requires explicit arguments.", span);
            }
            if !has_type(t) {
                bad(c, "E200", "Unknown type: " + name, span);
            }
        } else {
            let args = list_new<TypeId>();
            var i = 1;
            while i < list_len(parts) {
                list_push(args, resolve_pattern(c, list_get(parts, i), mapping, span));
                i = i + 1;
            }
            t = instantiate_type(c, module_global_name(c, list_get(parts, 0), span), args, span);
        }
    }
    leave(c);
    return t;
}
fn resolve_type(c: Context, name: String, span: Span) -> TypeId effects { state, io, process } {
    return resolve_pattern(c, name, list_get(c.control, 0).type_mapping, span);
}
fn unify_pattern(c: Context, pattern: String, actual: TypeId, mapping: Dict<String, TypeId>, span: Span) -> Unit effects { state, io, process } {
    enter(c, span);
    if dict_has(mapping, pattern) {
        let previous = dict_get(mapping, pattern);
        if !has_type(previous) {
            dict_set(mapping, pattern, actual);
        } else {
            require_type(c, actual, previous, span);
        }
    } else {
        let parts = type_parts(pattern);
        if list_len(parts) == 1 {
            require_type(c, actual, resolve_type(c, pattern, span), span);
        } else {
            if list_len(type_info(c, actual).arguments) == 0 {
                bad(c, "E201", "Expected a collection.", span);
            }
            let t = type_info(c, actual);
            let actual_parts = type_parts(t.name);
            if list_get(parts, 0) != list_get(actual_parts, 0) || list_len(parts) != list_len(actual_parts) {
                bad(c, "E201", "Incompatible collection types.", span);
            }
            var i = 0;
            while i < list_len(t.arguments) {
                unify_pattern(c, list_get(parts, i + 1), list_get(t.arguments, i), mapping, span);
                i = i + 1;
            }
        }
    }
    leave(c);
}
fn require_effects(c: Context, signature_id: SymbolId, span: Span) -> Unit effects { state, io, process } {
    let sig = symbol_info(c, signature_id);
    let required = sig.effect_mask;
    let allowed = list_get(c.control, 0).allowed_effects;
    var bit = 1;
    var missing = 0;
    while bit <= 8 {
        if has_bit(required, bit) && !has_bit(allowed, bit) {
            missing = missing + bit;
        }
        bit = bit * 2;
    }
    if missing != 0 {
        var details = empty_details();
        details.callee = sig.name;
        details.required_effects = required;
        details.allowed_effects = allowed;
        details.missing_effects = missing;
        if !sig.builtin {
            list_push(details.related, RelatedLocation(message: "Called function declares these effects.", span: sig.span));
        }
        fail_details(c, "E209", "Call to '" + sig.name + "' requires undeclared effects: " + strings_join(effect_names(missing), ", ") +".", span, details);
    }
}
fn install_prelude(c: Context) -> Unit effects { state, io, process } {
    let primitive_names = split_text("Int;Bool;String;Unit;IntList;StringList;Float64;ForeignHandle;Int32", 59);
    var i = 0;
    while i < list_len(primitive_names) {
        let id = add_type(c, type_record(0, list_get(primitive_names, i), empty_span()));
        i = i + 1;
    }
    let rows = split_text(builtin_source(), 10);
    i = 0;
    while i < list_len(rows) {
        var row = list_get(rows, i);
        if str_len(row) > 0 && str_byte(row, str_len(row) - 1) == 13 {
            row = str_slice(row, 0, str_len(row) - 1);
        }
        if row != ""&& str_byte(row, 0) != 35 {
            let cols = split_text(row, 124);
            if list_len(cols) != 8 {
                bad(c, "E900", "Invalid embedded builtin catalog row.", empty_span());
            }
            let name = list_get(cols, 1);
            if list_get(cols, 0) == "enum" && list_get(cols, 2) != "" {
                install_generic_enum(c, name, list_get(cols, 2), list_get(cols, 3));
            } else if list_get(cols, 0) == "enum" {
                let id = add_type(c, type_record(70, name, empty_span()));
                let t = type_info(c, id);
                let variants = split_text(list_get(cols, 3), 59);
                var j = 0;
                while j < list_len(variants) {
                    let pair = split_text(list_get(variants, j), 58);
                    var v = symbol_record(71, list_get(pair, 0), id, empty_span());
                    v.owner = id;
                    v.tag = j;
                    if list_get(pair, 1) != "" {
                        let fields = split_text(list_get(pair, 1), 44);
                        var k = 0;
                        while k < list_len(fields) {
                            list_push(v.parameters, add_symbol(c, symbol_record(72, "", resolve_type(c, list_get(fields, k), empty_span()), empty_span())));
                            k = k + 1;
                        }
                    }
                    list_push(t.variants, add_symbol(c, v));
                    j = j + 1;
                }
            } else {
                var sig = symbol_record(73, name, no_type(), empty_span());
                sig.builtin = true;
                sig.abi = list_get(cols, 6);
                sig.return_pattern = list_get(cols, 4);
                if list_get(cols, 2) != "" {
                    sig.variables = split_text(list_get(cols, 2), 59);
                }
                if list_get(cols, 3) != "" {
                    sig.patterns = split_text(list_get(cols, 3), 59);
                }
                let names = split_text(list_get(cols, 5), 59);
                var j = 0;
                while j < list_len(names) {
                    sig.effect_mask = sig.effect_mask + effect_bit(list_get(names, j));
                    j = j + 1;
                }
                list_push(c.signatures, add_symbol(c, sig));
            }
        }
        i = i + 1;
    }
}
fn builtin_call(c: Context, signature_id: SymbolId, args: List<SyntaxArgument>, explicit: List<String>, span: Span) -> ExprId effects { state, io, process } {
    let sig = symbol_info(c, signature_id);
    let mapping = dict_new<String, TypeId>();
    var i = 0;
    while i < list_len(sig.variables) {
        dict_set(mapping, list_get(sig.variables, i), no_type());
        i = i + 1;
    }
    if list_len(explicit) > 0 {
        if list_len(explicit) != list_len(sig.variables) {
            bad(c, "E210", "Incorrect type argument count.", span);
        }
        i = 0;
        while i < list_len(explicit) {
            dict_set(mapping, list_get(sig.variables, i), resolve_type(c, list_get(explicit, i), span));
            i = i + 1;
        }
    }
    let checked_args = list_new<ExprId>();
    i = 0;
    while i < list_len(args) && i < list_len(sig.patterns) {
        let a = list_get(args, i);
        if a.label != "" {
            bad(c, "E210", "Named arguments are reserved for struct constructors.", ast_expr(c, a.value).span);
        }
        let checked = check_expr(c, a.value);
        unify_pattern(c, list_get(sig.patterns, i), checked_expr(c, checked).type_id, mapping, ast_expr(c, a.value).span);
        list_push(checked_args, checked);
        i = i + 1;
    }
    if list_len(args) != list_len(sig.patterns) {
        bad(c, "E210", "Incorrect argument count.", span);
    }
    if sig.abi == "print" || sig.abi == "format" {
        if !is_scalar(scalar_type(c, checked_expr(c, list_get(checked_args, 0)).type_id)) {
            bad(c, "E201", "Formatting requires Int, Float64, Bool, String or a distinct primitive.", span);
        }
    }
    var instance = sig;
    instance.type_id = resolve_pattern(c, sig.return_pattern, mapping, span);
    let id = add_symbol(c, instance);
    require_effects(c, id, span);
    var n = expression_record(107, span, instance.type_id);
    n.symbol = id;
    n.arguments = checked_args;
    return add_expr(c, n);
}
fn check_record(c: Context, id: TypeId, args: List<SyntaxArgument>, span: Span) -> ExprId effects { state, io, process } {
    let t = type_info(c, id);
    var n = expression_record(112, span, id);
    let seen = dict_new<SymbolId, Bool>();
    var i = 0;
    while i < list_len(args) {
        let a = list_get(args, i);
        let arg_span = ast_expr(c, a.value).span;
        var field = no_symbol();
        if t.kind == 77 {
            if a.label != "" {
                bad(c, "E210", "Distinct constructors take one positional argument.", arg_span);
            }
            field = list_get(t.fields, 0);
        } else {
            if a.label == "" {
                bad(c, "E210", "Struct constructors require field: value arguments.", arg_span);
            }
            field = find_symbol(c, t.fields, a.label);
        }
        if !has_symbol(field) {
            bad(c, "E211", "Unknown struct field.", arg_span);
        }
        if dict_has(seen, field) {
            bad(c, "E202", "Duplicate constructor field.", arg_span);
        }
        dict_set(seen, field, true);
        let checked = check_expr(c, a.value);
        require_type(c, checked_expr(c, checked).type_id, symbol_info(c, field).type_id, arg_span);
        list_push(n.arguments, checked);
        list_push(n.fields, field);
        i = i + 1;
    }
    if dict_len(seen) != list_len(t.fields) {
        bad(c, "E210", "Constructor is missing required fields.", span);
    }
    return add_expr(c, n);
}
fn check_access(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let base = check_expr(c, syntax.left);
    let t = type_info(c, checked_expr(c, base).type_id);
    if t.kind != 76 && t.kind != 77 {
        bad(c, "E201", "Field access requires a struct or distinct primitive.", syntax.span);
    }
    let field = find_symbol(c, t.fields, syntax.text);
    if !has_symbol(field) {
        bad(c, "E211", "Unknown field.", syntax.span);
    }
    var n = expression_record(110, syntax.span, symbol_info(c, field).type_id);
    n.left = base;
    n.symbol = field;
    return add_expr(c, n);
}
fn install_generic_enum(c: Context, name: String, variables: String, variants: String) -> Unit effects { state } {
    let parameters = list_new<TypeParameter>();
    let names = split_text(variables, 59);
    var i = 0;
    while i < list_len(names) {
        list_push(parameters, TypeParameter(name: list_get(names, i), bound: "Any", span: empty_span()));
        i = i + 1;
    }
    let items = list_new<SyntaxVariant>();
    let rows = split_text(variants, 59);
    i = 0;
    while i < list_len(rows) {
        let pair = split_text(list_get(rows, i), 58);
        var fields = list_new<String>();
        if list_get(pair, 1) != "" {
            fields = split_text(list_get(pair, 1), 44);
        }
        list_push(items, SyntaxVariant(name: list_get(pair, 0), fields: fields, span: empty_span()));
        i = i + 1;
    }
    var t = type_record(78, name, empty_span());
    t.template_index = list_len(c.bound_types);
    let id = add_type(c, t);
    list_push(c.bound_types, SyntaxType(type_parameters: parameters, kind: 70, name: name, base: "", fields: list_new<SyntaxField>(), variants: items, span: empty_span()));
}


// Monomorphization belongs to semantic analysis; all instances precede emission.
fn validate_type_parameters(c: Context, parameters: List<TypeParameter>) -> Unit effects { state, io, process } {
    let names = dict_new<String, Bool>();
    for i in 0 .. list_len(parameters) {
        let p = list_get(parameters, i);
        let named = find_type(c, p.name);
        if dict_has(names, p.name) || (has_type(named) && type_kind(c, named) == 0) || p.name == "Option" || p.name == "Result" || p.name == "List" || p.name == "Dict" || p.name == "Any" || p.name == "Scalar" || p.name == "Number" {
            bad(c, "E210", "Duplicate or reserved type parameter: " + p.name, p.span);
        }
        if p.bound != "Any" && p.bound != "Scalar" && p.bound != "Number" {
            bad(c, "E210", "Unknown type constraint: " + p.bound, p.span);
        }
        dict_set(names, p.name, true);
    }
}
fn generic_mapping(c: Context, parameters: List<TypeParameter>, args: List<TypeId>, span: Span) -> Dict<String, TypeId> effects { state, io, process } {
    if list_len(parameters) != list_len(args) {
        bad(c, "E210", "Incorrect type argument count.", span);
    }
    let mapping = dict_new<String, TypeId>();
    for i in 0 .. list_len(parameters) {
        let p = list_get(parameters, i);
        let t = list_get(args, i);
        if !has_type(t) {
            bad(c, "E210", "Cannot infer type argument " + p.name + "; provide explicit <Types>.", span);
        }
        if (p.bound == "Scalar" && !is_scalar(scalar_type(c, t))) || (p.bound == "Number" && t != int_type() && t != float_type()) {
            bad(c, "E210", "Type " + type_name(c, t) + " does not satisfy " + p.bound +".", span);
        }
        dict_set(mapping, p.name, t);
    }
    return mapping;
}
fn instance_name(c: Context, name: String, args: List<TypeId>) -> String effects { state, io, process } {
    let names = list_new<String>();
    for i in 0 .. list_len(args) {
        list_push(names, type_name(c, list_get(args, i)));
    }
    return name + "<" + join_text(names,",") + ">";
}
fn fill_type(c: Context, id: TypeId, syntax: SyntaxType, mapping: Dict<String, TypeId>) -> Unit effects { state, io, process } {
    var t = type_info(c, id);
    var j = 0;
    if t.kind == 77 {
        t.base = resolve_pattern(c, syntax.base, mapping, syntax.span);
        if !is_scalar(t.base) {
            bad(c, "E201", "Distinct types wrap Int, Float64, Bool or String.", syntax.span);
        }
        list_push(t.fields, add_symbol(c, symbol_record(72, "value", t.base, syntax.span)));
        set_type(c, id, t);
    } else if t.kind == 76 {
        while j < list_len(syntax.fields) {
            let field = list_get(syntax.fields, j);
            let previous = find_symbol(c, t.fields, field.name);
            if has_symbol(previous) {
                duplicate(c, "Duplicate struct field '" + field.name + "'.", field.span, symbol_info(c, previous).span);
            }
            list_push(t.fields, add_symbol(c, symbol_record(72, field.name, resolve_pattern(c, field.annotation, mapping, field.span), field.span)));
            j = j + 1;
        }
    } else {
        if list_len(syntax.variants) == 0 {
            bad(c, "E204", "Empty enum.", syntax.span);
        }
        while j < list_len(syntax.variants) {
            let variant = list_get(syntax.variants, j);
            let previous = find_symbol(c, t.variants, variant.name);
            if has_symbol(previous) {
                duplicate(c, "Duplicate variant '" + variant.name + "'.", variant.span, symbol_info(c, previous).span);
            }
            var v = symbol_record(71, variant.name, id, variant.span);
            v.owner = id;
            v.tag = j;
            var k = 0;
            while k < list_len(variant.fields) {
                list_push(v.parameters, add_symbol(c, symbol_record(72, "", resolve_pattern(c, list_get(variant.fields, k), mapping, variant.span), variant.span)));
                k = k + 1;
            }
            list_push(t.variants, add_symbol(c, v));
            j = j + 1;
        }
    }
}
fn instantiate_type(c: Context, name: String, args: List<TypeId>, span: Span) -> TypeId effects { state, io, process } {
    if name == "List" || name == "Dict" {
        return collection_type(c, name, args, span);
    }
    let template = find_type(c, name);
    if type_kind(c, template) != 78 {
        bad(c, "E200", "Unknown generic type: " + name, span);
    }
    let syntax_index = type_info(c, template).template_index;
    let syntax = list_get(c.bound_types, syntax_index);
    let mapping = generic_mapping(c, syntax.type_parameters, args, span);
    let canonical = instance_name(c, name, args);
    let found = find_type(c, canonical);
    if has_type(found) {
        return found;
    }
    var ctl = list_get(c.control, 0);
    if ctl.type_depth >= 32 || ctl.type_instances >= 512 {
        bad(c, "E217", "Generic type instantiation limit exceeded.", span);
    }
    ctl.type_depth = ctl.type_depth + 1;
    ctl.type_instances = ctl.type_instances + 1;
    list_set(c.control, 0, ctl);
    var t = type_record(syntax.kind, canonical, syntax.span);
    t.arguments = args;
    t.template_index = syntax_index;
    let id = add_type(c, t);
    fill_type(c, id, syntax, mapping);
    ctl = list_get(c.control, 0);
    ctl.type_depth = ctl.type_depth - 1;
    list_set(c.control, 0, ctl);
    return id;
}
fn concrete_signature(c: Context, syntax: SyntaxFunction, name: String, mapping: Dict<String, TypeId>) -> Symbol effects { state, io, process } {
    var sig = symbol_record(73, name, resolve_pattern(c, syntax.return_name, mapping, syntax.span), syntax.span);
    sig.effect_mask = syntax.effect_mask;
    sig.foreign_library = syntax.foreign_library;
    sig.foreign_name = syntax.foreign_name;
    for i in 0 .. list_len(syntax.parameters) {
        let p = list_get(syntax.parameters, i);
        list_push(sig.parameters, add_symbol(c, symbol_record(72, p.name, resolve_pattern(c, p.annotation, mapping, p.span), p.span)));
    }
    if sig.foreign_library != "" {
        if !has_bit(sig.effect_mask, 4) || !has_bit(sig.effect_mask, 8) {
            bad(c, "E228", "Foreign functions require state and process effects.", syntax.span);
        }
        if list_len(sig.parameters) > 16 || !foreign_type(sig.type_id, true) {
            bad(c, "E228", "Unsupported foreign result type or more than 16 parameters.", syntax.span);
        }
        for parameter in sig.parameters {
            let p = symbol_info(c, parameter);
            if !foreign_type(p.type_id, false) { bad(c, "E228", "Unsupported foreign parameter type.", p.span); }
            if p.name == "result" || p.name == "_" { bad(c, "E228", "Reserved foreign parameter name.", p.span); }
            for other in sig.parameters {
                if other != parameter && symbol_info(c, other).name == p.name { bad(c, "E228", "Duplicate foreign parameter.", p.span); }
            }
        }
    }
    return sig;
}
fn foreign_type(t: TypeId, is_return: Bool) -> Bool {
    return t == int_type() || t == int32_type() || t == float_type() || t == bool_type() || t == foreign_handle_type() || is_return && t == unit_type() || !is_return && t == string_type();
}
fn generic_function_call(c: Context, template: SymbolId, args: List<SyntaxArgument>, explicit: List<String>, span: Span) -> ExprId effects { state, io, process } {
    let sig = symbol_info(c, template);
    let syntax = list_get(c.bound_functions, sig.template_index);
    let mapping = dict_new<String, TypeId>();
    var i = 0;
    while i < list_len(syntax.type_parameters) {
        dict_set(mapping, list_get(syntax.type_parameters, i).name, no_type());
        i = i + 1;
    }
    if list_len(explicit) > 0 {
        if list_len(explicit) != list_len(syntax.type_parameters) {
            bad(c, "E210", "Incorrect type argument count.", span);
        }
        i = 0;
        while i < list_len(explicit) {
            dict_set(mapping, list_get(syntax.type_parameters, i).name, resolve_type(c, list_get(explicit, i), span));
            i = i + 1;
        }
    }
    if list_len(args) != list_len(syntax.parameters) {
        bad(c, "E210", "Incorrect argument count.", span);
    }
    let checked = list_new<ExprId>();
    i = 0;
    while i < list_len(args) {
        let a = list_get(args, i);
        if a.label != "" {
            bad(c, "E210", "Named arguments require a struct constructor.", span);
        }
        let value = check_expr(c, a.value);
        unify_pattern(c, list_get(syntax.parameters, i).annotation, checked_expr(c, value).type_id, mapping, ast_expr(c, a.value).span);
        list_push(checked, value);
        i = i + 1;
    }
    let types = list_new<TypeId>();
    i = 0;
    while i < list_len(syntax.type_parameters) {
        list_push(types, dict_get(mapping, list_get(syntax.type_parameters, i).name));
        i = i + 1;
    }
    let validated = generic_mapping(c, syntax.type_parameters, types, span);
    let canonical = instance_name(c, sig.name, types);
    var id = no_symbol();
    if dict_has(c.generic_functions, canonical) {
        id = dict_get(c.generic_functions, canonical);
    } else {
        if dict_len(c.generic_functions) >= 512 || list_get(c.control, 0).instance_depth >= 32 {
            bad(c, "E217", "Generic function instantiation limit exceeded.", span);
        }
        var instance = concrete_signature(c, syntax, canonical, validated);
        instance.template_index = sig.template_index;
        id = add_symbol(c, instance);
        dict_set(c.generic_functions, canonical, id);
        list_push(c.instances, FunctionInstance(depth: list_get(c.control, 0).instance_depth + 1, signature: id, syntax_index: sig.template_index, mapping: validated));
    }
    require_effects(c, id, span);
    var n = expression_record(107, span, symbol_info(c, id).type_id);
    n.symbol = id;
    n.arguments = checked;
    return add_expr(c, n);
}


// Semantic analysis creates checked tables; syntax tables are read-only here.
fn lookup(c: Context, name: String) -> SymbolId effects { state, io, process } {
    var i = list_len(c.scopes);
    while i > 0 {
        i = i - 1;
        let found = find_symbol(c, list_get(c.scopes, i), name);
        if has_symbol(found) {
            return found;
        }
    }
    return no_symbol();
}
fn push_scope(c: Context) -> Unit effects { state } {
    list_push(c.scopes, list_new<SymbolId>());
}
fn pop_scope(c: Context) -> Unit effects { state } {
    list_truncate(c.scopes, list_len(c.scopes) - 1);
}
fn bind(c: Context, name: String, type_id: TypeId, mutable: Bool, span: Span, implicit: Bool) -> SymbolId effects { state, io, process } {
    if !implicit && (name == "result" || name == "_") {
        bad(c, "E202", "Reserved binding name.", span);
    }
    let scope = list_get(c.scopes, list_len(c.scopes) - 1);
    let previous = find_symbol(c, scope, name);
    if has_symbol(previous) {
        duplicate(c, "Duplicate binding '" + name + "' in this scope.", span, symbol_info(c, previous).span);
    }
    var symbol = symbol_record(61, name, type_id, span);
    symbol.mutable = mutable;
    let id = add_symbol(c, symbol);
    list_push(scope, id);
    return id;
}
fn check_arguments(c: Context, args: List<SyntaxArgument>, params: List<SymbolId>, span: Span) -> List<ExprId> effects { state, io, process } {
    let items = list_new<ExprId>();
    var i = 0;
    while i < list_len(args) && i < list_len(params) {
        let a = list_get(args, i);
        if a.label != "" {
            bad(c, "E210", "Named arguments require a struct constructor.", ast_expr(c, a.value).span);
        }
        let checked = check_expr(c, a.value);
        let parameter = symbol_info(c, list_get(params, i));
        require_type_at(c, checked_expr(c, checked).type_id, parameter.type_id, checked_expr(c, checked).span, parameter.span);
        list_push(items, checked);
        i = i + 1;
    }
    if list_len(args) != list_len(params) {
        bad(c, "E210", "Incorrect argument count.", span);
    }
    return items;
}
fn check_construct(c: Context, owner: String, name: String, args: List<SyntaxArgument>, span: Span) -> ExprId effects { state, io, process } {
    let id = resolve_type(c, owner, span);
    if !has_type(id) || type_kind(c, id) != 70 {
        bad(c, "E200", "Unknown enum.", span);
    }
    let variant = find_symbol(c, type_info(c, id).variants, name);
    if !has_symbol(variant) {
        bad(c, "E211", "Unknown enum variant.", span);
    }
    var n = expression_record(108, span, id);
    n.symbol = variant;
    n.arguments = check_arguments(c, args, symbol_info(c, variant).parameters, span);
    return add_expr(c, n);
}
fn normalize_integer(c: Context, syntax: SyntaxExpr, negative: Bool) -> String effects { state, io, process } {
    let raw = syntax.text;
    var start = 0;
    while start + 1 < str_len(raw) && str_byte(raw, start) == 48 {
        start = start + 1;
    }
    var number = str_slice(raw, start, str_len(raw));
    if negative {
        number = "-"+ number;
    }
    match parse_int(number) {
        IntResult::Ok(value) => {
            return to_string(value);
        }
        IntResult::Err(_) => {
            bad(c, "E205", "Integer literal outside signed 64-bit range.", syntax.span);
            return "0";
        }
    }
}
fn check_expr(c: Context, ast: AstExprId) -> ExprId effects { state, io, process } {
    let syntax = ast_expr(c, ast);
    enter(c, syntax.span);
    let k = syntax.kind;
    var n = expression_record(0, syntax.span, no_type());
    var id = no_expr();
    if k == 1 {
        n.kind = 101;
        n.type_id = int_type();
        n.text = normalize_integer(c, syntax, false);
    } else if k == 12 {
        if !float_text_valid(syntax.text) {
            bad(c, "E205", "Float64 literal outside binary64 range or numeric text limit.", syntax.span);
        }
        n.kind = 117;
        n.type_id = float_type();
        n.text = syntax.text;
    } else if k == 2 {
        n.kind = 102;
        n.type_id = bool_type();
        n.text = syntax.text;
    } else if k == 3 {
        n.kind = 103;
        n.type_id = string_type();
        n.text = syntax.text;
    } else if k == 4 {
        if syntax.qualifier != "" {
            id = check_construct(c, syntax.qualifier, syntax.text, list_new<SyntaxArgument>(), syntax.span);
        } else {
            let b = lookup(c, syntax.text);
            if !has_symbol(b) {
                bad(c, "E203", "Unknown binding.", syntax.span);
            }
            n.kind = 104;
            n.type_id = symbol_info(c, b).type_id;
            n.symbol = b;
        }
    } else if k == 5 {
        let operand = ast_expr(c, syntax.left);
        if syntax.text == "-"&& operand.kind == 1 {
            n.kind = 101;
            n.type_id = int_type();
            n.text = normalize_integer(c, operand, true);
        } else {
            n.left = check_expr(c, syntax.left);
            n.type_id = bool_type();
            if syntax.text == "-" {
                n.type_id = int_type();
                if checked_expr(c, n.left).type_id == float_type() {
                    n.type_id = float_type();
                }
            }
            require_type(c, checked_expr(c, n.left).type_id, n.type_id, syntax.span);
            n.kind = 105;
            n.text = syntax.text;
        }
    } else if k == 6 {
        let left = check_expr(c, syntax.left);
        let right = check_expr(c, syntax.right);
        let a = checked_expr(c, left);
        let b = checked_expr(c, right);
        let op = syntax.text;
        n.type_id = int_type();
        if op == "&&" || op == "||" {
            require_type(c, a.type_id, bool_type(), a.span);
            require_type(c, b.type_id, bool_type(), b.span);
            n.type_id = bool_type();
        } else if op == "==" || op == "!=" {
            require_type(c, b.type_id, a.type_id, b.span);
            if !is_scalar(scalar_type(c, a.type_id)) {
                bad(c, "E201", "Equality requires scalar values of the same type.", syntax.span);
            }
            n.type_id = bool_type();
        } else if op == "+" && a.type_id == string_type() {
            require_type(c, b.type_id, string_type(), b.span);
            n.type_id = string_type();
        } else {
            var numeric = int_type();
            if a.type_id == float_type() && op != "%" {
                numeric = float_type();
            }
            require_type(c, a.type_id, numeric, a.span);
            require_type(c, b.type_id, numeric, b.span);
            n.type_id = numeric;
            if op == "<" || op == "<=" || op == ">" || op == ">=" {
                n.type_id = bool_type();
            }
        }
        n.kind = 106;
        n.text = op;
        n.left = left;
        n.right = right;
    } else if k == 11 {
        id = check_interpolation(c, syntax);
    } else if k == 9 {
        n.kind = 113;
        n.left = check_expr(c, syntax.left);
        n.arms = check_match_arms(c, checked_expr(c, n.left).type_id, syntax.arms, syntax.span, true);
        n.type_id = checked_expr(c, list_get(n.arms, 0).value).type_id;
    } else if k == 10 {
        id = check_propagation(c, syntax);
    } else if k == 8 {
        id = check_access(c, syntax);
    } else if k == 7 {
        var target = ast_expr(c, syntax.left);
        let is_module = module_alias(c, target.qualifier, target.span) >= 0;
        if is_module {
            target.text = target.qualifier +"::"+ target.text;
            target.qualifier = "";
        }
        if target.qualifier != "" {
            if list_len(syntax.type_arguments) > 0 {
                bad(c, "E210", "Enum constructors are not generic.", syntax.span);
            }
            id = check_construct(c, target.qualifier, target.text, syntax.arguments, syntax.span);
        } else {
            if has_symbol(lookup(c, target.text)) {
                bad(c, "E201", "Local binding is not callable.", syntax.span);
            }
            target.text = module_global_name(c, target.text, target.span);
            var t = find_type(c, target.text);
            if type_kind(c, t) == 78 {
                if list_len(syntax.type_arguments) == 0 {
                    bad(c, "E210", "Generic type requires explicit arguments.", syntax.span);
                }
                t = resolve_type(c, target.text + "<" + join_text(syntax.type_arguments,",") + ">", syntax.span);
            }
            if type_kind(c, t) == 76 || type_kind(c, t) == 77 {
                if list_len(syntax.type_arguments) > 0 && type_info(c, t).template_index < 0 {
                    bad(c, "E210", "This constructor is not generic.", syntax.span);
                }
                id = check_record(c, t, syntax.arguments, syntax.span);
            } else {
                let sig_id = find_symbol(c, c.signatures, target.text);
                if !has_symbol(sig_id) {
                    bad(c, "E203", "Unknown function.", syntax.span);
                }
                let sig = symbol_info(c, sig_id);
                if sig.builtin {
                    id = builtin_call(c, sig_id, syntax.arguments, syntax.type_arguments, syntax.span);
                } else if sig.template_index >= 0 {
                    id = generic_function_call(c, sig_id, syntax.arguments, syntax.type_arguments, syntax.span);
                } else {
                    if list_len(syntax.type_arguments) > 0 {
                        bad(c, "E210", "This function is not generic.", syntax.span);
                    }
                    n.arguments = check_arguments(c, syntax.arguments, sig.parameters, syntax.span);
                    require_effects(c, sig_id, syntax.span);
                    n.kind = 107;
                    n.type_id = sig.type_id;
                    n.symbol = sig_id;
                }
            }
        }
    }
    if !has_expr(id) {
        id = add_expr(c, n);
    }
    leave(c);
    return id;
}
fn condition(c: Context, ast: AstExprId) -> ExprId effects { state, io, process } {
    let id = check_expr(c, ast);
    let n = checked_expr(c, id);
    require_type(c, n.type_id, bool_type(), n.span);
    return id;
}
fn checked_conditions(c: Context, items: List<AstExprId>) -> List<ExprId> effects { state, io, process } {
    let checked = list_new<ExprId>();
    var i = 0;
    while i < list_len(items) {
        list_push(checked, condition(c, list_get(items, i)));
        i = i + 1;
    }
    return checked;
}
fn block_returns(c: Context, items: List<StmtId>) -> Bool effects { state, io, process } {
    return match last(items) {
        Option::Some(id) => checked_stmt(c, id).returns, Option::None => false
    };
}
fn check_block(c: Context, items: List<AstStmtId>, nested: Bool) -> List<StmtId> effects { state, io, process } {
    if nested {
        push_scope(c);
    }
    let checked = list_new<StmtId>();
    var returns = false;
    var i = 0;
    while i < list_len(items) {
        let ast = list_get(items, i);
        if returns {
            bad(c, "E212", "Unreachable statement.", ast_stmt(c, ast).span);
        }
        let id = check_statement(c, ast);
        list_push(checked, id);
        returns = checked_stmt(c, id).exits;
        i = i + 1;
    }
    if nested {
        pop_scope(c);
    }
    return checked;
}
fn check_statement(c: Context, ast: AstStmtId) -> StmtId effects { state, io, process } {
    let syntax = ast_stmt(c, ast);
    enter(c, syntax.span);
    let k = syntax.kind;
    var n = statement_record(k + 100, syntax.span);
    if k == 30 {
        n.value = check_expr(c, syntax.value);
        let value_type = checked_expr(c, n.value).type_id;
        if syntax.annotation != "" {
            require_type(c, value_type, resolve_type(c, syntax.annotation, syntax.span), syntax.span);
        }
        n.binding = bind(c, syntax.name, value_type, syntax.mutable, syntax.span, false);
    } else if k == 31 {
        let b = lookup(c, syntax.name);
        if !has_symbol(b) {
            bad(c, "E203", "Unknown binding.", syntax.span);
        }
        if !symbol_info(c, b).mutable {
            bad(c, "E213", "Cannot assign to immutable binding.", syntax.span);
        }
        n.value = check_expr(c, syntax.value);
        require_type(c, checked_expr(c, n.value).type_id, symbol_info(c, b).type_id, syntax.span);
        n.binding = b;
    } else if k == 38 {
        n.target = check_expr(c, syntax.target);
        var root = checked_expr(c, n.target);
        while root.kind == 110 {
            root = checked_expr(c, root.left);
        }
        if root.kind != 104 {
            bad(c, "E213", "Assignment requires a local variable.", syntax.span);
        }
        if !symbol_info(c, root.symbol).mutable {
            bad(c, "E213", "Cannot change a field of an immutable binding.", syntax.span);
        }
        n.value = check_expr(c, syntax.value);
        require_type(c, checked_expr(c, n.value).type_id, checked_expr(c, n.target).type_id, syntax.span);
    } else if k == 32 {
        if has_ast_expr(syntax.value) {
            n.value = check_expr(c, syntax.value);
        } else {
            n.value = add_expr(c, expression_record(109, syntax.span, unit_type()));
        }
        require_type(c, checked_expr(c, n.value).type_id, list_get(c.control, 0).return_type, syntax.span);
        n.returns = true;
        n.exits = true;
    } else if k == 33 {
        n.value = check_expr(c, syntax.value);
        if checked_expr(c, n.value).type_id != unit_type() {
            bad(c, "E214", "Unused expression value.", syntax.span);
        }
    } else if k == 34 {
        n.value = condition(c, syntax.value);
        n.yes = check_block(c, syntax.yes, true);
        n.no = check_block(c, syntax.no, true);
        n.returns = block_returns(c, n.yes) && block_returns(c, n.no);
        n.exits = block_exits(c, n.yes) && block_exits(c, n.no);
    } else if k == 35 {
        n.value = condition(c, syntax.value);
        enter_loop(c);
        n.yes = check_block(c, syntax.yes, true);
        leave_loop(c);
    } else if k == 39 || k == 40 {
        if list_get(c.control, 0).loop_depth == 0 {
            bad(c, "E219", "Loop exit outside a loop.", syntax.span);
        }
        n.exits = true;
    } else if k == 41 {
        n = check_for(c, syntax);
    } else if k == 36 {
        n.value = check_expr(c, syntax.value);
        n.arms = check_match_arms(c, checked_expr(c, n.value).type_id, syntax.arms, syntax.span, false);
        n.returns = true;
        n.exits = true;
        var i = 0;
        while i < list_len(n.arms) {
            n.returns = n.returns && block_returns(c, list_get(n.arms, i).body);
            n.exits = n.exits && block_exits(c, list_get(n.arms, i).body);
            i = i + 1;
        }
    }
    leave(c);
    return add_stmt(c, n);
}
fn order_type(c: Context, id: TypeId) -> Unit effects { state, io, process } {
    var t = type_info(c, id);
    if t.kind == 0 || t.kind == 75 || t.kind == 78 {
        return;
    }
    if t.visit == 1 {
        bad(c, "E204", "Recursive by-value type.", t.span);
    }
    if t.visit == 2 {
        return;
    }
    enter(c, t.span);
    t.visit = 1;
    set_type(c, id, t);
    var i = 0;
    if t.kind == 70 {
        while i < list_len(t.variants) {
            let fields = symbol_info(c, list_get(t.variants, i)).parameters;
            var j = 0;
            while j < list_len(fields) {
                order_type(c, symbol_info(c, list_get(fields, j)).type_id);
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        while i < list_len(t.fields) {
            order_type(c, symbol_info(c, list_get(t.fields, i)).type_id);
            i = i + 1;
        }
    }
    t.visit = 2;
    set_type(c, id, t);
    list_push(c.type_order, id);
    leave(c);
}
fn analyze(c: Context) -> Unit effects { state, io, process } {
    install_prelude(c);
    bind_modules(c);
    var i = 0;
    while i < list_len(c.bound_types) {
        let syntax = list_get(c.bound_types, i);
        if syntax.span.end > syntax.span.start {
            declaration_name_available(c, syntax.name, syntax.span);
            if syntax.name == "List" || syntax.name == "Dict" {
                bad(c, "E202", "Reserved type constructor.", syntax.span);
            }
            var t = type_record(syntax.kind, syntax.name, syntax.span);
            t.base_name = syntax.base;
            if list_len(syntax.type_parameters) > 0 {
                if syntax.kind == 77 {
                    bad(c, "E210", "Distinct declarations cannot be generic.", syntax.span);
                }
                t.kind = 78;
                t.template_index = i;
            }
            let id = add_type(c, t);
        }
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.bound_types) {
        let syntax = list_get(c.bound_types, i);
        let id = find_type(c, syntax.name);
        validate_type_parameters(c, syntax.type_parameters);
        if type_kind(c, id) != 78 {
            fill_type(c, id, syntax, dict_new<String, TypeId>());
        }
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.bound_functions) {
        let syntax = list_get(c.bound_functions, i);
        declaration_name_available(c, syntax.name, syntax.span);
        validate_type_parameters(c, syntax.type_parameters);
        let mapping = dict_new<String, TypeId>();
        var sig = symbol_record(73, syntax.name, no_type(), syntax.span);
        sig.effect_mask = syntax.effect_mask;
        if list_len(syntax.type_parameters) > 0 {
            sig.template_index = i;
        } else {
            sig = concrete_signature(c, syntax, syntax.name, mapping);
        }
        let id = add_symbol(c, sig);
        list_push(c.signatures, id);
        if sig.template_index < 0 && sig.foreign_library == "" {
            list_push(c.instances, FunctionInstance(depth: 0, signature: id, syntax_index: i, mapping: mapping));
        }
        i = i + 1;
    }
    let main_id = find_symbol(c, c.signatures, "main");
    var entry_tests = false;
    for function in c.bound_functions {
        if function.test_name != ""&& source_unit_at(c, function.span.start) == 0 {
            entry_tests = true;
        }
    }
    if !has_symbol(main_id) {
        if !entry_tests {
            bad(c, "E207", "Missing main function.", empty_span());
        }
    } else {
        let main_sig = symbol_info(c, main_id);
        if list_len(main_sig.parameters) != 0 || (main_sig.type_id != int_type() && main_sig.type_id != unit_type()) {
            bad(c, "E207", "main must take no parameters and return Int or Unit.", empty_span());
        }
    }
    i = 0;
    while i < list_len(c.instances) {
        let instance = list_get(c.instances, i);
        let syntax = list_get(c.bound_functions, instance.syntax_index);
        let sig_id = instance.signature;
        let sig = symbol_info(c, sig_id);
        push_scope(c);
        let params = list_new<SymbolId>();
        var j = 0;
        while j < list_len(syntax.parameters) {
            let p = list_get(syntax.parameters, j);
            list_push(params, bind(c, p.name, symbol_info(c, list_get(sig.parameters, j)).type_id, false, p.span, false));
            j = j + 1;
        }
        var ctl = list_get(c.control, 0);
        ctl.type_mapping = instance.mapping;
        ctl.instance_depth = instance.depth;
        ctl.return_type = sig.type_id;
        ctl.in_contract = true;
        ctl.allowed_effects = 0;
        list_set(c.control, 0, ctl);
        let pre = checked_conditions(c, syntax.preconditions);
        push_scope(c);
        let r = bind(c, "result", sig.type_id, false, syntax.span, true);
        let post = checked_conditions(c, syntax.postconditions);
        pop_scope(c);
        ctl = list_get(c.control, 0);
        ctl.in_contract = false;
        ctl.allowed_effects = sig.effect_mask;
        list_set(c.control, 0, ctl);
        let body = check_block(c, syntax.body, false);
        if !block_returns(c, body) {
            if sig.type_id != unit_type() {
                bad(c, "E208", "Function may reach its end without returning.", syntax.span);
            }
            var ret = statement_record(132, syntax.span);
            ret.value = add_expr(c, expression_record(109, syntax.span, unit_type()));
            ret.returns = true;
            list_push(body, add_stmt(c, ret));
        }
        list_push(c.functions, CheckedFunction(symbol: sig_id, parameters: params, result_binding: r, preconditions: pre, postconditions: post, body: body, span: syntax.span));
        pop_scope(c);
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.types) {
        order_type(c, primitive_type_id(i + 1));
        i = i + 1;
    }
}
fn declaration_name_available(c: Context, name: String, span: Span) -> Unit effects { state, io, process } {
    let t = find_type(c, name);
    if has_type(t) {
        duplicate(c, "Duplicate or reserved declaration '" + name + "'.", span, type_info(c, t).span);
    }
    let sig = find_symbol(c, c.signatures, name);
    if has_symbol(sig) {
        duplicate(c, "Duplicate or reserved declaration '" + name + "'.", span, symbol_info(c, sig).span);
    }
}
fn check_match_arms(c: Context, enum_id: TypeId, arms: List<SyntaxArm>, span: Span, value_mode: Bool) -> List<CheckedArm> effects { state, io, process } {
    if type_kind(c, enum_id) != 70 {
        bad(c, "E201", "match expects an enum value.", span);
    }
    let e = type_info(c, enum_id);
    let seen = dict_new<SymbolId, Bool>();
    var i = 0;
    var result_type = no_type();
    let checked = list_new<CheckedArm>();
    while i < list_len(arms) {
        let arm = list_get(arms, i);
        if module_global_name(c, arm.owner, arm.span) != list_get(type_parts(e.name), 0) {
            bad(c, "E201", "Wrong enum in pattern.", arm.span);
        }
        let variant = find_symbol(c, e.variants, arm.variant);
        if !has_symbol(variant) {
            bad(c, "E211", "Unknown pattern variant.", arm.span);
        }
        if dict_has(seen, variant) {
            bad(c, "E215", "Duplicate match arm.", arm.span);
        }
        dict_set(seen, variant, true);
        push_scope(c);
        let fields = symbol_info(c, variant).parameters;
        let bindings = list_new<SymbolId>();
        var j = 0;
        while j < list_len(arm.names) && j < list_len(fields) {
            let name = list_get(arm.names, j);
            var b = no_symbol();
            if name.name != "_" {
                b = bind(c, name.name, symbol_info(c, list_get(fields, j)).type_id, false, arm.span, false);
            }
            list_push(bindings, b);
            j = j + 1;
        }
        if list_len(arm.names) != list_len(fields) {
            bad(c, "E210", "Incorrect pattern field count.", arm.span);
        }
        var body = list_new<StmtId>();
        var value = no_expr();
        if value_mode {
            value = check_expr(c, arm.value);
            let actual = checked_expr(c, value).type_id;
            if has_type(result_type) {
                require_type(c, actual, result_type, arm.span);
            } else {
                result_type = actual;
            }
        } else {
            body = check_block(c, arm.body, false);
        }
        pop_scope(c);
        list_push(checked, CheckedArm(value: value, variant: variant, bindings: bindings, body: body, span: arm.span));
        i = i + 1;
    }
    if dict_len(seen) != list_len(e.variants) {
        let details = empty_details();
        var j = 0;
        while j < list_len(e.variants) {
            let v = list_get(e.variants, j);
            if !dict_has(seen, v) {
                list_push(details.missing_variants, e.name +"::"+ symbol_info(c, v).name);
            }
            j = j + 1;
        }
        if e.span.end > e.span.start {
            list_push(details.related, RelatedLocation(message: "Enum is declared here.", span: e.span));
        }
        fail_details(c, "E216", "Non-exhaustive match; missing: " + join_text(details.missing_variants, ", ") +".", span, details);
    }
    return checked;
}
fn check_interpolation(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    var n = expression_record(115, syntax.span, string_type());
    for i in 0 .. list_len(syntax.arguments) {
        let part = list_get(syntax.arguments, i);
        var value = check_expr(c, part.value);
        if part.label != "" {
            let t = checked_expr(c, value).type_id;
            let format = part.label;
            if format != "d" && format != "s" && format != "b" && format != "display" {
                bad(c, "E220", "Unknown interpolation format: " + format, ast_expr(c, part.value).span);
            }
            if format == "d" {
                require_type(c, t, int_type(), ast_expr(c, part.value).span);
            }
            if format == "s" {
                require_type(c, t, string_type(), ast_expr(c, part.value).span);
            }
            if format == "b" {
                require_type(c, t, bool_type(), ast_expr(c, part.value).span);
            }
            if format == "display" && !is_scalar(scalar_type(c, t)) {
                bad(c, "E201", "display requires a scalar value.", ast_expr(c, part.value).span);
            }
            var converted = expression_record(116, ast_expr(c, part.value).span, string_type());
            converted.left = value;
            value = add_expr(c, converted);
        }
        list_push(n.arguments, value);
    }
    return add_expr(c, n);
}


fn propagation_family(c: Context, id: TypeId) -> String effects { state, io, process } {
    if type_kind(c, id) != 70 {
        return "";
    }
    let t = type_info(c, id);
    let root = list_get(type_parts(t.name), 0);
    if root != "Option" && root != "Result" {
        return "";
    }
    if t.template_index != type_info(c, find_type(c, root)).template_index {
        return "";
    }
    return root;
}
fn check_propagation(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let ctl = list_get(c.control, 0);
    if ctl.in_contract {
        bad(c, "E218", "Propagation is not allowed in contracts.", syntax.span);
    }
    let value = check_expr(c, syntax.left);
    let operand = checked_expr(c, value).type_id;
    let family = propagation_family(c, operand);
    if family == "" {
        bad(c, "E218", "Propagation requires Option or Result.", syntax.span);
    }
    if propagation_family(c, ctl.return_type) != family {
        bad(c, "E201", "Propagation requires the same return family.", syntax.span);
    }
    let t = type_info(c, operand);
    let target = type_info(c, ctl.return_type);
    if family == "Result" {
        require_type(c, list_get(t.arguments, 1), list_get(target.arguments, 1), syntax.span);
    }
    var n = expression_record(114, syntax.span, list_get(t.arguments, 0));
    n.left = value;
    n.symbol = list_get(target.variants, 1);
    return add_expr(c, n);
}
fn from_string(r: StringResult) -> Result<String, String> {
    return match r {
        StringResult::Ok(s) => Result<String, String>::Ok(s), StringResult::Err(e) => Result<String, String>::Err(e)
    };
}
fn from_write(r: WriteResult) -> Result<Bool, String> {
    return match r {
        WriteResult::Ok => Result<Bool, String>::Ok(true), WriteResult::Err(e) => Result<Bool, String>::Err(e)
    };
}
fn io_result<T>(r: Result<T, String>, fallback: T) -> T effects { io, process } {
    match r {
        Result::Ok(value) => {
            return value;
        }
        Result::Err(message) => {
            eprint("velac: " + message);
            exit(2);
            return fallback;
        }
    }
}


fn block_exits(c: Context, items: List<StmtId>) -> Bool effects { state, io, process } {
    return match last(items) {
        Option::Some(id) => checked_stmt(c, id).exits, Option::None => false
    };
}
fn enter_loop(c: Context) -> Unit effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.loop_depth = ctl.loop_depth + 1;
    list_set(c.control, 0, ctl);
}
fn leave_loop(c: Context) -> Unit effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.loop_depth = ctl.loop_depth - 1;
    list_set(c.control, 0, ctl);
}
fn check_for(c: Context, syntax: SyntaxStmt) -> CheckedStmt effects { state, io, process } {
    var n = statement_record(141, syntax.span);
    n.mode = syntax.mode;
    n.value = check_expr(c, syntax.value);
    let t = checked_expr(c, n.value).type_id;
    var element = int_type();
    if n.mode != 0 {
        require_type(c, t, int_type(), syntax.span);
        n.target = check_expr(c, syntax.target);
        require_type(c, checked_expr(c, n.target).type_id, int_type(), syntax.span);
    } else {
        if t == strings_type() {
            element = string_type();
        } else if t == ints_type() {
            element = int_type();
        } else if type_kind(c, t) == 75 && list_len(type_info(c, t).arguments) == 1 {
            element = list_get(type_info(c, t).arguments, 0);
        } else {
            bad(c, "E201", "for expects a list or an Int range.", syntax.span);
        }
        require_effects(c, find_symbol(c, c.signatures, "list_len"), syntax.span);
    }
    push_scope(c);
    n.binding = bind(c, syntax.name, element, false, syntax.span, false);
    enter_loop(c);
    n.yes = check_block(c, syntax.yes, false);
    leave_loop(c);
    pop_scope(c);
    return n;
}


// Backend APIs accept checked IDs/records, never syntax IDs.
fn emit(c: Context, line: String) -> Unit effects { state } {
    strings_push(c.output, line + "\n");
}
fn ctype(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == int32_type() { return "int32_t"; }
    if t == foreign_handle_type() { return "v_foreign_handle*"; }
    if t == float_type() {
        return "double";
    }
    if t == int_type() {
        return "int64_t";
    }
    if t == bool_type() {
        return "int";
    }
    if t == string_type() {
        return "v_string";
    }
    if t == unit_type() {
        return "uint8_t";
    }
    if t == ints_type() {
        return "v_int_list*";
    }
    if t == strings_type() {
        return "v_string_list*";
    }
    let info = type_info(c, t);
    if info.kind == 75 {
        if list_len(info.arguments) == 1 {
            return "v_list*";
        }
        return "v_dict*";
    }
    if info.template_index >= 0 {
        return "v_g_type_" + num(type_number(t));
    }
    if str_len(info.name) > 0 && str_byte(info.name, 0) == 64 {
        return "v_m_type_" + num(type_number(t));
    }
    return "v_e_" + info.name;
}
fn cquote(value: String) -> String effects { state } {
    let parts = strings_new();
    strings_push(parts, "\"");
    var i = 0;
    while i < str_len(value) {
        if i > 0 && i % 512 == 0 {
            strings_push(parts, "\" \"");
        }
        let b = str_byte(value, i);
        strings_push(parts, "\\" + num(b / 64) + num(b / 8 % 8) + num(b % 8));
        i = i + 1;
    }
    strings_push(parts, "\"");
    return strings_join(parts, "");
}
fn location(c: Context, span: Span) -> String effects { state } {
    return cquote(filename_at(c, span.start)) + ", " + num(line_at(c, span.start)) + ", " + num(column_at(c, span.start));
}
fn local_name(binding: SymbolId) -> String {
    return "v_l_" + num(symbol_number(binding));
}
fn temp(c: Context, t: TypeId, value: String) -> String effects { state, io, process } {
    return raw_temp(c, ctype(c, t), value);
}
fn raw_temp(c: Context, type_name: String, value: String) -> String effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.temporary = ctl.temporary + 1;
    list_set(c.control, 0, ctl);
    let name = "v_t_" + num(ctl.temporary);
    emit(c, type_name + " " + name + " = " + value +";");
    return name;
}
fn signature(c: Context, f: CheckedFunction) -> String effects { state, io, process } {
    let sig = symbol_info(c, f.symbol);
    let parts = strings_new();
    var i = 0;
    while i < list_len(f.parameters) {
        let id = list_get(f.parameters, i);
        strings_push(parts, ctype(c, symbol_info(c, id).type_id) + " " + local_name(id));
        i = i + 1;
    }
    var params = strings_join(parts, ", ");
    if strings_len(parts) == 0 {
        params = "void";
    }
    return "static " + ctype(c, sig.type_id) + " " + function_name(c, f.symbol) + "("+ params +")";
}
fn zero_value(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == string_type() {
        return "v_text(\"\", 0)";
    }
    let kind = type_kind(c, t);
    if kind == 0 || kind == 75 {
        return "0";
    }
    return "("+ ctype(c, t) + "){0}";
}
fn emit_arguments(c: Context, args: List<ExprId>) -> StringList effects { state, io, process } {
    let parts = strings_new();
    for i in 0 .. list_len(args) {
        strings_push(parts, emit_expr(c, list_get(args, i)));
    }
    return parts;
}
fn emit_expr(c: Context, id: ExprId) -> String effects { state, io, process } {
    let n = checked_expr(c, id);
    let k = n.kind;
    let t = n.type_id;
    let value = n.text;
    if k == 117 {
        return temp(c, t, value);
    }
    if k == 101 {
        if value == "-9223372036854775808" {
            return temp(c, t, "INT64_MIN");
        }
        if str_byte(value, 0) == 45 {
            return temp(c, t, "(-INT64_C(" + str_slice(value, 1, str_len(value)) + "))");
        }
        return temp(c, t, "INT64_C(" + value +")");
    }
    if k == 102 {
        if value == "true" {
            return temp(c, t, "1");
        }
        return temp(c, t, "0");
    }
    if k == 103 {
        return temp(c, t, "v_text(" + cquote(value) + ", " + num(str_len(value)) +")");
    }
    if k == 109 {
        return temp(c, t, "0");
    }
    if k == 104 {
        return temp(c, t, local_name(n.symbol));
    }
    if k == 110 {
        return temp(c, t, emit_expr(c, n.left) + ".v_m_" + symbol_info(c, n.symbol).name);
    }
    if k == 115 {
        return emit_interpolation(c, n);
    }
    if k == 116 {
        return emit_formatted_value(c, n);
    }
    if k == 113 {
        return emit_match_expression(c, n);
    }
    if k == 114 {
        return emit_propagation(c, n);
    }
    if k == 112 {
        let args = emit_arguments(c, n.arguments);
        let r = temp(c, t, "{0}");
        var i = 0;
        while i < list_len(n.arguments) {
            emit(c, r + ".v_m_" + symbol_info(c, list_get(n.fields, i)).name + " = " + strings_get(args, i) +";");
            i = i + 1;
        }
        return r;
    }
    if k == 105 {
        let arg = emit_expr(c, n.left);
        if value == "-" {
            if t == float_type() {
                return temp(c, t, "(-" + arg +")");
            }
            return temp(c, t, "v_neg(" + arg + ", " + location(c, n.span) +")");
        }
        return temp(c, t, "(!" + arg +")");
    }
    if k == 106 {
        var left = emit_expr(c, n.left);
        if value == "&&" || value == "||" {
            let r = temp(c, t, left);
            var test = r;
            if value == "||" {
                test = "!"+ r;
            }
            emit(c, "if (" + test + ") {");
            let right = emit_expr(c, n.right);
            emit(c, r + " = " + right +";");
            emit(c, "}");
            return r;
        }
        var right = emit_expr(c, n.right);
        var arithmetic = "";
        let operand_type = checked_expr(c, n.left).type_id;
        if operand_type == float_type() {
            return temp(c, t,"("+ left + " " + value + " " + right +")");
        }
        if type_kind(c, operand_type) == 77 {
            left = left + ".v_m_value";
            right = right + ".v_m_value";
        }
        if value == "+" && t == string_type() {
            return temp(c, t, "v_str_concat(" + left + ", " + right + ", " + location(c, n.span) +")");
        }
        if value == "+" {
            arithmetic = "add";
        } else if value == "-" {
            arithmetic = "sub";
        } else if value == "*" {
            arithmetic = "mul";
        } else if value == "/" {
            arithmetic = "div";
        } else if value == "%" {
            arithmetic = "rem";
        }
        if arithmetic != "" {
            return temp(c, t, "v_" + arithmetic + "("+ left + ", " + right + ", " + location(c, n.span) +")");
        }
        if scalar_type(c, operand_type) == string_type() {
            var code = "v_string_eq(" + left + ", " + right +")";
            if value == "!=" {
                code = "!"+ code;
            }
            return temp(c, t, code);
        }
        return temp(c, t,"("+ left + " " + value + " " + right +")");
    }
    if k == 107 {
        let args = emit_arguments(c, n.arguments);
        let sig = symbol_info(c, n.symbol);
        if sig.builtin {
            return temp(c, t, emit_builtin(c, n, args));
        }
        if sig.foreign_library != "" { return emit_foreign(c, n, args); }
        return temp(c, t, cc_call(function_name(c, n.symbol), args));
    }
    if k == 108 {
        let args = emit_arguments(c, n.arguments);
        let tag = symbol_info(c, n.symbol).tag;
        let r = temp(c, t, "{0}");
        emit(c, r + ".tag = " + num(tag) +";");
        var i = 0;
        while i < strings_len(args) {
            emit(c, r + ".data.k" + num(tag) + ".f" + num(i) + " = " + strings_get(args, i) +";");
            i = i + 1;
        }
        return r;
    }
    eprint("velac: internal error: invalid checked expression kind");
    exit(70);
    return "";
}
fn emit_contracts(c: Context, items: List<ExprId>, kind: String) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(items) {
        let id = list_get(items, i);
        let n = checked_expr(c, id);
        let value = emit_expr(c, id);
        let message = cquote(kind + " failed: " + str_slice(c.source_text, n.span.start, n.span.end));
        emit(c, "if (!" + value + ") v_panic(" + location(c, n.span) + ", " + message + ");");
    }
}
fn emit_block(c: Context, items: List<StmtId>) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(items) {
        emit_statement(c, list_get(items, i));
    }
}
fn emit_statement(c: Context, id: StmtId) -> Unit effects { state, io, process } {
    let n = checked_stmt(c, id);
    let k = n.kind;
    if k == 130 || k == 131 {
        let value = emit_expr(c, n.value);
        var name = local_name(n.binding);
        if k == 130 {
            name = ctype(c, symbol_info(c, n.binding).type_id) + " " + name;
        }
        emit(c, name + " = " + value +";");
    } else if k == 138 {
        let value = emit_expr(c, n.value);
        emit(c, emit_lvalue(c, n.target) + " = " + value +";");
    } else if k == 133 {
        let value = emit_expr(c, n.value);
        emit(c, "(void)" + value +";");
    } else if k == 132 {
        emit(c, "{");
        let value = emit_expr(c, n.value);
        emit_return_value(c, value);
        emit(c, "}");
    } else if k == 134 {
        let cond = emit_expr(c, n.value);
        emit(c, "if (" + cond + ") {");
        emit_block(c, n.yes);
        if list_len(n.no) > 0 {
            emit(c, "} else {");
            emit_block(c, n.no);
        }
        emit(c, "}");
    } else if k == 135 {
        let label = enter_emitted_loop(c);
        emit(c, "for (;;) {");
        let cond = emit_expr(c, n.value);
        emit(c, "if (!" + cond + ") break;");
        emit_block(c, n.yes);
        emit(c, label + "_continue:; }");
        leave_emitted_loop(c, label);
    } else if k == 139 || k == 140 {
        let label = list_get(c.loop_labels, list_len(c.loop_labels) - 1);
        if k == 139 {
            emit(c, "goto " + label + "_break;");
        } else {
            emit(c, "goto " + label + "_continue;");
        }
    } else if k == 141 {
        emit_for(c, n);
    } else if k == 136 {
        let value = emit_expr(c, n.value);
        emit(c, "switch (" + value + ".tag) {");
        var i = 0;
        while i < list_len(n.arms) {
            let arm = list_get(n.arms, i);
            let tag = symbol_info(c, arm.variant).tag;
            emit(c, "case " + num(tag) + ": {");
            var j = 0;
            while j < list_len(arm.bindings) {
                let b = list_get(arm.bindings, j);
                if has_symbol(b) {
                    emit(c, ctype(c, symbol_info(c, b).type_id) + " " + local_name(b) + " = " + value + ".data.k" + num(tag) + ".f" + num(j) +";");
                }
                j = j + 1;
            }
            emit_block(c, arm.body);
            emit(c, "break; }");
            i = i + 1;
        }
        emit(c, "default: v_panic(" + location(c, n.span) + ", \"invalid enum tag\");");
        emit(c, "}");
    } else {
        eprint("velac: internal error: invalid checked statement kind");
        exit(70);
    }
}
fn emit_types(c: Context) -> Unit effects { state, io, process } {
    var i = 0;
    while i < list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        let t = type_info(c, id);
        if t.kind == 76 || t.kind == 77 {
            emit(c, "typedef struct {");
            if list_len(t.fields) == 0 {
                emit(c, "uint8_t empty;");
            }
            var j = 0;
            while j < list_len(t.fields) {
                let field = symbol_info(c, list_get(t.fields, j));
                emit(c, ctype(c, field.type_id) + " v_m_" + field.name +";");
                j = j + 1;
            }
            emit(c, "} " + ctype(c, id) +";");
        } else {
            emit(c, "typedef struct { int tag; union {");
            var j = 0;
            while j < list_len(t.variants) {
                let v = symbol_info(c, list_get(t.variants, j));
                emit(c, "struct {");
                if list_len(v.parameters) == 0 {
                    emit(c, "uint8_t empty;");
                }
                var k = 0;
                while k < list_len(v.parameters) {
                    emit(c, ctype(c, symbol_info(c, list_get(v.parameters, k)).type_id) + " f" + num(k) +";");
                    k = k + 1;
                }
                emit(c, "} k" + num(v.tag) +";");
                j = j + 1;
            }
            emit(c, "} data; } " + ctype(c, id) +";");
        }
        i = i + 1;
    }
}
fn generate(c: Context) -> String effects { state, io, process } {
    let entry = find_symbol(c, c.signatures, "main");
    if !has_symbol(entry) {
        bad(c, "E207", "build/run requires main; use vela test for test-only modules.", empty_span());
    }
    return generate_entry(c, entry);
}
fn generate_entry(c: Context, entry: SymbolId) -> String effects { state, io, process } {
    strings_truncate(c.output, 0);
    var initial = list_get(c.control, 0);
    initial.temporary = 0;
    list_set(c.control, 0, initial);
    emit(c, "/* Generated by the Vela typed self-hosted compiler. */");
    emit(c, runtime_source());
    emit_types(c);
    emit(c, "static v_e_IntResult v_result(v_parse_result p) { v_e_IntResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_Int32Result v_int32_result(v_parse_result p) { v_e_Int32Result r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = (int32_t)p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_FloatResult v_float_result(v_float_parse p) { v_e_FloatResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_ReadResult v_read_result(v_bounded_read p) { v_e_ReadResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.value; else if (p.kind == 2) r.data.k2.f0 = p.value; return r; }");
    emit(c, "static v_e_ProcessResult v_process_result_value(v_process_result p) { v_e_ProcessResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.code; else if (p.kind == 2) r.data.k2.f0 = p.message; return r; }");
    emit(c, "static v_e_StringResult v_string_result(v_io_result p) { v_e_StringResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.value; return r; }");
    emit(c, "static v_e_WriteResult v_write_result(v_io_result p) { v_e_WriteResult r = {0}; r.tag = p.ok ? 0 : 1; if (!p.ok) r.data.k1.f0 = p.value; return r; }");
    var i = 0;
    var main_index = 0;
    while i < list_len(c.functions) {
        emit(c, signature(c, list_get(c.functions, i)) +";");
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.functions) {
        let f = list_get(c.functions, i);
        let sig = symbol_info(c, f.symbol);
        if f.symbol == entry {
            main_index = i;
        }
        var ctl = list_get(c.control, 0);
        ctl.function_index = i;
        list_set(c.control, 0, ctl);
        emit(c, signature(c, f) + " {");
        emit_contracts(c, f.preconditions, "precondition");
        emit_block(c, f.body);
        emit(c, "v_panic(" + location(c, f.span) + ", \"unreachable function end\");");
        emit(c, "return " + zero_value(c, sig.type_id) +";");
        emit(c, "}");
        i = i + 1;
    }
    let main_func = list_get(c.functions, main_index);
    emit(c, "int main(int argc, char **argv) { v_argc = argc; v_argv = argv; v_runtime_init(); int code = 0;");
    if symbol_info(c, main_func.symbol).type_id == int_type() {
        emit(c, "code = v_exit_code(" + function_name(c, entry) + "(), " + location(c, main_func.span) + ");");
    } else {
        emit(c, "(void)" + function_name(c, entry) + "();");
    }
    emit(c, "if (fflush(stdout) == EOF) v_panic(" + location(c, main_func.span) + ", \"failed to flush standard output\");");
    emit(c, "return code; }");
    return strings_join(c.output, "");
}
fn function_name(c: Context, id: SymbolId) -> String effects { state, io, process } {
    let sig = symbol_info(c, id);
    if sig.template_index >= 0 {
        return "v_g_f_" + num(symbol_number(id));
    }
    if str_len(sig.name) > 0 && str_byte(sig.name, 0) == 64 {
        return "v_m_f_" + num(symbol_number(id));
    }
    return "v_f_" + sig.name;
}
fn emit_return_value(c: Context, value: String) -> Unit effects { state, io, process } {
    let f = list_get(c.functions, list_get(c.control, 0).function_index);
    let name = local_name(f.result_binding);
    emit(c, ctype(c, symbol_info(c, f.result_binding).type_id) + " " + name + " = " + value +";");
    emit_contracts(c, f.postconditions, "postcondition");
    emit(c, "return " + name +";");
}
fn emit_arm_bindings(c: Context, arm: CheckedArm, value: String) -> Unit effects { state, io, process } {
    let tag = symbol_info(c, arm.variant).tag;
    var i = 0;
    while i < list_len(arm.bindings) {
        let b = list_get(arm.bindings, i);
        if has_symbol(b) {
            emit(c, ctype(c, symbol_info(c, b).type_id) + " " + local_name(b) + " = " + value + ".data.k" + num(tag) + ".f" + num(i) +";");
        }
        i = i + 1;
    }
}
fn emit_match_expression(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let value = emit_expr(c, n.left);
    let result_value = temp(c, n.type_id, zero_value(c, n.type_id));
    emit(c, "switch (" + value + ".tag) {");
    var i = 0;
    while i < list_len(n.arms) {
        let arm = list_get(n.arms, i);
        emit(c, "case " + num(symbol_info(c, arm.variant).tag) + ": {");
        emit_arm_bindings(c, arm, value);
        let selected = emit_expr(c, arm.value);
        emit(c, result_value + " = " + selected + "; break; }");
        i = i + 1;
    }
    emit(c, "default: v_panic(" + location(c, n.span) + ", \"invalid enum tag\"); }");
    return result_value;
}
fn emit_propagation(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let value = emit_expr(c, n.left);
    let failure = symbol_info(c, n.symbol);
    emit(c, "if (" + value + ".tag == 1) {");
    let propagated = temp(c, failure.owner, "{0}");
    emit(c, propagated + ".tag = 1;");
    if list_len(failure.parameters) == 1 {
        emit(c, propagated + ".data.k1.f0 = " + value + ".data.k1.f0;");
    }
    emit_return_value(c, propagated);
    emit(c, "}");
    return temp(c, n.type_id, value + ".data.k0.f0");
}
fn enter_emitted_loop(c: Context) -> String effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.temporary = ctl.temporary + 1;
    list_set(c.control, 0, ctl);
    let label = "v_loop_" + num(ctl.temporary);
    list_push(c.loop_labels, label);
    return label;
}
fn leave_emitted_loop(c: Context, label: String) -> Unit effects { state } {
    emit(c, label + "_break:;");
    list_truncate(c.loop_labels, list_len(c.loop_labels) - 1);
}
fn emit_for(c: Context, n: CheckedStmt) -> Unit effects { state, io, process } {
    let value = emit_expr(c, n.value);
    let label = enter_emitted_loop(c);
    let element = ctype(c, symbol_info(c, n.binding).type_id);
    let loc = location(c, n.span);
    var counter = "";
    var end_value = "";
    var condition_text = "";
    var item = "";
    if n.mode != 0 {
        end_value = emit_expr(c, n.target);
        counter = temp(c, int_type(), value);
        condition_text = counter + " < " + end_value;
        if n.mode == 2 {
            condition_text = counter + " <= " + end_value;
        }
        item = counter;
    } else {
        end_value = temp(c, int_type(), value + "->length");
        let snapshot = label + "_items";
        emit(c, element + " *" + snapshot + " = (" + element + "*)v_copy_items(" + value + "->data, " + end_value + ", sizeof(" + element + "), " + loc + ");");
        counter = temp(c, int_type(), "0");
        condition_text = counter + " < " + end_value;
        item = snapshot + "[" + counter + "]";
    }
    emit(c, "while (" + condition_text + ") {");
    emit(c, element + " " + local_name(n.binding) + " = " + item +";");
    emit_block(c, n.yes);
    emit(c, label + "_continue:;");
    if n.mode == 2 {
        emit(c, "if (" + counter + " == " + end_value + ") break;");
    }
    emit(c, counter + " = v_add(" + counter + ", 1, " + loc + "); }");
    leave_emitted_loop(c, label);
}
fn emit_formatted_value(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    var value = emit_expr(c, n.left);
    let original = checked_expr(c, n.left).type_id;
    let scalar = scalar_type(c, original);
    if type_kind(c, original) == 77 {
        value = value + ".v_m_value";
    }
    if scalar == string_type() {
        return temp(c, string_type(), value);
    }
    if scalar == bool_type() {
        return temp(c, string_type(),"("+ value + " ? v_text(\"true\", 4) : v_text(\"false\", 5))");
    }
    if scalar == float_type() {
        return temp(c, string_type(), "v_float_to_string(" + value + ", " + location(c, n.span) +")");
    }
    return temp(c, string_type(), "v_int_to_string(" + value + ", " + location(c, n.span) +")");
}
fn emit_interpolation(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let loc = location(c, n.span);
    let parts = temp(c, strings_type(), "v_strings_new(" + loc +")");
    for i in 0 .. list_len(n.arguments) {
        let value = emit_expr(c, list_get(n.arguments, i));
        emit(c, "v_strings_push(" + parts + ", " + value + ", " + loc + ");");
    }
    return temp(c, string_type(), "v_strings_join(" + parts + ", v_text(\"\", 0), " + loc +")");
}


// Intrinsic lowering uses resolved signatures and checked arguments only.
fn emit_lvalue(c: Context, id: ExprId) -> String effects { state, io, process } {
    let n = checked_expr(c, id);
    if n.kind == 104 {
        return local_name(n.symbol);
    }
    return emit_lvalue(c, n.left) + ".v_m_" + symbol_info(c, n.symbol).name;
}
fn cc_call(name: String, args: StringList) -> String effects { state } {
    return name + "("+ strings_join(args, ", ") +")";
}
fn emit_builtin(c: Context, n: CheckedExpr, args: StringList) -> String effects { state, io, process } {
    let sig = symbol_info(c, n.symbol);
    let abi = sig.abi;
    let t = n.type_id;
    let loc = location(c, n.span);
    if abi == "print" || abi == "format" {
        let original = checked_expr(c, list_get(n.arguments, 0)).type_id;
        let scalar = scalar_type(c, original);
        var value = strings_get(args, 0);
        if type_kind(c, original) == 77 {
            value = value + ".v_m_value";
        }
        strings_set(args, 0, value);
        strings_push(args, loc);
        if abi == "print" {
            return cc_call("v_print_" + type_name(c, scalar), args);
        }
        if scalar == string_type() {
            return value;
        }
        if scalar == bool_type() {
            return "("+ value + " ? v_text(\"true\", 4) : v_text(\"false\", 5))";
        }
        if scalar == float_type() { return cc_call("v_float_to_string", args); }
        return cc_call("v_int_to_string", args);
    }
    if str_len(abi) >= 5 && str_slice(abi, 0, 5) == "list_" {
        if abi == "list_new" {
            strings_push(args, "sizeof(" + ctype(c, list_get(type_info(c, t).arguments, 0)) +")");
        }
        if abi == "list_push" {
            strings_set(args, 1, "&" + strings_get(args, 1));
        }
        if abi == "list_set" {
            strings_set(args, 2, "&" + strings_get(args, 2));
        }
        strings_push(args, loc);
        let code = cc_call("v_" + abi, args);
        if abi == "list_get" {
            return "*(" + ctype(c, t) + "*)" + code;
        }
        return code;
    }
    if str_len(abi) >= 5 && str_slice(abi, 0, 5) == "dict_" {
        if abi == "dict_new" {
            let types = type_info(c, t).arguments;
            let scalar = scalar_type(c, list_get(types, 0));
            strings_push(args, "sizeof(" + ctype(c, scalar) +")");
            strings_push(args, "sizeof(" + ctype(c, list_get(types, 1)) +")");
            var kind = 1;
            if scalar == bool_type() {
                kind = 2;
            } else if scalar == string_type() {
                kind = 3;
            }
            strings_push(args, num(kind));
        } else if abi != "dict_len" {
            let collection = checked_expr(c, list_get(n.arguments, 0)).type_id;
            let key_type = list_get(type_info(c, collection).arguments, 0);
            var key = strings_get(args, 1);
            if type_kind(c, key_type) == 77 {
                key = key + ".v_m_value";
            }
            strings_set(args, 1, "&" + key);
            if abi == "dict_set" || abi == "dict_get_or" {
                strings_set(args, 2, "&" + strings_get(args, 2));
            }
        }
        strings_push(args, loc);
        let code = cc_call("v_" + abi, args);
        if abi == "dict_get" || abi == "dict_get_or" {
            return "*(" + ctype(c, t) + "*)" + code;
        }
        return code;
    }
    if abi != "plain" && abi != "int_result" {
        strings_push(args, loc);
    }
    var code = cc_call("v_" + sig.name, args);
    if abi == "int_result" {
        code = "v_result(" + code +")";
    }
    if abi == "string_result" {
        code = "v_string_result(" + code +")";
    }
    if abi == "write_result" {
        code = "v_write_result(" + code +")";
    }
    if abi == "float_result" { code = "v_float_result(" + code + ")"; }
    if abi == "int32_result" { code = "v_int32_result(" + code + ")"; }
    if abi == "read_result" { code = "v_read_result(" + code + ")"; }
    if abi == "process_result" { code = "v_process_result_value(" + code + ")"; }
    return code;
}
fn foreign_ctype(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == foreign_handle_type() { return "void*"; }
    if t == string_type() { return "VelaBytes"; }
    if t == bool_type() { return "int32_t"; }
    if t == unit_type() { return "void"; }
    return ctype(c, t);
}
fn emit_foreign(c: Context, n: CheckedExpr, args: StringList) -> String effects { state, io, process } {
    let sig = symbol_info(c, n.symbol);
    let loc = location(c, n.span);
    let library = raw_temp(c, "v_foreign_library*", "v_foreign_require(" + cquote(sig.foreign_library) + ", " + loc + ")");
    let types = strings_new();
    for i in 0 .. list_len(sig.parameters) {
        let t = symbol_info(c, list_get(sig.parameters, i)).type_id;
        strings_push(types, foreign_ctype(c, t));
        if t == foreign_handle_type() {
            strings_set(args, i, raw_temp(c, "void*", "v_foreign_unwrap(" + strings_get(args, i) + ", " + library + ", " + loc + ")"));
        } else if t == string_type() {
            strings_set(args, i, "(VelaBytes){" + strings_get(args, i) + ".data, (uint64_t)" + strings_get(args, i) + ".length}");
        }
    }
    if strings_len(types) == 0 { strings_push(types, "void"); }
    let pointer = raw_temp(c, "v_foreign_proc", "v_foreign_symbol(" + library + ", " + cquote(sig.foreign_name) + ", " + loc + ")");
    let environment = raw_temp(c, "fenv_t", "{0}");
    emit(c, "if (fegetenv(&" + environment + ")) v_panic(" + loc + ", \"cannot save floating-point environment\");");
    let call = "((" + foreign_ctype(c, n.type_id) + " (*)(" + strings_join(types, ", ") + "))" + pointer + ")(" + strings_join(args, ", ") + ")";
    var returned = "0";
    if n.type_id == unit_type() { emit(c, call + ";"); }
    else { returned = raw_temp(c, foreign_ctype(c, n.type_id), call); }
    emit(c, "if (fesetenv(&" + environment + ")) v_panic(" + loc + ", \"cannot restore floating-point environment\");");
    if n.type_id == foreign_handle_type() { return temp(c, n.type_id, "v_foreign_wrap(" + returned + ", " + library + ", " + loc + ")"); }
    if n.type_id == bool_type() { emit(c, "if (" + returned + " != 0 && " + returned + " != 1) v_panic(" + loc + ", \"foreign Bool must be 0 or 1\");"); }
    return returned;
}


// Formatting uses concrete token spelling and preserved comment spans.
fn format_tokens(c: Context) -> List<Token> effects { state } {
    let tokens = list_new<Token>();
    var i = 0;
    var j = 0;
    while i + 1 < list_len(c.tokens) || j < list_len(c.comments) {
        if j < list_len(c.comments) && (i + 1 >= list_len(c.tokens) || list_get(c.comments, j).span.start < list_get(c.tokens, i).span.start) {
            list_push(tokens, list_get(c.comments, j));
            j = j + 1;
        } else {
            list_push(tokens, list_get(c.tokens, i));
            i = i + 1;
        }
    }
    return tokens;
}
fn format_line(parts: StringList, line: String, indentation: Int) -> Unit effects { state } {
    if line == "" {
        return;
    }
    var prefix = "";
    var i = 0;
    while i < indentation {
        prefix = prefix + "    ";
        i = i + 1;
    }
    strings_push(parts, prefix + line + "\n");
}
fn format_generic(tokens: List<Token>, index: Int) -> Bool effects { state } {
    if index == 0 || list_get(tokens, index - 1).kind != 50 {
        return false;
    }
    let previous = list_get(tokens, index - 1).text;
    if index >= 2 {
        let declaration = list_get(tokens, index - 2).text;
        if declaration == "fn" || declaration == "struct" || declaration == "enum" {
            return true;
        }
    }
    if previous == "List" || previous == "Dict" {
        return true;
    }
    var i = index;
    var depth = 0;
    while i < list_len(tokens) {
        let t = list_get(tokens, i);
        if t.kind == 55 {
            i = i + 1;
        } else {
            if t.text == "<" {
                depth = depth + 1;
            } else if t.text == ">" {
                depth = depth - 1;
                if depth == 0 {
                    var following = i + 1;
                    while following < list_len(tokens) && list_get(tokens, following).kind == 55 {
                        following = following + 1;
                    }
                    if following >= list_len(tokens) {
                        return false;
                    }
                    let next = list_get(tokens, following).text;
                    return next == "("|| next =="::"|| next ==")" || next =="," || next == "{" || next == "}"
                    || next == "=" || next ==";" || next == ">" || next == "effects" || next == "requires" || next == "ensures";
                }
            } else if t.kind != 50 && t.text !="," {
                return false;
            }
            i = i + 1;
        }
    }
    return false;
}
fn format_unary(previous: String, token: String) -> Bool {
    if token == "!" {
        return true;
    }
    return token == "-"&& (previous == ""|| previous == "("|| previous =="," || previous ==":" || previous == "=" || previous == "return" || previous == "requires" || previous == "ensures" || previous == "if" || previous == "while" || precedence(previous) >= 0 || previous == "!"|| previous == "=>");
}
fn format_space(previous: String, token: String, previous_unary: Bool, generic: Bool, previous_open_generic: Bool) -> Bool {
    if previous == ""|| previous_unary || previous_open_generic || generic {
        return false;
    }
    if token =="?" || token ==")" || token =="," || token ==";" || token =="."|| token =="::"|| token ==":" {
        return false;
    }
    if previous == "("|| previous =="."|| previous =="::" {
        return false;
    }
    if token == "("&& previous == ">" {
        return false;
    }
    if token == "("&& previous != "if" && previous != "while" && previous != "return" && previous != "requires" && previous != "ensures" && previous != "=" && precedence(previous) < 0 {
        return false;
    }
    return true;
}
fn format_source(c: Context) -> String effects { state, io, process } {
    let tokens = format_tokens(c);
    let parts = strings_new();
    let braces = ints_new();
    var line = "";
    var indent = 0;
    var previous = "";
    var previous_end = 0;
    var previous_unary = false;
    var previous_open_generic = false;
    var closed_inline = false;
    var declaration = false;
    var parens = 0;
    var generics = 0;
    var i = 0;
    while i < list_len(tokens) {
        let t = list_get(tokens, i);
        let raw = str_slice(c.source_text, t.span.start, t.span.end);
        let word = t.text;
        if t.kind == 55 {
            if line != ""&& line_at(c, previous_end) != line_at(c, t.span.start) {
                format_line(parts, line, indent);
                line = "";
            }
            if line != "" {
                line = line + " ";
            }
            line = line + raw;
            format_line(parts, line, indent);
            line = "";
        } else {
            if previous == "}"
            && !closed_inline && word != "else" && word !=";" && word !="," && word !=")" && word != "}"
            {
                format_line(parts, line, indent);
                line = "";
            }
            if t.kind == 50 && (word == "struct" || word == "enum") {
                declaration = true;
            }
            if t.kind == 53 && word == "{" {
                var kind = 0;
                if previous == "effects" { kind = 1;
                } else if declaration {
                    kind = 2;
                    declaration = false;
                }
                if line != "" {
                    line = line + " ";
                }
                line = line + "{";
                ints_push(braces, kind);
                if kind != 1 {
                    if i + 1 >= list_len(tokens) || list_get(tokens, i + 1).text != "}"
                    {
                        format_line(parts, line, indent);
                        line = "";
                    }
                    indent = indent + 1;
                }
            } else if t.kind == 53 && word == "}"
            {
                let kind = ints_get(braces, ints_len(braces) - 1);
                ints_truncate(braces, ints_len(braces) - 1);
                closed_inline = kind == 1;
                if kind != 1 {
                    if previous != "{" {
                        format_line(parts, line, indent);
                        line = "";
                    }
                    indent = indent - 1;
                    line = line + "}";
                } else {
                    if previous != "{" && line != "" {
                        line = line + " ";
                    }
                    line = line + "}";
                }
            } else {
                var generic = false;
                var open_generic = false;
                if t.kind == 53 && word == "<" && (generics > 0 || format_generic(tokens, i)) {
                    generic = true;
                    open_generic = true;
                    generics = generics + 1;
                } else if t.kind == 53 && word == ">" && generics > 0 {
                    generic = true;
                    generics = generics - 1;
                }
                let unary = format_unary(previous, word);
                if line != ""&& format_space(previous, word, previous_unary, generic, previous_open_generic) {
                    line = line + " ";
                }
                line = line + raw;
                if t.kind == 53 && word == "(" {
                    parens = parens + 1;
                } else if t.kind == 53 && word ==")" {
                    parens = parens - 1;
                }
                var newline = t.kind == 53 && word ==";";
                if t.kind == 53 && word =="," && ints_len(braces) > 0 && ints_get(braces, ints_len(braces) - 1) == 2 && parens == 0 && generics == 0 {
                    newline = true;
                }
                if newline {
                    let inline_comment = i + 1 < list_len(tokens) && list_get(tokens, i + 1).kind == 55 && line_at(c, list_get(tokens, i + 1).span.start) == line_at(c, t.span.end);
                    if !inline_comment {
                        format_line(parts, line, indent);
                        line = "";
                    }
                }
                previous_unary = unary;
                previous_open_generic = open_generic;
            }
            if word == "{" || word == "}"
            {
                previous_unary = false;
                previous_open_generic = false;
            }
            previous = word;
            previous_end = t.span.end;
        }
        i = i + 1;
    }
    format_line(parts, line, indent);
    let formatted = strings_join(parts, "");
    let checked = make_context(formatted, c.source_name, c.json_mode);
    lex(checked);
    parse_module(checked);
    if list_len(checked.tokens) != list_len(c.tokens) || list_len(checked.comments) != list_len(c.comments) {
        eprint("velac: internal formatter token mismatch");
        exit(70);
    }
    i = 0;
    while i < list_len(c.tokens) {
        let a = list_get(c.tokens, i);
        let b = list_get(checked.tokens, i);
        if a.kind != b.kind || a.text != b.text || str_slice(c.source_text, a.span.start, a.span.end) != str_slice(formatted, b.span.start, b.span.end) {
            eprint("velac: internal formatter token mismatch");
            exit(70);
        }
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.comments) {
        if list_get(c.comments, i).text != list_get(checked.comments, i).text {
            eprint("velac: internal formatter comment mismatch");
            exit(70);
        }
        i = i + 1;
    }
    return formatted;
}


fn io_value(r: StringResult) -> String effects { io, process } {
    return io_result(from_string(r), "");
}
fn io_done(r: WriteResult) -> Unit effects { io, process } {
    let success = io_result(from_write(r), false);
}
fn ignored_write(result_value: WriteResult) -> Unit {
    match result_value {
        WriteResult::Ok => {}
        WriteResult::Err(_) => {}
    }
}
fn symbol_index(c: Context) -> String effects { state, io, process } {
    let enums = strings_new();
    let records = strings_new();
    let distincts = strings_new();
    var i = 0;
    while i < list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        let t = type_info(c, id);
        if t.kind == 77 {
            strings_push(distincts, "{\"name\":" + json_string(t.name) + ",\"base\":" + json_string(type_name(c, t.base)) + "}");
        } else if t.kind == 76 {
            let fields = strings_new();
            var j = 0;
            while j < list_len(t.fields) {
                let field = symbol_info(c, list_get(t.fields, j));
                strings_push(fields, "{\"name\":" + json_string(field.name) + ",\"type\":" + json_string(type_name(c, field.type_id)) + "}");
                j = j + 1;
            }
            strings_push(records, "{\"name\":" + json_string(t.name) + ",\"fields\":[" + strings_join(fields,",") + "]}");
        } else {
            let variants = strings_new();
            var j = 0;
            while j < list_len(t.variants) {
                let v = symbol_info(c, list_get(t.variants, j));
                let fields = strings_new();
                var k = 0;
                while k < list_len(v.parameters) {
                    strings_push(fields, json_string(type_name(c, symbol_info(c, list_get(v.parameters, k)).type_id)));
                    k = k + 1;
                }
                strings_push(variants, "{\"name\":" + json_string(v.name) + ",\"fields\":[" + strings_join(fields,",") + "]}");
                j = j + 1;
            }
            strings_push(enums, "{\"name\":" + json_string(t.name) + ",\"variants\":[" + strings_join(variants,",") + "]}");
        }
        i = i + 1;
    }
    let functions = strings_new();
    let tests = strings_new();
    i = 0;
    while i < list_len(c.functions) {
        let f = list_get(c.functions, i);
        let sig = symbol_info(c, f.symbol);
        var test_name = "";
        for declaration in c.bound_functions {
            if declaration.name == sig.name {
                test_name = declaration.test_name;
            }
        }
        if test_name != "" {
            strings_push(tests, "{\"name\":" + json_string(test_name) + ",\"source\":" + json_string(filename_at(c, f.span.start)) + ",\"module_id\":" + to_string(source_unit_at(c, f.span.start)) + ",\"span\":" + span_json(c, f.span) + ",\"effects\":" + effect_json(sig.effect_mask) + "}");
            i = i + 1;
            continue;
        }
        let params = strings_new();
        var j = 0;
        while j < list_len(f.parameters) {
            let b = symbol_info(c, list_get(f.parameters, j));
            strings_push(params, "{\"name\":" + json_string(b.name) + ",\"type\":" + json_string(type_name(c, b.type_id)) + "}");
            j = j + 1;
        }
        strings_push(functions, "{\"source\":" + json_string(filename_at(c, f.span.start)) + ",\"module_id\":" + to_string(source_unit_at(c, f.span.start)) + ",\"name\":" + json_string(sig.name) + ",\"parameters\":[" + strings_join(params,",") + "],\"returns\":" + json_string(type_name(c, sig.type_id)) + ",\"effects\":" + effect_json(sig.effect_mask) + ",\"line\":" + num(line_at(c, f.span.start)) + ",\"contracts\":{\"verification\":\"runtime\",\"requires\":" + num(list_len(f.preconditions)) + ",\"ensures\":" + num(list_len(f.postconditions)) + "}}");
        i = i + 1;
    }
    for sig_id in c.signatures {
        let sig = symbol_info(c, sig_id);
        if sig.foreign_library != "" {
            let params = strings_new();
            for id in sig.parameters {
                let parameter = symbol_info(c, id);
                strings_push(params, "{\"name\":" + json_string(parameter.name) + ",\"type\":" + json_string(type_name(c, parameter.type_id)) + "}");
            }
            strings_push(functions, "{\"source\":" + json_string(filename_at(c, sig.span.start)) + ",\"module_id\":" + to_string(source_unit_at(c, sig.span.start)) + ",\"name\":" + json_string(sig.name) + ",\"parameters\":[" + strings_join(params, ",") + "],\"returns\":" + json_string(type_name(c, sig.type_id)) + ",\"effects\":" + effect_json(sig.effect_mask) + ",\"line\":" + num(line_at(c, sig.span.start)) + ",\"foreign\":{\"library\":" + json_string(sig.foreign_library) + ",\"symbol\":" + json_string(sig.foreign_name) + "}}");
        }
    }
    let modules = strings_new();
    for i in 0 .. list_len(c.source_units) {
        let unit = list_get(c.source_units, i);
        strings_push(modules, "{\"id\":" + to_string(i) + ",\"source\":" + json_string(unit.name) + "}");
    }
    return "{\"schema_version\":1,\"modules\":[" + strings_join(modules,",") + "],\"source\":" + json_string(c.source_name) + ",\"enums\":[" + strings_join(enums,",") + "],\"structs\":[" + strings_join(records,",") + "],\"distinct_types\":[" + strings_join(distincts,",") + "],\"functions\":[" + strings_join(functions,",") + "],\"tests\":[" + strings_join(tests,",") + "]}";
}
fn parent_path(path: String) -> String {
    var i = str_len(path);
    while i > 0 {
        i = i - 1;
        let ch = str_byte(path, i);
        if ch == 47 || ch == 92 {
            return str_slice(path, 0, i + 1);
        }
    }
    return".";
}
fn path_key(path: String) -> String effects { state } {
    if platform() != "windows" {
        return path;
    }
    let chars = strings_new();
    var i = 0;
    while i < str_len(path) {
        var b = str_byte(path, i);
        if b >= 65 && b <= 90 {
            b = b + 32;
        }
        if b == 47 {
            b = 92;
        }
        strings_push(chars, str_from_byte(b));
        i = i + 1;
    }
    return strings_join(chars, "");
}
fn compile_native(cfile: String, executable: String, object_file: String) -> Int effects { state, process } {
    var cc = env("VELA_CC");
    var kind = env("VELA_CC_KIND");
    if cc == "" {
        if platform() == "windows" {
            cc = "cl.exe";
        } else {
            cc = "cc";
        }
    }
    if kind == "" {
        if platform() == "windows" {
            kind = "msvc";
        } else {
            kind = "cc";
        }
    }
    let args = strings_new();
    strings_push(args, cc);
    if kind == "msvc" {
        strings_push(args, "/nologo");
        strings_push(args, "/TC");
        strings_push(args, "/std:c11");
        strings_push(args, "/utf-8");
        strings_push(args, "/O2");
        strings_push(args, "/fp:strict");
        strings_push(args, "/W3");
        strings_push(args, "/wd4102");
        strings_push(args, "/MT");
        strings_push(args, cat("/Fo", object_file));
        strings_push(args, cat("/Fe", executable));
        strings_push(args, cfile);
        strings_push(args, "/link");
        strings_push(args, "/INCREMENTAL:NO");
    } else {
        strings_push(args, "-std=c11");
        strings_push(args, "-O2");
        strings_push(args, "-ffp-contract=off");
        strings_push(args, cfile);
        strings_push(args, "-o");
        strings_push(args, executable);
        strings_push(args, "-lm");
    }
    return process_run_to_stderr(args);
}
fn write_atomic_result(path: String, code: String) -> Result<Bool, String> effects { state, io } {
    let absolute = from_string(absolute_path(path))?;
    let dir = from_string(temp_dir(parent_path(absolute)))?;
    let temp_path = dir + "/program.c";
    var saved = from_write(write_file(temp_path, code));
    match saved {
        Result::Ok(_) => {
            saved = from_write(replace_file(temp_path, absolute));
        }
        Result::Err(_) => {}
    }
    ignored_write(remove_file(temp_path));
    ignored_write(remove_dir(dir));
    return saved;
}
fn write_atomic(path: String, code: String) -> Unit effects { state, io, process } {
    let success = io_result(write_atomic_result(path, code), false);
}
fn build_or_run(code: String, output_path: String, arguments: StringList, running: Bool) -> Int effects { state, io, process } {
    return build_or_run_native(code, output_path, arguments, running, list_new<NativeDependency>());
}
fn build_or_run_native(code: String, output_path: String, arguments: StringList, running: Bool, natives: List<NativeDependency>) -> Int effects { state, io, process } {
    var parent = "";
    if !running {
        parent = parent_path(output_path);
    }
    let dir = io_value(temp_dir(parent));
    let cfile = cat(dir, "/program.c");
    let exe = cat(dir, "/program.exe");
    let obj = cat(dir, "/program.obj");
    io_done(write_file(cfile, code));
    var status = compile_native(cfile, exe, obj);
    if status != 0 {
        status = 2;
    }
    if status == 0 {
        var destination = parent_path(output_path);
        if running { destination = dir; }
        match stage_native(natives, destination) {
            Result::Ok(_) => {}
            Result::Err(message) => { eprint(message); status = 2; }
        }
    }
    if status == 0 {
        if running {
            let args = strings_new();
            strings_push(args, exe);
            var i = 0;
            while i < strings_len(arguments) {
                strings_push(args, strings_get(arguments, i));
                i = i + 1;
            }
            status = process_run(args);
        } else {
            match replace_file(exe, output_path) {
                WriteResult::Ok => {}
                WriteResult::Err(message) => {
                    eprint(message);
                    status = 2;
                }
            }
        }
    }
    ignored_write(remove_file(cfile));
    ignored_write(remove_file(obj));
    ignored_write(remove_file(exe));
    if running {
        for native in natives { ignored_write(remove_file(dir + "/" + native.name)); }
    }
    ignored_write(remove_dir(dir));
    if status < 0 || status > 255 {
        eprint("velac: cannot run compiler or program; configure VELA_CC and its environment");
        return 2;
    }
    return status;
}
fn main() -> Int effects { args, state, io, process } {
    if arg_count() == 1 {
        let option = io_value(arg(0));
        if option == "--version" {
            print("Vela 0.7.0 (self-hosted)");
            return 0;
        }
    }
    if arg_count() < 2 {
        eprint("Usage: vela check|symbols|emit-c|build|run|test|fmt|lock SOURCE_OR_PROJECT [-o OUTPUT] [--json] [--check|--write] [-- ARGS]");
        return 2;
    }
    let command = io_value(arg(0));
    let input = io_value(arg(1));
    var output_path = "";
    var source_name = "";
    var json_mode = false;
    let arguments = strings_new();
    var index = 2;
    var rest = false;
    var format_check = false;
    var format_write = false;
    while index < arg_count() {
        let option = io_value(arg(index));
        if rest {
            strings_push(arguments, option);
        } else if option == "--" {
            rest = true;
        } else if option == "--json" {
            json_mode = true;
        } else if command == "fmt" && option == "--check" {
            format_check = true;
        } else if command == "fmt" && option == "--write" {
            format_write = true;
        } else if option == "-o" || option == "--output" || option == "--source-name" {
            index = index + 1;
            let value = io_value(arg(index));
            if option == "--source-name" {
                source_name = value;
            } else {
                output_path = value;
            }
        } else if command == "run" {
            rest = true;
            strings_push(arguments, option);
        } else {
            eprint(cat("Unknown option: ", option));
            return 2;
        }
        index = index + 1;
    }
    if command != "check" && command != "symbols" && command != "emit-c" && command != "build" && command != "run" && command != "fmt" && command != "lock" && command != "test" {
        eprint("Unknown compiler command.");
        return 2;
    }
    if command == "fmt" && (output_path != ""|| (format_check && format_write) || strings_len(arguments) > 0) {
        eprint("Usage: velac fmt SOURCE [--check|--write]");
        return 2;
    }
    let p = project_load(io_value(absolute_path(input)), json_mode);
    if command == "lock" {
        return project_write_lock(p, json_mode);
    }
    project_verify_lock(p, json_mode);
    if command == "test" {
        return project_test(p, json_mode);
    }
    if command == "fmt" && p.manifest != "" {
        return project_format(p, format_check, format_write, json_mode);
    }
    let input_path = p.entry;
    if source_name == "" {
        source_name = input_path;
    }
    if output_path != "" {
        output_path = io_value(absolute_path(output_path));
        if p.manifest != "" {
            let target_id = io_value(file_identity(output_path));
            let protected = list_new<String>();
            list_push(protected, p.manifest);
            list_push(protected, p.manifest + ".lock");
            for test in p.tests {
                list_push(protected, test);
            }
            for dep in p.dependencies {
                let graph = project_module_context(dep.path, dep.path, load_source(dep.path, json_mode), json_mode, p.dependencies);
                for unit in graph.source_units {
                    list_push(protected, unit.path);
                }
            }
            for native in p.natives { list_push(protected, native.path); }
            for path in protected {
                if path_key(output_path) == path_key(path) || target_id != ""&& target_id == io_value(file_identity(path)) {
                    eprint("Output must not overwrite project metadata.");
                    return 2;
                }
            }
        }
        let input_identity = io_value(file_identity(input_path));
        let output_identity = io_value(file_identity(output_path));
        if path_key(output_path) == path_key(input_path) || (input_identity != ""&& input_identity == output_identity) {
            eprint("Output must not overwrite source.");
            return 2;
        }
    }
    let code = load_source(input_path, json_mode);
    var c = make_context(code, source_name, json_mode);
    if command != "fmt" {
        c = project_module_context(input_path, source_name, code, json_mode, p.dependencies);
    }
    if output_path != "" {
        let output_identity = io_value(file_identity(output_path));
        for unit in c.source_units {
            if path_key(output_path) == path_key(unit.path) || (output_identity != ""&& output_identity == unit.identity) {
                eprint("Output must not overwrite source.");
                return 2;
            }
        }
    }
    if command == "fmt" {
        lex(c);
        parse_module(c);
    } else {
        parse_program(c);
    }
    if command == "fmt" {
        let formatted = format_source(c);
        if format_check {
            if io_value(read_file(input_path)) == formatted {
                return 0;
            }
            eprint("Needs formatting: " + input);
            return 1;
        }
        if format_write {
            if io_value(read_file(input_path)) != formatted {
                write_atomic(input_path, formatted);
            }
            return 0;
        }
        write_stdout(formatted);
        return 0;
    }
    analyze(c);
    if command == "check" {
        if json_mode {
            print(cat(cat("{\"schema_version\":1,\"ok\":true,\"diagnostics\":[],\"source\":", json_string(source_name)), "}"));
        } else {
            print(cat("OK: ", input));
        }
        return 0;
    }
    if command == "symbols" {
        print(symbol_index(c));
        return 0;
    }
    let generated = generate(c);
    if command == "emit-c" {
        if output_path == "" {
            print(generated);
        } else {
            write_atomic(output_path, generated);
        }
        return 0;
    }
    if command == "build" && output_path == "" {
        eprint("build requires -o OUTPUT");
        return 2;
    }
    return build_or_run_native(generated, output_path, arguments, command == "run", p.natives);
}


fn builtin_source() -> String { return "# Vela builtin catalog v1. UTF-8, pipe-delimited; no quoting. Empty columns are significant.\n# kind|name|type variables|parameter types separated by ;|return type|effects separated by ;|ABI|since\nenum|IntResult||Ok:Int;Err:String||||0.2\nenum|StringResult||Ok:String;Err:String||||0.2\nenum|WriteResult||Ok:;Err:String||||0.2\nenum|FloatResult||Ok:Float64;Err:String||||0.7\nenum|Int32Result||Ok:Int32;Err:String||||0.7\nenum|ReadResult||Ok:String;Limit:;Err:String||||0.7\nenum|ProcessResult||Exited:Int;TimedOut:;Err:String||||0.7\nenum|Option|T|Some:T;None:||||0.5\nenum|Result|T;E|Ok:T;Err:E||||0.5\nfn|arg_count|||Int|args|plain|0.2\nfn|arg_int||Int|IntResult|args|int_result|0.2\nfn|parse_int||String|IntResult||int_result|0.2\nfn|str_len||String|Int||located|0.2\nfn|str_byte||String;Int|Int||located|0.2\nfn|str_slice||String;Int;Int|String||located|0.2\nfn|str_concat||String;String|String||located|0.2\nfn|str_from_byte||Int|String||located|0.2\nfn|int_to_string||Int|String||located|0.2\nfn|ints_new|||IntList|state|located|0.2\nfn|ints_len||IntList|Int|state|located|0.2\nfn|ints_get||IntList;Int|Int|state|located|0.2\nfn|ints_set||IntList;Int;Int|Unit|state|located|0.2\nfn|ints_push||IntList;Int|Unit|state|located|0.2\nfn|ints_truncate||IntList;Int|Unit|state|located|0.2\nfn|strings_new|||StringList|state|located|0.2\nfn|strings_len||StringList|Int|state|located|0.2\nfn|strings_get||StringList;Int|String|state|located|0.2\nfn|strings_set||StringList;Int;String|Unit|state|located|0.2\nfn|strings_push||StringList;String|Unit|state|located|0.2\nfn|strings_truncate||StringList;Int|Unit|state|located|0.2\nfn|strings_join||StringList;String|String|state|located|0.2\nfn|arg||Int|StringResult|args|string_result|0.2\nfn|read_file||String|StringResult|io|string_result|0.2\nfn|absolute_path||String|StringResult|io|string_result|0.2\nfn|temp_dir||String|StringResult|io|string_result|0.2\nfn|write_file||String;String|WriteResult|io|write_result|0.2\nfn|remove_file||String|WriteResult|io|write_result|0.2\nfn|replace_file||String;String|WriteResult|io|write_result|0.2\nfn|remove_dir||String|WriteResult|io|write_result|0.2\nfn|eprint||String|Unit|io|located|0.2\nfn|exit||Int|Unit|process|located|0.2\nfn|env||String|String|process|located|0.2\nfn|process_run||StringList|Int|process;state|located|0.2\nfn|process_run_to_stderr||StringList|Int|process;state|located|0.2\nfn|platform|||String||located|0.2\nfn|print|T|T|Unit|io|print|0.3\nfn|to_string|T|T|String||format|0.3\nfn|list_new|T||List<T>|state|list_new|0.3\nfn|list_len|T|List<T>|Int|state|list_len|0.3\nfn|list_get|T|List<T>;Int|T|state|list_get|0.3\nfn|list_set|T|List<T>;Int;T|Unit|state|list_set|0.3\nfn|list_push|T|List<T>;T|Unit|state|list_push|0.3\nfn|list_truncate|T|List<T>;Int|Unit|state|list_truncate|0.3\nfn|dict_new|K;V||Dict<K,V>|state|dict_new|0.3\nfn|dict_len|K;V|Dict<K,V>|Int|state|dict_len|0.3\nfn|dict_has|K;V|Dict<K,V>;K|Bool|state|dict_has|0.3\nfn|dict_get|K;V|Dict<K,V>;K|V|state|dict_get|0.3\nfn|dict_get_or|K;V|Dict<K,V>;K;V|V|state|dict_get_or|0.3\nfn|dict_set|K;V|Dict<K,V>;K;V|Unit|state|dict_set|0.3\nfn|dict_remove|K;V|Dict<K,V>;K|Bool|state|dict_remove|0.3\nfn|process_run_files||StringList;String;String;Int|Int|process;state;io|located|0.3\nfn|make_dir||String|WriteResult|io|write_result|0.3\nfn|set_env||String;String|Unit|process|located|0.3\nfn|set_current_dir||String|WriteResult|io;process|write_result|0.3\nfn|file_identity||String|StringResult|io|string_result|0.4\nfn|write_stdout||String|Unit|io|located|0.4\nfn|sha256||String|String||located|0.6\nfn|parse_float||String|FloatResult||float_result|0.7\nfn|float_text_valid||String|Bool||located|0.7\nfn|float_from_int||Int|Float64||plain|0.7\nfn|float_to_int||Float64|IntResult||int_result|0.7\nfn|float_to_string||Float64|String||located|0.7\nfn|float_floor||Float64|Float64||plain|0.7\nfn|float_ceil||Float64|Float64||plain|0.7\nfn|float_round||Float64|Float64||plain|0.7\nfn|float_is_f