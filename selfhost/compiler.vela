// Typed per-compilation tables. Only this module unwraps arena IDs.
type AstExprId = distinct Int;
type AstStmtId = distinct Int;
type ExprId = distinct Int;
type StmtId = distinct Int;
type TypeId = distinct Int;
type SymbolId = distinct Int;
struct Span {
    start: Int,
    end: Int
}
struct ProjectDependency {
    alias: String,
    path: String,
    relative: String
}
struct RelatedLocation {
    message: String,
    span: Span
}
struct DiagnosticDetails {
    effect_parameter: String,
    capture: String,
    expected: String,
    actual: String,
    interface_name: String,
    implementor: String,
    type_parameter: String,
    operation: String,
    reason: String,
    owner: String,
    member: String,
    method: String,
    exposed_type: String,
    expected_type: String,
    actual_type: String,
    callee: String,
    required_effects: Int,
    allowed_effects: Int,
    missing_effects: Int,
    missing_variants: List<String>,
    related: List<RelatedLocation>
}
struct Token {
    kind: Int,
    text: String,
    span: Span
}
struct SyntaxArgument {
    label: String,
    value: AstExprId
}
struct SyntaxExpr {
    closure_index: Int,
    arms: List<SyntaxArm>,
    kind: Int,
    span: Span,
    name_span: Span,
    text: String,
    qualifier: String,
    left: AstExprId,
    right: AstExprId,
    arguments: List<SyntaxArgument>,
    type_arguments: List<String>
}
struct SyntaxName {
    name: String,
    span: Span
}
struct SyntaxClosure {
    suspending: Bool,
    effect_pattern: String,
    captures: List<SyntaxName>,
    parameters: List<SyntaxField>,
    return_name: String,
    body: List<AstStmtId>
}
struct SyntaxArm {
    value: AstExprId,
    owner: String,
    variant: String,
    variant_span: Span,
    names: List<SyntaxName>,
    body: List<AstStmtId>,
    span: Span
}
struct SyntaxStmt {
    mode: Int,
    kind: Int,
    span: Span,
    name_span: Span,
    name: String,
    annotation: String,
    mutable: Bool,
    value: AstExprId,
    target: AstExprId,
    yes: List<AstStmtId>,
    no: List<AstStmtId>,
    arms: List<SyntaxArm>
}
struct SyntaxField {
    name: String,
    annotation: String,
    span: Span
}
struct SyntaxVariant {
    name: String,
    fields: List<String>,
    span: Span
}
struct TypeParameter {
    name: String,
    bound: String,
    span: Span
}
struct SyntaxType {
    opaque: Bool,
    type_parameters: List<TypeParameter>,
    kind: Int,
    name: String,
    base: String,
    fields: List<SyntaxField>,
    variants: List<SyntaxVariant>,
    span: Span
}
struct SyntaxImpl {
    interface_name: String,
    owner: String,
    parameters: List<TypeParameter>,
    span: Span
}
struct SyntaxOperation {
    name: String,
    parameters: List<SyntaxField>,
    return_name: String,
    effect_mask: Int,
    span: Span
}
struct SyntaxInterface {
    name: String,
    operations: List<SyntaxOperation>,
    span: Span
}
struct InterfaceOperation {
    owner: String,
    name: String,
    signature: SymbolId
}
struct SyntaxFunction {
    suspending: Bool,
    effect_pattern: String,
    impl_index: Int,
    method_exported: Bool,
    name_span: Span,
    foreign_library: String,
    foreign_name: String,
    test_name: String,
    type_parameters: List<TypeParameter>,
    name: String,
    parameters: List<SyntaxField>,
    return_name: String,
    effect_mask: Int,
    preconditions: List<AstExprId>,
    postconditions: List<AstExprId>,
    body: List<AstStmtId>,
    span: Span
}
struct TypeInfo {
    call_effect_mask: Int,
    constraint: String,
    parameter_name: String,
    opaque: Bool,
    template_index: Int,
    kind: Int,
    name: String,
    fields: List<SymbolId>,
    variants: List<SymbolId>,
    arguments: List<TypeId>,
    base: TypeId,
    base_name: String,
    span: Span,
    visit: Int
}
struct Symbol {
    suspending: Bool,
    capture_origin: SymbolId,
    interface_operation: Bool,
    constraints_checked: Bool,
    method_span: Span,
    method_exported: Bool,
    foreign_library: String,
    foreign_name: String,
    template_index: Int,
    kind: Int,
    name: String,
    type_id: TypeId,
    owner: TypeId,
    span: Span,
    parameters: List<SymbolId>,
    effect_mask: Int,
    mutable: Bool,
    tag: Int,
    builtin: Bool,
    prelude_fallback: Bool,
    abi: String,
    variables: List<String>,
    patterns: List<String>,
    return_pattern: String
}
struct CheckedExpr {
    reference: SymbolId,
    arms: List<CheckedArm>,
    kind: Int,
    span: Span,
    type_id: TypeId,
    text: String,
    left: ExprId,
    right: ExprId,
    arguments: List<ExprId>,
    symbol: SymbolId,
    fields: List<SymbolId>
}
struct CheckedArm {
    value: ExprId,
    variant: SymbolId,
    bindings: List<SymbolId>,
    body: List<StmtId>,
    span: Span
}
struct CheckedStmt {
    mode: Int,
    exits: Bool,
    kind: Int,
    span: Span,
    binding: SymbolId,
    value: ExprId,
    target: ExprId,
    yes: List<StmtId>,
    no: List<StmtId>,
    arms: List<CheckedArm>,
    returns: Bool
}
struct CheckedFunction {
    captures: List<SymbolId>,
    symbol: SymbolId,
    parameters: List<SymbolId>,
    result_binding: SymbolId,
    preconditions: List<ExprId>,
    postconditions: List<ExprId>,
    body: List<StmtId>,
    span: Span
}
struct FunctionInstance {
    depth: Int,
    signature: SymbolId,
    syntax_index: Int,
    mapping: Dict<String, TypeId>
}
struct Control {
    in_async: Bool,
    await_site: Span,
    scope_base: Int,
    loop_depth: Int,
    in_contract: Bool,
    in_defer: Bool,
    instance_depth: Int,
    type_mapping: Dict<String, TypeId>,
    type_depth: Int,
    type_instances: Int,
    cursor: Int,
    previous_end: Int,
    depth: Int,
    return_type: TypeId,
    allowed_effects: Int,
    temporary: Int,
    function_index: Int
}
struct Context {
    repair_mode: Bool,
    repair_root: String,
    repair_document: Int,
    repair_overlays: List<QueryOverlay>,
    debug_codegen: Bool,
    query_mode: Bool,
    query_uses: List<QueryUse>,
    query_types: List<SyntaxName>,
    generic_tokens: Dict<Int, Bool>,
    arm_commas: Dict<Int, Bool>,
    source_units: List<SourceUnit>,
    imports: List<ModuleImport>,
    declarations: List<ModuleDeclaration>,
    bound_types: List<SyntaxType>,
    bound_functions: List<SyntaxFunction>,
    bound_interfaces: List<SyntaxInterface>,
    bound_impls: List<SyntaxImpl>,
    interface_operations: List<InterfaceOperation>,
    loop_labels: List<String>,
    loop_cleanup_depths: List<Int>,
    cleanup_blocks: List<StmtId>,
    instances: List<FunctionInstance>,
    generic_functions: Dict<String, SymbolId>,
    source_text: String,
    source_name: String,
    json_mode: Bool,
    lines: List<Int>,
    output: StringList,
    tokens: List<Token>,
    comments: List<Token>,
    syntax_exprs: List<SyntaxExpr>,
    syntax_stmts: List<SyntaxStmt>,
    syntax_types: List<SyntaxType>,
    syntax_impls: List<SyntaxImpl>,
    syntax_closures: List<SyntaxClosure>,
    syntax_interfaces: List<SyntaxInterface>,
    syntax_functions: List<SyntaxFunction>,
    expressions: List<CheckedExpr>,
    statements: List<CheckedStmt>,
    types: List<TypeInfo>,
    symbols: List<Symbol>,
    functions: List<CheckedFunction>,
    signatures: List<SymbolId>,
    scopes: List<List<SymbolId>>,
    type_order: List<TypeId>,
    control: List<Control>
}
struct QueryUse {
    span: Span,
    symbol: SymbolId,
    type_id: TypeId,
    role: String
}
struct SourceUnit {
    path: String,
    name: String,
    identity: String,
    code: String,
    start: Int,
    end: Int,
    line_base: Int
}
struct QueryOverlay {
    path: String,
    code: String
}
struct ImportSpec {
    path: String,
    alias: String,
    span: Span
}
struct ModuleImport {
    owner: Int,
    target: Int,
    alias: String,
    span: Span
}
struct ModuleDeclaration {
    owner: Int,
    name: String,
    canonical: String,
    exported: Bool,
    span: Span
}
fn empty_span() -> Span {
    return Span(start: 0, end: 0);
}
fn no_ast_expr() -> AstExprId {
    return AstExprId(0);
}
fn no_ast_stmt() -> AstStmtId {
    return AstStmtId(0);
}
fn no_expr() -> ExprId {
    return ExprId(0);
}
fn no_stmt() -> StmtId {
    return StmtId(0);
}
fn no_type() -> TypeId {
    return TypeId(0);
}
fn no_symbol() -> SymbolId {
    return SymbolId(0);
}
fn has_ast_expr(id: AstExprId) -> Bool {
    return id.value != 0;
}
fn has_expr(id: ExprId) -> Bool {
    return id.value != 0;
}
fn has_type(id: TypeId) -> Bool {
    return id.value != 0;
}
fn has_symbol(id: SymbolId) -> Bool {
    return id.value != 0;
}
fn int_type() -> TypeId {
    return TypeId(1);
}
fn bool_type() -> TypeId {
    return TypeId(2);
}
fn string_type() -> TypeId {
    return TypeId(3);
}
fn unit_type() -> TypeId {
    return TypeId(4);
}
fn ints_type() -> TypeId {
    return TypeId(5);
}
fn strings_type() -> TypeId {
    return TypeId(6);
}
fn float_type() -> TypeId {
    return TypeId(7);
}
fn foreign_handle_type() -> TypeId {
    return TypeId(8);
}
fn int32_type() -> TypeId {
    return TypeId(9);
}
fn callback_handle_type() -> TypeId {
    return TypeId(10);
}
fn primitive_type_id(index: Int) -> TypeId {
    return TypeId(index);
}
fn symbol_number(id: SymbolId) -> Int {
    return id.value;
}
fn type_number(id: TypeId) -> Int {
    return id.value;
}
fn table_index(id: Int, length: Int, category: String) -> Int effects { io, process } {
    if id <= 0 || id > length {
        eprint("velac: internal error: invalid " + category + " ID " + to_string(id));
        exit(70);
    }
    return id - 1;
}
fn ast_expr(c: Context, id: AstExprId) -> SyntaxExpr effects { state, io, process } {
    return table_get(c.syntax_exprs, id.value, "AST expression");
}
fn ast_stmt(c: Context, id: AstStmtId) -> SyntaxStmt effects { state, io, process } {
    return table_get(c.syntax_stmts, id.value, "AST statement");
}
fn checked_expr(c: Context, id: ExprId) -> CheckedExpr effects { state, io, process } {
    return table_get(c.expressions, id.value, "HIR expression");
}
fn checked_stmt(c: Context, id: StmtId) -> CheckedStmt effects { state, io, process } {
    return table_get(c.statements, id.value, "HIR statement");
}
fn type_info(c: Context, id: TypeId) -> TypeInfo effects { state, io, process } {
    return table_get(c.types, id.value, "type");
}
fn symbol_info(c: Context, id: SymbolId) -> Symbol effects { state, io, process } {
    return table_get(c.symbols, id.value, "symbol");
}
fn add_ast_expr(c: Context, value: SyntaxExpr) -> AstExprId effects { state } {
    list_push(c.syntax_exprs, value);
    return AstExprId(list_len(c.syntax_exprs));
}
fn add_ast_stmt(c: Context, value: SyntaxStmt) -> AstStmtId effects { state } {
    list_push(c.syntax_stmts, value);
    return AstStmtId(list_len(c.syntax_stmts));
}
fn add_expr(c: Context, value: CheckedExpr) -> ExprId effects { state } {
    list_push(c.expressions, value);
    return ExprId(list_len(c.expressions));
}
fn add_stmt(c: Context, value: CheckedStmt) -> StmtId effects { state } {
    list_push(c.statements, value);
    return StmtId(list_len(c.statements));
}
fn add_type(c: Context, value: TypeInfo) -> TypeId effects { state } {
    list_push(c.types, value);
    return TypeId(list_len(c.types));
}
fn add_symbol(c: Context, value: Symbol) -> SymbolId effects { state } {
    list_push(c.symbols, value);
    return SymbolId(list_len(c.symbols));
}
fn symbol_at(index: Int) -> SymbolId {
    return SymbolId(index + 1);
}
fn set_type(c: Context, id: TypeId, value: TypeInfo) -> Unit effects { state, io, process } {
    list_set(c.types, table_index(id.value, list_len(c.types), "type"), value);
}
fn set_symbol(c: Context, id: SymbolId, value: Symbol) -> Unit effects { state, io, process } {
    list_set(c.symbols, table_index(id.value, list_len(c.symbols), "symbol"), value);
}
fn syntax_expression(kind: Int, span: Span, text: String) -> SyntaxExpr effects { state } {
    return SyntaxExpr(closure_index: -1, arms: list_new<SyntaxArm>(), kind: kind, span: span,
        name_span: span, text: text, qualifier: "", left: no_ast_expr(), right: no_ast_expr(),
        arguments: list_new<SyntaxArgument>(), type_arguments: list_new<String>());
}
fn syntax_statement(kind: Int, span: Span) -> SyntaxStmt effects { state } {
    return SyntaxStmt(mode: 0, kind: kind, span: span, name_span: span, name: "", annotation: "",
        mutable: false, value: no_ast_expr(), target: no_ast_expr(), yes: list_new<AstStmtId>(),
        no: list_new<AstStmtId>(), arms: list_new<SyntaxArm>());
}
fn expression_record(kind: Int, span: Span, type_id: TypeId) -> CheckedExpr effects { state } {
    return CheckedExpr(reference: no_symbol(), arms: list_new<CheckedArm>(), kind: kind, span: span,
        type_id: type_id, text: "", left: no_expr(), right: no_expr(),
        arguments: list_new<ExprId>(), symbol: no_symbol(), fields: list_new<SymbolId>());
}
fn statement_record(kind: Int, span: Span) -> CheckedStmt effects { state } {
    return CheckedStmt(mode: 0, exits: false, kind: kind, span: span, binding: no_symbol(),
        value: no_expr(), target: no_expr(), yes: list_new<StmtId>(), no: list_new<StmtId>(),
        arms: list_new<CheckedArm>(), returns: false);
}
fn type_record(kind: Int, name: String, span: Span) -> TypeInfo effects { state } {
    return TypeInfo(call_effect_mask: 0, constraint: "", parameter_name: "", opaque: false,
        template_index: -1, kind: kind, name: name, fields: list_new<SymbolId>(),
        variants: list_new<SymbolId>(), arguments: list_new<TypeId>(), base: no_type(),
        base_name: "", span: span, visit: 0);
}
fn symbol_record(kind: Int, name: String, type_id: TypeId,
    span: Span) -> Symbol effects { state } {
    return Symbol(suspending: false, capture_origin: no_symbol(), interface_operation: false,
        constraints_checked: false, method_span: empty_span(), method_exported: false,
        foreign_library: "", foreign_name: "", template_index: -1, kind: kind, name: name,
        type_id: type_id, owner: no_type(), span: span, parameters: list_new<SymbolId>(),
        effect_mask: 0, mutable: false, tag: 0, builtin: false, prelude_fallback: false, abi: "",
        variables: list_new<String>(), patterns: list_new<String>(), return_pattern: "");
}
fn table_get<T>(items: List<T>, id: Int, category: String) -> T effects { state, io, process } {
    return list_get(items, table_index(id, list_len(items), category));
}
fn last<T>(items: List<T>) -> Option<T> effects { state } {
    if list_len(items) == 0 {
        return Option<T>::None;
    }
    return Option<T>::Some(list_get(items, list_len(items) - 1));
}


// Source coordinates and diagnostics shared by typed compiler phases.
fn cat(a: String, b: String) -> String {
    return str_concat(a, b);
}
fn num(value: Int) -> String {
    return int_to_string(value);
}
fn source(c: Context) -> String {
    return c.source_text;
}
fn filename(c: Context) -> String {
    return c.source_name;
}
fn global_line_at(c: Context, position: Int) -> Int effects { state } {
    var low = 0;
    var high = list_len(c.lines);
    while low + 1 < high {
        let middle = low + (high - low) / 2;
        if list_get(c.lines, middle) <= position {
            low = middle;
        } else {
            high = middle;
        }
    }
    return low + 1;
}
fn source_unit_at(c: Context, position: Int) -> Int effects { state } {
    var found = 0;
    for i in 0 .. list_len(c.source_units) {
        if list_get(c.source_units, i).start <= position {
            found = i;
        } else {
            break;
        }
    }
    return found;
}
fn filename_at(c: Context, position: Int) -> String effects { state } {
    return list_get(c.source_units, source_unit_at(c, position)).name;
}
fn line_at(c: Context, position: Int) -> Int effects { state } {
    return global_line_at(c, position) - list_get(c.source_units, source_unit_at(c,
        position)).line_base;
}
fn column_at(c: Context, position: Int) -> Int effects { state } {
    var i = list_get(c.lines, global_line_at(c, position) - 1);
    var column = 1;
    while i < position {
        let b = str_byte(c.source_text, i);
        if b < 128 || b >= 192 {
            column = column + 1;
        }
        i = i + 1;
    }
    return column;
}
fn codepoint_at(c: Context, position: Int) -> Int effects { state } {
    var i = list_get(c.source_units, source_unit_at(c, position)).start;
    var count = 0;
    while i < position {
        let b = str_byte(c.source_text, i);
        if b < 128 || b >= 192 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
fn json_string(value: String) -> String effects { state } {
    let parts = strings_new();
    strings_push(parts, "\"");
    var i = 0;
    while i < str_len(value) {
        let b = str_byte(value, i);
        if b == 34 {
            strings_push(parts, "\\\"");
        } else if b == 92 {
            strings_push(parts, "\\\\");
        } else if b < 32 {
            let hex = "0123456789abcdef";
            strings_push(parts, "\\u00");
            strings_push(parts, str_slice(hex, b / 16, b / 16 + 1));
            strings_push(parts, str_slice(hex, b % 16, b % 16 + 1));
        } else {
            strings_push(parts, str_slice(value, i, i + 1));
        }
        i = i + 1;
    }
    strings_push(parts, "\"");
    return strings_join(parts, "");
}
fn empty_details() -> DiagnosticDetails effects { state } {
    return DiagnosticDetails(effect_parameter: "", capture: "", expected: "", actual: "",
        interface_name: "", implementor: "", type_parameter: "", operation: "", reason: "",
        owner: "", member: "", method: "", exposed_type: "", expected_type: "", actual_type: "",
        callee: "", required_effects: 0, allowed_effects: 0, missing_effects: 0,
        missing_variants: list_new<String>(), related: list_new<RelatedLocation>());
}
fn effect_names(mask: Int) -> StringList effects { state } {
    let items = strings_new();
    if mask / 2 % 2 == 1 {
        strings_push(items, "args");
    }
    if mask % 2 == 1 {
        strings_push(items, "io");
    }
    if mask / 8 % 2 == 1 {
        strings_push(items, "process");
    }
    if mask / 4 % 2 == 1 {
        strings_push(items, "state");
    }
    return items;
}
fn effect_json(mask: Int) -> String effects { state } {
    let names = effect_names(mask);
    var i = 0;
    while i < strings_len(names) {
        strings_set(names, i, json_string(strings_get(names, i)));
        i = i + 1;
    }
    return "[" + strings_join(names, ",") + "]";
}
fn span_json(c: Context, span: Span) -> String effects { state } {
    return f"{{\"start\":{codepoint_at(c, span.start):d},\"end\":{codepoint_at(c, span.end):d},\"line\":{line_at(c, span.start):d},\"column\":{column_at(c, span.start):d},\"end_line\":{line_at(c, span.end):d},\"end_column\":{column_at(c, span.end):d}}}";
}
fn details_json(details: DiagnosticDetails) -> String effects { state } {
    let items = strings_new();
    if details.effect_parameter != "" {
        strings_push(items, "\"effect_parameter\":" + json_string(details.effect_parameter));
    }
    if details.capture != "" {
        strings_push(items, "\"capture\":" + json_string(details.capture));
    }
    if details.expected != "" {
        strings_push(items, "\"expected\":" + json_string(details.expected));
    }
    if details.actual != "" {
        strings_push(items, "\"actual\":" + json_string(details.actual));
    }
    if details.reason != "" {
        strings_push(items, "\"reason\":" + json_string(details.reason));
    }
    if details.owner != "" {
        strings_push(items, "\"owner\":" + json_string(details.owner));
    }
    if details.member != "" {
        strings_push(items, "\"member\":" + json_string(details.member));
    }
    if details.method != "" {
        strings_push(items, "\"method\":" + json_string(details.method));
    }
    if details.exposed_type != "" {
        strings_push(items, "\"type\":" + json_string(details.exposed_type));
    }
    if details.interface_name != "" {
        strings_push(items, "\"interface\":" + json_string(details.interface_name));
    }
    if details.implementor != "" {
        strings_push(items, "\"implementor\":" + json_string(details.implementor));
    }
    if details.type_parameter != "" {
        strings_push(items, "\"type_parameter\":" + json_string(details.type_parameter));
    }
    if details.operation != "" {
        strings_push(items, "\"operation\":" + json_string(details.operation));
        strings_push(items, "\"actual_type\":" + json_string(details.actual_type));
    }
    if details.expected_type != "" {
        strings_push(items, "\"expected_type\":" + json_string(details.expected_type));
        strings_push(items, "\"actual_type\":" + json_string(details.actual_type));
    }
    if details.callee != "" {
        strings_push(items, "\"callee\":" + json_string(details.callee));
        strings_push(items, "\"required_effects\":" + effect_json(details.required_effects));
        strings_push(items, "\"allowed_effects\":" + effect_json(details.allowed_effects));
        strings_push(items, "\"missing_effects\":" + effect_json(details.missing_effects));
    }
    if list_len(details.missing_variants) > 0 {
        let names = strings_new();
        var i = 0;
        while i < list_len(details.missing_variants) {
            strings_push(names, json_string(list_get(details.missing_variants, i)));
            i = i + 1;
        }
        strings_push(items, "\"missing_variants\":[" + strings_join(names, ",") + "]");
    }
    return "{" + strings_join(items, ",") + "}";
}
fn fail_details(c: Context, code: String, message: String, span: Span,
    details: DiagnosticDetails) -> Unit effects { state, io, process } {
    if c.repair_mode {
        print(repair_plan(c, code, message, span, details));
        exit(0);
    }
    var i = 0;
    if c.json_mode {
        print(
            f"{{\"schema_version\":1,\"ok\":false,\"source\":{json_string(filename_at(c, span.start)):s},\"revision\":\"{query_revision(c):s}\",\"documents\":{repair_documents(c):s},\"diagnostics\":[{repair_diagnostic(c,code,message,span,details):s}]}}");
    } else {
        eprint(
            f"{filename_at(c, span.start):s}:{line_at(c, span.start):d}:{column_at(c, span.start):d}: {code:s}: {message:s}");
        i = 0;
        while i < list_len(details.related) {
            let item = list_get(details.related, i);
            eprint(
                f"{filename_at(c, item.span.start):s}:{line_at(c, item.span.start):d}:{column_at(c, item.span.start):d}: note: {item.message:s}");
            i = i + 1;
        }
    }
    exit(1);
}
fn fail(c: Context, code: String, message: String, start: Int,
    end: Int) -> Unit effects { state, io, process } {
    fail_details(c, code, message, Span(start: start, end: end), empty_details());
}
fn bad(c: Context, code: String, message: String, span: Span) -> Unit effects { state, io,
    process } {
    fail_details(c, code, message, span, empty_details());
}
fn method_error(c: Context, reason: String, owner: String, member: String, message: String,
    span: Span, related: Span) -> Unit effects { state, io, process } {
    var details = empty_details();
    details.reason = reason;
    details.owner = owner;
    details.method = member;
    if related.end > related.start {
        list_push(details.related, RelatedLocation(message: "Related declaration is here.",
            span: related));
    }
    fail_details(c, "E233", message, span, details);
}
fn interface_error(c: Context, code: String, reason: String, interface_name: String,
    implementor: String, method: String, message: String, span: Span,
    related: Span) -> Unit effects { state, io, process } {
    var details = empty_details();
    details.reason = reason;
    details.interface_name = interface_name;
    details.implementor = implementor;
    details.method = method;
    if related.end > related.start {
        list_push(details.related, RelatedLocation(
            message: "Related interface or implementation declaration.", span: related));
    }
    fail_details(c, code, message, span, details);
}
fn duplicate(c: Context, message: String, span: Span, previous: Span) -> Unit effects { state,
    io, process } {
    let details = empty_details();
    if previous.end > previous.start {
        list_push(details.related, RelatedLocation(message: "Previous declaration is here.",
            span: previous));
    }
    fail_details(c, "E202", message, span, details);
}
fn enter(c: Context, span: Span) -> Unit effects { state, io, process } {
    var control = list_get(c.control, 0);
    control.depth = control.depth + 1;
    list_set(c.control, 0, control);
    if control.depth > 200 {
        bad(c, "E101", "Source nesting exceeds the compiler limit.", span);
    }
}
fn leave(c: Context) -> Unit effects { state } {
    var control = list_get(c.control, 0);
    control.depth = control.depth - 1;
    list_set(c.control, 0, control);
}
fn make_context(code: String, name: String, json_mode: Bool) -> Context effects { state } {
    let lines = list_new<Int>();
    list_push(lines, 0);
    var i = 0;
    while i < str_len(code) {
        if str_byte(code, i) == 10 {
            list_push(lines, i + 1);
        }
        i = i + 1;
    }
    let control = list_new<Control>();
    list_push(control, Control(in_async: false, await_site: empty_span(), scope_base: 0,
        loop_depth: 0, in_contract: false, in_defer: false, instance_depth: 0,
        type_mapping: dict_new<String, TypeId>(), type_depth: 0, type_instances: 0, cursor: 0,
        previous_end: 0, depth: 0, return_type: no_type(), allowed_effects: 0, temporary: 0,
        function_index: 0));
    let units = list_new<SourceUnit>();
    list_push(units, SourceUnit(path: name, name: name, identity: "", code: code, start: 0,
        end: str_len(code), line_base: 0));
    return Context(repair_mode: false, repair_root: "", repair_document: -1,
        repair_overlays: list_new<QueryOverlay>(), debug_codegen: false, query_mode: false,
        query_uses: list_new<QueryUse>(), query_types: list_new<SyntaxName>(),
        generic_tokens: dict_new<Int, Bool>(), arm_commas: dict_new<Int, Bool>(),
        source_units: units, imports: list_new<ModuleImport>(),
        declarations: list_new<ModuleDeclaration>(), bound_types: list_new<SyntaxType>(),
        bound_functions: list_new<SyntaxFunction>(), bound_interfaces: list_new<SyntaxInterface>(),
        bound_impls: list_new<SyntaxImpl>(), interface_operations: list_new<InterfaceOperation>(),
        loop_labels: list_new<String>(), loop_cleanup_depths: list_new<Int>(),
        cleanup_blocks: list_new<StmtId>(), instances: list_new<FunctionInstance>(),
        generic_functions: dict_new<String, SymbolId>(), source_text: code, source_name: name,
        json_mode: json_mode, lines: lines, output: strings_new(), tokens: list_new<Token>(),
        comments: list_new<Token>(), syntax_exprs: list_new<SyntaxExpr>(),
        syntax_stmts: list_new<SyntaxStmt>(), syntax_types: list_new<SyntaxType>(),
        syntax_impls: list_new<SyntaxImpl>(), syntax_closures: list_new<SyntaxClosure>(),
        syntax_interfaces: list_new<SyntaxInterface>(),
        syntax_functions: list_new<SyntaxFunction>(), expressions: list_new<CheckedExpr>(),
        statements: list_new<CheckedStmt>(), types: list_new<TypeInfo>(),
        symbols: list_new<Symbol>(), functions: list_new<CheckedFunction>(),
        signatures: list_new<SymbolId>(), scopes: list_new<List<SymbolId>>(),
        type_order: list_new<TypeId>(), control: control);
}


fn utf8_width(byte: Int) -> Int {
    if byte < 128 {
        return 1;
    }
    if byte >= 194 && byte <= 223 {
        return 2;
    }
    if byte >= 224 && byte <= 239 {
        return 3;
    }
    if byte >= 240 && byte <= 244 {
        return 4;
    }
    return 0;
}
fn utf8_valid(s: String) -> Bool {
    var i = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        let width = utf8_width(b);
        if width == 0 || i + width > str_len(s) {
            return false;
        }
        var j = 1;
        while j < width {
            let tail = str_byte(s, i + j);
            if tail < 128 || tail > 191 {
                return false;
            }
            j = j + 1;
        }
        if width >= 3 {
            let second = str_byte(s, i + 1);
            if b == 224 && second < 160 || b == 237 && second > 159 || b == 240 && second < 144 || b == 244 && second > 143 {
                return false;
            }
        }
        i = i + width;
    }
    return true;
}
fn codepoint(s: String, i: Int) -> Int {
    let b = str_byte(s, i);
    let width = utf8_width(b);
    if width == 1 {
        return b;
    }
    var value = b % 32;
    if width == 3 {
        value = b % 16;
    }
    if width == 4 {
        value = b % 8;
    }
    var j = 1;
    while j < width {
        value = value * 64 + str_byte(s, i + j) % 64;
        j = j + 1;
    }
    return value;
}
fn whitespace(s: String, i: Int) -> Bool {
    let cp = codepoint(s, i);
    return cp >= 9 && cp <= 13 || cp >= 28 && cp <= 32 || cp == 133 || cp == 160 || cp == 5760 || cp >= 8192 && cp <= 8202 || cp == 8232 || cp == 8233 || cp == 8239 || cp == 8287 || cp == 12288;
}
fn normalized(s: String) -> String effects { state, io, process } {
    if !utf8_valid(s) {
        eprint("velac: E900: source is not valid UTF-8");
        exit(2);
    }
    let parts = strings_new();
    var start = 0;
    if str_len(s) >= 3 && str_byte(s, 0) == 239 && str_byte(s, 1) == 187 && str_byte(s, 2) == 191 {
        start = 3;
    }
    var i = start;
    while i < str_len(s) {
        if str_byte(s, i) == 13 {
            strings_push(parts, str_slice(s, start, i));
            strings_push(parts, "\n");
            i = i + 1;
            if i < str_len(s) && str_byte(s, i) == 10 {
                i = i + 1;
            }
            start = i;
        } else {
            i = i + 1;
        }
    }
    strings_push(parts, str_slice(s, start, i));
    return strings_join(parts, "");
}
fn source_error(message: String, json_mode: Bool) -> Unit effects { state, io, process } {
    if json_mode {
        print(cat(cat("{\"schema_version\":1,\"ok\":false,\"diagnostics\":[{\"code\":\"E900\",\"severity\":\"error\",\"message\":", json_string(message)), "}]}"));
    } else {
        eprint(cat("velac: E900: ", message));
    }
    exit(2);
}
fn source_inside_boundary(path: String) -> Bool effects { state, io, process } {
    let boundary = env("VELA_SOURCE_ROOT");
    if boundary != "" {
        let root = path_key(io_value(absolute_path(boundary)));
        let absolute = path_key(io_value(absolute_path(path)));
        var prefix = root + "/";
        if platform() == "windows" {
            prefix = root + "\\";
        }
        if str_len(absolute) <= str_len(prefix) || str_slice(absolute, 0, str_len(prefix)) != prefix {
            return false;
        }
    }
    return true;
}
fn query_source_text(path: String, overlays: List<QueryOverlay>) -> Result<String, String> effects { state, io, process } {
    if !source_inside_boundary(path) {
        return Result<String, String>::Err("Source path escapes VELA_SOURCE_ROOT.");
    }
    if list_len(overlays) > 0 {
        let key = path_key(path);
        for overlay in overlays {
            if path_key(overlay.path) == key { return Result<String, String>::Ok(overlay.code); }
        }
    }
    let code = from_string(read_file(path))?;
    if !utf8_valid(code) {
        return Result<String, String>::Err("Source is not valid UTF-8.");
    }
    return Result<String, String>::Ok(normalized(code));
}
fn source_text_result(path: String) -> Result<String, String> effects { state, io, process } {
    return query_source_text(path, list_new<QueryOverlay>());
}
fn load_source(path: String, json_mode: Bool) -> String effects { state, io, process } {
    match source_text_result(path) {
        Result::Ok(code) => {
            return code;
        }
        Result::Err(message) => {
            source_error(message, json_mode);
            return "";
        }
    }
}


fn is_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}
fn is_alpha(b: Int) -> Bool {
    return b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95;
}
fn keyword(s: String) -> Bool {
    return s == "import" || s == "as" || s == "pub" || s == "for" || s == "in" || s == "break" || s == "continue" || s == "fn" || s == "enum" || s == "let" || s == "var" || s == "return" || s == "if" || s == "else" || s == "while" || s == "match" || s == "effects" || s == "requires" || s == "ensures" || s == "true" || s == "false" || s == "struct" || s == "type" || s == "distinct";
}
fn contains_byte(s: String, b: Int) -> Bool {
    var i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == b {
            return true;
        }
        i = i + 1;
    }
    return false;
}
fn lex(c: Context) -> Unit effects { state, io, process } {
    lex_range(c, 0, str_len(c.source_text));
}
fn lex_range(c: Context, begin: Int, limit: Int) -> Unit effects { state, io, process } {
    let s = source(c);
    var i = begin;
    while i < limit {
        let start = i;
        let b = str_byte(s, i);
        var kind = 0;
        var value = "";
        if whitespace(s, i) {
            i = i + utf8_width(b);
        } else if b == 47 && i + 1 < limit && str_byte(s, i + 1) == 47 {
            while i < limit && str_byte(s, i) != 10 {
                i = i + 1;
            }
            list_push(c.comments, Token(kind: 55, text: str_slice(s, start, i), span: Span(start: start, end: i)));
        } else if b == 102 && raw_delimiter(s, i + 1, limit) {
            fail(c, "E001", "Raw strings do not support interpolation.", i, i + 4);
        } else if b == 102 && i + 1 < limit && str_byte(s, i + 1) == 34 {
            i = interpolation_end(c, i);
            kind = 56;
            value = str_slice(s, start, i);
        } else if is_alpha(b) {
            i = i + 1;
            while i < limit && (is_alpha(str_byte(s, i)) || is_digit(str_byte(s, i))) {
                i = i + 1;
            }
            kind = 50;
            value = str_slice(s, start, i);
        } else if is_digit(b) {
            i = i + 1;
            while i < limit && is_digit(str_byte(s, i)) {
                i = i + 1;
            }
            kind = 51;
            if i + 1 < limit && str_byte(s, i) == 46 && is_digit(str_byte(s, i + 1)) {
                kind = 57;
                i = i + 1;
                while i < limit && is_digit(str_byte(s, i)) { i = i + 1; }
            }
            if i < limit && (str_byte(s, i) == 101 || str_byte(s, i) == 69) {
                kind = 57;
                i = i + 1;
                if i < limit && (str_byte(s, i) == 43 || str_byte(s, i) == 45) { i = i + 1; }
                let exponent_start = i;
                while i < limit && is_digit(str_byte(s, i)) { i = i + 1; }
                if i == exponent_start { fail(c, "E001", "Expected exponent digits.", start, i); }
            }
            value = str_slice(s, start, i);
        } else if raw_delimiter(s, i, limit) {
            i = i + 3;
            let content = i;
            while i + 2 < limit && !raw_delimiter(s, i, limit) {
                i = i + 1;
            }
            if !raw_delimiter(s, i, limit) {
                fail(c, "E001", "Unterminated raw string literal.", start, start + 3);
            }
            value = str_slice(s, content, i);
            i = i + 3;
            kind = 58;
        } else if b == 34 {
            i = i + 1;
            let parts = strings_new();
            while i < limit && str_byte(s, i) != 34 {
                var ch = str_byte(s, i);
                if ch == 10 || ch == 13 {
                    fail(c, "E001", "Newline in string literal.", start, i);
                }
                if ch == 92 {
                    i = i + 1;
                    if i >= limit {
                        fail(c, "E001", "Incomplete string escape.", start, i);
                    }
                    ch = str_byte(s, i);
                    if ch == 110 {
                        ch = 10;
                    } else if ch == 114 {
                        ch = 13;
                    } else if ch == 116 {
                        ch = 9;
                    } else if ch == 48 {
                        ch = 0;
                    } else if ch != 34 && ch != 92 {
                        fail(c, "E001", "Unknown string escape.", start, i);
                    }
                }
                strings_push(parts, str_from_byte(ch));
                i = i + 1;
            }
            if i == limit {
                fail(c, "E001", "Unterminated string literal.", start, i);
            }
            i = i + 1;
            kind = 52;
            value = strings_join(parts, "");
        } else {
            var pair = "";
            if i + 1 < limit {
                pair = str_slice(s, i, i + 2);
            }
            if i + 2 < limit && str_slice(s, i, i + 3) == "..=" {
                i = i + 3;
                kind = 53;
                value = "..=";
            } else if pair == ".." || pair == "->" || pair == "=>" || pair =="::"|| pair == "==" || pair == "!=" || pair == "<=" || pair == ">=" || pair == "&&" || pair == "||" {
                i = i + 2;
                kind = 53;
                value = pair;
            } else if contains_byte("(){}[]:.,;=+-*/%!<>?", b) {
                i = i + 1;
                kind = 53;
                value = str_slice(s, start, i);
            } else {
                fail(c, "E001", "Unexpected character.", start, start + utf8_width(b));
            }
        }
        if kind != 0 {
            list_push(c.tokens, Token(kind: kind, text: value, span: Span(start: start, end: i)));
        }
    }
    list_push(c.tokens, Token(kind: 54, text: "<eof>", span: Span(start: i, end: i)));
}
fn raw_delimiter(s: String, i: Int, limit: Int) -> Bool {
    return i + 2 < limit && str_byte(s, i) == 34 && str_byte(s, i + 1) == 34 && str_byte(s, i + 2) == 34;
}
fn quoted_end(c: Context, start: Int) -> Int effects { state, io, process } {
    let s = c.source_text;
    var i = start + 1;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 10 || b == 13 {
            fail(c, "E001", "Newline in interpolation.", start, i);
        }
        if b == 34 {
            return i + 1;
        }
        if b == 92 {
            i = i + 1;
        }
        i = i + 1;
    }
    fail(c, "E001", "Unterminated string in interpolation.", start, i);
    return i;
}
fn interpolation_hole_end(c: Context, start: Int) -> Int effects { state, io, process } {
    let s = c.source_text;
    var i = start;
    var braces = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 10 || b == 13 {
            fail(c, "E001", "Newline in interpolation.", start, i);
        }
        if b == 47 && i + 1 < str_len(s) && str_byte(s, i + 1) == 47 {
            fail(c, "E001", "Comments are not allowed in interpolation holes.", i, i + 2);
        }
        if b == 102 && i + 1 < str_len(s) && str_byte(s, i + 1) == 34 {
            i = interpolation_end(c, i);
        } else if raw_delimiter(s, i, str_len(s)) {
            fail(c, "E001", "Raw strings are not allowed in interpolation holes.", i, i + 3);
        } else if b == 34 {
            i = quoted_end(c, i);
        } else {
            if b == 123 {
                braces = braces + 1;
            }
            if b == 125 {
                if braces == 0 {
                    return i;
                }
                braces = braces - 1;
            }
            i = i + 1;
        }
    }
    fail(c, "E001", "Unterminated interpolation hole.", start, i);
    return i;
}
fn interpolation_end(c: Context, start: Int) -> Int effects { state, io, process } {
    enter(c, Span(start: start, end: start + 2));
    let s = c.source_text;
    var i = start + 2;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 10 || b == 13 {
            fail(c, "E001", "Newline in interpolation.", start, i);
        }
        if b == 34 {
            leave(c);
            return i + 1;
        }
        if b == 92 {
            i = i + 2;
        } else if (b == 123 || b == 125) && i + 1 < str_len(s) && str_byte(s, i + 1) == b {
            i = i + 2;
        } else if b == 123 {
            i = interpolation_hole_end(c, i + 1) + 1;
        } else if b == 125 {
            fail(c, "E001", "Unmatched closing interpolation brace.", i, i + 1);
        } else {
            i = i + 1;
        }
    }
    fail(c, "E001", "Unterminated interpolation.", start, str_len(s));
    leave(c);
    return i;
}


fn current(c: Context) -> Token effects { state } {
    return list_get(c.tokens, list_get(c.control, 0).cursor);
}
fn at(c: Context, value: String) -> Bool effects { state } {
    let t = current(c);
    return (t.kind == 50 || t.kind == 53 || t.kind == 54) && t.text == value;
}
fn take(c: Context) -> Token effects { state } {
    let t = current(c);
    var ctl = list_get(c.control, 0);
    if t.kind != 54 {
        ctl.cursor = ctl.cursor + 1;
    }
    ctl.previous_end = t.span.end;
    list_set(c.control, 0, ctl);
    return t;
}
fn accept(c: Context, value: String) -> Bool effects { state } {
    if at(c, value) {
        let ignored = take(c);
        return true;
    }
    return false;
}
fn async_fn_ahead(c: Context) -> Bool effects { state } {
    if !at(c, "async") { return false; }
    let index = list_get(c.control, 0).cursor + 1;
    return index < list_len(c.tokens) && list_get(c.tokens, index).kind == 50
        && list_get(c.tokens, index).text == "fn";
}
fn expect(c: Context, value: String) -> Token effects { state, io, process } {
    if !at(c, value) {
        bad(c, "E100", "Expected " + value, current(c).span);
    }
    return take(c);
}
fn generic_token(c: Context, value: String) -> Token effects { state, io, process } {
    let token = expect(c, value);
    dict_set(c.generic_tokens, token.span.start, true);
    return token;
}
fn identifier(c: Context) -> Token effects { state, io, process } {
    let t = current(c);
    if t.kind != 50 || keyword(t.text) {
        bad(c, "E100", "Expected an identifier.", t.span);
    }
    return take(c);
}
fn through_previous(c: Context, start: Int) -> Span effects { state } {
    return Span(start: start, end: list_get(c.control, 0).previous_end);
}
fn precedence(op: String) -> Int {
    if op == "||" {
        return 1;
    }
    if op == "&&" {
        return 2;
    }
    if op == "==" || op == "!=" {
        return 3;
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        return 4;
    }
    if op == "+" || op == "-" {
        return 5;
    }
    if op == "*" || op == "/" || op == "%" {
        return 6;
    }
    return -1;
}
fn parse_type(c: Context) -> String effects { state, io, process } {
    let suspending = async_fn_ahead(c);
    if suspending { let marker = take(c); }
    if at(c, "fn") {
        let keyword_token = take(c);
        enter(c, keyword_token.span);
        let open = expect(c, "(");
        let parameters = type_list(c, ")");
        let arrow = expect(c, "->");
        let result_type = parse_type(c);
        var effects_pattern = parse_effect_pattern(c);
        if suspending { effects_pattern = suspension_pattern(effects_pattern); }
        var pattern = "@fn:" + effects_pattern + "<" + result_type;
        for parameter in parameters { pattern = pattern + "," + parameter; }
        leave(c);
        return pattern + ">";
    }
    let first = identifier(c);
    let dynamic = first.text == "dyn" && current(c).kind == 50 && !keyword(current(c).text);
    var token = first;
    if dynamic { token = identifier(c); }
    enter(c, first.span);
    var name = token.text;
    var name_span = token.span;
    while accept(c,"::") {
        let member = identifier(c);
        name = name +"::"+ member.text;
        name_span = member.span;
    }
    if c.query_mode {
        list_push(c.query_types, SyntaxName(name: name, span: name_span));
    }
    if at(c, "<") {
        let open = generic_token(c, "<");
        let parts = strings_new();
        var more = true;
        while more {
            strings_push(parts, parse_type(c));
            more = accept(c,",");
        }
        let close = generic_token(c, ">");
        name = name + "<" + strings_join(parts,",") + ">";
    }
    leave(c);
    if dynamic { return "@dyn:" + name; }
    return name;
}
fn type_list(c: Context, end: String) -> List<String> effects { state, io, process } {
    let items = list_new<String>();
    var more = !at(c, end);
    while more {
        if end == ">" && at(c, "effects") {
            list_push(items, "@fx:" + to_string(parse_test_effects(c)));
        } else {
            list_push(items, parse_type(c));
        }
        more = accept(c,",") && !at(c, end);
    }
    if end == ">" { let close = generic_token(c, end); }
    else { let close = expect(c, end); }
    return items;
}
fn generic_call_ahead(c: Context) -> Bool effects { state } {
    if !at(c, "<") {
        return false;
    }
    var i = list_get(c.control, 0).cursor;
    var depth = 0;
    while i < list_len(c.tokens) {
        let t = list_get(c.tokens, i);
        if t.kind == 54 {
            return false;
        }
        if t.text == "<" {
            depth = depth + 1;
        } else if t.text == ">" {
            depth = depth - 1;
            if depth == 0 {
                let next = list_get(c.tokens, i + 1).text;
                return next == "(" || next == "::" || next == ";" || next == ")" || next == "," || next == "}";
            }
        } else if t.kind != 50 && t.text !="," && t.text !="::" && t.text != "(" && t.text != ")" && t.text != "->" && t.text != "{" && t.text != "}" {
            return false;
        }
        i = i + 1;
    }
    return false;
}
fn expressions(c: Context) -> List<SyntaxArgument> effects { state, io, process } {
    let items = list_new<SyntaxArgument>();
    var more = !at(c,")");
    while more {
        var label = "";
        if current(c).kind == 50 && list_get(c.tokens, list_get(c.control, 0).cursor + 1).text ==":" {
            label = identifier(c).text;
            let colon = expect(c,":");
        }
        let value = expression(c, 0);
        list_push(items, SyntaxArgument(label: label, value: value));
        more = accept(c,",") && !at(c,")");
    }
    let close = expect(c,")");
    return items;
}
fn expression(c: Context, minimum: Int) -> AstExprId effects { state, io, process } {
    let token = take(c);
    enter(c, token.span);
    var left = no_ast_expr();
    if token.kind == 53 && token.text == "(" {
        left = expression(c, 0);
        let close = expect(c, ")");
    } else {
        left = expression_atom(c, token);
    }
    let parsed = expression_suffix(c, left, minimum);
    leave(c);
    return parsed;
}
fn expression_atom(c: Context, t: Token) -> AstExprId effects { state, io, process } {
    var n = syntax_expression(0, t.span, t.text);
    var left = no_ast_expr();
    if t.kind == 51 {
        n.kind = 1;
    } else if t.kind == 57 {
        n.kind = 12;
    } else if t.kind == 56 {
        left = parse_interpolation(c, t);
    } else if t.kind == 52 || t.kind == 58 {
        n.kind = 3;
    } else if t.kind == 50 && (t.text == "true" || t.text == "false") {
        n.kind = 2;
    } else if t.kind == 53 && (t.text == "-"|| t.text == "!") {
        n.kind = 5;
        n.left = expression(c, 7);
        n.span = through_previous(c, t.span.start);
    } else if t.kind == 50 && t.text == "await" && current(c).kind == 50 && !keyword(current(c).text) {
        n.kind = 17;
        n.left = expression(c, 7);
        n.span = through_previous(c, t.span.start);
    } else if t.kind == 50 && (t.text == "fn" || (t.text == "async" && at(c, "fn"))) {
        let suspending = t.text == "async";
        if suspending { let marker = take(c); }
        n.kind = 15;
        n.closure_index = parse_closure(c, suspending);
        n.span = through_previous(c, t.span.start);
    } else if t.kind == 50 && t.text == "dyn" && current(c).kind == 50 && !keyword(current(c).text) {
        n.kind = 16;
        n.qualifier = parse_type(c);
        let open = expect(c, "(");
        n.arguments = expressions(c);
        n.span = through_previous(c, t.span.start);
    } else if t.kind == 50 && t.text == "match" {
        n.kind = 9;
        n.left = expression(c, 0);
        n.arms = parse_arms(c, true);
        n.span = through_previous(c, t.span.start);
    } else if t.kind == 50 && !keyword(t.text) {
        n.kind = 4;
        var path = n.text;
        var reading = true;
        while reading {
            if generic_call_ahead(c) {
                let open = generic_token(c, "<");
                n.type_arguments = type_list(c, ">");
            }
            if accept(c,"::") {
                if list_len(n.type_arguments) > 0 {
                    path = path + "<" + join_text(n.type_arguments,",") + ">";
                    n.type_arguments = list_new<String>();
                }
                n.qualifier = path;
                let member = identifier(c);
                n.text = member.text;
                n.name_span = member.span;
                path = path +"::"+ n.text;
            } else {
                reading = false;
            }
        }
        n.span = through_previous(c, t.span.start);
        left = add_ast_expr(c, n);
        if generic_call_ahead(c) {
            let open = generic_token(c, "<");
            n.type_arguments = type_list(c, ">");
        }
        if accept(c,"(") {
            n.kind = 7;
            n.left = left;
            n.arguments = expressions(c);
            n.span = through_previous(c, t.span.start);
            left = add_ast_expr(c, n);
        }
    } else {
        bad(c, "E100", "Expected an expression.", t.span);
    }
    if !has_ast_expr(left) {
        left = add_ast_expr(c, n);
    }
    return left;
}
fn expression_suffix(c: Context, atom: AstExprId, minimum: Int) -> AstExprId effects { state, io, process } {
    var left = atom;
    while at(c,".") || at(c,"?") || at(c, "(") {
        if accept(c, "(") {
            var call = syntax_expression(14, ast_expr(c, left).span, "");
            call.left = left;
            call.arguments = expressions(c);
            call.span = through_previous(c, call.span.start);
            left = add_ast_expr(c, call);
        } else if accept(c,"?") {
            var propagation = syntax_expression(10, through_previous(c, ast_expr(c, left).span.start),"?");
            propagation.left = left;
            left = add_ast_expr(c, propagation);
        } else {
            let dot = expect(c,".");
            let field = identifier(c);
            var access = syntax_expression(8, Span(start: ast_expr(c, left).span.start, end: field.span.end), field.text);
            access.name_span = field.span;
            access.left = left;
            if accept(c, "(") {
                access.kind = 13;
                access.arguments = expressions(c);
                access.span = through_previous(c, access.span.start);
            }
            left = add_ast_expr(c, access);
        }
    }
    while current(c).kind == 53 && precedence(current(c).text) >= minimum {
        let op = take(c);
        let right = expression(c, precedence(op.text) + 1);
        var binary = syntax_expression(6, Span(start: ast_expr(c, left).span.start, end: ast_expr(c, right).span.end), op.text);
        binary.left = left;
        binary.right = right;
        left = add_ast_expr(c, binary);
    }
    return left;
}
fn name_fields(c: Context, end: String) -> List<SyntaxField> effects { state, io, process } {
    let items = list_new<SyntaxField>();
    var more = !at(c, end);
    while more {
        let name = identifier(c);
        let colon = expect(c,":");
        let annotation = parse_type(c);
        list_push(items, SyntaxField(name: name.text, annotation: annotation, span: through_previous(c, name.span.start)));
        more = accept(c,",") && !at(c, end);
    }
    let close = expect(c, end);
    return items;
}
fn block(c: Context) -> List<AstStmtId> effects { state, io, process } {
    let open = expect(c, "{");
    enter(c, open.span);
    let body = list_new<AstStmtId>();
    while !at(c, "}") {
        list_push(body, statement(c));
    }
    let close = expect(c, "}");
    leave(c);
    return body;
}
fn statement(c: Context) -> AstStmtId effects { state, io, process } {
    let start = current(c).span;
    enter(c, start);
    var n = syntax_statement(0, start);
    if at(c, "let") || at(c, "var") {
        n.mutable = take(c).text == "var";
        n.kind = 30;
        let name = identifier(c);
        n.name = name.text;
        n.name_span = name.span;
        if accept(c,":") {
            n.annotation = parse_type(c);
        }
        let equal = expect(c, "=");
        n.value = expression(c, 0);
        let semi = expect(c,";");
    } else if accept(c, "return") {
        n.kind = 32;
        if !at(c,";") {
            n.value = expression(c, 0);
        }
        let semi = expect(c,";");
    } else if accept(c, "if") {
        n.kind = 34;
        n.value = expression(c, 0);
        n.yes = block(c);
        if accept(c, "else") {
            if at(c, "if") {
                list_push(n.no, statement(c));
            } else {
                n.no = block(c);
            }
        }
    } else if at(c, "break") || at(c, "continue") {
        n.kind = 39;
        if take(c).text == "continue" {
            n.kind = 40;
        }
        let semi = expect(c,";");
    } else if accept(c, "for") {
        n.kind = 41;
        let name = identifier(c);
        n.name = name.text;
        n.name_span = name.span;
        let in_token = expect(c, "in");
        n.value = expression(c, 0);
        if at(c, "..") || at(c, "..=") {
            n.mode = 1;
            if take(c).text == "..=" {
                n.mode = 2;
            }
            n.target = expression(c, 0);
        }
        n.yes = block(c);
    } else if accept(c, "while") {
        n.kind = 35;
        n.value = expression(c, 0);
        n.yes = block(c);
    } else if (at(c, "defer") || at(c, "scope")) && list_get(c.tokens, list_get(c.control, 0).cursor + 1).text == "{" {
        n.kind = 43;
        if take(c).text == "defer" { n.kind = 42; }
        n.yes = block(c);
    } else if accept(c, "match") {
        n.kind = 36;
        n.value = expression(c, 0);
        n.arms = parse_arms(c, false);
    } else if current(c).kind == 50 && list_get(c.tokens, list_get(c.control, 0).cursor + 1).text == "=" {
        n.kind = 31;
        n.name = identifier(c).text;
        let equal = expect(c, "=");
        n.value = expression(c, 0);
        let semi = expect(c,";");
    } else {
        let value = expression(c, 0);
        if accept(c, "=") {
            n.kind = 38;
            n.target = value;
            n.value = expression(c, 0);
        } else {
            n.kind = 33;
            n.value = value;
        }
        let semi = expect(c,";");
    }
    n.span = through_previous(c, start.start);
    leave(c);
    return add_ast_stmt(c, n);
}
fn effect_bit(name: String) -> Int {
    if name == "io" {
        return 1;
    }
    if name == "args" {
        return 2;
    }
    if name == "state" {
        return 4;
    }
    if name == "process" {
        return 8;
    }
    return 0;
}
fn has_bit(mask: Int, bit: Int) -> Bool {
    return mask / bit % 2 == 1;
}
fn parse_function_body(c: Context, start: Int, exported: Bool, impl_index: Int, suspending: Bool) -> Unit effects { state, io, process } {
    let name = identifier(c);
    var type_parameters = parse_generic_parameters(c, true);
    if impl_index >= 0 {
        let implementation = list_get(c.syntax_impls, impl_index);
        if list_len(type_parameters) != 0 {
            method_error(c, "method_generic", implementation.owner, name.text, "Methods cannot declare their own generic parameters.", name.span, implementation.span);
        }
        type_parameters = implementation.parameters;
    } else {
        declare_module_name(c, name.text, exported, name.span);
    }
    let open = expect(c, "(");
    let params = name_fields(c, ")");
    let arrow = expect(c, "->");
    let return_name = parse_type(c);
    let effect_pattern = parse_effect_pattern(c);
    validate_effect_names(c, effect_pattern, type_parameters, name.span);
    let mask = effect_pattern_constant(effect_pattern);
    let pre = list_new<AstExprId>();
    let post = list_new<AstExprId>();
    while at(c, "requires") || at(c, "ensures") {
        let word = take(c).text;
        let value = expression(c, 0);
        let semi = expect(c, ";");
        if word == "requires" { list_push(pre, value); }
        else { list_push(post, value); }
    }
    let body = block(c);
    list_push(c.syntax_functions, SyntaxFunction(suspending: suspending, effect_pattern: effect_pattern, impl_index: impl_index, method_exported: exported && impl_index >= 0, name_span: name.span, foreign_library: "", foreign_name: "", test_name: "", type_parameters: type_parameters, name: name.text, parameters: params, return_name: return_name, effect_mask: mask, preconditions: pre, postconditions: post, body: body, span: through_previous(c, start)));
}
fn parse_closure(c: Context, suspending: Bool) -> Int effects { state, io, process } {
    let captures = list_new<SyntaxName>();
    let open = expect(c, "[");
    var more = !at(c, "]");
    while more {
        let name = identifier(c);
        list_push(captures, SyntaxName(name: name.text, span: name.span));
        more = accept(c, ",") && !at(c, "]");
    }
    let close = expect(c, "]");
    let open_parameters = expect(c, "(");
    let parameters = name_fields(c, ")");
    let arrow = expect(c, "->");
    let return_name = parse_type(c);
    let effect_pattern = parse_effect_pattern(c);
    let body = block(c);
    let index = list_len(c.syntax_closures);
    list_push(c.syntax_closures, SyntaxClosure(suspending: suspending, effect_pattern: effect_pattern, captures: captures, parameters: parameters, return_name: return_name, body: body));
    return index;
}
fn parse_impl(c: Context, start: Int, exported: Bool) -> Unit effects { state, io, process } {
    let parameters = parse_type_parameters(c);
    var owner = parse_type(c);
    var interface_name = "";
    if accept(c, "for") {
        interface_name = owner;
        owner = parse_type(c);
    }
    let header = through_previous(c, start);
    if exported {
        if interface_name != "" {
            interface_error(c, "E236", "impl_visibility", interface_name, owner, "", "An interface implementation has no visibility modifier.", header, empty_span());
        }
        method_error(c, "method_impl_visibility", owner, "", "Declare visibility on methods, not on impl.", header, empty_span());
    }
    let index = list_len(c.syntax_impls);
    list_push(c.syntax_impls, SyntaxImpl(interface_name: interface_name, owner: owner, parameters: parameters, span: header));
    let open = expect(c, "{");
    while !at(c, "}") {
        let member_start = current(c).span.start;
        let visible = accept(c, "pub");
        if visible && interface_name != "" {
            interface_error(c, "E236", "impl_visibility", interface_name, owner, "", "Interface implementation methods have no visibility modifier.", current(c).span, header);
        }
        let suspending = async_fn_ahead(c);
        if suspending {
            if interface_name != "" { bad(c, "E240", "Interface implementations require synchronous methods.", current(c).span); }
            let marker = take(c);
        }
        let word = expect(c, "fn");
        parse_function_body(c, member_start, visible, index, suspending);
    }
    let close = expect(c, "}");
}
fn parse_interface(c: Context, exported: Bool) -> Unit effects { state, io, process } {
    let name = identifier(c);
    declare_module_name(c, name.text, exported, name.span);
    let operations = list_new<SyntaxOperation>();
    let open = expect(c, "{");
    while !at(c, "}") {
        let word = expect(c, "fn");
        let method = identifier(c);
        let open_parameters = expect(c, "(");
        let parameters = name_fields(c, ")");
        let arrow = expect(c, "->");
        let return_name = parse_type(c);
        let effects_mask = parse_test_effects(c);
        let semi = expect(c, ";");
        list_push(operations, SyntaxOperation(name: method.text, parameters: parameters, return_name: return_name, effect_mask: effects_mask, span: method.span));
    }
    let close = expect(c, "}");
    list_push(c.syntax_interfaces, SyntaxInterface(name: name.text, operations: operations, span: name.span));
}
fn parse_module(c: Context) -> Unit effects { state, io, process } {
    let declared = dict_new<Int, Bool>();
    while current(c).kind != 54 {
        let start = current(c).span.start;
        let owner = source_unit_at(c, start);
        if at(c, "import") {
            if dict_has(declared, owner) {
                bad(c, "E221", "Imports must precede declarations.", current(c).span);
            }
            let spec = parse_import(c);
            continue;
        }
        dict_set(declared, owner, true);
        let exported = accept(c, "pub");
        let opaque = accept(c, "opaque");
        if opaque && !at(c, "struct") {
            bad(c, "E100", "Expected struct after opaque.", current(c).span);
        }
        if at(c, "enum") || at(c, "struct") || at(c, "type") {
            let word = take(c).text;
            let name = identifier(c);
            declare_module_name(c, name.text, exported, name.span);
            var decl = SyntaxType(opaque: opaque, type_parameters: parse_type_parameters(c), kind: 70, name: name.text, base: "", fields: list_new<SyntaxField>(), variants: list_new<SyntaxVariant>(), span: name.span);
            if word == "enum" {
                let open = expect(c, "{");
                var more = !at(c, "}");
                while more {
                    let v = identifier(c);
                    var fields = list_new<String>();
                    if accept(c,"(") {
                        fields = type_list(c,")");
                    }
                    list_push(decl.variants, SyntaxVariant(name: v.text, fields: fields, span: through_previous(c, v.span.start)));
                    more = accept(c,",") && !at(c, "}");
                }
                let close = expect(c, "}");
            } else if word == "struct" {
                decl.kind = 76;
                let open = expect(c, "{");
                decl.fields = name_fields(c, "}");
            } else {
                decl.kind = 77;
                let equal = expect(c, "=");
                let distinct_token = expect(c, "distinct");
                decl.base = parse_type(c);
                let semi = expect(c,";");
            }
            var declaration_start = start;
            if word != "enum" {
                declaration_start = name.span.start;
            }
            decl.span = through_previous(c, declaration_start);
            list_push(c.syntax_types, decl);
        } else if accept(c, "extern") {
            let library = take(c);
            if library.kind != 52 || !foreign_library_name(library.text) {
                bad(c, "E228", "extern requires an ASCII DLL basename (1..128 bytes).", library.span);
            }
            let keyword = expect(c, "fn");
            let name = identifier(c);
            if name.text == "main" || name.text == "vela_ffi_abi_version" {
                bad(c, "E228", "Reserved foreign function name.", name.span);
            }
            declare_module_name(c, name.text, exported, name.span);
            if at(c, "<") { bad(c, "E228", "Foreign functions cannot be generic.", current(c).span); }
            let open = expect(c, "(");
            let params = name_fields(c, ")");
            let arrow = expect(c, "->");
            let return_name = parse_type(c);
            let mask = parse_test_effects(c);
            if !at(c, ";") { bad(c, "E228", "Foreign declarations end with ';' and have no contracts or body.", current(c).span); }
            let semi = expect(c, ";");
            list_push(c.syntax_functions, SyntaxFunction(suspending: false, effect_pattern: "", impl_index: -1, method_exported: false, name_span: name.span, foreign_library: library.text, foreign_name: name.text, test_name: "", type_parameters: list_new<TypeParameter>(), name: name.text, parameters: params, return_name: return_name, effect_mask: mask, preconditions: list_new<AstExprId>(), postconditions: list_new<AstExprId>(), body: list_new<AstStmtId>(), span: through_previous(c, start)));
        } else if accept(c, "interface") {
            parse_interface(c, exported);
        } else if accept(c, "impl") {
            parse_impl(c, start, exported);
        } else if async_fn_ahead(c) || at(c, "fn") {
            let suspending = async_fn_ahead(c);
            if suspending { let marker = take(c); }
            let word = expect(c, "fn");
            parse_function_body(c, start, exported, -1, suspending);
        } else if accept(c, "test") {
            let name = take(c);
            if exported || name.kind != 52 || str_len(name.text) == 0 || str_len(name.text) > 256 || contains_byte(name.text, 0) {
                bad(c, "E227", "test requires a private, nonempty string name of at most 256 bytes without NUL.", name.span);
            }
            var count = 0;
            for previous in c.syntax_functions {
                if previous.test_name != ""&& source_unit_at(c, previous.span.start) == owner {
                    count = count + 1;
                    if previous.test_name == name.text {
                        bad(c, "E227", "Duplicate test name.", name.span);
                    }
                }
            }
            if count >= 256 {
                bad(c, "E227", "At most 256 tests per module.", name.span);
            }
            let internal = "@test" + to_string(list_len(c.syntax_functions));
            declare_module_name(c, internal, false, name.span);
            let mask = parse_test_effects(c);
            let body = block(c);
            list_push(c.syntax_functions, SyntaxFunction(suspending: false, effect_pattern: "", impl_index: -1, method_exported: false, name_span: name.span, foreign_library: "", foreign_name: "", test_name: name.text, type_parameters: list_new<TypeParameter>(), name: internal, parameters: list_new<SyntaxField>(), return_name: "Unit", effect_mask: mask, preconditions: list_new<AstExprId>(), postconditions: list_new<AstExprId>(), body: body, span: through_previous(c, start)));
        } else {
            bad(c, "E100", "Expected fn, enum, struct, type or test.", current(c).span);
        }
    }
}
fn parse_test_effects(c: Context) -> Int effects { state, io, process } {
    var mask = 0;
    if accept(c, "effects") {
        let opening = expect(c, "{");
        var more = !at(c, "}");
        while more {
            let e = identifier(c);
            let bit = effect_bit(e.text);
            if bit == 0 {
                bad(c, "E206", "Unknown effect.", e.span);
            }
            if has_bit(mask, bit) {
                bad(c, "E100", "Duplicate effect.", e.span);
            }
            mask = mask + bit;
            more = accept(c,",") && !at(c, "}");
        }
        let close = expect(c, "}");
    }
    return mask;
}
fn foreign_library_name(name: String) -> Bool {
    let n = str_len(name);
    if n < 5 || n > 128 || str_slice(name, n - 4, n) != ".dll" { return false; }
    for i in 0 .. n - 4 {
        let b = str_byte(name, i);
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 95 || b == 45) { return false; }
    }
    return true;
}
fn parse_type_parameters(c: Context) -> List<TypeParameter> effects { state, io, process } {
    return parse_generic_parameters(c, false);
}
fn parse_generic_parameters(c: Context, effect_parameters: Bool) -> List<TypeParameter> effects { state, io, process } {
    let items = list_new<TypeParameter>();
    if at(c, "<") {
        let open = generic_token(c, "<");
        var more = true;
        while more {
            let next = list_get(c.tokens, list_get(c.control, 0).cursor + 1);
            let is_effect = effect_parameters && at(c, "effect") && next.kind == 50;
            if is_effect { let marker = take(c); }
            let name = identifier(c);
            var bound = "Any";
            if is_effect {
                bound = "$effect";
            } else if accept(c,":") {
                bound = parse_type(c);
            }
            list_push(items, TypeParameter(name: name.text, bound: bound, span: name.span));
            more = accept(c,",");
        }
        let close = generic_token(c, ">");
    }
    return items;
}
fn parse_arms(c: Context, value_mode: Bool) -> List<SyntaxArm> effects { state, io, process } {
    let arms = list_new<SyntaxArm>();
    let open = expect(c, "{");
    while !at(c, "}") {
        let owner = identifier(c);
        let sep = expect(c,"::");
        var owner_name = owner.text;
        var variant = identifier(c);
        while accept(c,"::") {
            owner_name = owner_name +"::"+ variant.text;
            variant = identifier(c);
        }
        let names = list_new<SyntaxName>();
        if accept(c,"(") {
            var more = !at(c,")");
            while more {
                let name = identifier(c);
                list_push(names, SyntaxName(name: name.text, span: name.span));
                more = accept(c,",") && !at(c,")");
            }
            let close = expect(c,")");
        }
        let arrow = expect(c, "=>");
        var body = list_new<AstStmtId>();
        var value = no_ast_expr();
        if value_mode {
            value = expression(c, 0);
        } else {
            body = block(c);
        }
        list_push(arms, SyntaxArm(value: value, owner: owner_name, variant: variant.text, variant_span: variant.span, names: names, body: body, span: through_previous(c, owner.span.start)));
        let separator = current(c);
        let comma = accept(c,",");
        if value_mode && comma { dict_set(c.arm_commas, separator.span.start, true); }
        if value_mode && !comma && !at(c, "}") {
            bad(c, "E100", "Expected comma between expression arms.", current(c).span);
        }
    }
    let close = expect(c, "}");
    return arms;
}
fn interpolation_literal(c: Context, parts: List<SyntaxArgument>, text: String, start: Int, end: Int) -> Unit effects { state } {
    list_push(parts, SyntaxArgument(label: "", value: add_ast_expr(c, syntax_expression(3, Span(start: start, end: end), text))));
}
fn interpolation_hole(c: Context, start: Int, end: Int) -> SyntaxArgument effects { state, io, process } {
    var inner = c;
    inner.tokens = list_new<Token>();
    inner.comments = list_new<Token>();
    inner.control = list_new<Control>();
    var ctl = list_get(c.control, 0);
    ctl.cursor = 0;
    ctl.previous_end = start;
    list_push(inner.control, ctl);
    lex_range(inner, start, end);
    let value = expression(inner, 0);
    let colon = expect(inner,":");
    let format = identifier(inner);
    if current(inner).kind != 54 {
        bad(inner, "E100", "Unexpected token after interpolation format.", current(inner).span);
    }
    return SyntaxArgument(label: format.text, value: value);
}
fn parse_interpolation(c: Context, token: Token) -> AstExprId effects { state, io, process } {
    var n = syntax_expression(11, token.span, "");
    let s = c.source_text;
    var i = token.span.start + 2;
    var start = i;
    let literal = strings_new();
    while i + 1 < token.span.end {
        var b = str_byte(s, i);
        if b == 92 {
            i = i + 1;
            b = str_byte(s, i);
            if b == 110 {
                b = 10;
            } else if b == 114 {
                b = 13;
            } else if b == 116 {
                b = 9;
            } else if b == 48 {
                b = 0;
            } else if b != 34 && b != 92 {
                fail(c, "E001", "Unknown string escape.", i - 1, i + 1);
            }
            strings_push(literal, str_from_byte(b));
            i = i + 1;
        } else if (b == 123 || b == 125) && str_byte(s, i + 1) == b {
            strings_push(literal, str_from_byte(b));
            i = i + 2;
        } else if b == 123 {
            interpolation_literal(c, n.arguments, strings_join(literal, ""), start, i);
            strings_truncate(literal, 0);
            let end = interpolation_hole_end(c, i + 1);
            list_push(n.arguments, interpolation_hole(c, i + 1, end));
            i = end + 1;
            start = i;
        } else {
            strings_push(literal, str_from_byte(b));
            i = i + 1;
        }
    }
    interpolation_literal(c, n.arguments, strings_join(literal, ""), start, i);
    return add_ast_expr(c, n);
}


// Source graph and binding. Syntax remains immutable; declarations are bound separately.
fn parse_import(c: Context) -> ImportSpec effects { state, io, process } {
    let start = expect(c, "import").span.start;
    let path = take(c);
    if path.kind != 52 || path.text == "" || contains_byte(path.text, 0) || contains_byte(path.text,
        10) || contains_byte(path.text, 13) {
        bad(c, "E221", "Import requires a nonempty file path.", path.span);
    }
    if str_byte(path.text, 0) == 47 || str_byte(path.text, 0) == 92 || contains_byte(path.text,
        58) {
        bad(c, "E221", "Import path must be relative.", path.span);
    }
    var alias = "";
    if accept(c, "as") {
        alias = identifier(c).text;
    }
    let end = expect(c, ";");
    return ImportSpec(path: path.text, alias: alias, span: Span(start: start, end: end.span.end));
}
fn module_import_specs(local: Context, code: String,
    cache: Cache) -> List<ImportSpec> effects { state, io, process } {
    var key = "";
    if cache.directory != "" {
        key = import_cache_key(code);
        match cache_read(cache, key, "imports") {
            Option::None => {}
            Option::Some(saved) => {
                if str_len(saved) <= 1048576 {
                    match decode_imports(saved, str_len(code)) {
                        Option::Some(specs) => {
                            cache_event(cache, "read", "imports", "hit", "reused", key, "", false);
                            return specs;
                        }
                        Option::None => {}
                    }
                }
                cache_event(cache, "read", "imports", "miss", "invalid_imports", key, "", false);
            }
        }
    }
    let specs = list_new<ImportSpec>();
    lex(local);
    while at(local, "import") {
        list_push(specs, parse_import(local));
    }
    if cache.directory != "" {
        let encoded = encode_imports(specs);
        if str_len(encoded) <= 1048576 {
            cache_store(cache, key, encoded, "imports");
        }
    }
    return specs;
}
fn collect_module(units: List<SourceUnit>, imports: List<ModuleImport>, path: String,
    name: String, code: String, identity: String, json_mode: Bool, depth: Int,
    dependencies: List<ProjectDependency>, overlays: List<QueryOverlay>,
    cache: Cache) -> Int effects { state, io, process } {
    for i in 0 .. list_len(units) {
        if identity != "" && list_get(units, i).identity == identity || identity == "" && path_key(
            path) == path_key(list_get(units, i).path) {
            return i;
        }
    }
    let local = make_context(code, name, json_mode);
    if list_len(units) >= 256 || depth >= 128 {
        bad(local, "E221", "Module graph limit exceeded.", empty_span());
    }
    var start = 0;
    var line_base = 0;
    for unit in units {
        start = unit.end + 1;
        for i in 0 .. str_len(unit.code) {
            if str_byte(unit.code, i) == 10 {
                line_base = line_base + 1;
            }
        }
        line_base = line_base + 1;
    }
    if start + str_len(code) > 16777216 {
        bad(local, "E221", "Module graph exceeds 16 MiB.", empty_span());
    }
    let owner = list_len(units);
    list_push(units, SourceUnit(path: path, name: name, identity: identity, code: code,
        start: start, end: start + str_len(code), line_base: line_base));
    for spec in module_import_specs(local, code, cache) {
        for previous in imports {
            if spec.alias != "" && previous.owner == owner && previous.alias == spec.alias {
                bad(local, "E222", "Duplicate import alias.", spec.span);
            }
        }
        var imported_path = io_value(absolute_path(parent_path(path) + "/" + spec.path));
        if str_byte(spec.path, 0) == 64 {
            imported_path = "";
            for dep in dependencies {
                if spec.path == "@" + dep.alias {
                    imported_path = dep.path;
                }
            }
            if imported_path == "" {
                bad(local, "E221", "Unknown project dependency: " + spec.path, spec.span);
            }
        }
        var imported_code = "";
        match query_source_text(imported_path, overlays) {
            Result::Ok(text) => {
                imported_code = text;
            }
            Result::Err(message) => {
                bad(local, "E221", "Cannot import " + spec.path + ": " + message, spec.span);
            }
        }
        let target_identity = io_value(file_identity(imported_path));
        // Register the edge before recursion so aliases are checked through cycles.
        let edge = list_len(imports);
        let span = Span(start: start + spec.span.start, end: start + spec.span.end);
        list_push(imports, ModuleImport(owner: owner, target: -1, alias: spec.alias, span: span));
        let target = collect_module(units, imports, imported_path, imported_path, imported_code,
            target_identity, json_mode, depth + 1, dependencies, overlays, cache);
        list_set(imports, edge, ModuleImport(owner: owner, target: target, alias: spec.alias,
            span: span));
    }
    return owner;
}
fn module_context(path: String, name: String, code: String,
    json_mode: Bool) -> Context effects { state, io, process } {
    return project_module_context(path, name, code, json_mode, list_new<ProjectDependency>());
}
fn project_module_context(path: String, name: String, code: String, json_mode: Bool,
    dependencies: List<ProjectDependency>) -> Context effects { state, io, process } {
    return project_overlay_context(path, name, code, json_mode, dependencies,
        list_new<QueryOverlay>());
}
fn project_overlay_context(path: String, name: String, code: String, json_mode: Bool,
    dependencies: List<ProjectDependency>, overlays: List<QueryOverlay>) -> Context effects { state,
    io, process } {
    return project_cached_context(path, name, code, json_mode, dependencies, overlays, Cache(
        directory: "", report: false));
}
fn project_cached_context(path: String, name: String, code: String, json_mode: Bool,
    dependencies: List<ProjectDependency>, overlays: List<QueryOverlay>,
    cache: Cache) -> Context effects { state, io, process } {
    let units = list_new<SourceUnit>();
    let imports = list_new<ModuleImport>();
    let entry = collect_module(units, imports, path, name, code, io_value(file_identity(path)),
        json_mode, 0, dependencies, overlays, cache);
    let parts = strings_new();
    for unit in units {
        strings_push(parts, unit.code + "\n");
    }
    var c = make_context(strings_join(parts, ""), name, json_mode);
    c.source_units = units;
    c.imports = imports;
    return c;
}
fn parse_program(c: Context) -> Unit effects { state, io, process } {
    for unit in c.source_units {
        var local = c;
        local.tokens = list_new<Token>();
        local.comments = list_new<Token>();
        local.control = list_new<Control>();
        var control = list_get(c.control, 0);
        control.cursor = 0;
        control.previous_end = unit.start;
        list_push(local.control, control);
        lex_range(local, unit.start, unit.end);
        parse_module(local);
    }
}
fn module_canonical(owner: Int, name: String) -> String {
    if owner == 0 {
        return name;
    }
    return "@" + to_string(owner) + "::" + name;
}
fn declare_module_name(c: Context, name: String, exported: Bool,
    span: Span) -> Unit effects { state, io, process } {
    let owner = source_unit_at(c, span.start);
    list_push(c.declarations, ModuleDeclaration(owner: owner, name: name,
        canonical: module_canonical(owner, name), exported: exported, span: span));
}
fn module_declaration(c: Context, owner: Int, name: String) -> Int effects { state } {
    for i in 0 .. list_len(c.declarations) {
        let d = list_get(c.declarations, i);
        if d.owner == owner && d.name == name {
            return i;
        }
    }
    return -1;
}
fn module_alias(c: Context, name: String, span: Span) -> Int effects { state } {
    let owner = source_unit_at(c, span.start);
    for edge in c.imports {
        if edge.owner == owner && edge.alias == name && name != "" {
            return edge.target;
        }
    }
    return -1;
}
fn module_global_name(c: Context, name: String, span: Span) -> String effects { state, io,
    process } {
    if name == "" {
        return name;
    }
    if str_byte(name, 0) == 64 {
        return name;
    }
    let owner = source_unit_at(c, span.start);
    for i in 0 .. str_len(name) - 1 {
        if str_byte(name, i) == 58 && str_byte(name, i + 1) == 58 {
            let alias = str_slice(name, 0, i);
            let target = module_alias(c, alias, span);
            if target < 0 {
                bad(c, "E222", "Unknown module alias: " + alias, span);
            }
            let index = module_declaration(c, target, str_slice(name, i + 2, str_len(name)));
            if index < 0 {
                bad(c, "E222", "Unknown module member: " + name, span);
            }
            let d = list_get(c.declarations, index);
            if !d.exported {
                bad(c, "E223", "Private module member: " + name, span);
            }
            return d.canonical;
        }
    }
    let own = module_declaration(c, owner, name);
    if own >= 0 {
        return list_get(c.declarations, own).canonical;
    }
    var found = "";
    for edge in c.imports {
        if edge.owner == owner && edge.alias == "" {
            let index = module_declaration(c, edge.target, name);
            if index >= 0 {
                let d = list_get(c.declarations, index);
                if d.exported {
                    if found != "" && found != d.canonical {
                        bad(c, "E222", "Ambiguous imported name: " + name, span);
                    }
                    found = d.canonical;
                }
            }
        }
    }
    if found != "" {
        return found;
    }
    if name == "List" || name == "Dict" || name == "Option" || name == "Result" {
        return name;
    }
    let builtin_type = find_type(c, name);
    if has_type(builtin_type) && type_info(c, builtin_type).span.end == 0 {
        return name;
    }
    let builtin_function = find_symbol(c, c.signatures, name);
    if has_symbol(builtin_function) && symbol_info(c, builtin_function).builtin {
        return name;
    }
    return module_canonical(owner, name);
}
fn module_type_name(c: Context, name: String, parameters: List<TypeParameter>, span: Span,
    public_api: Bool) -> String effects { state, io, process } {
    if name == "" {
        return name;
    }
    for parameter in parameters {
        if parameter.name == name {
            if parameter.bound == "$effect" {
                bad(c, "E210", "Effect parameters are not value types.", span);
            }
            return name;
        }
    }
    let parts = type_parts(name);
    var base = list_get(parts, 0);
    if dynamic_pattern(base) {
        let interface_name = str_slice(base, 5, str_len(base));
        base = "@dyn:" + module_type_name(c, interface_name, list_new<TypeParameter>(), span,
            public_api);
    } else {
        base = module_global_name(c, base, span);
    }
    if callable_pattern(base) {
        validate_effect_names(c, str_slice(base, 4, str_len(base)), parameters, span);
    }
    if public_api {
        for d in c.declarations {
            if d.canonical == base && !d.exported {
                var details = empty_details();
                details.exposed_type = name;
                list_push(details.related, RelatedLocation(message: "Private declaration is here.",
                    span: d.span));
                fail_details(c, "E224", "Public API exposes private type: " + name, span, details);
            }
        }
    }
    if list_len(parts) == 1 {
        return base;
    }
    let args = list_new<String>();
    for i in 1 .. list_len(parts) {
        list_push(args, module_type_name(c, list_get(parts, i), parameters, span, public_api));
    }
    return base + "<" + join_text(args, ",") + ">";
}
fn bind_impl_owners(c: Context) -> List<Int> effects { state, io, process } {
    let owners = list_new<Int>();
    let seen = dict_new<String, Span>();
    for implementation in c.syntax_impls {
        let parts = type_parts(implementation.owner);
        let name = list_get(parts, 0);
        let unit = source_unit_at(c, implementation.span.start);
        let declaration = module_declaration(c, unit, name);
        var interface_name = "";
        if implementation.interface_name != "" {
            interface_name = module_global_name(c, implementation.interface_name,
                implementation.span);
            if find_interface(c, interface_name) < 0 {
                interface_error(c, "E235", "impl_interface", implementation.interface_name, name,
                    "", "Expected a nominal interface.", implementation.span, empty_span());
            }
        }
        var index = -1;
        if declaration >= 0 {
            let declared = list_get(c.declarations, declaration);
            for i in 0 .. list_len(c.bound_types) {
                if list_get(c.bound_types, i).name == declared.canonical {
                    index = i;
                    break;
                }
            }
        }
        if index < 0 {
            if interface_name != "" {
                interface_error(c, "E235", "impl_owner", implementation.interface_name, name, "",
                    "The implementation belongs in the module defining the type.",
                    implementation.span, empty_span());
            }
            method_error(c, "method_owner", name, "",
                "An inherent impl requires a nominal type declared in this module.",
                implementation.span, empty_span());
        }
        let target = list_get(c.bound_types, index);
        let key = target.name + "#" + interface_name;
        if dict_has(seen, key) {
            if interface_name != "" {
                interface_error(c, "E235", "impl_duplicate", implementation.interface_name, name,
                    "", "Duplicate interface implementation.", implementation.span, dict_get(seen,
                    key));
            }
            method_error(c, "method_duplicate_impl", name, "",
                "Only one inherent impl is allowed per type.", implementation.span, dict_get(seen,
                key));
        }
        let count = list_len(implementation.parameters);
        let parameters = bind_type_bounds(c, implementation.parameters, false);
        if count != list_len(target.type_parameters) || list_len(parts) != count + 1 {
            if interface_name != "" {
                interface_error(c, "E235", "impl_conditional", implementation.interface_name, name,
                    "", "An impl must cover the owning type's complete parameter list.",
                    implementation.span, target.span);
            }
            method_error(c, "method_impl_parameters", name, "",
                "Impl must cover the owning type's complete generic parameter list.",
                implementation.span, target.span);
        }
        for i in 0 .. count {
            let p = list_get(parameters, i);
            if p.name != list_get(parts, i + 1) || p.bound != list_get(target.type_parameters,
                i).bound {
                if interface_name != "" {
                    interface_error(c, "E235", "impl_conditional", implementation.interface_name,
                        name, "", "Implementation parameters must match the owner in order.",
                        implementation.span, target.span);
                }
                method_error(c, "method_impl_parameters", name, "",
                    "Impl parameters and bounds must match the owner in order.",
                    implementation.span, target.span);
            }
        }
        validate_type_parameters(c, parameters);
        dict_set(seen, key, implementation.span);
        list_push(c.bound_impls, SyntaxImpl(interface_name: interface_name, owner: target.name,
            parameters: parameters, span: implementation.span));
        list_push(owners, index);
    }
    return owners;
}
fn bind_modules(c: Context) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(c.declarations) {
        var d = list_get(c.declarations, i);
        for j in 0 .. i {
            let previous = list_get(c.declarations, j);
            if previous.owner == d.owner && previous.name == d.name {
                duplicate(c, "Duplicate declaration '" + d.name + "'.", d.span, previous.span);
            }
        }
        let prelude = find_symbol(c, c.signatures, d.name);
        var reserved_function = has_symbol(prelude);
        if has_symbol(prelude) && symbol_info(c, prelude).prelude_fallback {
            reserved_function = false;
            if d.owner == 0 {
                // Post-1.0 prelude additions must not reserve valid old names.
                // Other modules already have distinct canonical identities.
                d.canonical = "@0::" + d.name;
                list_set(c.declarations, i, d);
            }
        }
        if has_type(find_type(c, d.name)) || reserved_function || d.name == "List" || d.name
            == "Dict" {
            bad(c, "E202", "Reserved declaration: " + d.name, d.span);
        }
        if module_alias(c, d.name, d.span) >= 0 {
            bad(c, "E222", "Declaration conflicts with import alias.", d.span);
        }
    }
    bind_interfaces(c);
    for syntax in c.syntax_types {
        let owner = source_unit_at(c, syntax.span.start);
        let d = list_get(c.declarations, module_declaration(c, owner, syntax.name));
        var bound = syntax;
        bound.type_parameters = bind_type_bounds(c, syntax.type_parameters, d.exported);
        bound.name = d.canonical;
        bound.base = module_type_name(c, syntax.base, syntax.type_parameters, syntax.span,
            d.exported);
        bound.fields = list_new<SyntaxField>();
        for field in syntax.fields {
            var f = field;
            f.annotation = module_type_name(c, field.annotation, syntax.type_parameters, field.span,
                d.exported && !syntax.opaque);
            list_push(bound.fields, f);
        }
        bound.variants = list_new<SyntaxVariant>();
        for variant in syntax.variants {
            var v = variant;
            v.fields = list_new<String>();
            for field in variant.fields {
                list_push(v.fields, module_type_name(c, field, syntax.type_parameters, variant.span,
                    d.exported));
            }
            list_push(bound.variants, v);
        }
        list_push(c.bound_types, bound);
    }
    let impl_owners = bind_impl_owners(c);
    let methods = dict_new<String, Span>();
    for syntax in c.syntax_functions {
        let owner = source_unit_at(c, syntax.span.start);
        var bound = syntax;
        var public_api = false;
        if syntax.impl_index < 0 {
            let d = list_get(c.declarations, module_declaration(c, owner, syntax.name));
            bound.name = d.canonical;
            public_api = d.exported;
            bound.type_parameters = bind_type_bounds(c, syntax.type_parameters, public_api);
        } else {
            let implementation = list_get(c.syntax_impls, syntax.impl_index);
            let implementation_bound = list_get(c.bound_impls, syntax.impl_index);
            let target = list_get(c.bound_types, list_get(impl_owners, syntax.impl_index));
            let local_name = list_get(type_parts(implementation.owner), 0);
            let declaration = list_get(c.declarations, module_declaration(c, owner, local_name));
            let exact = module_type_name(c, implementation.owner, syntax.type_parameters,
                implementation.span, false);
            bound.type_parameters = implementation_bound.parameters;
            if list_len(syntax.parameters) == 0 {
                if implementation_bound.interface_name != "" {
                    interface_error(c, "E236", "impl_receiver", implementation.interface_name,
                        local_name, syntax.name, "Expected self with the owning type.",
                        syntax.name_span, target.span);
                }
                method_error(c, "method_receiver", local_name, syntax.name,
                    "A method requires a first parameter self: Owner.", syntax.name_span,
                    target.span);
            }
            let receiver = list_get(syntax.parameters, 0);
            if receiver.name != "self" || module_type_name(c, receiver.annotation,
                syntax.type_parameters, receiver.span, false) != exact {
                if implementation_bound.interface_name != "" {
                    interface_error(c, "E236", "impl_receiver", implementation.interface_name,
                        local_name, syntax.name, "Expected self with the owning type.",
                        receiver.span, target.span);
                }
                method_error(c, "method_receiver", local_name, syntax.name,
                    "The first parameter must be self with the exact owning type.", receiver.span,
                    target.span);
            }
            if implementation_bound.interface_name != "" {
                bound.name = implementation_method_name(implementation_bound, syntax.name);
                bound.method_exported = true;
            } else {
                for field in target.fields {
                    if field.name == syntax.name {
                        method_error(c, "method_collision", local_name, syntax.name,
                            "Method conflicts with a field.", syntax.name_span, field.span);
                    }
                }
                for variant in target.variants {
                    if variant.name == syntax.name {
                        method_error(c, "method_collision", local_name, syntax.name,
                            "Method conflicts with an enum variant.", syntax.name_span,
                            variant.span);
                    }
                }
                if target.kind == 77 && syntax.name == "value" {
                    method_error(c, "method_collision", local_name, syntax.name,
                        "Method conflicts with the distinct value field.", syntax.name_span,
                        target.span);
                }
                bound.name = target.name + "::" + syntax.name;
                public_api = syntax.method_exported && declaration.exported;
            }
            if dict_has(methods, bound.name) {
                if implementation_bound.interface_name != "" {
                    interface_error(c, "E236", "impl_duplicate_method",
                        implementation.interface_name, local_name, syntax.name,
                        "Duplicate interface method.", syntax.name_span, dict_get(methods,
                        bound.name));
                }
                method_error(c, "method_collision", local_name, syntax.name, "Duplicate method.",
                    syntax.name_span, dict_get(methods, bound.name));
            }
            dict_set(methods, bound.name, syntax.name_span);
        }
        bound.return_name = module_type_name(c, syntax.return_name, syntax.type_parameters,
            syntax.span, public_api);
        bound.parameters = list_new<SyntaxField>();
        for parameter in syntax.parameters {
            var p = parameter;
            p.annotation = module_type_name(c, parameter.annotation, syntax.type_parameters,
                parameter.span, public_api);
            let effect_parameter = direct_effect_parameter(c, p.annotation, p.span);
            list_push(bound.parameters, p);
        }
        list_push(c.bound_functions, bound);
    }
    validate_interface_implementations(c);
}


struct Resource {
    name: String,
    relative: String,
    path: String,
    data: String
}
struct Companion {
    name: String,
    data: String
}
fn artifact_join(directory: String, relative: String) -> String {
    if str_len(directory) > 0 {
        let byte = str_byte(directory, str_len(directory) - 1);
        if byte == 47 || (platform() == "windows" && byte == 92) {
            return directory + relative;
        }
    }
    return directory + "/" + relative;
}
fn artifact_key(value: String) -> String effects { state } {
    let bytes = strings_new();
    for i in 0 .. str_len(value) {
        var b = str_byte(value, i);
        if b >= 65 && b <= 90 {
            b = b + 32;
        }
        strings_push(bytes, str_from_byte(b));
    }
    return strings_join(bytes, "");
}
fn starts_with(value: String, prefix: String) -> Bool {
    return str_len(value) >= str_len(prefix) && str_slice(value, 0, str_len(prefix)) == prefix;
}
fn asset_name(value: String) -> Bool effects { state } {
    if str_len(value) > 240 || !starts_with(value, "assets/") {
        return false;
    }
    for part in project_split(value, 47) {
        if part == "" || str_len(part) > 80 || str_byte(part, str_len(part) - 1) == 46 {
            return false;
        }
        for i in 0 .. str_len(part) {
            let b = str_byte(part, i);
            if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45
                || b == 46 || b == 95) {
                return false;
            }
        }
        let stem = artifact_key(list_get(project_split(part, 46), 0));
        if stem == "con" || stem == "prn" || stem == "aux" || stem == "nul" {
            return false;
        }
        if str_len(stem) == 4 && (starts_with(stem, "com") || starts_with(stem, "lpt")) && str_byte(
            stem, 3) >= 48 && str_byte(stem, 3) <= 57 {
            return false;
        }
    }
    return true;
}
fn assets_collide(left: String, right: String) -> Bool effects { state } {
    let a = artifact_key(left);
    let b = artifact_key(right);
    return a == b || starts_with(a, b + "/") || starts_with(b, a + "/");
}
fn artifact_source(manifest: String, relative: String) -> Result<String, String> effects { io,
    state } {
    if !project_relative(relative, true) {
        return Result<String, String>::Err("Artifact source must be relative to the project");
    }
    let directory = parent_path(manifest);
    let root = from_string(canonical_path(directory, false))?;
    let full = artifact_join(directory, relative);
    let file = from_string(canonical_path(full, true))?;
    if !starts_with(path_key(file), path_key(artifact_join(root, ""))) {
        return Result<String, String>::Err("Artifact source escapes the project directory");
    }
    return from_string(absolute_path(full));
}
fn artifact_bytes(file: String) -> Result<String, String> effects { io } {
    return match read_file_bounded(file, 16777216) {
        ReadResult::Ok(data) => Result<String, String>::Ok(data),
        ReadResult::Limit => Result<String, String>::Err("Artifact exceeds 16 MiB"),
        ReadResult::Err(message) => Result<String, String>::Err(message)
    };
}
fn windows_x64_dll(data: String) -> Bool {
    let size = str_len(data);
    if size < 88 || str_slice(data, 0, 2) != "MZ" {
        return false;
    }
    let pe = str_byte(data, 60) + 256 * str_byte(data, 61) + 65536 * str_byte(data, 62) + 16777216
        * str_byte(data, 63);
    if pe < 64 || pe > size - 24 {
        return false;
    }
    return str_slice(data, pe, pe + 2) == "PE" && str_byte(data, pe + 2) == 0 && str_byte(data, pe
        + 3) == 0 && str_byte(data, pe + 4) == 100 && str_byte(data, pe + 5) == 134 && str_byte(
        data, pe + 23) / 32 % 2 == 1;
}
fn artifact_alias(path: String, expected: String, file: Bool) -> Result<Bool,
    String> effects { state, io } {
    let actual = from_string(canonical_path(path, file))?;
    if path_key(actual) != path_key(expected) {
        return Result<Bool, String>::Err("Artifact destination is an alias: " + path);
    }
    return Result<Bool, String>::Ok(true);
}
fn artifact_parents(directory: String, root: String, name: String, create: Bool) -> Result<Bool,
    String> effects { state, io } {
    let parts = project_split(name, 47);
    var relative = "";
    for i in 0 .. list_len(parts) - 1 {
        let part = list_get(parts, i);
        if relative == "" {
            relative = part;
        } else {
            relative = relative + "/" + part;
        }
        let path = artifact_join(directory, relative);
        if from_string(file_identity(path))? == "" {
            if !create {
                return Result<Bool, String>::Ok(true);
            }
            match make_dir(path) {
                WriteResult::Ok => {}
                WriteResult::Err(message) => {
                    if from_string(file_identity(path))? == "" {
                        return Result<Bool, String>::Err(message);
                    }
                }
            }
        }
        let verified = artifact_alias(path, artifact_join(root, relative), false)?;
    }
    return Result<Bool, String>::Ok(true);
}
fn artifact_matches(path: String, expected: String, data: String) -> Result<Bool,
    String> effects { state, io } {
    if from_string(file_identity(path))? == "" {
        return Result<Bool, String>::Ok(false);
    }
    let verified = artifact_alias(path, expected, true)?;
    match read_file_bounded(path, str_len(data)) {
        ReadResult::Ok(existing) => {
            if existing == data {
                return Result<Bool, String>::Ok(true);
            }
        }
        ReadResult::Limit => {}
        ReadResult::Err(_) => {}
    }
    return Result<Bool, String>::Err("Conflicting artifact output: " + path);
}
fn artifact_install(destination: String, expected: String, data: String) -> Result<Bool,
    String> effects { state, io } {
    let dir = from_string(temp_dir(parent_path(destination)))?;
    let source = dir + "/content";
    let written = write_file(source, data);
    var outcome = written;
    match written {
        WriteResult::Ok => {
            outcome = install_file(source, destination);
        }
        WriteResult::Err(_) => {}
    }
    let removed = remove_file(source);
    let closed = remove_dir(dir);
    match outcome {
        WriteResult::Ok => {
            return Result<Bool, String>::Ok(true);
        }
        WriteResult::Err(message) => {
            if artifact_matches(destination, expected, data)? {
                return Result<Bool, String>::Ok(true);
            }
            return Result<Bool, String>::Err(message);
        }
    }
}
fn stage_artifacts(natives: List<NativeDependency>, assets: List<Resource>,
    directory: String) -> Result<Bool, String> effects { state, io } {
    if list_len(natives) == 0 && list_len(assets) == 0 {
        return Result<Bool, String>::Ok(true);
    }
    let root = from_string(canonical_path(directory, false))?;
    let files = list_new<Companion>();
    for native in natives {
        var bytes = native.data;
        if native.target == "" {
            bytes = from_string(read_file(native.path))?;
        }
        list_push(files, Companion(name: native.name, data: bytes));
    }
    for asset in assets {
        list_push(files, Companion(name: asset.name, data: asset.data));
    }
    for file in files {
        let parents = artifact_parents(directory, root, file.name, false)?;
        let matched = artifact_matches(artifact_join(directory, file.name), artifact_join(root,
            file.name), file.data)?;
    }
    for file in files {
        let parents = artifact_parents(directory, root, file.name, true)?;
        let path = artifact_join(directory, file.name);
        let expected = artifact_join(root, file.name);
        if !artifact_matches(path, expected, file.data)? {
            let installed = artifact_install(path, expected, file.data)?;
        }
    }
    return Result<Bool, String>::Ok(true);
}
fn unstage_assets(assets: List<Resource>, directory: String) -> Unit effects { state, io } {
    let root = artifact_join(directory, "");
    for asset in assets {
        let path = artifact_join(directory, asset.name);
        let removed = remove_file(path);
        var parent = parent_path(path);
        while str_len(parent) > str_len(root) {
            let closed = remove_dir(parent);
            parent = parent_path(str_slice(parent, 0, str_len(parent) - 1));
        }
    }
}


struct NativeDependency {
    name: String,
    path: String,
    relative: String,
    target: String,
    data: String
}
struct Project {
    manifest: String,
    text: String,
    name: String,
    entry: String,
    dependencies: List<ProjectDependency>,
    natives: List<NativeDependency>,
    assets: List<Resource>,
    tests: List<String>
}
fn project_split(text: String, separator: Int) -> List<String> effects { state } {
    let parts = list_new<String>();
    var start = 0;
    for i in 0 .. str_len(text) {
        if str_byte(text, i) == separator {
            list_push(parts, str_slice(text, start, i));
            start = i + 1;
        }
    }
    list_push(parts, str_slice(text, start, str_len(text)));
    return parts;
}
fn project_identifier(text: String) -> Bool {
    if text == "" {
        return false;
    }
    for i in 0 .. str_len(text) {
        let b = str_byte(text, i);
        if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95 || i > 0 && b >= 48 && b <= 57) {
            return false;
        }
    }
    return true;
}
fn project_suggest_name(text: String) -> String effects { state } {
    let parts = strings_new();
    var meaningful = false;
    for i in 0 .. str_len(text) {
        let b = str_byte(text, i);
        if b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 95 {
            strings_push(parts, str_from_byte(b));
            if b != 95 {
                meaningful = true;
            }
        } else {
            strings_push(parts, "_");
        }
    }
    if !meaningful {
        return "vela_project";
    }
    let name = strings_join(parts, "");
    if str_byte(name, 0) >= 48 && str_byte(name, 0) <= 57 {
        return "project_" + name;
    }
    return name;
}
fn project_fail(path: String, code: String, message: String,
    json_mode: Bool) -> Unit effects { state, io, process } {
    bad(make_context("", path, json_mode), code, message, empty_span());
}
fn project_relative(path: String, owned: Bool) -> Bool effects { state } {
    if path == "" {
        return false;
    }
    if str_byte(path, 0) == 47 || str_byte(path, 0) == 92 {
        return false;
    }
    for i in 0 .. str_len(path) {
        let b = str_byte(path, i);
        if b < 32 || b == 58 || b == 92 {
            return false;
        }
    }
    if owned {
        for part in project_split(path, 47) {
            if part == ".." {
                return false;
            }
        }
    }
    return true;
}
fn project_is_manifest(path: String) -> Bool {
    let n = str_len(path);
    return n >= 6 && str_slice(path, n - 6, n) == ".vproj" || n >= 12 && str_slice(path, n - 12, n)
        == "vela.project" && (n == 12 || str_byte(path, n - 13) == 47 || str_byte(path, n - 13)
        == 92);
}
fn project_artifact_checked(value: Result<String, String>, text: String, reject: fn(String, String,
    String) -> Unit effects { state, io, process }) -> String effects { state, io, process } {
    match value {
        Result::Ok(data) => {
            return data;
        }
        Result::Err(message) => {
            reject("E225", message, text);
            panic(message);
        }
    }
}
fn project_load_with(input: String, json_mode: Bool, overlays: List<QueryOverlay>, reject: fn(
    String, String, String) -> Unit effects { state, io, process }) -> Project effects { state, io,
    process } {
    var p = Project(manifest: "", text: "", name: "", entry: input,
        dependencies: list_new<ProjectDependency>(), natives: list_new<NativeDependency>(),
        assets: list_new<Resource>(), tests: list_new<String>());
    if !project_is_manifest(input) {
        return p;
    }
    p.manifest = input;
    match query_source_text(input, overlays) {
        Result::Ok(text) => {
            p.text = text;
        }
        Result::Err(message) => {
            source_error(message, json_mode);
        }
    }
    p.entry = "";
    if str_len(p.text) > 1048576 {
        reject("E225", "Manifest exceeds 1 MiB.", p.text);
    }
    var header = false;
    var artifact_size = 0;
    for line in project_split(p.text, 10) {
        if line != "" && str_byte(line, 0) != 35 {
            let fields = project_split(line, 124);
            let kind = list_get(fields, 0);
            if !header {
                if line != "vela-project|1" {
                    reject("E225", "Expected vela-project|1.", p.text);
                }
                header = true;
            } else if kind == "name" && list_len(fields) == 2 && p.name == "" {
                p.name = list_get(fields, 1);
                if !project_identifier(p.name) {
                    reject("E225", "Invalid project name. Suggested name: " + project_suggest_name(
                        p.name), p.text);
                }
            } else if kind == "entry" && list_len(fields) == 2 && p.entry == "" {
                let path = list_get(fields, 1);
                if !project_relative(path, true) {
                    reject("E225", "Invalid entry path.", p.text);
                }
                p.entry = io_value(absolute_path(parent_path(input) + "/" + path));
            } else if kind == "dep" && list_len(fields) == 3 {
                let alias = list_get(fields, 1);
                let path = list_get(fields, 2);
                if !project_identifier(alias) || !project_relative(path, false) || list_len(
                    p.dependencies) >= 128 {
                    reject("E225", "Invalid dependency.", p.text);
                }
                for dep in p.dependencies {
                    if dep.alias == alias {
                        reject("E225", "Duplicate dependency alias.", p.text);
                    }
                }
                list_push(p.dependencies, ProjectDependency(alias: alias, path: io_value(
                    absolute_path(parent_path(input) + "/" + path)), relative: path));
            } else if kind == "native" && (list_len(fields) == 3 || list_len(fields) == 6) {
                let name = list_get(fields, 1);
                let path = list_get(fields, 2);
                if !foreign_library_name(name) || !project_relative(path, false) || list_len(
                    p.natives) >= 128 {
                    reject("E225", "Invalid native dependency.", p.text);
                }
                for previous in p.natives {
                    if path_key(previous.name) == path_key(name) {
                        reject("E225", "Duplicate native library.", p.text);
                    }
                }
                var target = "";
                var data = "";
                var full = io_value(absolute_path(artifact_join(parent_path(input), path)));
                if list_len(fields) == 6 {
                    target = list_get(fields, 3);
                    if target != "windows-x64" || platform() != "windows" || list_get(fields, 4)
                        != "1" || list_get(fields, 5) != "shared" {
                        reject("E225", "Unsupported native target, ABI or artifact kind.", p.text);
                    }
                    full = project_artifact_checked(artifact_source(input, path), p.text, reject);
                    data = project_artifact_checked(artifact_bytes(full), p.text, reject);
                    if !windows_x64_dll(data) {
                        reject("E225", "Expected a Windows x64 PE DLL.", p.text);
                    }
                    artifact_size = artifact_size + str_len(data);
                }
                list_push(p.natives, NativeDependency(name: name, path: full, relative: path,
                    target: target, data: data));
            } else if kind == "resource" && list_len(fields) == 3 {
                let name = list_get(fields, 1);
                let relative = list_get(fields, 2);
                if !asset_name(name) || list_len(p.assets) >= 128 {
                    reject("E225", "Invalid resource destination.", p.text);
                }
                for asset in p.assets {
                    if assets_collide(asset.name, name) {
                        reject("E225", "Colliding resource destinations.", p.text);
                    }
                }
                let path = project_artifact_checked(artifact_source(input, relative), p.text,
                    reject);
                let data = project_artifact_checked(artifact_bytes(path), p.text, reject);
                artifact_size = artifact_size + str_len(data);
                list_push(p.assets, Resource(name: name, relative: relative, path: path,
                    data: data));
            } else if kind == "test" && list_len(fields) == 2 {
                let path = list_get(fields, 1);
                if !project_relative(path, true) || list_len(p.tests) >= 128 {
                    reject("E225", "Invalid test path.", p.text);
                }
                let absolute = io_value(absolute_path(parent_path(input) + "/" + path));
                for previous in p.tests {
                    if path_key(previous) == path_key(absolute) {
                        reject("E225", "Duplicate test.", p.text);
                    }
                }
                list_push(p.tests, absolute);
            } else {
                reject("E225", "Unknown, duplicate or malformed manifest field: " + kind, p.text);
            }
            if artifact_size > 67108864 {
                reject("E225", "Explicit artifacts exceed 64 MiB.", p.text);
            }
        }
    }
    if !header || p.name == "" || p.entry == "" {
        reject("E225", "Manifest requires header, name and entry.", p.text);
    }
    return p;
}
fn project_load(input: String, json_mode: Bool) -> Project effects { state, io, process } {
    return project_load_with(input, json_mode, list_new<QueryOverlay>(), fn [ input, json_mode ](
        code: String, message: String, text: String) -> Unit effects { state, io, process } {
        let context = repair_project_error_context(text, input, json_mode);
        bad(context, code, message, repair_project_span(context, message));
    });
}
fn project_lock_text(p: Project, json_mode: Bool) -> String effects { state, io, process } {
    let lines = strings_new();
    strings_push(lines, "vela-lock|1\nmanifest|" + sha256(p.text) + "\n");
    for dep in p.dependencies {
        let c = project_module_context(dep.path, dep.path, load_source(dep.path, json_mode),
            json_mode, p.dependencies);
        let graph = strings_new();
        for unit in c.source_units {
            strings_push(graph, sha256(unit.code) + "\n");
        }
        for edge in c.imports {
            strings_push(graph, to_string(edge.owner) + "|" + to_string(edge.target) + "|"
                + edge.alias + "\n");
        }
        strings_push(lines, "dep|" + dep.alias + "|" + dep.relative + "|" + sha256(strings_join(
            graph, "")) + "\n");
    }
    for native in p.natives {
        let prefix = "native|" + native.name + "|" + native.relative + "|";
        if native.target == "" {
            strings_push(lines, prefix + sha256(io_value(read_file(native.path))) + "\n");
        } else {
            strings_push(lines, prefix + native.target + "|1|shared|" + sha256(native.data) + "\n");
        }
    }
    for asset in p.assets {
        strings_push(lines, "resource|" + asset.name + "|" + asset.relative + "|" + sha256(
            asset.data) + "\n");
    }
    return strings_join(lines, "");
}
fn project_verify_lock(p: Project, json_mode: Bool) -> Unit effects { state, io, process } {
    if list_len(p.dependencies) == 0 && list_len(p.natives) == 0 && list_len(p.assets) == 0 {
        return;
    }
    let expected = project_lock_text(p, json_mode);
    match source_text_result(p.manifest + ".lock") {
        Result::Ok(actual) => {
            if actual == expected {
                return;
            }
        }
        Result::Err(_) => {}
    }
    project_fail(p.manifest, "E226",
        "Missing or stale lock; run vela lock PROJECT after reviewing dependencies.", json_mode);
}
fn project_write_lock(p: Project, json_mode: Bool) -> Int effects { state, io, process } {
    if p.manifest == "" {
        project_fail(p.entry, "E225", "lock requires a project manifest.", json_mode);
    }
    let lock = p.manifest + ".lock";
    let identity = io_value(file_identity(lock));
    let c = project_module_context(p.entry, p.entry, load_source(p.entry, json_mode), json_mode,
        p.dependencies);
    for unit in c.source_units {
        if path_key(lock) == path_key(unit.path) || identity != "" && identity == unit.identity {
            project_fail(lock, "E226", "Lock must not overwrite source.", json_mode);
        }
    }
    for dep in p.dependencies {
        let graph = project_module_context(dep.path, dep.path, load_source(dep.path, json_mode),
            json_mode, p.dependencies);
        for unit in graph.source_units {
            if path_key(lock) == path_key(unit.path) || identity != "" && identity
                == unit.identity {
                project_fail(lock, "E226", "Lock must not overwrite dependency source.", json_mode);
            }
        }
    }
    for test in p.tests {
        if path_key(lock) == path_key(test) || identity != "" && identity == io_value(file_identity(
            test)) {
            project_fail(lock, "E226", "Lock must not overwrite test source.", json_mode);
        }
    }
    if identity != "" && identity == io_value(file_identity(p.manifest)) {
        project_fail(lock, "E226", "Lock must not overwrite manifest.", json_mode);
    }
    for native in p.natives {
        if path_key(lock) == path_key(native.path) || identity != "" && identity == io_value(
            file_identity(native.path)) {
            project_fail(lock, "E226", "Lock must not overwrite native input.", json_mode);
        }
    }
    for asset in p.assets {
        if path_key(lock) == path_key(asset.path) || identity != "" && identity == io_value(
            file_identity(asset.path)) {
            project_fail(lock, "E226", "Lock must not overwrite resource input.", json_mode);
        }
    }
    write_atomic(lock, project_lock_text(p, json_mode));
    if json_mode {
        print("{\"schema_version\":1,\"ok\":true,\"lock\":" + json_string(lock) + "}");
    } else {
        print("Locked: " + p.manifest);
    }
    return 0;
}


struct Cache {
    directory: String,
    report: Bool
}
fn cache_event(cache: Cache, phase: String, layer: String, status: String, reason: String,
    key: String, message: String, warning: Bool) -> Unit effects { io, state } {
    if !cache.report && !warning { return; }
    eprint("{\"schema_version\":1,\"kind\":\"cache\",\"phase\":" + json_string(phase)
        + ",\"layer\":" + json_string(layer) + ",\"status\":" + json_string(status)
        + ",\"reason\":" + json_string(reason) + ",\"directory\":" + json_string(cache.directory)
        + ",\"key\":" + json_string(key) + ",\"message\":" + json_string(message) + "}");
}
fn cache_prepare(directory: String, report: Bool) -> Cache effects { io, state } {
    let cache = Cache(directory: directory, report: report);
    if directory == "" {
        cache_event(cache, "directory", "all", "disabled", "not_requested", "", "", false);
        return cache;
    }
    match make_dir(directory) {
        WriteResult::Ok => {
            cache_event(cache, "directory", "all", "ready", "available", "", "", false);
            return cache;
        }
        WriteResult::Err(message) => {
            cache_event(cache, "directory", "all", "unavailable", "create_failed", "", message, true);
            return Cache(directory: "", report: report);
        }
    }
}
// The file name binds the record to its input key. The header checks integrity.
fn cache_read(cache: Cache, key: String, layer: String) -> Option<String> effects { io, state } {
    if cache.directory == "" {
        return Option<String>::None;
    }
    let prefix = "VLC1\n" + key + "\n";
    var reason = "corrupt";
    var message = "";
    match read_file_bounded(cache.directory + "/vela-cache-v1-" + key, 67108864) {
        ReadResult::Ok(value) => {
            if str_len(value) >= 135 && str_slice(value, 0, 70) == prefix && str_byte(value, 134)
                == 10 {
                let body = str_slice(value, 135, str_len(value));
                if sha256(body) == str_slice(value, 70, 134) {
                    return Option<String>::Some(body);
                }
            }
        }
        ReadResult::Limit => { reason = "limit"; }
        ReadResult::Err(error) => { reason = "read_error"; message = error; }
    }
    cache_event(cache, "read", layer, "miss", reason, key, message, false);
    return Option<String>::None;
}
fn cache_store(cache: Cache, key: String, body: String, layer: String) -> Unit effects { io, state } {
    if cache.directory == "" {
        return;
    }
    if str_len(body) > 67108729 {
        cache_event(cache, "write", layer, "skipped", "limit", key, "", false);
        return;
    }
    let record = "VLC1\n" + key + "\n" + sha256(body) + "\n" + body;
    match write_atomic_result(cache.directory + "/vela-cache-v1-" + key, record) {
        Result::Ok(_) => { cache_event(cache, "write", layer, "stored", "published", key, "", false); }
        Result::Err(message) => { cache_event(cache, "write", layer, "failed", "write_error", key, message, true); }
    }
}
fn import_cache_key(code: String) -> String {
    return sha256("imports-v1\n" + compiler_fingerprint() + sha256(code));
}
fn encode_imports(specs: List<ImportSpec>) -> String effects { state } {
    let parts = strings_new();
    for spec in specs {
        strings_push(parts, spec.path + "\n" + spec.alias + "\n" + to_string(spec.span.start) + "\n"
            + to_string(spec.span.end) + "\n");
    }
    return strings_join(parts, "");
}
fn decode_imports(value: String, length: Int) -> Option<List<ImportSpec>> effects { state } {
    let fields = project_split(value, 10);
    let count = list_len(fields);
    if count % 4 != 1 || list_get(fields, count - 1) != "" {
        return Option<List<ImportSpec>>::None;
    }
    let imports = list_new<ImportSpec>();
    var previous = 0;
    for row in 0 .. count / 4 {
        let i = row * 4;
        let path = list_get(fields, i);
        if path == "" {
            return Option<List<ImportSpec>>::None;
        }
        var begin = -1;
        var finish = -1;
        match parse_int(list_get(fields, i + 2)) {
            IntResult::Ok(n) => {
                begin = n;
            }
            IntResult::Err(_) => {}
        }
        match parse_int(list_get(fields, i + 3)) {
            IntResult::Ok(n) => {
                finish = n;
            }
            IntResult::Err(_) => {}
        }
        if begin < previous || finish <= begin || finish > length {
            return Option<List<ImportSpec>>::None;
        }
        list_push(imports, ImportSpec(path: path, alias: list_get(fields, i + 1), span: Span(
            start: begin, end: finish)));
        previous = finish;
    }
    return Option<List<ImportSpec>>::Some(imports);
}
fn analysis_cache_key(c: Context, p: Project, kind: String) -> String effects { state } {
    let parts = strings_new();
    strings_push(parts, compiler_fingerprint());
    strings_push(parts, kind);
    strings_push(parts, sha256(p.text));
    for unit in c.source_units {
        strings_push(parts, sha256(unit.path) + sha256(unit.name) + sha256(unit.code));
    }
    for edge in c.imports {
        strings_push(parts, f"{edge.owner:d}:{edge.target:d}:{edge.span.start:d}:{edge.span.end:d}:"
            + sha256(edge.alias));
    }
    return sha256(strings_join(parts, "\n"));
}


fn capture_data(data: String) -> String effects { state } {
    if utf8_valid(data) {
        return data;
    }
    let parts = strings_new();
    let digits = "0123456789abcdef";
    for i in 0 .. str_len(data) {
        let b = str_byte(data, i);
        strings_push(parts, str_slice(digits, b / 16, b / 16 + 1));
        strings_push(parts, str_slice(digits, b % 16, b % 16 + 1));
    }
    return strings_join(parts, "");
}
fn capture_encoding(data: String) -> String {
    if utf8_valid(data) {
        return "utf8";
    }
    return "hex";
}
fn project_test(p: Project, json_mode: Bool) -> Int effects { state, io, process } {
    let paths = list_new<String>();
    if p.manifest == "" {
        list_push(paths, p.entry);
    } else {
        if list_len(p.tests) == 0 {
            project_fail(p.entry, "E225", "Project has no test entries.", json_mode);
        }
        for path in p.tests {
            list_push(paths, path);
        }
    }
    let reports = strings_new();
    var passed = 0;
    var failed = 0;
    var infrastructure = false;
    for path in paths {
        let c = project_module_context(path, path, load_source(path, json_mode), json_mode, p.dependencies);
        parse_program(c);
        analyze(c);
        let entries = list_new<SymbolId>();
        let names = list_new<String>();
        for declaration in c.bound_functions {
            if declaration.test_name != ""&& source_unit_at(c, declaration.span.start) == 0 {
                list_push(entries, find_symbol(c, c.signatures, declaration.name));
                list_push(names, declaration.test_name);
            }
        }
        if list_len(entries) == 0 {
            list_push(entries, find_symbol(c, c.signatures, "main"));
            list_push(names, "main");
        }
        for index in 0 .. list_len(entries) {
            let entry = list_get(entries, index);
            let name = list_get(names, index);
            let generated = generate_entry(c, entry);
            let dir = io_value(temp_dir(""));
            let exe = dir + "/test.exe";
            var exit_code = build_or_run_native(generated, exe, strings_new(), false, p.natives, p.assets);
            var status = "build_error";
            var out = "";
            var err = "";
            if exit_code == 0 {
                let args = strings_new();
                strings_push(args, exe);
                match process_run_at(args, dir, dir + "/stdout", dir + "/stderr", 30000) {
                    ProcessResult::Exited(code) => {
                        exit_code = code;
                        status = "failed";
                        if code == 0 {
                            status = "passed";
                        }
                    }
                    ProcessResult::TimedOut => {
                        exit_code = 124;
                        status = "timeout";
                    }
                    ProcessResult::Err(message) => {
                        exit_code = 2;
                        err = message;
                    }
                }
                match read_file_bounded(dir + "/stdout", 4194304) {
                    ReadResult::Ok(data) => {
                        out = data;
                    }
                    ReadResult::Limit => {
                        status = "failed";
                        err = err + "stdout capture exceeds 4 MiB";
                    }
                    ReadResult::Err(_) => {}
                }
                match read_file_bounded(dir + "/stderr", 4194304) {
                    ReadResult::Ok(data) => {
                        err = err + data;
                    }
                    ReadResult::Limit => {
                        status = "failed";
                        err = err + "stderr capture exceeds 4 MiB";
                    }
                    ReadResult::Err(_) => {}
                }
            }
            if status == "build_error" {
                infrastructure = true;
            }
            ignored_write(remove_file(dir + "/stdout"));
            ignored_write(remove_file(dir + "/stderr"));
            ignored_write(remove_file(exe));
            for native in p.natives { ignored_write(remove_file(dir + "/" + native.name)); }
            unstage_assets(p.assets, dir);
            var artifact = "";
            match remove_dir(dir) {
                WriteResult::Ok => {}
                WriteResult::Err(_) => {
                    artifact = dir;
                }
            }
            if status == "passed" {
                passed = passed + 1;
            } else {
                failed = failed + 1;
            }
            strings_push(reports, "{\"name\":" + json_string(name) + ",\"source\":" + json_string(path) + ",\"span\":" + span_json(c, symbol_info(c, entry).span) + ",\"status\":" + json_string(status) + ",\"exit_code\":" + to_string(exit_code) + ",\"stdout\":" + json_string(capture_data(out)) + ",\"stderr\":" + json_string(capture_data(err)) + ",\"stdout_encoding\":" + json_string(capture_encoding(out)) + ",\"stderr_encoding\":" + json_string(capture_encoding(err)) + ",\"artifact_dir\":" + json_string(artifact) + "}");
            if !json_mode {
                print(path + " [" + name + "]: " + status + " (exit " + to_string(exit_code) +")");
                if out != "" {
                    write_stdout(out);
                }
                if err != "" {
                    eprint(err);
                }
                if artifact != "" {
                    print("Artifacts: " + artifact);
                }
            }
        }
    }
    if json_mode {
        print("{\"schema_version\":2,\"ok\":" + to_string(failed == 0) + ",\"passed\":" + to_string(passed) + ",\"failed\":" + to_string(failed) + ",\"tests\":[" + strings_join(reports,",") + "]}");
    }
    if infrastructure {
        return 2;
    }
    if failed != 0 {
        return 1;
    }
    return 0;
}
fn project_format(p: Project, checking: Bool, writing: Bool, json_mode: Bool) -> Int effects { state, io, process } {
    if !checking && !writing {
        eprint("fmt PROJECT requires --check or --write.");
        return 2;
    }
    let excluded = list_new<String>();
    for dep in p.dependencies {
        let c = project_module_context(dep.path, dep.path, load_source(dep.path, json_mode), json_mode, p.dependencies);
        for unit in c.source_units {
            list_push(excluded, unit.identity);
        }
    }
    let entries = list_new<String>();
    list_push(entries, p.entry);
    for test in p.tests {
        list_push(entries, test);
    }
    let visited = list_new<String>();
    let root = path_key(parent_path(p.manifest));
    var status = 0;
    for entry in entries {
        let c = project_module_context(entry, entry, load_source(entry, json_mode), json_mode, p.dependencies);
        for unit in c.source_units {
            var selected = true;
            for id in excluded {
                if unit.identity == id {
                    selected = false;
                }
            }
            for id in visited {
                if unit.identity == id {
                    selected = false;
                }
            }
            let path = path_key(unit.path);
            if str_len(path) < str_len(root) || str_slice(path, 0, str_len(root)) != root {
                selected = false;
            }
            if selected {
                list_push(visited, unit.identity);
                let local = make_context(unit.code, unit.path, json_mode);
                lex(local);
                parse_module(local);
                let formatted = format_source(local);
                if io_value(read_file(unit.path)) != formatted {
                    if checking {
                        eprint("Needs formatting: " + unit.path);
                        status = 1;
                    } else {
                        write_atomic(unit.path, formatted);
                    }
                }
            }
        }
    }
    return status;
}


// Canonical semantic types and signatures; syntax never reaches the backend.
fn split_text(s: String, delimiter: Int) -> List<String> effects { state } {
    let parts = list_new<String>();
    var start = 0;
    var i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == delimiter {
            list_push(parts, str_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    list_push(parts, str_slice(s, start, i));
    return parts;
}
fn join_text(items: List<String>, separator: String) -> String effects { state } {
    let parts = strings_new();
    for i in 0 .. list_len(items) {
        strings_push(parts, list_get(items, i));
    }
    return strings_join(parts, separator);
}
fn find_type(c: Context, name: String) -> TypeId effects { state } {
    for i in 0 .. list_len(c.types) {
        if list_get(c.types, i).name == name {
            return primitive_type_id(i + 1);
        }
    }
    return no_type();
}
fn type_name(c: Context, id: TypeId) -> String effects { state, io, process } {
    return type_info(c, id).name;
}
fn display_root_name(name: String) -> String {
    if str_len(name) >= 4 && str_slice(name, 0, 4) == "@0::" {
        return str_slice(name, 4, str_len(name));
    }
    return name;
}
fn display_type(c: Context, id: TypeId) -> String effects { state, io, process } {
    let info = type_info(c, id);
    if info.kind == 82 {
        return "dyn " + display_root_name(interface_label(c, info.base_name));
    }
    if info.kind == 80 {
        let arguments = strings_new();
        for i in 1 .. list_len(info.arguments) {
            strings_push(arguments, display_type(c, list_get(info.arguments, i)));
        }
        var prefix = "fn(";
        if has_bit(info.call_effect_mask, 16) {
            prefix = "async fn(";
        }
        return prefix + strings_join(arguments, ", ") + ") -> " + display_type(c, list_get(
            info.arguments, 0)) + " effects {" + strings_join(effect_names(info.call_effect_mask),
            ", ") + "}";
    }
    if list_len(info.arguments) > 0 {
        let arguments = strings_new();
        for argument in info.arguments {
            strings_push(arguments, display_type(c, argument));
        }
        return display_root_name(list_get(type_parts(info.name), 0)) + "<" + strings_join(arguments,
            ",") + ">";
    }
    return display_root_name(info.name);
}
fn type_kind(c: Context, id: TypeId) -> Int effects { state, io, process } {
    if !has_type(id) {
        return 0;
    }
    return type_info(c, id).kind;
}
fn scalar_type(c: Context, id: TypeId) -> TypeId effects { state, io, process } {
    if type_kind(c, id) == 77 {
        let t = type_info(c, id);
        if has_type(t.base) {
            return t.base;
        }
        return find_type(c, t.base_name);
    }
    return id;
}
fn is_scalar(id: TypeId) -> Bool {
    return id == int_type() || id == bool_type() || id == string_type() || id == float_type();
}
fn supports_scalar(c: Context, id: TypeId) -> Bool effects { state, io, process } {
    let t = type_info(c, id);
    return t.constraint == "Scalar" || t.constraint == "Number" || is_scalar(scalar_type(c, id));
}
fn supports_enum_equality(c: Context, id: TypeId) -> Bool effects { state, io, process } {
    let t = type_info(c, id);
    if t.kind != 70 || t.parameter_name != "" {
        return false;
    }
    for variant in t.variants {
        if list_len(symbol_info(c, variant).parameters) != 0 {
            return false;
        }
    }
    return list_len(t.variants) > 0;
}
fn find_symbol(c: Context, items: List<SymbolId>, name: String) -> SymbolId effects { state, io,
    process } {
    for i in 0 .. list_len(items) {
        let id = list_get(items, i);
        if symbol_info(c, id).name == name {
            return id;
        }
    }
    return no_symbol();
}
fn require_type(c: Context, actual: TypeId, expected: TypeId,
    span: Span) -> Unit effects { state, io, process } {
    require_type_at(c, actual, expected, span, type_info(c, expected).span);
}
fn require_type_at(c: Context, actual: TypeId, expected: TypeId, span: Span,
    declaration: Span) -> Unit effects { state, io, process } {
    if actual != expected {
        if matching_callable_shape(c, actual, expected) {
            let got = type_info(c, actual).call_effect_mask;
            let allowed = type_info(c, expected).call_effect_mask;
            require_callable_effects(c, got % 16, allowed % 16, span);
            return;
        }
        if type_info(c, actual).parameter_name != "" {
            bound_error(c, actual, "", "type match", span);
        }
        if type_info(c, expected).parameter_name != "" {
            bound_error(c, expected, "", "type match", span);
        }
        if type_kind(c, expected) == 82 {
            dynamic_error(c, type_info(c, expected).base_name, "dynamic_conversion",
                "Expected explicit dynamic interface packing.", span);
        }
        var details = empty_details();
        details.expected_type = display_type(c, expected);
        details.actual_type = display_type(c, actual);
        if declaration.end > declaration.start {
            list_push(details.related, RelatedLocation(message: "Expected type is declared here.",
                span: declaration));
        }
        fail_details(c, "E201", "Expected " + details.expected_type + ", found "
            + details.actual_type + ".", span, details);
    }
}
fn type_parts(name: String) -> List<String> effects { state } {
    let parts = list_new<String>();
    var i = 0;
    while i < str_len(name) && str_byte(name, i) != 60 {
        i = i + 1;
    }
    list_push(parts, str_slice(name, 0, i));
    if i == str_len(name) {
        return parts;
    }
    i = i + 1;
    var start = i;
    var depth = 0;
    while i + 1 < str_len(name) {
        let b = str_byte(name, i);
        if b == 60 {
            depth = depth + 1;
        } else if b == 62 {
            depth = depth - 1;
        } else if b == 44 && depth == 0 {
            list_push(parts, str_slice(name, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    list_push(parts, str_slice(name, start, i));
    return parts;
}
fn collection_type(c: Context, name: String, args: List<TypeId>,
    span: Span) -> TypeId effects { state, io, process } {
    if (name == "List" && list_len(args) != 1) || (name == "Dict" && list_len(args) != 2) || (name
        != "List" && name != "Dict") {
        bad(c, "E200", "Invalid generic type or argument count.", span);
    }
    if name == "Dict" && (!is_scalar(scalar_type(c, list_get(args, 0))) || scalar_type(c, list_get(
        args, 0)) == float_type()) {
        let key = list_get(args, 0);
        if type_info(c, key).parameter_name != "" {
            bound_error(c, key, "", "dictionary key", span);
        }
        bad(c, "E201", "Dictionary keys must be Int, Bool, String or a distinct primitive.", span);
    }
    let names = list_new<String>();
    var i = 0;
    while i < list_len(args) {
        list_push(names, type_name(c, list_get(args, i)));
        i = i + 1;
    }
    let canonical = name + "<" + join_text(names, ",") + ">";
    let found = find_type(c, canonical);
    if has_type(found) {
        return found;
    }
    var t = type_record(75, canonical, span);
    t.arguments = args;
    return add_type(c, t);
}
fn resolve_pattern(c: Context, name: String, mapping: Dict<String, TypeId>,
    span: Span) -> TypeId effects { state, io, process } {
    enter(c, span);
    var t = no_type();
    if dict_has(mapping, name) {
        t = dict_get(mapping, name);
        if !has_type(t) {
            bad(c, "E201", "Cannot infer type argument; provide explicit <Types>.", span);
        }
        if type_kind(c, t) == 81 {
            bad(c, "E210", "An effect argument is not a value type.", span);
        }
    } else {
        let parts = type_parts(name);
        if callable_pattern(list_get(parts, 0)) {
            t = resolve_callable_type(c, parts, mapping, span);
        } else if dynamic_pattern(list_get(parts, 0)) {
            t = resolve_dynamic_type(c, str_slice(name, 5, str_len(name)), span);
        } else if effect_argument_pattern(name) {
            t = effect_argument(c, effect_pattern_constant(str_slice(name, 4, str_len(name))));
        } else if list_len(parts) == 1 {
            t = find_type(c, module_global_name(c, name, span));
            if type_kind(c, t) == 78 {
                bad(c, "E210", "Generic type requires explicit arguments.", span);
            }
            if !has_type(t) {
                bad(c, "E200", "Unknown type: " + name, span);
            }
        } else {
            let args = list_new<TypeId>();
            var i = 1;
            while i < list_len(parts) {
                list_push(args, resolve_pattern(c, list_get(parts, i), mapping, span));
                i = i + 1;
            }
            t = instantiate_type(c, module_global_name(c, list_get(parts, 0), span), args, span);
        }
    }
    leave(c);
    return t;
}
fn resolve_type(c: Context, name: String, span: Span) -> TypeId effects { state, io, process } {
    return resolve_pattern(c, name, list_get(c.control, 0).type_mapping, span);
}
fn unify_pattern(c: Context, pattern: String, actual: TypeId, mapping: Dict<String, TypeId>,
    span: Span) -> Unit effects { state, io, process } {
    enter(c, span);
    if dict_has(mapping, pattern) {
        let previous = dict_get(mapping, pattern);
        if !has_type(previous) {
            dict_set(mapping, pattern, actual);
        } else {
            require_type(c, actual, previous, span);
        }
    } else {
        let parts = type_parts(pattern);
        if callable_pattern(list_get(parts, 0)) {
            unify_callable_pattern(c, parts, actual, mapping, span);
        } else if list_len(parts) == 1 {
            require_type(c, actual, resolve_type(c, pattern, span), span);
        } else {
            if list_len(type_info(c, actual).arguments) == 0 {
                bad(c, "E201", "Expected a collection.", span);
            }
            let t = type_info(c, actual);
            let actual_parts = type_parts(t.name);
            if list_get(parts, 0) != list_get(actual_parts, 0) || list_len(parts) != list_len(
                actual_parts) {
                bad(c, "E201", "Incompatible collection types.", span);
            }
            var i = 0;
            while i < list_len(t.arguments) {
                unify_pattern(c, list_get(parts, i + 1), list_get(t.arguments, i), mapping, span);
                i = i + 1;
            }
        }
    }
    leave(c);
}
fn require_effects(c: Context, signature_id: SymbolId, span: Span) -> Unit effects { state, io,
    process } {
    let sig = symbol_info(c, signature_id);
    require_await_call(c, sig.suspending, span);
    let required = sig.effect_mask;
    let allowed = list_get(c.control, 0).allowed_effects;
    var bit = 1;
    var missing = 0;
    while bit <= 8 {
        if has_bit(required, bit) && !has_bit(allowed, bit) {
            missing = missing + bit;
        }
        bit = bit * 2;
    }
    if missing != 0 {
        var details = empty_details();
        details.callee = sig.name;
        details.required_effects = required;
        details.allowed_effects = allowed;
        details.missing_effects = missing;
        if !sig.builtin {
            list_push(details.related, RelatedLocation(
                message: "Called function declares these effects.", span: sig.span));
        }
        fail_details(c, "E209", "Call to '" + sig.name + "' requires undeclared effects: "
            + strings_join(effect_names(missing), ", ") + ".", span, details);
    }
}
fn post_stable_builtin(version: String) -> Bool effects { state } {
    let parts = split_text(version, 46);
    if list_len(parts) < 2 {
        return false;
    }
    var major = 0;
    var minor = 0;
    match parse_int(list_get(parts, 0)) {
        IntResult::Ok(n) => {
            major = n;
        }
        IntResult::Err(_) => {
            return false;
        }
    }
    match parse_int(list_get(parts, 1)) {
        IntResult::Ok(n) => {
            minor = n;
        }
        IntResult::Err(_) => {
            return false;
        }
    }
    return major > 1 || major == 1 && minor > 0;
}
fn install_prelude(c: Context) -> Unit effects { state, io, process } {
    let primitive_names = split_text(
        "Int;Bool;String;Unit;IntList;StringList;Float64;ForeignHandle;Int32;CallbackHandle", 59);
    var i = 0;
    while i < list_len(primitive_names) {
        let id = add_type(c, type_record(0, list_get(primitive_names, i), empty_span()));
        i = i + 1;
    }
    let rows = split_text(builtin_source(), 10);
    i = 0;
    while i < list_len(rows) {
        var row = list_get(rows, i);
        if str_len(row) > 0 && str_byte(row, str_len(row) - 1) == 13 {
            row = str_slice(row, 0, str_len(row) - 1);
        }
        if row != "" && str_byte(row, 0) != 35 {
            let cols = split_text(row, 124);
            if list_len(cols) != 8 {
                bad(c, "E900", "Invalid embedded builtin catalog row.", empty_span());
            }
            let name = list_get(cols, 1);
            if list_get(cols, 0) == "enum" && list_get(cols, 2) != "" {
                install_generic_enum(c, name, list_get(cols, 2), list_get(cols, 3));
            } else if list_get(cols, 0) == "enum" {
                let id = add_type(c, type_record(70, name, empty_span()));
                let t = type_info(c, id);
                let variants = split_text(list_get(cols, 3), 59);
                var j = 0;
                while j < list_len(variants) {
                    let pair = split_text(list_get(variants, j), 58);
                    var v = symbol_record(71, list_get(pair, 0), id, empty_span());
                    v.owner = id;
                    v.tag = j;
                    if list_get(pair, 1) != "" {
                        let fields = split_text(list_get(pair, 1), 44);
                        var k = 0;
                        while k < list_len(fields) {
                            list_push(v.parameters, add_symbol(c, symbol_record(72, "",
                                resolve_type(c, list_get(fields, k), empty_span()), empty_span())));
                            k = k + 1;
                        }
                    }
                    list_push(t.variants, add_symbol(c, v));
                    j = j + 1;
                }
            } else {
                var sig = symbol_record(73, name, no_type(), empty_span());
                sig.builtin = true;
                sig.prelude_fallback = post_stable_builtin(list_get(cols, 7));
                sig.abi = list_get(cols, 6);
                sig.return_pattern = list_get(cols, 4);
                if list_get(cols, 2) != "" {
                    sig.variables = split_text(list_get(cols, 2), 59);
                }
                if list_get(cols, 3) != "" {
                    sig.patterns = split_text(list_get(cols, 3), 59);
                }
                let names = split_text(list_get(cols, 5), 59);
                var j = 0;
                while j < list_len(names) {
                    sig.effect_mask = sig.effect_mask + effect_bit(list_get(names, j));
                    j = j + 1;
                }
                list_push(c.signatures, add_symbol(c, sig));
            }
        }
        i = i + 1;
    }
}
fn builtin_call(c: Context, signature_id: SymbolId, args: List<SyntaxArgument>,
    explicit: List<String>, span: Span) -> ExprId effects { state, io, process } {
    let sig = symbol_info(c, signature_id);
    let mapping = dict_new<String, TypeId>();
    var i = 0;
    while i < list_len(sig.variables) {
        dict_set(mapping, list_get(sig.variables, i), no_type());
        i = i + 1;
    }
    if list_len(explicit) > 0 {
        if list_len(explicit) != list_len(sig.variables) {
            bad(c, "E210", "Incorrect type argument count.", span);
        }
        i = 0;
        while i < list_len(explicit) {
            dict_set(mapping, list_get(sig.variables, i), resolve_type(c, list_get(explicit, i),
                span));
            i = i + 1;
        }
    }
    let checked_args = list_new<ExprId>();
    i = 0;
    while i < list_len(args) && i < list_len(sig.patterns) {
        let a = list_get(args, i);
        if a.label != "" {
            bad(c, "E210", "Named arguments are reserved for struct constructors.", ast_expr(c,
                a.value).span);
        }
        let checked = check_expr(c, a.value);
        let pattern = list_get(sig.patterns, i);
        let actual = checked_expr(c, checked).type_id;
        let at = ast_expr(c, a.value).span;
        unify_pattern(c, pattern, actual, mapping, at);
        if callable_pattern(list_get(type_parts(pattern), 0)) {
            require_type(c, actual, resolve_pattern(c, pattern, mapping, at), at);
        }
        list_push(checked_args, checked);
        i = i + 1;
    }
    if list_len(args) != list_len(sig.patterns) {
        bad(c, "E210", "Incorrect argument count.", span);
    }
    if sig.abi == "print" || sig.abi == "format" {
        let argument = checked_expr(c, list_get(checked_args, 0)).type_id;
        if !supports_scalar(c, argument) {
            if type_info(c, argument).parameter_name != "" {
                bound_error(c, argument, "", sig.name, span);
            }
            bad(c, "E201",
                "Formatting requires Int, Float64, Bool, String or a distinct primitive.", span);
        }
    }
    var instance = sig;
    instance.type_id = resolve_pattern(c, sig.return_pattern, mapping, span);
    let id = add_symbol(c, instance);
    require_effects(c, id, span);
    var n = expression_record(107, span, instance.type_id);
    n.symbol = id;
    n.arguments = checked_args;
    return add_expr(c, n);
}
fn opaque_owner_name(c: Context, t: TypeInfo) -> String effects { state } {
    let owner = source_unit_at(c, t.span.start);
    var base = t.name;
    if t.template_index >= 0 {
        base = list_get(c.bound_types, t.template_index).name;
    }
    for decl in c.declarations {
        if decl.owner == owner && decl.canonical == base {
            return decl.name;
        }
    }
    return t.name;
}
fn check_opaque_constructor(c: Context, t: TypeInfo, span: Span) -> Unit effects { state, io,
    process } {
    if t.opaque && source_unit_at(c, t.span.start) != source_unit_at(c, span.start) {
        var details = empty_details();
        details.reason = "opaque_constructor";
        details.owner = opaque_owner_name(c, t);
        list_push(details.related, RelatedLocation(message: "Opaque structure declared here.",
            span: t.span));
        fail_details(c, "E232", "Cannot construct opaque structure outside its defining module: "
            + details.owner, span, details);
    }
}
fn check_record(c: Context, id: TypeId, args: List<SyntaxArgument>,
    span: Span) -> ExprId effects { state, io, process } {
    let t = type_info(c, id);
    var n = expression_record(112, span, id);
    let seen = dict_new<SymbolId, Bool>();
    var i = 0;
    while i < list_len(args) {
        let a = list_get(args, i);
        let arg_span = ast_expr(c, a.value).span;
        var field = no_symbol();
        if t.kind == 77 {
            if a.label != "" {
                bad(c, "E210", "Distinct constructors take one positional argument.", arg_span);
            }
            field = list_get(t.fields, 0);
        } else {
            if a.label == "" {
                bad(c, "E210", "Struct constructors require field: value arguments.", arg_span);
            }
            field = find_symbol(c, t.fields, a.label);
        }
        if !has_symbol(field) {
            bad(c, "E211", "Unknown struct field.", arg_span);
        }
        if dict_has(seen, field) {
            bad(c, "E202", "Duplicate constructor field.", arg_span);
        }
        dict_set(seen, field, true);
        let checked = check_expr(c, a.value);
        require_type(c, checked_expr(c, checked).type_id, symbol_info(c, field).type_id, arg_span);
        list_push(n.arguments, checked);
        list_push(n.fields, field);
        i = i + 1;
    }
    if dict_len(seen) != list_len(t.fields) {
        bad(c, "E210", "Constructor is missing required fields.", span);
    }
    return add_expr(c, n);
}
fn check_access(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let base = check_expr(c, syntax.left);
    let t = type_info(c, checked_expr(c, base).type_id);
    if t.parameter_name != "" {
        bound_error(c, checked_expr(c, base).type_id, "", syntax.text, syntax.name_span);
    }
    if t.kind != 76 && t.kind != 77 {
        bad(c, "E201", "Field access requires a struct or distinct primitive.", syntax.span);
    }
    let field = find_symbol(c, t.fields, syntax.text);
    if t.opaque && source_unit_at(c, t.span.start) != source_unit_at(c, syntax.name_span.start) {
        var details = empty_details();
        details.owner = opaque_owner_name(c, t);
        details.member = syntax.text;
        var location = t.span;
        if has_symbol(field) {
            location = symbol_info(c, field).span;
        }
        list_push(details.related, RelatedLocation(
            message: "Opaque representation belongs to this module.", span: location));
        fail_details(c, "E223",
            "Cannot access fields of opaque structure outside its defining module: "
            + details.owner, syntax.name_span, details);
    }
    if !has_symbol(field) {
        bad(c, "E211", "Unknown field.", syntax.span);
    }
    var n = expression_record(110, syntax.span, symbol_info(c, field).type_id);
    n.left = base;
    n.symbol = field;
    return add_expr(c, n);
}
fn install_generic_enum(c: Context, name: String, variables: String,
    variants: String) -> Unit effects { state } {
    let parameters = list_new<TypeParameter>();
    let names = split_text(variables, 59);
    var i = 0;
    while i < list_len(names) {
        list_push(parameters, TypeParameter(name: list_get(names, i), bound: "Any",
            span: empty_span()));
        i = i + 1;
    }
    let items = list_new<SyntaxVariant>();
    let rows = split_text(variants, 59);
    i = 0;
    while i < list_len(rows) {
        let pair = split_text(list_get(rows, i), 58);
        var fields = list_new<String>();
        if list_get(pair, 1) != "" {
            fields = split_text(list_get(pair, 1), 44);
        }
        list_push(items, SyntaxVariant(name: list_get(pair, 0), fields: fields,
            span: empty_span()));
        i = i + 1;
    }
    var t = type_record(78, name, empty_span());
    t.template_index = list_len(c.bound_types);
    let id = add_type(c, t);
    list_push(c.bound_types, SyntaxType(opaque: false, type_parameters: parameters, kind: 70,
        name: name, base: "", fields: list_new<SyntaxField>(), variants: items,
        span: empty_span()));
}


// Monomorphization belongs to semantic analysis; all instances precede emission.
fn validate_type_parameters(c: Context, parameters: List<TypeParameter>) -> Unit effects { state, io, process } {
    let names = dict_new<String, Bool>();
    for i in 0 .. list_len(parameters) {
        let p = list_get(parameters, i);
        let named = find_type(c, p.name);
        if dict_has(names, p.name) || (has_type(named) && type_kind(c, named) == 0) || p.name == "Option" || p.name == "Result" || p.name == "List" || p.name == "Dict" || p.name == "Any" || p.name == "Scalar" || p.name == "Number" {
            bad(c, "E210", "Duplicate or reserved type parameter: " + p.name, p.span);
        }
        if !builtin_bound(p.bound) && find_interface(c, p.bound) < 0 {
            bad(c, "E210", "Unknown type constraint: " + p.bound, p.span);
        }
        if p.bound == "$effect" && effect_bit(p.name) != 0 {
            effect_error(c, p.name, "effect_parameter_name", p.span, empty_span());
        }
        dict_set(names, p.name, true);
    }
}
fn generic_mapping(c: Context, parameters: List<TypeParameter>, args: List<TypeId>, span: Span) -> Dict<String, TypeId> effects { state, io, process } {
    if list_len(parameters) != list_len(args) {
        bad(c, "E210", "Incorrect type argument count.", span);
    }
    let mapping = dict_new<String, TypeId>();
    for i in 0 .. list_len(parameters) {
        let p = list_get(parameters, i);
        let t = list_get(args, i);
        if p.bound == "$effect" {
            if !has_type(t) { effect_error(c, p.name, "effect_not_inferred", span, p.span); }
            if type_kind(c, t) != 81 { effect_error(c, p.name, "effect_argument_kind", span, p.span); }
            dict_set(mapping, p.name, t);
            continue;
        }
        if !has_type(t) {
            bad(c, "E210", "Cannot infer type argument " + p.name + "; provide explicit <Types>.", span);
        }
        let actual = type_info(c, t);
        if actual.kind == 81 { bad(c, "E210", "Expected a type argument.", span); }
        let numeric = t == int_type() || t == float_type() || actual.constraint == "Number";
        if (p.bound == "Scalar" && !supports_scalar(c, t)) || (p.bound == "Number" && !numeric) {
            if actual.parameter_name != "" { bound_error(c, t, "", p.bound, span); }
            bad(c, "E210", "Type " + type_name(c, t) + " does not satisfy " + p.bound +".", span);
        }
        if !builtin_bound(p.bound) {
            if actual.parameter_name != "" {
                if actual.constraint != p.bound { bound_error(c, t, p.bound, p.name, span); }
            } else if lookup_implementation(c, t, p.bound) < 0 {
                bound_error(c, t, p.bound, p.name, span);
            }
        }
        dict_set(mapping, p.name, t);
    }
    return mapping;
}
fn instance_name(c: Context, name: String, args: List<TypeId>) -> String effects { state, io, process } {
    let names = list_new<String>();
    for i in 0 .. list_len(args) {
        list_push(names, type_name(c, list_get(args, i)));
    }
    return name + "<" + join_text(names,",") + ">";
}
fn fill_type(c: Context, id: TypeId, syntax: SyntaxType, mapping: Dict<String, TypeId>) -> Unit effects { state, io, process } {
    var t = type_info(c, id);
    var j = 0;
    if t.kind == 77 {
        t.base = resolve_pattern(c, syntax.base, mapping, syntax.span);
        if !is_scalar(t.base) {
            bad(c, "E201", "Distinct types wrap Int, Float64, Bool or String.", syntax.span);
        }
        list_push(t.fields, add_symbol(c, symbol_record(72, "value", t.base, syntax.span)));
        set_type(c, id, t);
    } else if t.kind == 76 {
        while j < list_len(syntax.fields) {
            let field = list_get(syntax.fields, j);
            let previous = find_symbol(c, t.fields, field.name);
            if has_symbol(previous) {
                duplicate(c, "Duplicate struct field '" + field.name + "'.", field.span, symbol_info(c, previous).span);
            }
            var member = symbol_record(72, field.name, resolve_pattern(c, field.annotation, mapping, field.span), field.span);
            member.owner = id;
            list_push(t.fields, add_symbol(c, member));
            j = j + 1;
        }
    } else {
        if list_len(syntax.variants) == 0 {
            bad(c, "E204", "Empty enum.", syntax.span);
        }
        while j < list_len(syntax.variants) {
            let variant = list_get(syntax.variants, j);
            let previous = find_symbol(c, t.variants, variant.name);
            if has_symbol(previous) {
                duplicate(c, "Duplicate variant '" + variant.name + "'.", variant.span, symbol_info(c, previous).span);
            }
            var v = symbol_record(71, variant.name, id, variant.span);
            v.owner = id;
            v.tag = j;
            var k = 0;
            while k < list_len(variant.fields) {
                list_push(v.parameters, add_symbol(c, symbol_record(72, "", resolve_pattern(c, list_get(variant.fields, k), mapping, variant.span), variant.span)));
                k = k + 1;
            }
            list_push(t.variants, add_symbol(c, v));
            j = j + 1;
        }
    }
}
fn instantiate_type(c: Context, name: String, args: List<TypeId>, span: Span) -> TypeId effects { state, io, process } {
    if name == "List" || name == "Dict" {
        return collection_type(c, name, args, span);
    }
    let template = find_type(c, name);
    if type_kind(c, template) != 78 {
        bad(c, "E200", "Unknown generic type: " + name, span);
    }
    let syntax_index = type_info(c, template).template_index;
    let syntax = list_get(c.bound_types, syntax_index);
    let mapping = generic_mapping(c, syntax.type_parameters, args, span);
    let canonical = instance_name(c, name, args);
    let found = find_type(c, canonical);
    if has_type(found) {
        return found;
    }
    var ctl = list_get(c.control, 0);
    if ctl.type_depth >= 32 || ctl.type_instances >= 512 {
        bad(c, "E217", "Generic type instantiation limit exceeded.", span);
    }
    ctl.type_depth = ctl.type_depth + 1;
    ctl.type_instances = ctl.type_instances + 1;
    list_set(c.control, 0, ctl);
    var t = type_record(syntax.kind, canonical, syntax.span);
    t.opaque = syntax.opaque;
    t.arguments = args;
    t.template_index = syntax_index;
    let id = add_type(c, t);
    fill_type(c, id, syntax, mapping);
    ctl = list_get(c.control, 0);
    ctl.type_depth = ctl.type_depth - 1;
    list_set(c.control, 0, ctl);
    return id;
}
fn concrete_signature(c: Context, syntax: SyntaxFunction, name: String, mapping: Dict<String, TypeId>) -> Symbol effects { state, io, process } {
    var sig = symbol_record(73, name, resolve_pattern(c, syntax.return_name, mapping, syntax.span), syntax.span);
    sig.suspending = syntax.suspending;
    sig.effect_mask = syntax.effect_mask;
    if syntax.effect_pattern != "" {
        sig.effect_mask = resolve_effect_pattern(c, syntax.effect_pattern, mapping, syntax.span);
    }
    if syntax.impl_index >= 0 {
        sig.method_span = syntax.name_span;
        sig.method_exported = syntax.method_exported;
    }
    sig.foreign_library = syntax.foreign_library;
    sig.foreign_name = syntax.foreign_name;
    for i in 0 .. list_len(syntax.parameters) {
        let p = list_get(syntax.parameters, i);
        list_push(sig.parameters, add_symbol(c, symbol_record(72, p.name, resolve_pattern(c, p.annotation, mapping, p.span), p.span)));
    }
    if sig.foreign_library != "" {
        if !has_bit(sig.effect_mask, 4) || !has_bit(sig.effect_mask, 8) {
            bad(c, "E228", "Foreign functions require state and process effects.", syntax.span);
        }
        if list_len(sig.parameters) > 16 || !foreign_type(sig.type_id, true) {
            bad(c, "E228", "Unsupported foreign result type or more than 16 parameters.", syntax.span);
        }
        for parameter in sig.parameters {
            let p = symbol_info(c, parameter);
            if !foreign_type(p.type_id, false) { bad(c, "E228", "Unsupported foreign parameter type.", p.span); }
            if p.name == "result" || p.name == "_" { bad(c, "E228", "Reserved foreign parameter name.", p.span); }
            for other in sig.parameters {
                if other != parameter && symbol_info(c, other).name == p.name { bad(c, "E228", "Duplicate foreign parameter.", p.span); }
            }
        }
    }
    return sig;
}
fn foreign_type(t: TypeId, is_return: Bool) -> Bool {
    return t == int_type() || t == int32_type() || t == float_type() || t == bool_type() || t == foreign_handle_type() || is_return && t == unit_type() || !is_return && (t == string_type() || t == callback_handle_type());
}
fn generic_function_call(c: Context, template: SymbolId, args: List<SyntaxArgument>, explicit: List<String>, span: Span) -> ExprId effects { state, io, process } {
    let sig = symbol_info(c, template);
    let syntax = list_get(c.bound_functions, sig.template_index);
    let mapping = dict_new<String, TypeId>();
    var i = 0;
    while i < list_len(syntax.type_parameters) {
        dict_set(mapping, list_get(syntax.type_parameters, i).name, no_type());
        i = i + 1;
    }
    if list_len(explicit) > 0 {
        if list_len(explicit) != list_len(syntax.type_parameters) {
            bad(c, "E210", "Incorrect type argument count.", span);
        }
        i = 0;
        while i < list_len(explicit) {
            dict_set(mapping, list_get(syntax.type_parameters, i).name, resolve_type(c, list_get(explicit, i), span));
            i = i + 1;
        }
    }
    if list_len(args) != list_len(syntax.parameters) {
        bad(c, "E210", "Incorrect argument count.", span);
    }
    let checked = list_new<ExprId>();
    i = 0;
    while i < list_len(args) {
        let a = list_get(args, i);
        if a.label != "" {
            bad(c, "E210", "Named arguments require a struct constructor.", span);
        }
        let value = check_expr(c, a.value);
        let pattern = list_get(syntax.parameters, i).annotation;
        let actual = checked_expr(c, value).type_id;
        let argument_span = ast_expr(c, a.value).span;
        unify_pattern(c, pattern, actual, mapping, argument_span);
        if list_len(explicit) == 0 {
            let variable = direct_effect_parameter(c, pattern, argument_span);
            if variable != "" {
                let previous = dict_get(mapping, variable);
                var mask = type_info(c, actual).call_effect_mask % 16;
                if has_type(previous) { mask = union_effects(mask, type_info(c, previous).call_effect_mask); }
                dict_set(mapping, variable, effect_argument(c, mask));
            }
        }
        list_push(checked, value);
        i = i + 1;
    }
    let types = list_new<TypeId>();
    i = 0;
    while i < list_len(syntax.type_parameters) {
        list_push(types, dict_get(mapping, list_get(syntax.type_parameters, i).name));
        i = i + 1;
    }
    let id = instantiate_function(c, template, types, span);
    let concrete = symbol_info(c, id);
    for j in 0 .. list_len(checked) {
        let parameter = symbol_info(c, list_get(concrete.parameters, j));
        let argument = checked_expr(c, list_get(checked, j));
        require_type_at(c, argument.type_id, parameter.type_id, argument.span, parameter.span);
    }
    require_effects(c, id, span);
    var n = expression_record(107, span, symbol_info(c, id).type_id);
    n.symbol = id;
    n.arguments = checked;
    return add_expr(c, n);
}
fn instantiate_function(c: Context, template: SymbolId, types: List<TypeId>, span: Span) -> SymbolId effects { state, io, process } {
    let sig = symbol_info(c, template);
    let syntax = list_get(c.bound_functions, sig.template_index);
    let validated = generic_mapping(c, syntax.type_parameters, types, span);
    let canonical = instance_name(c, sig.name, types);
    var id = no_symbol();
    if dict_has(c.generic_functions, canonical) {
        id = dict_get(c.generic_functions, canonical);
    } else {
        if dict_len(c.generic_functions) >= 512 || list_get(c.control, 0).instance_depth >= 32 {
            bad(c, "E217", "Generic function instantiation limit exceeded.", span);
        }
        var instance = concrete_signature(c, syntax, canonical, validated);
        instance.template_index = sig.template_index;
        id = add_symbol(c, instance);
        dict_set(c.generic_functions, canonical, id);
        list_push(c.instances, FunctionInstance(depth: list_get(c.control, 0).instance_depth + 1, signature: id, syntax_index: sig.template_index, mapping: validated));
    }
    return id;
}



fn find_interface(c: Context, name: String) -> Int effects { state } {
    for i in 0 .. list_len(c.bound_interfaces) {
        if list_get(c.bound_interfaces, i).name == name { return i; }
    }
    return -1;
}
fn contains_self(name: String) -> Bool effects { state } {
    let parts = type_parts(name);
    if list_get(parts, 0) == "Self" { return true; }
    for i in 1 .. list_len(parts) {
        if contains_self(list_get(parts, i)) { return true; }
    }
    return false;
}
fn bind_interfaces(c: Context) -> Unit effects { state, io, process } {
    let no_parameters = list_new<TypeParameter>();
    for syntax in c.syntax_interfaces {
        let owner = source_unit_at(c, syntax.span.start);
        let d = list_get(c.declarations, module_declaration(c, owner, syntax.name));
        let operations = list_new<SyntaxOperation>();
        let seen = dict_new<String, Span>();
        for operation in syntax.operations {
            if dict_has(seen, operation.name) {
                interface_error(c, "E236", "interface_duplicate_method", syntax.name, "", operation.name, "Duplicate interface operation.", operation.span, dict_get(seen, operation.name));
            }
            dict_set(seen, operation.name, operation.span);
            if list_len(operation.parameters) == 0 || list_get(operation.parameters, 0).name != "self" || list_get(operation.parameters, 0).annotation != "Self" {
                interface_error(c, "E236", "interface_receiver", syntax.name, "", operation.name, "The first parameter must be self: Self.", operation.span, syntax.span);
            }
            if contains_self(operation.return_name) {
                interface_error(c, "E236", "interface_signature", syntax.name, "", operation.name, "Self is allowed only as the receiver type.", operation.span, syntax.span);
            }
            var bound = operation;
            bound.return_name = module_type_name(c, operation.return_name, no_parameters, operation.span, d.exported);
            bound.parameters = list_new<SyntaxField>();
            list_push(bound.parameters, list_get(operation.parameters, 0));
            let parameter_names = dict_new<String, Bool>();
            dict_set(parameter_names, "self", true);
            for i in 1 .. list_len(operation.parameters) {
                var parameter = list_get(operation.parameters, i);
                if contains_self(parameter.annotation) || parameter.name == "_" || parameter.name == "result" || dict_has(parameter_names, parameter.name) {
                    interface_error(c, "E236", "interface_signature", syntax.name, "", operation.name, "Invalid interface parameter.", parameter.span, operation.span);
                }
                dict_set(parameter_names, parameter.name, true);
                parameter.annotation = module_type_name(c, parameter.annotation, no_parameters, parameter.span, d.exported);
                list_push(bound.parameters, parameter);
            }
            list_push(operations, bound);
        }
        list_push(c.bound_interfaces, SyntaxInterface(name: d.canonical, operations: operations, span: syntax.span));
    }
}
fn builtin_bound(bound: String) -> Bool {
    return bound == "Any" || bound == "Scalar" || bound == "Number" || bound == "$effect";
}
fn bind_type_bounds(c: Context, parameters: List<TypeParameter>, exported: Bool) -> List<TypeParameter> effects { state, io, process } {
    let items = list_new<TypeParameter>();
    for original in parameters {
        var parameter = original;
        if !builtin_bound(parameter.bound) {
            let name = module_type_name(c, parameter.bound, list_new<TypeParameter>(), parameter.span, exported);
            if find_interface(c, name) < 0 {
                bad(c, "E210", "Unknown type constraint: " + parameter.bound, parameter.span);
            }
            parameter.bound = name;
        }
        list_push(items, parameter);
    }
    return items;
}
fn implementation_method_name(implementation: SyntaxImpl, name: String) -> String {
    return implementation.owner + "#" + implementation.interface_name + "#" + name;
}
fn effects_subset(actual: Int, allowed: Int) -> Bool {
    var bit = 1;
    while bit <= 8 {
        if has_bit(actual, bit) && !has_bit(allowed, bit) { return false; }
        bit = bit * 2;
    }
    return true;
}
fn interface_signature(parameters: List<SyntaxField>, result_type: String, effects_mask: Int) -> String effects { state } {
    let types = list_new<String>();
    for i in 1 .. list_len(parameters) { list_push(types, list_get(parameters, i).annotation); }
    return "(" + join_text(types, ", ") + ") -> " + result_type + " effects " + effect_json(effects_mask);
}
fn interface_signature_error(c: Context, implementation: SyntaxImpl, operation: SyntaxOperation, method: SyntaxFunction, reason: String, message: String) -> Unit effects { state, io, process } {
    var details = empty_details();
    details.reason = reason;
    details.interface_name = implementation.interface_name;
    details.implementor = implementation.owner;
    details.method = operation.name;
    details.expected = interface_signature(operation.parameters, operation.return_name, operation.effect_mask);
    details.actual = interface_signature(method.parameters, method.return_name, method.effect_mask);
    list_push(details.related, RelatedLocation(message: "Interface operation declared here.", span: operation.span));
    fail_details(c, "E236", message, method.name_span, details);
}
fn validate_interface_implementations(c: Context) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(c.bound_impls) {
        let implementation = list_get(c.bound_impls, i);
        if implementation.interface_name == "" { continue; }
        let iface = list_get(c.bound_interfaces, find_interface(c, implementation.interface_name));
        let methods = dict_new<String, SyntaxFunction>();
        for method in c.bound_functions {
            if method.impl_index == i { dict_set(methods, method.name, method); }
        }
        for operation in iface.operations {
            let key = implementation_method_name(implementation, operation.name);
            if !dict_has(methods, key) {
                interface_error(c, "E236", "impl_missing_method", iface.name, implementation.owner, operation.name, "Missing interface operation: " + operation.name, implementation.span, operation.span);
            }
            let method = dict_get(methods, key);
            let removed = dict_remove(methods, key);
            var matches = method.return_name == operation.return_name && list_len(method.parameters) == list_len(operation.parameters);
            if matches {
                for p in 1 .. list_len(method.parameters) {
                    if list_get(method.parameters, p).annotation != list_get(operation.parameters, p).annotation { matches = false; }
                }
            }
            if !matches {
                interface_signature_error(c, implementation, operation, method, "impl_signature", "Implementation signature differs from the interface.");
            }
            if !effects_subset(method.effect_mask, operation.effect_mask) {
                interface_signature_error(c, implementation, operation, method, "impl_effects", "Implementation widens the interface effects.");
            }
            if list_len(method.preconditions) + list_len(method.postconditions) > 0 {
                interface_error(c, "E236", "impl_contract", iface.name, implementation.owner, operation.name, "Interface implementation methods cannot add contracts.", method.name_span, operation.span);
            }
        }
        if dict_len(methods) != 0 {
            for method in c.bound_functions {
                if method.impl_index == i && dict_has(methods, method.name) {
                    let name = str_slice(c.source_text, method.name_span.start, method.name_span.end);
                    interface_error(c, "E236", "impl_extra_method", iface.name, implementation.owner, name, "Operation is absent from the interface: " + name, method.name_span, iface.span);
                }
            }
        }
    }
}
fn lookup_implementation(c: Context, id: TypeId, interface_name: String) -> Int effects { state, io, process } {
    let t = type_info(c, id);
    var owner = t.name;
    if t.template_index >= 0 { owner = list_get(c.bound_types, t.template_index).name; }
    for i in 0 .. list_len(c.bound_impls) {
        let impl = list_get(c.bound_impls, i);
        if impl.owner == owner && impl.interface_name == interface_name { return i; }
    }
    return -1;
}
fn bound_error(c: Context, id: TypeId, interface_name: String, operation: String, span: Span) -> Unit effects { state, io, process } {
    let t = type_info(c, id);
    var details = empty_details();
    details.reason = "unavailable_operation";
    details.actual_type = t.name;
    details.type_parameter = t.parameter_name;
    details.interface_name = interface_name;
    details.operation = operation;
    if t.parameter_name != "" {
        details.actual_type = t.parameter_name;
        list_push(details.related, RelatedLocation(message: "Type parameter and its bound are declared here.", span: t.span));
    }
    fail_details(c, "E234", "Operation " + operation + " is unavailable for " + details.actual_type + ".", span, details);
}
fn install_interface_operations(c: Context) -> Unit effects { state, io, process } {
    for interface in c.bound_interfaces {
        for index in 0 .. list_len(interface.operations) {
            let op = list_get(interface.operations, index);
            var signature = symbol_record(73, interface.name + "::" + op.name, resolve_type(c, op.return_name, op.span), op.span);
            signature.tag = index;
            signature.method_span = op.span;
            signature.method_exported = true;
            signature.interface_operation = true;
            signature.effect_mask = op.effect_mask;
            list_push(signature.parameters, add_symbol(c, symbol_record(72, "self", no_type(), op.span)));
            for i in 1 .. list_len(op.parameters) {
                let p = list_get(op.parameters, i);
                list_push(signature.parameters, add_symbol(c, symbol_record(72, p.name, resolve_type(c, p.annotation, p.span), p.span)));
            }
            list_push(c.interface_operations, InterfaceOperation(owner: interface.name, name: op.name, signature: add_symbol(c, signature)));
        }
    }
}
fn static_interface_call(c: Context, interface_name: String, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let operation = interface_operation(c, interface_name, syntax.text, syntax.name_span);
    if syntax.kind != 7 || list_len(syntax.arguments) == 0 {
        bad(c, "E210", "An interface operation requires a call with a receiver.", syntax.name_span);
    }
    let first = list_get(syntax.arguments, 0);
    if first.label != "" { bad(c, "E210", "Interface arguments are positional.", syntax.name_span); }
    let receiver = check_expr(c, first.value);
    let id = checked_expr(c, receiver).type_id;
    let t = type_info(c, id);
    let rest = list_new<SyntaxArgument>();
    for i in 1 .. list_len(syntax.arguments) { list_push(rest, list_get(syntax.arguments, i)); }
    if t.kind == 82 {
        if t.base_name != interface_name {
            dynamic_error(c, interface_name, "dynamic_conversion", "Receiver belongs to a different interface.", syntax.name_span);
        }
        return dynamic_call(c, operation, receiver, rest, syntax.span, syntax.name_span);
    }
    var target = operation;
    if t.parameter_name != "" {
        if t.constraint != interface_name { bound_error(c, id, interface_name, syntax.text, syntax.name_span); }
    } else {
        let impl_index = lookup_implementation(c, id, interface_name);
        if impl_index < 0 { bound_error(c, id, interface_name, syntax.text, syntax.name_span); }
        target = find_symbol(c, c.signatures, implementation_method_name(list_get(c.bound_impls, impl_index), syntax.text));
        if symbol_info(c, target).template_index >= 0 {
            target = instantiate_function(c, target, t.arguments, syntax.name_span);
        }
    }
    let signature = symbol_info(c, operation);
    var expression = expression_record(107, syntax.span, signature.type_id);
    expression.arguments = check_arguments_with_receiver(c, rest, signature.parameters, receiver, syntax.span);
    require_effects(c, operation, syntax.name_span);
    expression.symbol = target;
    expression.reference = operation;
    return add_expr(c, expression);
}

// The symbolic pass uses the same checker and instance cache rules. Its types,
// symbols and checked expressions are temporary and cannot reach emission.
fn verify_interface_bounds(c: Context) -> Unit effects { state, io, process } {
    let type_count = list_len(c.types);
    let symbol_count = list_len(c.symbols);
    let expression_count = list_len(c.expressions);
    let statement_count = list_len(c.statements);
    let function_count = list_len(c.functions);
    var scratch = c;
    scratch.query_mode = false;
    scratch.instances = list_new<FunctionInstance>();
    scratch.generic_functions = dict_new<String, SymbolId>();
    scratch.control = list_new<Control>();
    list_push(scratch.control, list_get(c.control, 0));
    let checked = list_new<SymbolId>();
    for signature in c.signatures {
        let symbol = symbol_info(c, signature);
        if symbol.template_index < 0 { continue; }
        let syntax = list_get(c.bound_functions, symbol.template_index);
        var constrained = false;
        var effect_count = 0;
        for parameter in syntax.type_parameters {
            if !builtin_bound(parameter.bound) { constrained = true; }
            if parameter.bound == "$effect" { effect_count = effect_count + 1; }
        }
        if !constrained && effect_count == 0 { continue; }
        let formals = list_new<TypeId>();
        for parameter in syntax.type_parameters {
            if parameter.bound == "$effect" {
                list_push(formals, no_type());
                continue;
            }
            var abstract = type_record(79, "$" + to_string(symbol.template_index) + ":" + parameter.name, parameter.span);
            abstract.constraint = parameter.bound;
            abstract.parameter_name = parameter.name;
            list_push(formals, add_type(scratch, abstract));
        }
        // For unions of masks, the all-zero case checks the constants. Each
        // one-hot case checks the contribution of one variable for every bit.
        for assignment in 0 ..= effect_count {
            let types = list_new<TypeId>();
            var variable = 0;
            for formal in formals {
                if has_type(formal) {
                    list_push(types, formal);
                } else {
                    variable = variable + 1;
                    var mask = 0;
                    if assignment == variable { mask = 15; }
                    list_push(types, effect_argument(scratch, mask));
                }
            }
            let instance = instantiate_function(scratch, signature, types, syntax.span);
        }
        list_push(checked, signature);
    }
    check_function_instances(scratch);
    list_truncate(c.types, type_count);
    list_truncate(c.symbols, symbol_count);
    list_truncate(c.expressions, expression_count);
    list_truncate(c.statements, statement_count);
    list_truncate(c.functions, function_count);
    for signature in checked {
        var symbol = symbol_info(c, signature);
        symbol.constraints_checked = true;
        set_symbol(c, signature, symbol);
    }
}



fn dynamic_pattern(name: String) -> Bool {
    return str_len(name) >= 5 && str_slice(name, 0, 5) == "@dyn:";
}

fn interface_label(c: Context, name: String) -> String effects { state } {
    for declaration in c.declarations {
        if declaration.canonical == name { return declaration.name; }
    }
    return name;
}

fn dynamic_error(c: Context, interface_name: String, reason: String, message: String, span: Span) -> Unit effects { state, io, process } {
    var details = empty_details();
    details.interface_name = interface_label(c, interface_name);
    details.reason = reason;
    let index = find_interface(c, interface_name);
    if index >= 0 {
        list_push(details.related, RelatedLocation(message: "Interface declared here.", span: list_get(c.bound_interfaces, index).span));
    }
    fail_details(c, "E237", message, span, details);
}

fn resolve_dynamic_type(c: Context, name: String, span: Span) -> TypeId effects { state, io, process } {
    if list_len(type_parts(name)) != 1 || dynamic_pattern(name) {
        dynamic_error(c, name, "dynamic_interface", "Expected a nominal interface after dyn.", span);
    }
    let interface_name = module_global_name(c, name, span);
    if find_interface(c, interface_name) < 0 {
        dynamic_error(c, interface_name, "dynamic_interface", "Expected a nominal interface after dyn.", span);
    }
    let key = "@dyn:" + interface_name;
    let previous = find_type(c, key);
    if has_type(previous) { return previous; }
    var info = type_record(82, key, span);
    info.base_name = interface_name;
    return add_type(c, info);
}

fn interface_operation(c: Context, owner: String, name: String, span: Span) -> SymbolId effects { state, io, process } {
    for operation in c.interface_operations {
        if operation.owner == owner && operation.name == name { return operation.signature; }
    }
    bad(c, "E203", "Unknown interface operation: " + name, span);
    return no_symbol();
}

fn check_dynamic_box(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let target = resolve_dynamic_type(c, syntax.qualifier, syntax.name_span);
    let owner = type_info(c, target).base_name;
    if list_len(syntax.arguments) != 1 || list_get(syntax.arguments, 0).label != "" {
        dynamic_error(c, owner, "dynamic_arity", "Dynamic packing requires one positional value.", syntax.span);
    }
    let payload = check_expr(c, list_get(syntax.arguments, 0).value);
    let concrete = checked_expr(c, payload).type_id;
    let info = type_info(c, concrete);
    var box = expression_record(121, syntax.span, target);
    box.left = payload;
    if info.parameter_name != "" {
        if info.constraint != owner {
            dynamic_error(c, owner, "dynamic_missing_impl", "Type parameter lacks the required interface bound.", syntax.span);
        }
        return add_expr(c, box);
    }
    if info.kind == 82 {
        dynamic_error(c, owner, "dynamic_repack", "Dynamic interface values cannot be packed again.", syntax.span);
    }
    let index = lookup_implementation(c, concrete, owner);
    if index < 0 {
        dynamic_error(c, owner, "dynamic_missing_impl", "Value type does not implement this interface.", syntax.span);
    }
    let implementation = list_get(c.bound_impls, index);
    let interface = list_get(c.bound_interfaces, find_interface(c, owner));
    for operation in interface.operations {
        var method = find_symbol(c, c.signatures, implementation_method_name(implementation, operation.name));
        if symbol_info(c, method).template_index >= 0 {
            method = instantiate_function(c, method, info.arguments, syntax.span);
        }
        list_push(box.fields, method);
    }
    return add_expr(c, box);
}

fn dynamic_call(c: Context, operation: SymbolId, receiver: ExprId, arguments: List<SyntaxArgument>, span: Span, name: Span) -> ExprId effects { state, io, process } {
    let signature = symbol_info(c, operation);
    var call = expression_record(122, span, signature.type_id);
    call.symbol = operation;
    call.arguments = check_arguments_with_receiver(c, arguments, signature.parameters, receiver, span);
    require_effects(c, operation, name);
    return add_expr(c, call);
}



fn effect_argument_pattern(name: String) -> Bool {
    return str_len(name) >= 4 && str_slice(name, 0, 4) == "@fx:";
}
fn parse_effect_pattern(c: Context) -> String effects { state, io, process } {
    if !accept(c, "effects") { return "0"; }
    if !accept(c, "{") {
        let variable = identifier(c);
        return "0+" + variable.text;
    }
    let variables = dict_new<String, Bool>();
    let terms = strings_new();
    var mask = 0;
    var more = !at(c, "}");
    while more {
        let token = identifier(c);
        if dict_has(variables, token.text) { bad(c, "E100", "Duplicate effect.", token.span); }
        dict_set(variables, token.text, true);
        let bit = effect_bit(token.text);
        if bit == 0 { strings_push(terms, "+" + token.text); }
        else { mask = mask + bit; }
        more = accept(c, ",") && !at(c, "}");
    }
    let close = expect(c, "}");
    return to_string(mask) + strings_join(terms, "");
}
fn effect_pattern_constant(pattern: String) -> Int effects { state } {
    return match parse_int(list_get(split_text(pattern, 43), 0)) {
        IntResult::Ok(value) => value, IntResult::Err(_) => 0
    };
}
fn validate_effect_names(c: Context, pattern: String, parameters: List<TypeParameter>, span: Span) -> Unit effects { state, io, process } {
    let terms = split_text(pattern, 43);
    for i in 1 .. list_len(terms) {
        let name = list_get(terms, i);
        var found = false;
        for parameter in parameters {
            if parameter.name == name && parameter.bound == "$effect" { found = true; }
        }
        if !found { bad(c, "E206", "Unknown effect: " + name, span); }
    }
}
fn effect_error(c: Context, name: String, reason: String, span: Span, declaration: Span) -> Unit effects { state, io, process } {
    var details = empty_details();
    details.reason = reason;
    details.effect_parameter = name;
    if declaration.end > declaration.start {
        list_push(details.related, RelatedLocation(message: "Effect parameter declared here.", span: declaration));
    }
    fail_details(c, "E239", "Invalid effect argument for " + name + ": " + reason, span, details);
}
fn union_effects(first: Int, second: Int) -> Int {
    var result_mask = first;
    var bit = 1;
    while bit <= 8 {
        if !has_bit(first, bit) && has_bit(second, bit) { result_mask = result_mask + bit; }
        bit = bit * 2;
    }
    return result_mask;
}
fn effect_argument(c: Context, mask: Int) -> TypeId effects { state } {
    let name = "@fx:" + to_string(mask);
    let found = find_type(c, name);
    if has_type(found) { return found; }
    var value = type_record(81, name, empty_span());
    value.call_effect_mask = mask;
    return add_type(c, value);
}
fn resolve_effect_pattern(c: Context, pattern: String, mapping: Dict<String, TypeId>, span: Span) -> Int effects { state, io, process } {
    let terms = split_text(pattern, 43);
    var mask = effect_pattern_constant(pattern);
    for i in 1 .. list_len(terms) {
        let variable = list_get(terms, i);
        if !dict_has(mapping, variable) { bad(c, "E206", "Unknown effect: " + variable, span); }
        let id = dict_get(mapping, variable);
        if type_kind(c, id) != 81 { effect_error(c, variable, "effect_argument_kind", span, empty_span()); }
        mask = union_effects(mask, type_info(c, id).call_effect_mask);
    }
    return mask;
}
fn direct_effect_parameter(c: Context, pattern: String, span: Span) -> String effects { state, io, process } {
    let base = list_get(type_parts(pattern), 0);
    if !callable_pattern(base) { return ""; }
    let effects_pattern = str_slice(base, 4, str_len(base));
    let terms = split_text(effects_pattern, 43);
    if list_len(terms) == 1 { return ""; }
    let variable = list_get(terms, 1);
    if list_len(terms) != 2 || effect_pattern_constant(effects_pattern) % 16 != 0 {
        effect_error(c, variable, "effect_parameter_shape", span, empty_span());
    }
    return variable;
}

fn callable_pattern(name: String) -> Bool {
    return str_len(name) >= 4 && str_slice(name, 0, 4) == "@fn:";
}
fn callable_type(c: Context, types: List<TypeId>, mask: Int, span: Span) -> TypeId effects { state, io, process } {
    let name = instance_name(c, "@fn:" + to_string(mask), types);
    let found = find_type(c, name);
    if has_type(found) { return found; }
    var info = type_record(80, name, span);
    info.arguments = types;
    info.call_effect_mask = mask;
    return add_type(c, info);
}
fn resolve_callable_type(c: Context, parts: List<String>, mapping: Dict<String, TypeId>, span: Span) -> TypeId effects { state, io, process } {
    let prefix = list_get(parts, 0);
    let mask = resolve_effect_pattern(c, str_slice(prefix, 4, str_len(prefix)), mapping, span);
    let types = list_new<TypeId>();
    for i in 1 .. list_len(parts) {
        list_push(types, resolve_pattern(c, list_get(parts, i), mapping, span));
    }
    return callable_type(c, types, mask, span);
}
fn matching_callable_shape(c: Context, actual: TypeId, expected: TypeId) -> Bool effects { state, io, process } {
    if type_kind(c, actual) != 80 || type_kind(c, expected) != 80 { return false; }
    if has_bit(type_info(c, actual).call_effect_mask, 16) != has_bit(type_info(c, expected).call_effect_mask, 16) {
        return false;
    }
    let got = type_info(c, actual).arguments;
    let wanted = type_info(c, expected).arguments;
    if list_len(got) != list_len(wanted) { return false; }
    for i in 0 .. list_len(got) {
        if list_get(got, i) != list_get(wanted, i) { return false; }
    }
    return true;
}
fn require_callable_effects(c: Context, required: Int, allowed: Int, span: Span) -> Unit effects { state, io, process } {
    if effects_subset(required, allowed) { return; }
    var details = empty_details();
    details.callee = "callable";
    details.required_effects = required;
    details.allowed_effects = allowed;
    var bit = 1;
    while bit <= 8 {
        if !effects_subset(bit, allowed) && effects_subset(bit, required) {
            details.missing_effects = details.missing_effects + bit;
        }
        bit = bit * 2;
    }
    fail_details(c, "E209", "Callable effects exceed the allowed effects.", span, details);
}
fn unify_callable_pattern(c: Context, parts: List<String>, actual: TypeId, mapping: Dict<String, TypeId>, span: Span) -> Unit effects { state, io, process } {
    let info = type_info(c, actual);
    if info.kind != 80 || list_len(parts) != list_len(info.arguments) + 1 {
        if info.parameter_name != "" { bound_error(c, actual, "", "callable argument", span); }
        bad(c, "E201", "Callable parameter or result shape differs.", span);
    }
    for i in 0 .. list_len(info.arguments) {
        unify_pattern(c, list_get(parts, i + 1), list_get(info.arguments, i), mapping, span);
    }
}
fn callable_from_function(c: Context, id: SymbolId, span: Span) -> ExprId effects { state, io, process } {
    let signature = symbol_info(c, id);
    if signature.builtin || signature.foreign_library != "" || signature.interface_operation {
        bad(c, "E238", "Only a checked Vela function can become a callable value.", span);
    }
    let types = list_new<TypeId>();
    list_push(types, signature.type_id);
    for parameter in signature.parameters { list_push(types, symbol_info(c, parameter).type_id); }
    var mask = signature.effect_mask;
    if signature.suspending { mask = mask + 16; }
    var value = expression_record(118, span, callable_type(c, types, mask, span));
    value.symbol = id;
    return add_expr(c, value);
}
fn named_callable(c: Context, name: String, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let canonical = module_global_name(c, name, syntax.span);
    var target = find_symbol(c, c.signatures, canonical);
    if !has_symbol(target) { bad(c, "E203", "Unknown binding.", syntax.span); }
    let signature = symbol_info(c, target);
    if signature.template_index >= 0 {
        let arguments = list_new<TypeId>();
        for argument in syntax.type_arguments { list_push(arguments, resolve_type(c, argument, syntax.span)); }
        target = instantiate_function(c, target, arguments, syntax.span);
    } else if list_len(syntax.type_arguments) != 0 {
        bad(c, "E210", "Function value does not take type arguments.", syntax.span);
    }
    return callable_from_function(c, target, syntax.span);
}
fn checked_indirect_call(c: Context, callee: ExprId, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let info = type_info(c, checked_expr(c, callee).type_id);
    if info.kind != 80 {
        if info.parameter_name != "" { bound_error(c, checked_expr(c, callee).type_id, "", "call", syntax.span); }
        bad(c, "E201", "Expression is not callable.", syntax.span);
    }
    if list_len(syntax.arguments) + 1 != list_len(info.arguments) {
        bad(c, "E210", "Incorrect callable argument count.", syntax.span);
    }
    require_await_call(c, has_bit(info.call_effect_mask, 16), syntax.span);
    require_callable_effects(c, info.call_effect_mask % 16, list_get(c.control, 0).allowed_effects, syntax.span);
    var call = expression_record(119, syntax.span, list_get(info.arguments, 0));
    call.left = callee;
    for i in 0 .. list_len(syntax.arguments) {
        let argument = list_get(syntax.arguments, i);
        if argument.label != "" { bad(c, "E210", "Callable arguments are positional.", syntax.span); }
        let value = check_expr(c, argument.value);
        require_type(c, checked_expr(c, value).type_id, list_get(info.arguments, i + 1), ast_expr(c, argument.value).span);
        list_push(call.arguments, value);
    }
    return add_expr(c, call);
}
fn capture_error(c: Context, reason: String, name: String, message: String, span: Span, declaration: Span) -> Unit effects { state, io, process } {
    var details = empty_details();
    details.reason = reason;
    details.capture = name;
    if declaration.end > declaration.start {
        list_push(details.related, RelatedLocation(message: "Captured binding declared here.", span: declaration));
    }
    fail_details(c, "E238", message, span, details);
}
fn check_closure(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let closure = list_get(c.syntax_closures, syntax.closure_index);
    let mask = resolve_effect_pattern(c, closure.effect_pattern, list_get(c.control, 0).type_mapping, syntax.span);
    let result_type = resolve_type(c, closure.return_name, syntax.span);
    var signature = symbol_record(73, "@closure", result_type, syntax.span);
    signature.suspending = closure.suspending;
    signature.effect_mask = mask;
    let symbol = add_symbol(c, signature);
    let types = list_new<TypeId>();
    list_push(types, result_type);
    let captures = list_new<SymbolId>();
    let parameters = list_new<SymbolId>();
    let sources = list_new<SymbolId>();
    let seen = dict_new<String, Bool>();
    for capture in closure.captures {
        let source = lookup(c, capture.name, capture.span);
        if !has_symbol(source) { bad(c, "E203", "Unknown captured binding: " + capture.name, capture.span); }
        let declaration = symbol_info(c, source);
        if dict_has(seen, capture.name) {
            capture_error(c, "capture_duplicate", capture.name, "Duplicate capture.", capture.span, declaration.span);
        }
        dict_set(seen, capture.name, true);
        list_push(sources, source);
        record_query_use(c, capture.span, source, declaration.type_id, "reference");
    }
    var saved = list_get(c.control, 0);
    var control = saved;
    control.scope_base = list_len(c.scopes);
    control.return_type = result_type;
    control.allowed_effects = mask;
    control.loop_depth = 0;
    control.in_contract = false;
    control.in_defer = false;
    control.in_async = closure.suspending;
    control.await_site = empty_span();
    list_set(c.control, 0, control);
    push_scope(c);
    for i in 0 .. list_len(closure.captures) {
        let capture = list_get(closure.captures, i);
        let source = list_get(sources, i);
        let binding = bind(c, capture.name, symbol_info(c, source).type_id, false, capture.span, false);
        var info = symbol_info(c, binding);
        info.capture_origin = source;
        set_symbol(c, binding, info);
        list_push(captures, binding);
    }
    for parameter in closure.parameters {
        if dict_has(seen, parameter.name) {
            capture_error(c, "capture_parameter", parameter.name, "Parameter conflicts with a capture.", parameter.span, empty_span());
        }
        let type_id = resolve_type(c, parameter.annotation, parameter.span);
        list_push(types, type_id);
        list_push(parameters, bind(c, parameter.name, type_id, false, parameter.span, false));
    }
    let result_binding = bind(c, "result", result_type, false, syntax.span, true);
    let body = check_block(c, closure.body, false);
    if !block_returns(c, body) {
        if result_type != unit_type() { bad(c, "E208", "Closure may reach its end without returning.", syntax.span); }
        var ret = statement_record(132, syntax.span);
        ret.value = add_expr(c, expression_record(109, syntax.span, unit_type()));
        ret.returns = true;
        list_push(body, add_stmt(c, ret));
    }
    pop_scope(c);
    saved.type_instances = list_get(c.control, 0).type_instances;
    list_set(c.control, 0, saved);
    list_push(c.functions, CheckedFunction(captures: captures, symbol: symbol, parameters: parameters, result_binding: result_binding,
        preconditions: list_new<ExprId>(), postconditions: list_new<ExprId>(), body: body, span: syntax.span));
    var callable_mask = mask;
    if closure.suspending { callable_mask = callable_mask + 16; }
    var expression = expression_record(120, syntax.span, callable_type(c, types, callable_mask, syntax.span));
    expression.symbol = symbol;
    for source in sources {
        var value = expression_record(104, syntax.span, symbol_info(c, source).type_id);
        value.symbol = source;
        list_push(expression.arguments, add_expr(c, value));
    }
    return add_expr(c, expression);
}



fn suspension_pattern(effect_spec: String) -> String effects { state } {
    let parts = split_text(effect_spec, 43);
    var pattern = to_string(effect_pattern_constant(effect_spec) + 16);
    for i in 1 .. list_len(parts) { pattern = pattern + "+" + list_get(parts, i); }
    return pattern;
}
fn require_await_call(c: Context, suspending: Bool, span: Span) -> Unit effects { state, io, process } {
    if !suspending { return; }
    let ctl = list_get(c.control, 0);
    if ctl.await_site.start != span.start || ctl.await_site.end != span.end || span.start == span.end {
        bad(c, "E240", "A suspending call requires explicit await.", span);
    }
}
fn check_await(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    var ctl = list_get(c.control, 0);
    if !ctl.in_async || ctl.in_contract || ctl.in_defer {
        bad(c, "E240", "await is only allowed in an async body outside contracts and defer.", syntax.span);
    }
    let operand = ast_expr(c, syntax.left);
    if operand.kind == 7 {
        let target = ast_expr(c, operand.left);
        if target.qualifier == "" && target.text == "sleep_ms" {
            if list_len(operand.arguments) != 1 || list_len(operand.type_arguments) != 0 {
                bad(c, "E210", "sleep_ms expects one positional delay.", operand.span);
            }
            let delay = list_get(operand.arguments, 0);
            if delay.label != "" { bad(c, "E210", "sleep_ms expects a positional delay.", operand.span); }
            require_callable_effects(c, 4, ctl.allowed_effects, syntax.span);
            var sleep = expression_record(124, syntax.span, unit_type());
            sleep.left = check_expr(c, delay.value);
            require_type(c, checked_expr(c, sleep.left).type_id, int_type(), operand.span);
            return add_expr(c, sleep);
        }
    }
    let saved = ctl.await_site;
    ctl.await_site = operand.span;
    list_set(c.control, 0, ctl);
    let value = check_expr(c, syntax.left);
    ctl = list_get(c.control, 0);
    ctl.await_site = saved;
    list_set(c.control, 0, ctl);
    let checked = checked_expr(c, value);
    var valid = false;
    if checked.kind == 107 { valid = symbol_info(c, checked.symbol).suspending; }
    if checked.kind == 119 {
        valid = has_bit(type_info(c, checked_expr(c, checked.left).type_id).call_effect_mask, 16);
    }
    if !valid { bad(c, "E240", "await requires a suspending call.", syntax.span); }
    var result_value = expression_record(123, syntax.span, checked.type_id);
    result_value.left = value;
    return add_expr(c, result_value);
}

struct CheckWork {
    functions: Dict<SymbolId, Int>,
    visited: Dict<SymbolId, Bool>,
    queue: List<SymbolId>,
    entry: Span
}
fn blocking(c: Context, work: CheckWork, span: Span, reason: String) -> Unit effects { state, io, process } {
    var details = empty_details();
    details.reason = "blocking_async_call";
    list_push(details.related, RelatedLocation(message: "Suspending body starts here.", span: work.entry));
    fail_details(c, "E241", reason, span, details);
}
fn check_target(c: Context, work: CheckWork, id: SymbolId, span: Span) -> Unit effects { state, io, process } {
    let sig = symbol_info(c, id);
    if sig.foreign_library != "" {
        blocking(c, work, span, "Foreign call may block a suspending body: " + sig.foreign_name);
    }
    if sig.builtin {
        if sig.abi == "noreturn" { return; }
        if has_bit(sig.effect_mask, 1) || has_bit(sig.effect_mask, 8) {
            blocking(c, work, span, "Synchronous OS operation in a suspending call graph: " + sig.name);
        }
        return;
    }
    if !dict_has(work.functions, id) {
        blocking(c, work, span, "Unresolved call target may block a suspending body.");
    }
    if !dict_has(work.visited, id) {
        dict_set(work.visited, id, true);
        list_push(work.queue, id);
    }
}
fn check_value(c: Context, work: CheckWork, id: ExprId) -> Unit effects { state, io, process } {
    if !has_expr(id) { return; }
    let value = checked_expr(c, id);
    if value.kind == 107 { check_target(c, work, value.symbol, value.span); }
    if value.kind == 122 { blocking(c, work, value.span, "Dynamic dispatch may block a suspending body."); }
    if value.kind == 119 {
        let target = checked_expr(c, value.left);
        if target.kind == 118 || target.kind == 120 {
            check_target(c, work, target.symbol, value.span);
        } else if !has_bit(type_info(c, target.type_id).call_effect_mask, 16) {
            blocking(c, work, value.span, "Unknown synchronous callable may block a suspending body.");
        }
    }
    check_value(c, work, value.left);
    check_value(c, work, value.right);
    for argument in value.arguments { check_value(c, work, argument); }
    for arm in value.arms { check_value(c, work, arm.value); }
}
fn check_body(c: Context, work: CheckWork, body: List<StmtId>) -> Unit effects { state, io, process } {
    for id in body {
        let stmt = checked_stmt(c, id);
        check_value(c, work, stmt.value);
        check_value(c, work, stmt.target);
        check_body(c, work, stmt.yes);
        check_body(c, work, stmt.no);
        for arm in stmt.arms { check_body(c, work, arm.body); }
    }
}
fn check_suspension_graph(c: Context) -> Unit effects { state, io, process } {
    var needed = false;
    for function in c.functions {
        if symbol_info(c, function.symbol).suspending { needed = true; break; }
    }
    if !needed { return; }
    let index = dict_new<SymbolId, Int>();
    for i in 0 .. list_len(c.functions) {
        dict_set(index, list_get(c.functions, i).symbol, i);
    }
    for entry in c.functions {
        if symbol_info(c, entry.symbol).suspending {
            let work = CheckWork(functions: index, visited: dict_new<SymbolId, Bool>(),
                queue: list_new<SymbolId>(), entry: entry.span);
            check_target(c, work, entry.symbol, entry.span);
            var i = 0;
            while i < list_len(work.queue) {
                let function = list_get(c.functions, dict_get(index, list_get(work.queue, i)));
                for pre in function.preconditions { check_value(c, work, pre); }
                for post in function.postconditions { check_value(c, work, post); }
                check_body(c, work, function.body);
                i = i + 1;
            }
        }
    }
}


// Semantic analysis creates checked tables; syntax tables are read-only here.
fn lookup(c: Context, name: String, span: Span) -> SymbolId effects { state, io, process } {
    var i = list_len(c.scopes);
    let base = list_get(c.control, 0).scope_base;
    while i > base {
        i = i - 1;
        let found = find_symbol(c, list_get(c.scopes, i), name);
        if has_symbol(found) {
            return found;
        }
    }
    while i > 0 {
        i = i - 1;
        let found = find_symbol(c, list_get(c.scopes, i), name);
        if has_symbol(found) {
            capture_error(c, "capture_missing", name, "Capture must be listed explicitly: " + name, span, symbol_info(c, found).span);
        }
    }
    return no_symbol();
}
fn push_scope(c: Context) -> Unit effects { state } {
    list_push(c.scopes, list_new<SymbolId>());
}
fn pop_scope(c: Context) -> Unit effects { state } {
    list_truncate(c.scopes, list_len(c.scopes) - 1);
}
fn bind(c: Context, name: String, type_id: TypeId, mutable: Bool, span: Span, implicit: Bool) -> SymbolId effects { state, io, process } {
    if !implicit && (name == "result" || name == "_") {
        bad(c, "E202", "Reserved binding name.", span);
    }
    let scope = list_get(c.scopes, list_len(c.scopes) - 1);
    let previous = find_symbol(c, scope, name);
    if has_symbol(previous) {
        duplicate(c, "Duplicate binding '" + name + "' in this scope.", span, symbol_info(c, previous).span);
    }
    var symbol = symbol_record(61, name, type_id, span);
    symbol.mutable = mutable;
    let id = add_symbol(c, symbol);
    list_push(scope, id);
    return id;
}
fn check_arguments(c: Context, args: List<SyntaxArgument>, params: List<SymbolId>, span: Span) -> List<ExprId> effects { state, io, process } {
    return check_arguments_with_receiver(c, args, params, no_expr(), span);
}
fn check_arguments_with_receiver(c: Context, args: List<SyntaxArgument>, params: List<SymbolId>, receiver: ExprId, span: Span) -> List<ExprId> effects { state, io, process } {
    let items = list_new<ExprId>();
    var first = 0;
    if has_expr(receiver) {
        list_push(items, receiver);
        first = 1;
    }
    var i = 0;
    while i < list_len(args) && i + first < list_len(params) {
        let a = list_get(args, i);
        if a.label != "" {
            bad(c, "E210", "Named arguments require a struct constructor.", ast_expr(c, a.value).span);
        }
        let checked = check_expr(c, a.value);
        let parameter = symbol_info(c, list_get(params, i + first));
        require_type_at(c, checked_expr(c, checked).type_id, parameter.type_id, checked_expr(c, checked).span, parameter.span);
        list_push(items, checked);
        i = i + 1;
    }
    if list_len(args) + first != list_len(params) {
        bad(c, "E210", "Incorrect argument count.", span);
    }
    return items;
}
fn lookup_method(c: Context, id: TypeId, name: String) -> SymbolId effects { state, io, process } {
    if !has_type(id) { return no_symbol(); }
    let t = type_info(c, id);
    var base = t.name;
    if t.template_index >= 0 { base = list_get(c.bound_types, t.template_index).name; }
    return find_symbol(c, c.signatures, base + "::" + name);
}
fn specialize_method(c: Context, type_id: TypeId, method: SymbolId, syntax: SyntaxExpr) -> SymbolId effects { state, io, process } {
    if !has_symbol(method) {
        if type_info(c, type_id).parameter_name != "" { bound_error(c, type_id, "", syntax.text, syntax.name_span); }
        bad(c, "E203", "Unknown method: " + syntax.text, syntax.name_span);
    }
    let t = type_info(c, type_id);
    let template = symbol_info(c, method);
    if !template.method_exported && source_unit_at(c, template.method_span.start) != source_unit_at(c, syntax.name_span.start) {
        var details = empty_details();
        details.owner = opaque_owner_name(c, t);
        details.member = syntax.text;
        list_push(details.related, RelatedLocation(message: "Private method declared here.", span: template.method_span));
        fail_details(c, "E223", "Private method: " + syntax.text, syntax.name_span, details);
    }
    var id = method;
    if template.template_index >= 0 {
        id = instantiate_function(c, method, t.arguments, syntax.name_span);
    }
    return id;
}
fn checked_method_call(c: Context, type_id: TypeId, method: SymbolId, syntax: SyntaxExpr, receiver: ExprId) -> ExprId effects { state, io, process } {
    let id = specialize_method(c, type_id, method, syntax);
    let sig = symbol_info(c, id);
    var n = expression_record(107, syntax.span, sig.type_id);
    n.arguments = check_arguments_with_receiver(c, syntax.arguments, sig.parameters, receiver, syntax.span);
    var call_span = syntax.name_span;
    if symbol_info(c, id).suspending { call_span = syntax.span; }
    require_effects(c, id, call_span);
    n.symbol = id;
    return add_expr(c, n);
}
fn check_construct(c: Context, owner: String, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let span = syntax.span;
    let name = module_global_name(c, list_get(type_parts(owner), 0), span);
    if find_interface(c, name) >= 0 {
        if owner != list_get(type_parts(owner), 0) { bad(c, "E210", "Interfaces are not generic.", span); }
        return static_interface_call(c, name, syntax);
    }
    let id = resolve_type(c, owner, span);
    let method = lookup_method(c, id, syntax.text);
    if has_symbol(method) || type_kind(c, id) == 76 || type_kind(c, id) == 77 {
        if syntax.kind != 7 {
            return callable_from_function(c, specialize_method(c, id, method, syntax), syntax.span);
        }
        return checked_method_call(c, id, method, syntax, no_expr());
    }
    if !has_type(id) || type_kind(c, id) != 70 {
        bad(c, "E200", "Unknown enum.", span);
    }
    let variant = find_symbol(c, type_info(c, id).variants, syntax.text);
    if !has_symbol(variant) {
        bad(c, "E211", "Unknown enum variant.", span);
    }
    var n = expression_record(108, span, id);
    n.symbol = variant;
    n.arguments = check_arguments(c, syntax.arguments, symbol_info(c, variant).parameters, span);
    return add_expr(c, n);
}
fn normalize_integer(c: Context, syntax: SyntaxExpr, negative: Bool) -> String effects { state, io, process } {
    let raw = syntax.text;
    var start = 0;
    while start + 1 < str_len(raw) && str_byte(raw, start) == 48 {
        start = start + 1;
    }
    var number = str_slice(raw, start, str_len(raw));
    if negative {
        number = "-"+ number;
    }
    match parse_int(number) {
        IntResult::Ok(value) => {
            return to_string(value);
        }
        IntResult::Err(_) => {
            bad(c, "E205", "Integer literal outside signed 64-bit range.", syntax.span);
            return "0";
        }
    }
}
fn check_expr(c: Context, ast: AstExprId) -> ExprId effects { state, io, process } {
    let syntax = ast_expr(c, ast);
    enter(c, syntax.span);
    let k = syntax.kind;
    var n = expression_record(0, syntax.span, no_type());
    var id = no_expr();
    if k == 1 {
        n.kind = 101;
        n.type_id = int_type();
        n.text = normalize_integer(c, syntax, false);
    } else if k == 12 {
        if !float_text_valid(syntax.text) {
            bad(c, "E205", "Float64 literal outside binary64 range or numeric text limit.", syntax.span);
        }
        n.kind = 117;
        n.type_id = float_type();
        n.text = syntax.text;
    } else if k == 2 {
        n.kind = 102;
        n.type_id = bool_type();
        n.text = syntax.text;
    } else if k == 3 {
        n.kind = 103;
        n.type_id = string_type();
        n.text = syntax.text;
    } else if k == 4 {
        if syntax.qualifier != "" {
            if module_alias(c, syntax.qualifier, syntax.span) >= 0 {
                id = named_callable(c, syntax.qualifier + "::" + syntax.text, syntax);
            } else {
                id = check_construct(c, syntax.qualifier, syntax);
            }
        } else {
            let b = lookup(c, syntax.text, syntax.name_span);
            if !has_symbol(b) {
                id = named_callable(c, syntax.text, syntax);
            } else {
                n.kind = 104;
                n.type_id = symbol_info(c, b).type_id;
                n.symbol = b;
            }
        }
    } else if k == 5 {
        let operand = ast_expr(c, syntax.left);
        if syntax.text == "-"&& operand.kind == 1 {
            n.kind = 101;
            n.type_id = int_type();
            n.text = normalize_integer(c, operand, true);
        } else {
            n.left = check_expr(c, syntax.left);
            n.type_id = bool_type();
            if syntax.text == "-" {
                n.type_id = int_type();
                if checked_expr(c, n.left).type_id == float_type() {
                    n.type_id = float_type();
                }
                if type_info(c, checked_expr(c, n.left).type_id).constraint == "Number" {
                    n.type_id = checked_expr(c, n.left).type_id;
                }
            }
            require_type(c, checked_expr(c, n.left).type_id, n.type_id, syntax.span);
            n.kind = 105;
            n.text = syntax.text;
        }
    } else if k == 6 {
        let left = check_expr(c, syntax.left);
        let right = check_expr(c, syntax.right);
        let a = checked_expr(c, left);
        let b = checked_expr(c, right);
        let op = syntax.text;
        n.type_id = int_type();
        if op == "&&" || op == "||" {
            require_type(c, a.type_id, bool_type(), a.span);
            require_type(c, b.type_id, bool_type(), b.span);
            n.type_id = bool_type();
        } else if op == "==" || op == "!=" {
            require_type(c, b.type_id, a.type_id, b.span);
            if !supports_scalar(c, a.type_id) && !supports_enum_equality(c, a.type_id) {
                if type_info(c, a.type_id).parameter_name != "" { bound_error(c, a.type_id, "", op, syntax.span); }
                bad(c, "E201", "Equality requires same-type scalars or an enum whose variants have no fields.", syntax.span);
            }
            n.type_id = bool_type();
        } else if op == "+" && a.type_id == string_type() {
            require_type(c, b.type_id, string_type(), b.span);
            n.type_id = string_type();
        } else {
            var numeric = int_type();
            if a.type_id == float_type() && op != "%" {
                numeric = float_type();
            }
            if type_info(c, a.type_id).constraint == "Number" && op != "%" {
                numeric = a.type_id;
            }
            require_type(c, a.type_id, numeric, a.span);
            require_type(c, b.type_id, numeric, b.span);
            n.type_id = numeric;
            if op == "<" || op == "<=" || op == ">" || op == ">=" {
                n.type_id = bool_type();
            }
        }
        n.kind = 106;
        n.text = op;
        n.left = left;
        n.right = right;
    } else if k == 11 {
        id = check_interpolation(c, syntax);
    } else if k == 9 {
        n.kind = 113;
        n.left = check_expr(c, syntax.left);
        n.arms = check_match_arms(c, checked_expr(c, n.left).type_id, syntax.arms, syntax.span, true);
        n.type_id = checked_expr(c, list_get(n.arms, 0).value).type_id;
    } else if k == 10 {
        id = check_propagation(c, syntax);
    } else if k == 8 {
        id = check_access(c, syntax);
    } else if k == 13 {
        let receiver = check_expr(c, syntax.left);
        let type_id = checked_expr(c, receiver).type_id;
        if type_kind(c, type_id) == 82 {
            let operation = interface_operation(c, type_info(c, type_id).base_name, syntax.text, syntax.name_span);
            id = dynamic_call(c, operation, receiver, syntax.arguments, syntax.span, syntax.name_span);
        } else {
            id = checked_method_call(c, type_id, lookup_method(c, type_id, syntax.text), syntax, receiver);
        }
    } else if k == 14 {
        id = checked_indirect_call(c, check_expr(c, syntax.left), syntax);
    } else if k == 15 {
        id = check_closure(c, syntax);
    } else if k == 16 {
        id = check_dynamic_box(c, syntax);
    } else if k == 17 {
        id = check_await(c, syntax);
    } else if k == 7 {
        var target = ast_expr(c, syntax.left);
        let is_module = module_alias(c, target.qualifier, target.span) >= 0;
        if is_module {
            target.text = target.qualifier +"::"+ target.text;
            target.qualifier = "";
        }
        if target.qualifier != "" {
            if list_len(syntax.type_arguments) > 0 {
                bad(c, "E210", "Enum constructors are not generic.", syntax.span);
            }
            id = check_construct(c, target.qualifier, syntax);
        } else {
            let binding = lookup(c, target.text, target.name_span);
            if has_symbol(binding) {
                if list_len(syntax.type_arguments) > 0 { bad(c, "E210", "Callable values do not take type arguments.", syntax.span); }
                id = checked_indirect_call(c, check_expr(c, syntax.left), syntax);
            } else {
            target.text = module_global_name(c, target.text, target.span);
            var t = find_type(c, target.text);
            if has_type(t) {
                check_opaque_constructor(c, type_info(c, t), target.name_span);
            }
            if type_kind(c, t) == 78 {
                if list_len(syntax.type_arguments) == 0 {
                    bad(c, "E210", "Generic type requires explicit arguments.", syntax.span);
                }
                t = resolve_type(c, target.text + "<" + join_text(syntax.type_arguments,",") + ">", syntax.span);
            }
            if type_kind(c, t) == 76 || type_kind(c, t) == 77 {
                if list_len(syntax.type_arguments) > 0 && type_info(c, t).template_index < 0 {
                    bad(c, "E210", "This constructor is not generic.", syntax.span);
                }
                id = check_record(c, t, syntax.arguments, syntax.span);
            } else {
                let sig_id = find_symbol(c, c.signatures, target.text);
                if !has_symbol(sig_id) {
                    bad(c, "E203", "Unknown function.", syntax.span);
                }
                let sig = symbol_info(c, sig_id);
                if sig.builtin {
                    id = builtin_call(c, sig_id, syntax.arguments, syntax.type_arguments, syntax.span);
                } else if sig.template_index >= 0 {
                    id = generic_function_call(c, sig_id, syntax.arguments, syntax.type_arguments, syntax.span);
                } else {
                    if list_len(syntax.type_arguments) > 0 {
                        bad(c, "E210", "This function is not generic.", syntax.span);
                    }
                    n.arguments = check_arguments(c, syntax.arguments, sig.parameters, syntax.span);
                    require_effects(c, sig_id, syntax.span);
                    n.kind = 107;
                    n.type_id = sig.type_id;
                    n.symbol = sig_id;
                }
            }
            }
        }
    }
    if !has_expr(id) {
        id = add_expr(c, n);
    }
    if c.query_mode {
        let checked = checked_expr(c, id);
        var role = "reference";
        if checked.kind == 107 || checked.kind == 122 { role = "call"; }
        if (k == 4 || k == 7 || k == 8 || k == 13) && checked.kind != 119 {
            var target = checked.symbol;
            if has_symbol(checked.reference) { target = checked.reference; }
            record_query_use(c, syntax.name_span, target, checked.type_id, role);
        }
    }
    leave(c);
    return id;
}
fn condition(c: Context, ast: AstExprId) -> ExprId effects { state, io, process } {
    let id = check_expr(c, ast);
    let n = checked_expr(c, id);
    require_type(c, n.type_id, bool_type(), n.span);
    return id;
}
fn checked_conditions(c: Context, items: List<AstExprId>) -> List<ExprId> effects { state, io, process } {
    let checked = list_new<ExprId>();
    var i = 0;
    while i < list_len(items) {
        list_push(checked, condition(c, list_get(items, i)));
        i = i + 1;
    }
    return checked;
}
fn block_returns(c: Context, items: List<StmtId>) -> Bool effects { state, io, process } {
    return match last(items) {
        Option::Some(id) => checked_stmt(c, id).returns, Option::None => false
    };
}
fn check_block(c: Context, items: List<AstStmtId>, nested: Bool) -> List<StmtId> effects { state, io, process } {
    if nested {
        push_scope(c);
    }
    let checked = list_new<StmtId>();
    var returns = false;
    var i = 0;
    while i < list_len(items) {
        let ast = list_get(items, i);
        if returns {
            bad(c, "E212", "Unreachable statement.", ast_stmt(c, ast).span);
        }
        let id = check_statement(c, ast);
        list_push(checked, id);
        returns = checked_stmt(c, id).exits;
        i = i + 1;
    }
    if nested {
        pop_scope(c);
    }
    return checked;
}
fn check_statement(c: Context, ast: AstStmtId) -> StmtId effects { state, io, process } {
    let syntax = ast_stmt(c, ast);
    enter(c, syntax.span);
    let k = syntax.kind;
    var n = statement_record(k + 100, syntax.span);
    if list_get(c.control, 0).in_defer && (k == 32 || k == 39 || k == 40 || k == 42) {
        bad(c, "E229", "A deferred block cannot transfer control or register another defer.", syntax.span);
    }
    if k == 30 {
        n.value = check_expr(c, syntax.value);
        var value_type = checked_expr(c, n.value).type_id;
        if syntax.annotation != "" {
            let annotation = resolve_type(c, syntax.annotation, syntax.span);
            require_type(c, value_type, annotation, syntax.span);
            value_type = annotation;
        }
        n.binding = bind(c, syntax.name, value_type, syntax.mutable, syntax.name_span, false);
    } else if k == 31 {
        let b = lookup(c, syntax.name, syntax.name_span);
        if !has_symbol(b) {
            bad(c, "E203", "Unknown binding.", syntax.span);
        }
        if !symbol_info(c, b).mutable {
            bad(c, "E213", "Cannot assign to immutable binding.", syntax.span);
        }
        n.value = check_expr(c, syntax.value);
        require_type(c, checked_expr(c, n.value).type_id, symbol_info(c, b).type_id, syntax.span);
        n.binding = b;
        record_query_use(c, syntax.name_span, b, symbol_info(c, b).type_id, "write");
    } else if k == 38 {
        n.target = check_expr(c, syntax.target);
        var root = checked_expr(c, n.target);
        while root.kind == 110 {
            root = checked_expr(c, root.left);
        }
        if root.kind != 104 {
            bad(c, "E213", "Assignment requires a local variable.", syntax.span);
        }
        if !symbol_info(c, root.symbol).mutable {
            bad(c, "E213", "Cannot change a field of an immutable binding.", syntax.span);
        }
        n.value = check_expr(c, syntax.value);
        require_type(c, checked_expr(c, n.value).type_id, checked_expr(c, n.target).type_id, syntax.span);
    } else if k == 32 {
        if has_ast_expr(syntax.value) {
            n.value = check_expr(c, syntax.value);
        } else {
            n.value = add_expr(c, expression_record(109, syntax.span, unit_type()));
        }
        require_type(c, checked_expr(c, n.value).type_id, list_get(c.control, 0).return_type, syntax.span);
        n.returns = true;
        n.exits = true;
    } else if k == 33 {
        n.value = check_expr(c, syntax.value);
        let value = checked_expr(c, n.value);
        if value.type_id != unit_type() {
            bad(c, "E214", "Unused expression value.", syntax.span);
        }
        if value.kind == 107 {
            let callee = symbol_info(c, value.symbol);
            if callee.builtin && callee.abi == "noreturn" {
                if list_get(c.control, 0).in_defer {
                    bad(c, "E229", "A deferred block cannot contain a direct panic statement.", syntax.span);
                }
                n.returns = true;
                n.exits = true;
            }
        }
    } else if k == 34 {
        n.value = condition(c, syntax.value);
        n.yes = check_block(c, syntax.yes, true);
        n.no = check_block(c, syntax.no, true);
        n.returns = block_returns(c, n.yes) && block_returns(c, n.no);
        n.exits = block_exits(c, n.yes) && block_exits(c, n.no);
    } else if k == 35 {
        n.value = condition(c, syntax.value);
        enter_loop(c);
        n.yes = check_block(c, syntax.yes, true);
        leave_loop(c);
    } else if k == 39 || k == 40 {
        if list_get(c.control, 0).loop_depth == 0 {
            bad(c, "E219", "Loop exit outside a loop.", syntax.span);
        }
        n.exits = true;
    } else if k == 41 {
        n = check_for(c, syntax);
    } else if k == 42 {
        var ctl = list_get(c.control, 0);
        ctl.in_defer = true;
        list_set(c.control, 0, ctl);
        n.yes = check_block(c, syntax.yes, true);
        ctl = list_get(c.control, 0);
        ctl.in_defer = false;
        list_set(c.control, 0, ctl);
    } else if k == 43 {
        n.yes = check_block(c, syntax.yes, true);
        n.returns = block_returns(c, n.yes);
        n.exits = block_exits(c, n.yes);
    } else if k == 36 {
        n.value = check_expr(c, syntax.value);
        n.arms = check_match_arms(c, checked_expr(c, n.value).type_id, syntax.arms, syntax.span, false);
        n.returns = true;
        n.exits = true;
        var i = 0;
        while i < list_len(n.arms) {
            n.returns = n.returns && block_returns(c, list_get(n.arms, i).body);
            n.exits = n.exits && block_exits(c, list_get(n.arms, i).body);
            i = i + 1;
        }
    }
    leave(c);
    return add_stmt(c, n);
}
fn order_type(c: Context, id: TypeId) -> Unit effects { state, io, process } {
    var t = type_info(c, id);
    if t.kind == 0 || t.kind == 75 || t.kind == 78 || t.kind == 80 || t.kind == 81 || t.kind == 82 {
        return;
    }
    if t.visit == 1 {
        bad(c, "E204", "Recursive by-value type.", t.span);
    }
    if t.visit == 2 {
        return;
    }
    enter(c, t.span);
    t.visit = 1;
    set_type(c, id, t);
    var i = 0;
    if t.kind == 70 {
        while i < list_len(t.variants) {
            let fields = symbol_info(c, list_get(t.variants, i)).parameters;
            var j = 0;
            while j < list_len(fields) {
                order_type(c, symbol_info(c, list_get(fields, j)).type_id);
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        while i < list_len(t.fields) {
            order_type(c, symbol_info(c, list_get(t.fields, i)).type_id);
            i = i + 1;
        }
    }
    t.visit = 2;
    set_type(c, id, t);
    list_push(c.type_order, id);
    leave(c);
}
fn analyze(c: Context) -> Unit effects { state, io, process } {
    analyze_mode(c, true);
}
fn analyze_mode(c: Context, require_entry: Bool) -> Unit effects { state, io, process } {
    install_prelude(c);
    bind_modules(c);
    var i = 0;
    while i < list_len(c.bound_types) {
        let syntax = list_get(c.bound_types, i);
        if syntax.span.end > syntax.span.start {
            declaration_name_available(c, syntax.name, syntax.span);
            if syntax.name == "List" || syntax.name == "Dict" {
                bad(c, "E202", "Reserved type constructor.", syntax.span);
            }
            var t = type_record(syntax.kind, syntax.name, syntax.span);
            t.opaque = syntax.opaque;
            t.base_name = syntax.base;
            if list_len(syntax.type_parameters) > 0 {
                if syntax.kind == 77 {
                    bad(c, "E210", "Distinct declarations cannot be generic.", syntax.span);
                }
                t.kind = 78;
                t.template_index = i;
            }
            let id = add_type(c, t);
        }
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.bound_types) {
        let syntax = list_get(c.bound_types, i);
        let id = find_type(c, syntax.name);
        validate_type_parameters(c, syntax.type_parameters);
        if type_kind(c, id) != 78 {
            fill_type(c, id, syntax, dict_new<String, TypeId>());
        }
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.bound_functions) {
        let syntax = list_get(c.bound_functions, i);
        declaration_name_available(c, syntax.name, syntax.span);
        validate_type_parameters(c, syntax.type_parameters);
        let mapping = dict_new<String, TypeId>();
        var sig = symbol_record(73, syntax.name, no_type(), syntax.span);
        sig.suspending = syntax.suspending;
        sig.effect_mask = syntax.effect_mask;
        if syntax.impl_index >= 0 {
            sig.method_span = syntax.name_span;
            sig.method_exported = syntax.method_exported;
        }
        if list_len(syntax.type_parameters) > 0 {
            sig.template_index = i;
        } else {
            sig = concrete_signature(c, syntax, syntax.name, mapping);
        }
        let id = add_symbol(c, sig);
        list_push(c.signatures, id);
        if sig.template_index < 0 && sig.foreign_library == "" {
            list_push(c.instances, FunctionInstance(depth: 0, signature: id, syntax_index: i, mapping: mapping));
        }
        i = i + 1;
    }
    install_interface_operations(c);
    verify_interface_bounds(c);
    let main_id = find_symbol(c, c.signatures, "main");
    var entry_tests = false;
    for function in c.bound_functions {
        if function.test_name != ""&& source_unit_at(c, function.span.start) == 0 {
            entry_tests = true;
        }
    }
    if require_entry && !has_symbol(main_id) {
        if !entry_tests {
            bad(c, "E207", "Missing main function.", empty_span());
        }
    } else if require_entry {
        let main_sig = symbol_info(c, main_id);
        if main_sig.suspending || list_len(main_sig.parameters) != 0 || (main_sig.type_id != int_type() && main_sig.type_id != unit_type()) {
            bad(c, "E207", "main must take no parameters and return Int or Unit.", empty_span());
        }
    }
    check_function_instances(c);
    check_suspension_graph(c);
    i = 0;
    while i < list_len(c.types) {
        order_type(c, primitive_type_id(i + 1));
        i = i + 1;
    }
}
fn check_function_instances(c: Context) -> Unit effects { state, io, process } {
    var i = 0;
    while i < list_len(c.instances) {
        let instance = list_get(c.instances, i);
        let syntax = list_get(c.bound_functions, instance.syntax_index);
        let sig_id = instance.signature;
        let sig = symbol_info(c, sig_id);
        push_scope(c);
        let params = list_new<SymbolId>();
        var j = 0;
        while j < list_len(syntax.parameters) {
            let p = list_get(syntax.parameters, j);
            list_push(params, bind(c, p.name, symbol_info(c, list_get(sig.parameters, j)).type_id, false, p.span, false));
            j = j + 1;
        }
        var ctl = list_get(c.control, 0);
        ctl.type_mapping = instance.mapping;
        ctl.instance_depth = instance.depth;
        ctl.return_type = sig.type_id;
        ctl.in_contract = true;
        ctl.in_async = sig.suspending;
        ctl.await_site = empty_span();
        ctl.allowed_effects = 0;
        list_set(c.control, 0, ctl);
        let pre = checked_conditions(c, syntax.preconditions);
        push_scope(c);
        let r = bind(c, "result", sig.type_id, false, syntax.span, true);
        let post = checked_conditions(c, syntax.postconditions);
        pop_scope(c);
        ctl = list_get(c.control, 0);
        ctl.in_contract = false;
        ctl.allowed_effects = sig.effect_mask;
        list_set(c.control, 0, ctl);
        let body = check_block(c, syntax.body, false);
        if !block_returns(c, body) {
            if sig.type_id != unit_type() {
                bad(c, "E208", "Function may reach its end without returning.", syntax.span);
            }
            var ret = statement_record(132, syntax.span);
            ret.value = add_expr(c, expression_record(109, syntax.span, unit_type()));
            ret.returns = true;
            list_push(body, add_stmt(c, ret));
        }
        list_push(c.functions, CheckedFunction(captures: list_new<SymbolId>(), symbol: sig_id, parameters: params, result_binding: r, preconditions: pre, postconditions: post, body: body, span: syntax.span));
        pop_scope(c);
        i = i + 1;
    }
}
fn declaration_name_available(c: Context, name: String, span: Span) -> Unit effects { state, io, process } {
    let t = find_type(c, name);
    if has_type(t) {
        duplicate(c, "Duplicate or reserved declaration '" + name + "'.", span, type_info(c, t).span);
    }
    let sig = find_symbol(c, c.signatures, name);
    if has_symbol(sig) {
        duplicate(c, "Duplicate or reserved declaration '" + name + "'.", span, symbol_info(c, sig).span);
    }
}
fn check_match_arms(c: Context, enum_id: TypeId, arms: List<SyntaxArm>, span: Span, value_mode: Bool) -> List<CheckedArm> effects { state, io, process } {
    if type_kind(c, enum_id) != 70 {
        bad(c, "E201", "match expects an enum value.", span);
    }
    let e = type_info(c, enum_id);
    let seen = dict_new<SymbolId, Bool>();
    var i = 0;
    var result_type = no_type();
    let checked = list_new<CheckedArm>();
    while i < list_len(arms) {
        let arm = list_get(arms, i);
        if module_global_name(c, arm.owner, arm.span) != list_get(type_parts(e.name), 0) {
            bad(c, "E201", "Wrong enum in pattern.", arm.span);
        }
        let variant = find_symbol(c, e.variants, arm.variant);
        if !has_symbol(variant) {
            bad(c, "E211", "Unknown pattern variant.", arm.span);
        }
        record_query_use(c, arm.variant_span, variant, enum_id, "pattern");
        if dict_has(seen, variant) {
            bad(c, "E215", "Duplicate match arm.", arm.span);
        }
        dict_set(seen, variant, true);
        push_scope(c);
        let fields = symbol_info(c, variant).parameters;
        let bindings = list_new<SymbolId>();
        var j = 0;
        while j < list_len(arm.names) && j < list_len(fields) {
            let name = list_get(arm.names, j);
            var b = no_symbol();
            if name.name != "_" {
                b = bind(c, name.name, symbol_info(c, list_get(fields, j)).type_id, false, name.span, false);
            }
            list_push(bindings, b);
            j = j + 1;
        }
        if list_len(arm.names) != list_len(fields) {
            bad(c, "E210", "Incorrect pattern field count.", arm.span);
        }
        var body = list_new<StmtId>();
        var value = no_expr();
        if value_mode {
            value = check_expr(c, arm.value);
            let actual = checked_expr(c, value).type_id;
            if has_type(result_type) {
                require_type(c, actual, result_type, arm.span);
            } else {
                result_type = actual;
            }
        } else {
            body = check_block(c, arm.body, false);
        }
        pop_scope(c);
        list_push(checked, CheckedArm(value: value, variant: variant, bindings: bindings, body: body, span: arm.span));
        i = i + 1;
    }
    if dict_len(seen) != list_len(e.variants) {
        let details = empty_details();
        var j = 0;
        while j < list_len(e.variants) {
            let v = list_get(e.variants, j);
            if !dict_has(seen, v) {
                list_push(details.missing_variants, e.name +"::"+ symbol_info(c, v).name);
            }
            j = j + 1;
        }
        if e.span.end > e.span.start {
            list_push(details.related, RelatedLocation(message: "Enum is declared here.", span: e.span));
        }
        fail_details(c, "E216", "Non-exhaustive match; missing: " + join_text(details.missing_variants, ", ") +".", span, details);
    }
    return checked;
}
fn check_interpolation(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    var n = expression_record(115, syntax.span, string_type());
    for i in 0 .. list_len(syntax.arguments) {
        let part = list_get(syntax.arguments, i);
        var value = check_expr(c, part.value);
        if part.label != "" {
            let t = checked_expr(c, value).type_id;
            let format = part.label;
            if format != "d" && format != "s" && format != "b" && format != "display" {
                bad(c, "E220", "Unknown interpolation format: " + format, ast_expr(c, part.value).span);
            }
            if format == "d" {
                require_type(c, t, int_type(), ast_expr(c, part.value).span);
            }
            if format == "s" {
                require_type(c, t, string_type(), ast_expr(c, part.value).span);
            }
            if format == "b" {
                require_type(c, t, bool_type(), ast_expr(c, part.value).span);
            }
            if format == "display" && !supports_scalar(c, t) {
                if type_info(c, t).parameter_name != "" { bound_error(c, t, "", format, syntax.span); }
                bad(c, "E201", "display requires a scalar value.", ast_expr(c, part.value).span);
            }
            var converted = expression_record(116, ast_expr(c, part.value).span, string_type());
            converted.left = value;
            value = add_expr(c, converted);
        }
        list_push(n.arguments, value);
    }
    return add_expr(c, n);
}


fn propagation_family(c: Context, id: TypeId) -> String effects { state, io, process } {
    if type_kind(c, id) != 70 {
        return "";
    }
    let t = type_info(c, id);
    let root = list_get(type_parts(t.name), 0);
    if root != "Option" && root != "Result" {
        return "";
    }
    if t.template_index != type_info(c, find_type(c, root)).template_index {
        return "";
    }
    return root;
}
fn check_propagation(c: Context, syntax: SyntaxExpr) -> ExprId effects { state, io, process } {
    let ctl = list_get(c.control, 0);
    if ctl.in_defer {
        bad(c, "E229", "Propagation is not allowed in a deferred block.", syntax.span);
    }
    if ctl.in_contract {
        bad(c, "E218", "Propagation is not allowed in contracts.", syntax.span);
    }
    let value = check_expr(c, syntax.left);
    let operand = checked_expr(c, value).type_id;
    let family = propagation_family(c, operand);
    if family == "" {
        bad(c, "E218", "Propagation requires Option or Result.", syntax.span);
    }
    if propagation_family(c, ctl.return_type) != family {
        bad(c, "E201", "Propagation requires the same return family.", syntax.span);
    }
    let t = type_info(c, operand);
    let target = type_info(c, ctl.return_type);
    if family == "Result" {
        require_type(c, list_get(t.arguments, 1), list_get(target.arguments, 1), syntax.span);
    }
    var n = expression_record(114, syntax.span, list_get(t.arguments, 0));
    n.left = value;
    n.symbol = list_get(target.variants, 1);
    return add_expr(c, n);
}
fn from_string(r: StringResult) -> Result<String, String> {
    return match r {
        StringResult::Ok(s) => Result<String, String>::Ok(s), StringResult::Err(e) => Result<String, String>::Err(e)
    };
}
fn from_write(r: WriteResult) -> Result<Bool, String> {
    return match r {
        WriteResult::Ok => Result<Bool, String>::Ok(true), WriteResult::Err(e) => Result<Bool, String>::Err(e)
    };
}
fn io_result<T>(r: Result<T, String>, fallback: T) -> T effects { io, process } {
    match r {
        Result::Ok(value) => {
            return value;
        }
        Result::Err(message) => {
            eprint("velac: " + message);
            exit(2);
            return fallback;
        }
    }
}


fn block_exits(c: Context, items: List<StmtId>) -> Bool effects { state, io, process } {
    return match last(items) {
        Option::Some(id) => checked_stmt(c, id).exits, Option::None => false
    };
}
fn enter_loop(c: Context) -> Unit effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.loop_depth = ctl.loop_depth + 1;
    list_set(c.control, 0, ctl);
}
fn leave_loop(c: Context) -> Unit effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.loop_depth = ctl.loop_depth - 1;
    list_set(c.control, 0, ctl);
}
fn check_for(c: Context, syntax: SyntaxStmt) -> CheckedStmt effects { state, io, process } {
    var n = statement_record(141, syntax.span);
    n.mode = syntax.mode;
    n.value = check_expr(c, syntax.value);
    let t = checked_expr(c, n.value).type_id;
    var element = int_type();
    if n.mode != 0 {
        require_type(c, t, int_type(), syntax.span);
        n.target = check_expr(c, syntax.target);
        require_type(c, checked_expr(c, n.target).type_id, int_type(), syntax.span);
    } else {
        if t == strings_type() {
            element = string_type();
        } else if t == ints_type() {
            element = int_type();
        } else if type_kind(c, t) == 75 && list_len(type_info(c, t).arguments) == 1 {
            element = list_get(type_info(c, t).arguments, 0);
        } else {
            bad(c, "E201", "for expects a list or an Int range.", syntax.span);
        }
        require_effects(c, find_symbol(c, c.signatures, "list_len"), syntax.span);
    }
    push_scope(c);
    n.binding = bind(c, syntax.name, element, false, syntax.name_span, false);
    enter_loop(c);
    n.yes = check_block(c, syntax.yes, false);
    leave_loop(c);
    pop_scope(c);
    return n;
}


// Backend APIs accept checked IDs/records, never syntax IDs.
fn emit(c: Context, line: String) -> Unit effects { state } {
    strings_push(c.output, line + "\n");
}
fn ctype(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == int32_type() { return "int32_t"; }
    if t == foreign_handle_type() { return "v_foreign_handle*"; }
    if t == callback_handle_type() { return "v_callback_entry*"; }
    if t == float_type() {
        return "double";
    }
    if t == int_type() {
        return "int64_t";
    }
    if t == bool_type() {
        return "int";
    }
    if t == string_type() {
        return "v_string";
    }
    if t == unit_type() {
        return "uint8_t";
    }
    if t == ints_type() {
        return "v_int_list*";
    }
    if t == strings_type() {
        return "v_string_list*";
    }
    let info = type_info(c, t);
    if info.kind == 80 { return "v_callable"; }
    if info.kind == 82 { return "v_dynamic"; }
    if info.kind == 75 {
        if list_len(info.arguments) == 1 {
            return "v_list*";
        }
        return "v_dict*";
    }
    if info.template_index >= 0 {
        return "v_g_type_" + num(type_number(t));
    }
    if str_len(info.name) > 0 && str_byte(info.name, 0) == 64 {
        return "v_m_type_" + num(type_number(t));
    }
    return "v_e_" + info.name;
}
fn cquote(value: String) -> String effects { state } {
    let parts = strings_new();
    strings_push(parts, "\"");
    var i = 0;
    while i < str_len(value) {
        if i > 0 && i % 512 == 0 {
            strings_push(parts, "\" \"");
        }
        let b = str_byte(value, i);
        strings_push(parts, "\\" + num(b / 64) + num(b / 8 % 8) + num(b % 8));
        i = i + 1;
    }
    strings_push(parts, "\"");
    return strings_join(parts, "");
}
fn location(c: Context, span: Span) -> String effects { state } {
    return cquote(filename_at(c, span.start)) + ", " + num(line_at(c, span.start)) + ", " + num(column_at(c, span.start));
}
fn emit_debug_line(c: Context, span: Span) -> Unit effects { state } {
    if !c.debug_codegen { return; }
    let path = filename_at(c, span.start);
    let parts = strings_new();
    strings_push(parts, "\"");
    for i in 0 .. str_len(path) {
        let byte = str_byte(path, i);
        if byte < 32 || byte == 127 {
            strings_push(parts, "\\" + num(byte / 64) + num(byte / 8 % 8) + num(byte % 8));
        } else {
            if byte == 34 || byte == 92 { strings_push(parts, "\\"); }
            strings_push(parts, str_from_byte(byte));
        }
    }
    strings_push(parts, "\"");
    emit(c, "#line " + num(line_at(c, span.start)) + " " + strings_join(parts, ""));
}
fn emit_debug_leave(c: Context) -> Unit effects { state } {
    if c.debug_codegen { emit(c, "v_debug_leave(&v_frame);"); }
}
fn local_name(binding: SymbolId) -> String {
    return "v_l_" + num(symbol_number(binding));
}
fn gc_visitor(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == string_type() { return "v_gc_string"; }
    if t == ints_type() { return "v_gc_ints_value"; }
    if t == strings_type() { return "v_gc_strings_value"; }
    if t == foreign_handle_type() { return "v_gc_handle_value"; }
    let info = type_info(c, t);
    if info.kind == 80 { return "v_gc_callable"; }
    if info.kind == 82 { return "v_gc_dynamic"; }
    if info.kind == 75 {
        if list_len(info.arguments) == 1 { return "v_gc_list_value"; }
        return "v_gc_dict_value";
    }
    if info.kind != 0 { return "v_trace_" + num(type_number(t)); }
    return "NULL";
}
fn gc_root(c: Context, name: String, visit: String) -> Unit effects { state } {
    if visit != "NULL" {
        emit(c, "v_gc_root v_root_" + name + "; v_gc_push(&v_root_" + name + ", &" + name + ", " + visit + ");");
    }
}
fn next_temporary(c: Context) -> String effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.temporary = ctl.temporary + 1;
    list_set(c.control, 0, ctl);
    return "v_t_" + num(ctl.temporary);
}
fn gc_scope(c: Context) -> String effects { state } {
    let mark = next_temporary(c);
    emit(c, "v_gc_root *const " + mark + " = v_gc_roots;");
    return mark;
}
fn gc_restore(c: Context, mark: String) -> Unit effects { state } {
    emit(c, "v_gc_roots = " + mark + ";");
}
fn temp(c: Context, t: TypeId, value: String) -> String effects { state, io, process } {
    emit(c, "v_gc_poll();");
    let name = raw_temp(c, ctype(c, t), value);
    gc_root(c, name, gc_visitor(c, t));
    return name;
}
fn raw_temp(c: Context, type_name: String, value: String) -> String effects { state } {
    let name = next_temporary(c);
    emit(c, type_name + " " + name + " = " + value +";");
    return name;
}
fn signature(c: Context, f: CheckedFunction) -> String effects { state, io, process } {
    let sig = symbol_info(c, f.symbol);
    let parts = strings_new();
    strings_push(parts, "void *v_environment");
    var i = 0;
    while i < list_len(f.parameters) {
        let id = list_get(f.parameters, i);
        strings_push(parts, ctype(c, symbol_info(c, id).type_id) + " " + local_name(id));
        i = i + 1;
    }
    return "static " + ctype(c, sig.type_id) + " " + function_name(c, f.symbol) + "(" + strings_join(parts, ", ") + ")";
}
fn zero_value(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == string_type() {
        return "v_text(\"\", 0)";
    }
    let kind = type_kind(c, t);
    if kind == 0 || kind == 75 {
        return "0";
    }
    return "("+ ctype(c, t) + "){0}";
}
fn emit_arguments(c: Context, args: List<ExprId>) -> StringList effects { state, io, process } {
    let parts = strings_new();
    for i in 0 .. list_len(args) {
        strings_push(parts, emit_expr(c, list_get(args, i)));
    }
    return parts;
}
fn emit_expr(c: Context, id: ExprId) -> String effects { state, io, process } {
    let n = checked_expr(c, id);
    let k = n.kind;
    let t = n.type_id;
    let value = n.text;
    if k == 123 || k == 124 {
        let operand = emit_expr(c, n.left);
        if k == 124 {
            emit(c, "v_fiber_suspend(" + operand + ", " + location(c, n.span) + ");");
        }
        emit(c, "if (v_fiber_cancelled()) {");
        emit_cleanups(c, 0);
        let function = list_get(c.functions, list_get(c.control, 0).function_index);
        let return_type = symbol_info(c, function.symbol).type_id;
        gc_restore(c, "v_gc_frame");
        emit_debug_leave(c);
        emit(c, "return " + zero_value(c, return_type) + "; }");
        if k == 124 { return temp(c, t, "0"); }
        return operand;
    }
    if k == 117 {
        return temp(c, t, value);
    }
    if k == 101 {
        if value == "-9223372036854775808" {
            return temp(c, t, "INT64_MIN");
        }
        if str_byte(value, 0) == 45 {
            return temp(c, t, "(-INT64_C(" + str_slice(value, 1, str_len(value)) + "))");
        }
        return temp(c, t, "INT64_C(" + value +")");
    }
    if k == 102 {
        if value == "true" {
            return temp(c, t, "1");
        }
        return temp(c, t, "0");
    }
    if k == 103 {
        return temp(c, t, "v_text(" + cquote(value) + ", " + num(str_len(value)) +")");
    }
    if k == 109 {
        return temp(c, t, "0");
    }
    if k == 104 {
        return temp(c, t, local_name(n.symbol));
    }
    if k == 118 || k == 119 || k == 120 { return emit_callable(c, n); }
    if k == 121 || k == 122 { return emit_dynamic(c, n); }
    if k == 110 {
        return temp(c, t, emit_expr(c, n.left) + ".v_m_" + symbol_info(c, n.symbol).name);
    }
    if k == 115 {
        return emit_interpolation(c, n);
    }
    if k == 116 {
        return emit_formatted_value(c, n);
    }
    if k == 113 {
        return emit_match_expression(c, n);
    }
    if k == 114 {
        return emit_propagation(c, n);
    }
    if k == 112 {
        let args = emit_arguments(c, n.arguments);
        let r = temp(c, t, "{0}");
        var i = 0;
        while i < list_len(n.arguments) {
            emit(c, r + ".v_m_" + symbol_info(c, list_get(n.fields, i)).name + " = " + strings_get(args, i) +";");
            i = i + 1;
        }
        return r;
    }
    if k == 105 {
        let arg = emit_expr(c, n.left);
        if value == "-" {
            if t == float_type() {
                return temp(c, t, "(-" + arg +")");
            }
            return temp(c, t, "v_neg(" + arg + ", " + location(c, n.span) +")");
        }
        return temp(c, t, "(!" + arg +")");
    }
    if k == 106 {
        var left = emit_expr(c, n.left);
        if value == "&&" || value == "||" {
            let r = temp(c, t, left);
            var test = r;
            if value == "||" {
                test = "!"+ r;
            }
            emit(c, "if (" + test + ") {");
            let mark = gc_scope(c);
            let right = emit_expr(c, n.right);
            emit(c, r + " = " + right +";");
            gc_restore(c, mark);
            emit(c, "}");
            return r;
        }
        var right = emit_expr(c, n.right);
        var arithmetic = "";
        let operand_type = checked_expr(c, n.left).type_id;
        if type_kind(c, operand_type) == 70 {
            return temp(c, t, "(" + left + ".tag " + value + " " + right + ".tag)");
        }
        if operand_type == float_type() {
            return temp(c, t,"("+ left + " " + value + " " + right +")");
        }
        if type_kind(c, operand_type) == 77 {
            left = left + ".v_m_value";
            right = right + ".v_m_value";
        }
        if value == "+" && t == string_type() {
            return temp(c, t, "v_str_concat(" + left + ", " + right + ", " + location(c, n.span) +")");
        }
        if value == "+" {
            arithmetic = "add";
        } else if value == "-" {
            arithmetic = "sub";
        } else if value == "*" {
            arithmetic = "mul";
        } else if value == "/" {
            arithmetic = "div";
        } else if value == "%" {
            arithmetic = "rem";
        }
        if arithmetic != "" {
            return temp(c, t, "v_" + arithmetic + "("+ left + ", " + right + ", " + location(c, n.span) +")");
        }
        if scalar_type(c, operand_type) == string_type() {
            var code = "v_string_eq(" + left + ", " + right +")";
            if value == "!=" {
                code = "!"+ code;
            }
            return temp(c, t, code);
        }
        return temp(c, t,"("+ left + " " + value + " " + right +")");
    }
    if k == 107 {
        let args = emit_arguments(c, n.arguments);
        let sig = symbol_info(c, n.symbol);
        if sig.builtin {
            return temp(c, t, emit_builtin(c, n, args));
        }
        if sig.foreign_library != "" { return emit_foreign(c, n, args); }
        let operands = strings_new();
        strings_push(operands, "NULL");
        for i in 0 .. strings_len(args) { strings_push(operands, strings_get(args, i)); }
        return temp(c, t, cc_call(function_name(c, n.symbol), operands));
    }
    if k == 108 {
        let args = emit_arguments(c, n.arguments);
        let tag = symbol_info(c, n.symbol).tag;
        let r = temp(c, t, "{0}");
        emit(c, r + ".tag = " + num(tag) +";");
        var i = 0;
        while i < strings_len(args) {
            emit(c, r + ".data.k" + num(tag) + ".f" + num(i) + " = " + strings_get(args, i) +";");
            i = i + 1;
        }
        return r;
    }
    eprint("velac: internal error: invalid checked expression kind");
    exit(70);
    return "";
}
fn emit_callable(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let k = n.kind;
    let t = n.type_id;
    if k == 118 {
        return temp(c, t, "{(void (*)(void))" + function_name(c, n.symbol) + ", NULL}");
    }
    if k == 120 {
        let args = emit_arguments(c, n.arguments);
        let code = "(void (*)(void))" + function_name(c, n.symbol);
        if strings_len(args) == 0 { return temp(c, t, "{" + code + ", NULL}"); }
        let environment = closure_environment(n.symbol);
        emit(c, "v_gc_poll();");
        let payload = raw_temp(c, environment + "*", "(" + environment + "*)v_allocate(sizeof(" + environment + "), " + location(c, n.span) + ")");
        emit(c, "v_gc_describe(" + payload + ", v_trace_" + environment + ");");
        for i in 0 .. strings_len(args) {
            emit(c, payload + "->v_capture_" + num(i) + " = " + strings_get(args, i) + ";");
        }
        let callable = raw_temp(c, "v_callable", "{" + code + ", " + payload + "}");
        gc_root(c, callable, "v_gc_callable");
        return callable;
    }
    let callee = emit_expr(c, n.left);
    let arguments = emit_arguments(c, n.arguments);
    let types = strings_new();
    strings_push(types, "void *");
    let signature = type_info(c, checked_expr(c, n.left).type_id).arguments;
    for i in 1 .. list_len(signature) { strings_push(types, ctype(c, list_get(signature, i))); }
    let operands = strings_new();
    strings_push(operands, callee + ".environment");
    for i in 0 .. strings_len(arguments) { strings_push(operands, strings_get(arguments, i)); }
    let code = "((" + ctype(c, t) + " (*)(" + strings_join(types, ", ") + "))" + callee + ".code)";
    return temp(c, t, code + "(" + strings_join(operands, ", ") + ")");
}
fn dynamic_table_name(target: TypeId, concrete: TypeId) -> String {
    return "v_dynamic_" + num(type_number(target)) + "_" + num(type_number(concrete));
}
fn emit_dynamic(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    if n.kind == 121 {
        let value = emit_expr(c, n.left);
        let concrete = checked_expr(c, n.left).type_id;
        let value_type = ctype(c, concrete);
        let table = dynamic_table_name(n.type_id, concrete);
        emit(c, "v_gc_poll();");
        let payload = raw_temp(c, value_type + " *", "(" + value_type + " *)v_allocate(sizeof(" + value_type + "), " + location(c, n.span) + ")");
        emit(c, "v_gc_describe(" + payload + ", " + gc_visitor(c, concrete) + ");");
        emit(c, "*" + payload + " = " + value + ";");
        let wrapper = raw_temp(c, "v_dynamic", "{" + payload + ", " + table + "}");
        gc_root(c, wrapper, "v_gc_dynamic");
        return wrapper;
    }
    let values = emit_arguments(c, n.arguments);
    let receiver = strings_get(values, 0);
    let signature = symbol_info(c, n.symbol);
    let types = strings_new();
    strings_push(types, "void *");
    let operands = strings_new();
    strings_push(operands, receiver + ".payload");
    for i in 1 .. list_len(signature.parameters) {
        strings_push(types, ctype(c, symbol_info(c, list_get(signature.parameters, i)).type_id));
        strings_push(operands, strings_get(values, i));
    }
    let code = "((" + ctype(c, n.type_id) + " (*)(" + strings_join(types, ", ") + "))" + receiver + ".operations[" + num(signature.tag) + "])";
    return temp(c, n.type_id, cc_call(code, operands));
}
fn emit_dynamic_tables(c: Context) -> Unit effects { state, io, process } {
    let seen = dict_new<String, Bool>();
    for n in c.expressions {
        if n.kind != 121 { continue; }
        let concrete = checked_expr(c, n.left).type_id;
        let table = dynamic_table_name(n.type_id, concrete);
        if dict_has(seen, table) { continue; }
        dict_set(seen, table, true);
        let entries = strings_new();
        for i in 0 .. list_len(n.fields) {
            let method = list_get(n.fields, i);
            let signature = symbol_info(c, method);
            let thunk = table + "_method_" + num(i);
            let parameters = strings_new();
            let operands = strings_new();
            strings_push(parameters, "void *payload");
            strings_push(operands, "NULL");
            strings_push(operands, "*(const " + ctype(c, concrete) + " *)payload");
            for j in 1 .. list_len(signature.parameters) {
                let type_id = symbol_info(c, list_get(signature.parameters, j)).type_id;
                let parameter = "arg_" + num(j);
                strings_push(parameters, ctype(c, type_id) + " " + parameter);
                strings_push(operands, parameter);
            }
            emit(c, "static " + ctype(c, signature.type_id) + " " + cc_call(thunk, parameters) + " {");
            emit(c, "return " + cc_call(function_name(c, method), operands) + "; }");
            strings_push(entries, "(void (*)(void))" + thunk);
        }
        if strings_len(entries) == 0 { strings_push(entries, "NULL"); }
        emit(c, "static void (*const " + table + "[])(void) = {" + strings_join(entries, ", ") + "};");
    }
}
fn emit_contracts(c: Context, items: List<ExprId>, kind: String) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(items) {
        let id = list_get(items, i);
        let n = checked_expr(c, id);
        let value = emit_expr(c, id);
        let message = cquote(kind + " failed: " + str_slice(c.source_text, n.span.start, n.span.end));
        emit(c, "if (!" + value + ") v_panic(" + location(c, n.span) + ", " + message + ");");
    }
}
fn emit_block(c: Context, items: List<StmtId>) -> Unit effects { state, io, process } {
    emit(c, "{");
    let mark = gc_scope(c);
    let cleanup_depth = list_len(c.cleanup_blocks);
    for i in 0 .. list_len(items) {
        emit_statement(c, list_get(items, i));
    }
    emit_cleanups(c, cleanup_depth);
    list_truncate(c.cleanup_blocks, cleanup_depth);
    gc_restore(c, mark);
    emit(c, "}");
}
fn emit_cleanups(c: Context, depth: Int) -> Unit effects { state, io, process } {
    var i = list_len(c.cleanup_blocks);
    while i > depth {
        i = i - 1;
        emit_block(c, checked_stmt(c, list_get(c.cleanup_blocks, i)).yes);
    }
}
fn emit_statement(c: Context, id: StmtId) -> Unit effects { state, io, process } {
    let n = checked_stmt(c, id);
    if n.kind == 142 {
        list_push(c.cleanup_blocks, id);
        return;
    }
    emit_debug_line(c, n.span);
    if n.kind == 130 {
        let t = symbol_info(c, n.binding).type_id;
        let name = local_name(n.binding);
        emit(c, ctype(c, t) + " " + name + " = " + zero_value(c, t) + ";");
        gc_root(c, name, gc_visitor(c, t));
    }
    emit(c, "{");
    let mark = gc_scope(c);
    emit_statement_inner(c, n);
    gc_restore(c, mark);
    emit(c, "}");
}
fn emit_statement_inner(c: Context, n: CheckedStmt) -> Unit effects { state, io, process } {
    let k = n.kind;
    if k == 130 || k == 131 {
        let value = emit_expr(c, n.value);
        emit(c, local_name(n.binding) + " = " + value +";");
    } else if k == 138 {
        let value = emit_expr(c, n.value);
        emit(c, emit_lvalue(c, n.target) + " = " + value +";");
    } else if k == 133 {
        let value = emit_expr(c, n.value);
        emit(c, "(void)" + value +";");
    } else if k == 132 {
        emit(c, "{");
        let value = emit_expr(c, n.value);
        emit_return_value(c, value);
        emit(c, "}");
    } else if k == 134 {
        let cond = emit_expr(c, n.value);
        emit(c, "if (" + cond + ") {");
        emit_block(c, n.yes);
        if list_len(n.no) > 0 {
            emit(c, "} else {");
            emit_block(c, n.no);
        }
        emit(c, "}");
    } else if k == 135 {
        let label = enter_emitted_loop(c);
        emit(c, "v_gc_root *const " + label + "_roots = v_gc_roots;");
        emit(c, "for (;;) {");
        let cond = emit_expr(c, n.value);
        emit(c, "if (!" + cond + ") break;");
        emit_block(c, n.yes);
        emit(c, label + "_continue:;");
        gc_restore(c, label + "_roots");
        emit(c, "}");
        leave_emitted_loop(c, label);
    } else if k == 139 || k == 140 {
        let label = list_get(c.loop_labels, list_len(c.loop_labels) - 1);
        emit_cleanups(c, list_get(c.loop_cleanup_depths, list_len(c.loop_cleanup_depths) - 1));
        if k == 139 {
            emit(c, "goto " + label + "_break;");
        } else {
            emit(c, "goto " + label + "_continue;");
        }
    } else if k == 141 {
        emit_for(c, n);
    } else if k == 143 {
        emit_block(c, n.yes);
    } else if k == 136 {
        let value = emit_expr(c, n.value);
        emit(c, "switch (" + value + ".tag) {");
        var i = 0;
        while i < list_len(n.arms) {
            let arm = list_get(n.arms, i);
            let tag = symbol_info(c, arm.variant).tag;
            emit(c, "case " + num(tag) + ": {");
            let mark = gc_scope(c);
            emit_arm_bindings(c, arm, value);
            emit_block(c, arm.body);
            gc_restore(c, mark);
            emit(c, "break; }");
            i = i + 1;
        }
        emit(c, "default: v_panic(" + location(c, n.span) + ", \"invalid enum tag\");");
        emit(c, "}");
    } else {
        eprint("velac: internal error: invalid checked statement kind");
        exit(70);
    }
}
fn emit_types(c: Context) -> Unit effects { state, io, process } {
    var i = 0;
    while i < list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        let t = type_info(c, id);
        if t.kind == 76 || t.kind == 77 {
            emit(c, "typedef struct {");
            if list_len(t.fields) == 0 {
                emit(c, "uint8_t empty;");
            }
            var j = 0;
            while j < list_len(t.fields) {
                let field = symbol_info(c, list_get(t.fields, j));
                emit(c, ctype(c, field.type_id) + " v_m_" + field.name +";");
                j = j + 1;
            }
            emit(c, "} " + ctype(c, id) +";");
        } else {
            emit(c, "typedef struct { int tag; union {");
            var j = 0;
            while j < list_len(t.variants) {
                let v = symbol_info(c, list_get(t.variants, j));
                emit(c, "struct {");
                if list_len(v.parameters) == 0 {
                    emit(c, "uint8_t empty;");
                }
                var k = 0;
                while k < list_len(v.parameters) {
                    emit(c, ctype(c, symbol_info(c, list_get(v.parameters, k)).type_id) + " f" + num(k) +";");
                    k = k + 1;
                }
                emit(c, "} k" + num(v.tag) +";");
                j = j + 1;
            }
            emit(c, "} data; } " + ctype(c, id) +";");
        }
        i = i + 1;
    }
}
fn emit_gc_field(c: Context, t: TypeId, field: String) -> Unit effects { state, io, process } {
    let visit = gc_visitor(c, t);
    if visit != "NULL" { emit(c, visit + "(&value->" + field + ");"); }
}
fn emit_gc_types(c: Context) -> Unit effects { state, io, process } {
    for i in 0 .. list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        emit(c, "static void " + gc_visitor(c, id) + "(const void *slot);");
    }
    for i in 0 .. list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        let t = type_info(c, id);
        let name = ctype(c, id);
        emit(c, "static void " + gc_visitor(c, id) + "(const void *slot) {");
        emit(c, "const " + name + " *value = (const " + name + "*)slot; (void)value;");
        if t.kind == 76 || t.kind == 77 {
            for j in 0 .. list_len(t.fields) {
                let field = symbol_info(c, list_get(t.fields, j));
                emit_gc_field(c, field.type_id, "v_m_" + field.name);
            }
        } else {
            emit(c, "switch (value->tag) {");
            for j in 0 .. list_len(t.variants) {
                let variant = symbol_info(c, list_get(t.variants, j));
                let tag = num(variant.tag);
                emit(c, "case " + tag + ":");
                for k in 0 .. list_len(variant.parameters) {
                    let field = symbol_info(c, list_get(variant.parameters, k));
                    emit_gc_field(c, field.type_id, "data.k" + tag + ".f" + num(k));
                }
                emit(c, "break;");
            }
            emit(c, "}");
        }
        emit(c, "}");
    }
}
fn generate(c: Context) -> String effects { state, io, process } {
    let entry = find_symbol(c, c.signatures, "main");
    if !has_symbol(entry) {
        bad(c, "E207", "build/run requires main; use vela test for test-only modules.", empty_span());
    }
    return generate_entry(c, entry);
}
fn closure_environment(symbol: SymbolId) -> String {
    return "v_env_" + num(symbol_number(symbol));
}
fn emit_closure_environments(c: Context) -> Unit effects { state, io, process } {
    for f in c.functions {
        if list_len(f.captures) == 0 { continue; }
        let name = closure_environment(f.symbol);
        emit(c, "typedef struct {");
        for i in 0 .. list_len(f.captures) {
            let captured = symbol_info(c, list_get(f.captures, i));
            emit(c, ctype(c, captured.type_id) + " v_capture_" + num(i) + ";");
        }
        emit(c, "} " + name + ";");
        emit(c, "static void v_trace_" + name + "(const void *slot) {");
        emit(c, "const " + name + " *value = (const " + name + "*)slot; (void)value;");
        for i in 0 .. list_len(f.captures) {
            emit_gc_field(c, symbol_info(c, list_get(f.captures, i)).type_id, "v_capture_" + num(i));
        }
        emit(c, "}");
    }
}
fn generate_entry(c: Context, entry: SymbolId) -> String effects { state, io, process } {
    strings_truncate(c.output, 0);
    var initial = list_get(c.control, 0);
    initial.temporary = 0;
    list_set(c.control, 0, initial);
    emit(c, "/* Generated by the Vela typed self-hosted compiler. */");
    emit(c, "#ifdef _MSC_VER\n#pragma comment(linker, \"/STACK:33554432\")\n#endif");
    if c.debug_codegen { emit(c, "#define VELA_DEBUG_INSTRUMENTED 1"); }
    emit(c, runtime_source());
    emit(c, "#if !defined(VELA_RUNTIME_ABI) || VELA_RUNTIME_ABI != 2");
    emit(c, "#error incompatible Vela internal runtime ABI");
    emit(c, "#endif");
    emit(c, "typedef struct { void (*code)(void); void *environment; } v_callable;");
    emit(c, "static void v_gc_callable(const void *slot) { v_gc_mark(((const v_callable *)slot)->environment); }");
    emit(c, "typedef struct { void *payload; void (*const *operations)(void); } v_dynamic;");
    emit(c, "static void v_gc_dynamic(const void *slot) { v_gc_mark(((const v_dynamic *)slot)->payload); }");
    emit_types(c);
    emit_gc_types(c);
    emit_closure_environments(c);
    emit(c, "static v_e_IntResult v_result(v_parse_result p) { v_e_IntResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_Int32Result v_int32_result(v_parse_result p) { v_e_Int32Result r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = (int32_t)p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_FloatResult v_float_result(v_float_parse p) { v_e_FloatResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_ReadResult v_read_result(v_bounded_read p) { v_e_ReadResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.value; else if (p.kind == 2) r.data.k2.f0 = p.value; return r; }");
    emit(c, "static v_e_StreamResult v_stream_open_result(v_stream_result p) { v_e_StreamResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.handle; else if (p.kind == 2) r.data.k2.f0 = p.error; return r; }");
    emit(c, "static v_e_SpawnResult v_spawn_result_value(v_spawn_result p) { v_e_SpawnResult r = {0}; r.tag = p.handle ? 0 : 1; if (p.handle) r.data.k0.f0 = p.handle; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_CallbackResult v_callback_result_value(v_callback_result p) { v_e_CallbackResult r = {0}; r.tag = p.entry ? 0 : 1; if (p.entry) r.data.k0.f0 = p.entry; else r.data.k1.f0 = p.error; return r; }");
    emit(c, "static v_e_ProcessResult v_process_result_value(v_process_result p) { v_e_ProcessResult r = {0}; r.tag = p.kind; if (p.kind == 0) r.data.k0.f0 = p.code; else if (p.kind == 2) r.data.k2.f0 = p.message; return r; }");
    emit(c, "static v_e_StringResult v_string_result(v_io_result p) { v_e_StringResult r = {0}; r.tag = p.ok ? 0 : 1; if (p.ok) r.data.k0.f0 = p.value; else r.data.k1.f0 = p.value; return r; }");
    emit(c, "static v_e_WriteResult v_write_result(v_io_result p) { v_e_WriteResult r = {0}; r.tag = p.ok ? 0 : 1; if (!p.ok) r.data.k1.f0 = p.value; return r; }");
    var i = 0;
    var main_index = 0;
    while i < list_len(c.functions) {
        emit(c, signature(c, list_get(c.functions, i)) +";");
        i = i + 1;
    }
    emit_dynamic_tables(c);
    i = 0;
    while i < list_len(c.functions) {
        let f = list_get(c.functions, i);
        let sig = symbol_info(c, f.symbol);
        if f.symbol == entry {
            main_index = i;
        }
        var ctl = list_get(c.control, 0);
        ctl.function_index = i;
        list_set(c.control, 0, ctl);
        emit_debug_line(c, f.span);
        emit(c, signature(c, f) + " {");
        emit(c, "(void)v_environment;");
        emit(c, "v_gc_root *const v_gc_frame = v_gc_roots;");
        if c.debug_codegen {
            emit(c, "static v_debug_record v_profile = {" + cquote(sig.name) + ", " + location(c, f.span) + ", 0, 0, 0, NULL};");
            emit(c, "v_debug_frame v_frame; v_debug_enter(&v_frame, &v_profile);");
        }
        for j in 0 .. list_len(f.captures) {
            let capture = list_get(f.captures, j);
            let type_id = symbol_info(c, capture).type_id;
            let name = local_name(capture);
            emit(c, ctype(c, type_id) + " " + name + " = ((" + closure_environment(f.symbol) + "*)v_environment)->v_capture_" + num(j) + ";");
            gc_root(c, name, gc_visitor(c, type_id));
        }
        for j in 0 .. list_len(f.parameters) {
            let parameter = list_get(f.parameters, j);
            gc_root(c, local_name(parameter), gc_visitor(c, symbol_info(c, parameter).type_id));
        }
        emit_contracts(c, f.preconditions, "precondition");
        emit_block(c, f.body);
        emit(c, "v_panic(" + location(c, f.span) + ", \"unreachable function end\");");
        emit(c, "return " + zero_value(c, sig.type_id) +";");
        emit(c, "}");
        i = i + 1;
    }
    if c.debug_codegen { emit(c, "#line 1 \"<vela-generated>\""); }
    let main_func = list_get(c.functions, main_index);
    emit(c, "int main(int argc, char **argv) { v_argc = argc; v_argv = argv; v_runtime_init(); v_gc_enable(); int code = 0;");
    if symbol_info(c, main_func.symbol).type_id == int_type() {
        emit(c, "code = v_exit_code(" + function_name(c, entry) + "(NULL), " + location(c, main_func.span) + ");");
    } else {
        emit(c, "(void)" + function_name(c, entry) + "(NULL);");
    }
    emit(c, "if (fflush(stdout) == EOF) v_panic(" + location(c, main_func.span) + ", \"failed to flush standard output\");");
    emit(c, "return code; }");
    return strings_join(c.output, "");
}
fn function_name(c: Context, id: SymbolId) -> String effects { state, io, process } {
    let sig = symbol_info(c, id);
    if sig.template_index >= 0 {
        return "v_g_f_" + num(symbol_number(id));
    }
    if sig.method_span.end > 0 || str_len(sig.name) > 0 && str_byte(sig.name, 0) == 64 {
        return "v_m_f_" + num(symbol_number(id));
    }
    return "v_f_" + sig.name;
}
fn emit_return_value(c: Context, value: String) -> Unit effects { state, io, process } {
    let f = list_get(c.functions, list_get(c.control, 0).function_index);
    let name = local_name(f.result_binding);
    let t = symbol_info(c, f.result_binding).type_id;
    emit(c, ctype(c, t) + " " + name + " = " + value +";");
    gc_root(c, name, gc_visitor(c, t));
    emit_cleanups(c, 0);
    emit_contracts(c, f.postconditions, "postcondition");
    gc_restore(c, "v_gc_frame");
    emit_debug_leave(c);
    emit(c, "return " + name +";");
}
fn emit_arm_bindings(c: Context, arm: CheckedArm, value: String) -> Unit effects { state, io, process } {
    let tag = symbol_info(c, arm.variant).tag;
    var i = 0;
    while i < list_len(arm.bindings) {
        let b = list_get(arm.bindings, i);
        if has_symbol(b) {
            let t = symbol_info(c, b).type_id;
            let name = local_name(b);
            emit(c, ctype(c, t) + " " + name + " = " + value + ".data.k" + num(tag) + ".f" + num(i) +";");
            gc_root(c, name, gc_visitor(c, t));
        }
        i = i + 1;
    }
}
fn emit_match_expression(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let value = emit_expr(c, n.left);
    let result_value = temp(c, n.type_id, zero_value(c, n.type_id));
    emit(c, "switch (" + value + ".tag) {");
    var i = 0;
    while i < list_len(n.arms) {
        let arm = list_get(n.arms, i);
        emit(c, "case " + num(symbol_info(c, arm.variant).tag) + ": {");
        let mark = gc_scope(c);
        emit_arm_bindings(c, arm, value);
        let selected = emit_expr(c, arm.value);
        emit(c, result_value + " = " + selected + ";");
        gc_restore(c, mark);
        emit(c, "break; }");
        i = i + 1;
    }
    emit(c, "default: v_panic(" + location(c, n.span) + ", \"invalid enum tag\"); }");
    return result_value;
}
fn emit_propagation(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let value = emit_expr(c, n.left);
    let failure = symbol_info(c, n.symbol);
    emit(c, "if (" + value + ".tag == 1) {");
    let propagated = temp(c, failure.owner, "{0}");
    emit(c, propagated + ".tag = 1;");
    if list_len(failure.parameters) == 1 {
        emit(c, propagated + ".data.k1.f0 = " + value + ".data.k1.f0;");
    }
    emit_return_value(c, propagated);
    emit(c, "}");
    return temp(c, n.type_id, value + ".data.k0.f0");
}
fn enter_emitted_loop(c: Context) -> String effects { state } {
    var ctl = list_get(c.control, 0);
    ctl.temporary = ctl.temporary + 1;
    list_set(c.control, 0, ctl);
    let label = "v_loop_" + num(ctl.temporary);
    list_push(c.loop_labels, label);
    list_push(c.loop_cleanup_depths, list_len(c.cleanup_blocks));
    return label;
}
fn leave_emitted_loop(c: Context, label: String) -> Unit effects { state } {
    emit(c, label + "_break:;");
    gc_restore(c, label + "_roots");
    list_truncate(c.loop_labels, list_len(c.loop_labels) - 1);
    list_truncate(c.loop_cleanup_depths, list_len(c.loop_cleanup_depths) - 1);
}
fn emit_for(c: Context, n: CheckedStmt) -> Unit effects { state, io, process } {
    let value = emit_expr(c, n.value);
    let label = enter_emitted_loop(c);
    let element_type = symbol_info(c, n.binding).type_id;
    let element = ctype(c, element_type);
    let loc = location(c, n.span);
    var counter = "";
    var end_value = "";
    var condition_text = "";
    var item = "";
    if n.mode != 0 {
        end_value = emit_expr(c, n.target);
        counter = temp(c, int_type(), value);
        condition_text = counter + " < " + end_value;
        if n.mode == 2 {
            condition_text = counter + " <= " + end_value;
        }
        item = counter;
    } else {
        end_value = temp(c, int_type(), value + "->length");
        let snapshot = label + "_items";
        emit(c, element + " *" + snapshot + " = (" + element + "*)v_copy_items(" + value + "->data, " + end_value + ", sizeof(" + element + "), " + loc + ");");
        let root = label + "_snapshot";
        emit(c, "v_gc_snapshot " + root + " = {" + snapshot + ", (size_t)" + end_value + ", sizeof(" + element + "), " + gc_visitor(c, element_type) + "};");
        gc_root(c, root, "v_gc_snapshot_value");
        counter = temp(c, int_type(), "0");
        condition_text = counter + " < " + end_value;
        item = snapshot + "[" + counter + "]";
    }
    emit(c, "v_gc_root *const " + label + "_roots = v_gc_roots;");
    emit(c, "while (" + condition_text + ") {");
    emit(c, element + " " + local_name(n.binding) + " = " + item +";");
    gc_root(c, local_name(n.binding), gc_visitor(c, element_type));
    emit_block(c, n.yes);
    emit(c, label + "_continue:;");
    gc_restore(c, label + "_roots");
    if n.mode == 2 {
        emit(c, "if (" + counter + " == " + end_value + ") break;");
    }
    emit(c, counter + " = v_add(" + counter + ", 1, " + loc + "); }");
    leave_emitted_loop(c, label);
}
fn emit_formatted_value(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    var value = emit_expr(c, n.left);
    let original = checked_expr(c, n.left).type_id;
    let scalar = scalar_type(c, original);
    if type_kind(c, original) == 77 {
        value = value + ".v_m_value";
    }
    if scalar == string_type() {
        return temp(c, string_type(), value);
    }
    if scalar == bool_type() {
        return temp(c, string_type(),"("+ value + " ? v_text(\"true\", 4) : v_text(\"false\", 5))");
    }
    if scalar == float_type() {
        return temp(c, string_type(), "v_float_to_string(" + value + ", " + location(c, n.span) +")");
    }
    return temp(c, string_type(), "v_int_to_string(" + value + ", " + location(c, n.span) +")");
}
fn emit_interpolation(c: Context, n: CheckedExpr) -> String effects { state, io, process } {
    let loc = location(c, n.span);
    let parts = temp(c, strings_type(), "v_strings_new(" + loc +")");
    for i in 0 .. list_len(n.arguments) {
        let value = emit_expr(c, list_get(n.arguments, i));
        emit(c, "v_strings_push(" + parts + ", " + value + ", " + loc + ");");
    }
    return temp(c, string_type(), "v_strings_join(" + parts + ", v_text(\"\", 0), " + loc +")");
}


// Intrinsic lowering uses resolved signatures and checked arguments only.
fn emit_lvalue(c: Context, id: ExprId) -> String effects { state, io, process } {
    let n = checked_expr(c, id);
    if n.kind == 104 {
        return local_name(n.symbol);
    }
    return emit_lvalue(c, n.left) + ".v_m_" + symbol_info(c, n.symbol).name;
}
fn cc_call(name: String, args: StringList) -> String effects { state } {
    return name + "("+ strings_join(args, ", ") +")";
}
fn emit_builtin(c: Context, n: CheckedExpr, args: StringList) -> String effects { state, io, process } {
    let sig = symbol_info(c, n.symbol);
    let abi = sig.abi;
    let t = n.type_id;
    let loc = location(c, n.span);
    if abi == "noreturn" {
        strings_push(args, loc);
        return cc_call("v_user_" + sig.name, args);
    }
    if abi == "print" || abi == "format" {
        let original = checked_expr(c, list_get(n.arguments, 0)).type_id;
        let scalar = scalar_type(c, original);
        var value = strings_get(args, 0);
        if type_kind(c, original) == 77 {
            value = value + ".v_m_value";
        }
        strings_set(args, 0, value);
        strings_push(args, loc);
        if abi == "print" {
            return cc_call("v_print_" + type_name(c, scalar), args);
        }
        if scalar == string_type() {
            return value;
        }
        if scalar == bool_type() {
            return "("+ value + " ? v_text(\"true\", 4) : v_text(\"false\", 5))";
        }
        if scalar == float_type() { return cc_call("v_float_to_string", args); }
        return cc_call("v_int_to_string", args);
    }
    if str_len(abi) >= 5 && str_slice(abi, 0, 5) == "list_" {
        var intrinsic = abi;
        if abi == "list_new" {
            let element = list_get(type_info(c, t).arguments, 0);
            strings_push(args, "sizeof(" + ctype(c, element) +")");
            strings_push(args, gc_visitor(c, element));
            intrinsic = "list_new_traced";
        }
        if abi == "list_push" {
            strings_set(args, 1, "&" + strings_get(args, 1));
        }
        if abi == "list_set" {
            strings_set(args, 2, "&" + strings_get(args, 2));
        }
        strings_push(args, loc);
        let code = cc_call("v_" + intrinsic, args);
        if abi == "list_get" {
            return "*(" + ctype(c, t) + "*)" + code;
        }
        return code;
    }
    if str_len(abi) >= 5 && str_slice(abi, 0, 5) == "dict_" {
        var intrinsic = abi;
        if abi == "dict_new" {
            let types = type_info(c, t).arguments;
            let scalar = scalar_type(c, list_get(types, 0));
            strings_push(args, "sizeof(" + ctype(c, scalar) +")");
            strings_push(args, "sizeof(" + ctype(c, list_get(types, 1)) +")");
            var kind = 1;
            if scalar == bool_type() {
                kind = 2;
            } else if scalar == string_type() {
                kind = 3;
            }
            strings_push(args, num(kind));
            strings_push(args, gc_visitor(c, scalar));
            strings_push(args, gc_visitor(c, list_get(types, 1)));
            intrinsic = "dict_new_traced";
        } else if abi != "dict_len" {
            let collection = checked_expr(c, list_get(n.arguments, 0)).type_id;
            let key_type = list_get(type_info(c, collection).arguments, 0);
            var key = strings_get(args, 1);
            if type_kind(c, key_type) == 77 {
                key = key + ".v_m_value";
            }
            strings_set(args, 1, "&" + key);
            if abi == "dict_set" || abi == "dict_get_or" {
                strings_set(args, 2, "&" + strings_get(args, 2));
            }
        }
        strings_push(args, loc);
        let code = cc_call("v_" + intrinsic, args);
        if abi == "dict_get" || abi == "dict_get_or" {
            return "*(" + ctype(c, t) + "*)" + code;
        }
        return code;
    }
    if abi == "callback_result" {
        let closure = strings_get(args, 1);
        strings_set(args, 1, closure + ".code");
        strings_push(args, closure + ".environment");
    }
    if abi == "fiber_result" {
        let closure = strings_get(args, 0);
        strings_set(args, 0, closure + ".code");
        strings_push(args, closure + ".environment");
    }
    if abi != "plain" && abi != "int_result" {
        strings_push(args, loc);
    }
    var code = cc_call("v_" + sig.name, args);
    if abi == "int_result" {
        code = "v_result(" + code +")";
    }
    if abi == "string_result" {
        code = "v_string_result(" + code +")";
    }
    if abi == "write_result" {
        code = "v_write_result(" + code +")";
    }
    if abi == "float_result" { code = "v_float_result(" + code + ")"; }
    if abi == "int32_result" { code = "v_int32_result(" + code + ")"; }
    if abi == "read_result" { code = "v_read_result(" + code + ")"; }
    if abi == "stream_result" { code = "v_stream_open_result(" + code + ")"; }
    if abi == "spawn_result" || abi == "fiber_result" { code = "v_spawn_result_value(" + code + ")"; }
    if abi == "callback_result" { code = "v_callback_result_value(" + code + ")"; }
    if abi == "process_result" { code = "v_process_result_value(" + code + ")"; }
    return code;
}
fn foreign_ctype(c: Context, t: TypeId) -> String effects { state, io, process } {
    if t == foreign_handle_type() { return "void*"; }
    if t == callback_handle_type() { return "const VelaCallback*"; }
    if t == string_type() { return "VelaBytes"; }
    if t == bool_type() { return "int32_t"; }
    if t == unit_type() { return "void"; }
    return ctype(c, t);
}
fn emit_foreign(c: Context, n: CheckedExpr, args: StringList) -> String effects { state, io, process } {
    let sig = symbol_info(c, n.symbol);
    let loc = location(c, n.span);
    let library = raw_temp(c, "v_foreign_library*", "v_foreign_require(" + cquote(sig.foreign_library) + ", " + loc + ")");
    let types = strings_new();
    for i in 0 .. list_len(sig.parameters) {
        let t = symbol_info(c, list_get(sig.parameters, i)).type_id;
        strings_push(types, foreign_ctype(c, t));
        if t == foreign_handle_type() {
            strings_set(args, i, raw_temp(c, "void*", "v_foreign_unwrap(" + strings_get(args, i) + ", " + library + ", " + loc + ")"));
        } else if t == callback_handle_type() {
            strings_set(args, i, raw_temp(c, "const VelaCallback*", "v_callback_require(" + strings_get(args, i) + ", " + library + ", " + loc + ")"));
        } else if t == string_type() {
            strings_set(args, i, "(VelaBytes){" + strings_get(args, i) + ".data, (uint64_t)" + strings_get(args, i) + ".length}");
        }
    }
    if strings_len(types) == 0 { strings_push(types, "void"); }
    let pointer = raw_temp(c, "v_foreign_proc", "v_foreign_symbol(" + library + ", " + cquote(sig.foreign_name) + ", " + loc + ")");
    let environment = raw_temp(c, "fenv_t", "{0}");
    emit(c, "if (fegetenv(&" + environment + ")) v_panic(" + loc + ", \"cannot save floating-point environment\");");
    let call = "((" + foreign_ctype(c, n.type_id) + " (*)(" + strings_join(types, ", ") + "))" + pointer + ")(" + strings_join(args, ", ") + ")";
    var returned = "0";
    if n.type_id == unit_type() { emit(c, call + ";"); }
    else { returned = raw_temp(c, foreign_ctype(c, n.type_id), call); }
    emit(c, "if (fesetenv(&" + environment + ")) v_panic(" + loc + ", \"cannot restore floating-point environment\");");
    if n.type_id == foreign_handle_type() { return temp(c, n.type_id, "v_foreign_wrap(" + returned + ", " + library + ", " + loc + ")"); }
    if n.type_id == bool_type() { emit(c, "if (" + returned + " != 0 && " + returned + " != 1) v_panic(" + loc + ", \"foreign Bool must be 0 or 1\");"); }
    return returned;
}


// Formatting uses concrete token spelling and preserved comment spans.
fn format_tokens(c: Context) -> List<Token> effects { state } {
    let tokens = list_new<Token>();
    var i = 0;
    var j = 0;
    while i + 1 < list_len(c.tokens) || j < list_len(c.comments) {
        if j < list_len(c.comments) && (i + 1 >= list_len(c.tokens) || list_get(c.comments, j).span.start < list_get(c.tokens, i).span.start) {
            list_push(tokens, list_get(c.comments, j));
            j = j + 1;
        } else {
            list_push(tokens, list_get(c.tokens, i));
            i = i + 1;
        }
    }
    return tokens;
}
fn format_line(parts: StringList, line: String, indentation: Int) -> Unit effects { state } {
    if line == "" {
        return;
    }
    var prefix = "";
    var i = 0;
    while i < indentation {
        prefix = prefix + "    ";
        i = i + 1;
    }
    strings_push(parts, prefix + line + "\n");
}
fn format_unary(previous: String, token: String) -> Bool {
    if token == "!" {
        return true;
    }
    return token == "-"&& (previous == ""|| previous == "("|| previous =="," || previous ==":" || previous == "=" || previous == "return" || previous == "requires" || previous == "ensures" || previous == "if" || previous == "while" || precedence(previous) >= 0 || previous == "!"|| previous == "=>");
}
fn format_space(previous: String, token: String, previous_unary: Bool, generic: Bool, previous_open_generic: Bool) -> Bool {
    if previous == ""|| previous_unary || previous_open_generic || generic {
        return false;
    }
    if token =="?" || token ==")" || token =="," || token ==";" || token =="."|| token =="::"|| token ==":" {
        return false;
    }
    if previous == "("|| previous =="."|| previous =="::" {
        return false;
    }
    if token == "("&& previous == ">" {
        return false;
    }
    if token == "("&& previous != "if" && previous != "while" && previous != "return" && previous != "requires" && previous != "ensures" && previous != "=" && precedence(previous) < 0 {
        return false;
    }
    return true;
}
fn format_break(c: Context, previous: Token, next: Token) -> Bool effects { state } {
    if next.kind == 55 || previous.kind == 55 { return false; }
    if previous.kind == 53 && (previous.text == "," || previous.text == "=" || previous.text == "=>" || previous.text == "(") {
        return next.kind != 53 || next.text != ")" && next.text != "}";
    }
    return next.kind == 53 && precedence(next.text) >= 0 &&
        !dict_has(c.generic_tokens, next.span.start) &&
        next.span.start > previous.span.end &&
        (next.text != "-" || !format_unary(previous.text, next.text));
}
fn format_wrap(c: Context) -> String effects { state } {
    let tokens = format_tokens(c);
    let parts = strings_new();
    var first = 0;
    var copied = 0;
    while first < list_len(tokens) {
        let head = list_get(tokens, first);
        let start_line = global_line_at(c, head.span.start);
        var last_line = global_line_at(c, head.span.end);
        var end = first + 1;
        while end < list_len(tokens) && global_line_at(c, list_get(tokens, end).span.start) <= last_line {
            last_line = global_line_at(c, list_get(tokens, end).span.end);
            end = end + 1;
        }
        let line_start = list_get(c.lines, start_line - 1);
        if last_line == start_line && list_get(tokens, end - 1).span.end - line_start > 100 {
            let prefix = str_slice(c.source_text, line_start, head.span.start) + "    ";
            var segment = first;
            var i = first + 1;
            var available = 100 - (head.span.start - line_start);
            var best = -1;
            while i < end {
                let a = list_get(tokens, i - 1);
                let b = list_get(tokens, i);
                if format_break(c, a, b) { best = i; }
                if b.span.end - list_get(tokens, segment).span.start > available && best > segment {
                    let before = list_get(tokens, best - 1);
                    let after = list_get(tokens, best);
                    strings_push(parts, str_slice(c.source_text, copied, before.span.end));
                    strings_push(parts, "\n" + prefix);
                    copied = after.span.start;
                    segment = best;
                    available = 100 - str_len(prefix);
                    best = -1;
                    i = segment + 1;
                } else {
                    i = i + 1;
                }
            }
        }
        first = end;
    }
    strings_push(parts, str_slice(c.source_text, copied, str_len(c.source_text)));
    return strings_join(parts, "");
}
fn format_source(c: Context) -> String effects { state, io, process } {
    let tokens = format_tokens(c);
    let parts = strings_new();
    let braces = ints_new();
    var line = "";
    var indent = 0;
    var previous = "";
    var previous_end = 0;
    var previous_unary = false;
    var previous_open_generic = false;
    var closed_inline = false;
    var declaration = false;
    var parens = 0;
    var generics = 0;
    var i = 0;
    while i < list_len(tokens) {
        let t = list_get(tokens, i);
        let raw = str_slice(c.source_text, t.span.start, t.span.end);
        var word = t.text;
        if t.kind == 52 || t.kind == 56 || t.kind == 58 { word = "<literal>"; }
        if t.kind == 55 {
            if line != ""&& line_at(c, previous_end) != line_at(c, t.span.start) {
                format_line(parts, line, indent);
                line = "";
            }
            if line != "" {
                line = line + " ";
            }
            line = line + raw;
            format_line(parts, line, indent);
            line = "";
        } else {
            if previous == "}"
            && !closed_inline && word != "else" && word !=";" && word !="," && word !=")" && word != "}"
            {
                format_line(parts, line, indent);
                line = "";
            }
            if t.kind == 50 && (word == "struct" || word == "enum") {
                declaration = true;
            }
            if t.kind == 53 && word == "{" {
                var kind = 0;
                if previous == "effects" { kind = 1;
                } else if declaration {
                    kind = 2;
                    declaration = false;
                }
                if line != "" {
                    line = line + " ";
                }
                line = line + "{";
                ints_push(braces, kind);
                if kind != 1 {
                    if i + 1 >= list_len(tokens) || list_get(tokens, i + 1).text != "}"
                    {
                        format_line(parts, line, indent);
                        line = "";
                    }
                    indent = indent + 1;
                }
            } else if t.kind == 53 && word == "}"
            {
                let kind = ints_get(braces, ints_len(braces) - 1);
                ints_truncate(braces, ints_len(braces) - 1);
                closed_inline = kind == 1;
                if kind != 1 {
                    if previous != "{" {
                        format_line(parts, line, indent);
                        line = "";
                    }
                    indent = indent - 1;
                    line = line + "}";
                } else {
                    if previous != "{" && line != "" {
                        line = line + " ";
                    }
                    line = line + "}";
                }
            } else {
                var generic = false;
                var open_generic = false;
                if t.kind == 53 && word == "<" && dict_has(c.generic_tokens, t.span.start) {
                    generic = true;
                    open_generic = true;
                    generics = generics + 1;
                } else if t.kind == 53 && word == ">" && dict_has(c.generic_tokens, t.span.start) {
                    generic = true;
                    generics = generics - 1;
                }
                let unary = format_unary(previous, word);
                if line != ""&& format_space(previous, word, previous_unary, generic, previous_open_generic) {
                    line = line + " ";
                }
                line = line + raw;
                if t.kind == 53 && word == "(" {
                    parens = parens + 1;
                } else if t.kind == 53 && word ==")" {
                    parens = parens - 1;
                }
                var newline = t.kind == 53 && word ==";" || dict_has(c.arm_commas, t.span.start);
                if t.kind == 53 && word =="," && ints_len(braces) > 0 && ints_get(braces, ints_len(braces) - 1) == 2 && parens == 0 && generics == 0 {
                    newline = true;
                }
                if newline {
                    let inline_comment = i + 1 < list_len(tokens) && list_get(tokens, i + 1).kind == 55 && line_at(c, list_get(tokens, i + 1).span.start) == line_at(c, t.span.end);
                    if !inline_comment {
                        format_line(parts, line, indent);
                        line = "";
                    }
                }
                previous_unary = unary;
                previous_open_generic = open_generic;
            }
            if word == "{" || word == "}"
            {
                previous_unary = false;
                previous_open_generic = false;
            }
            previous = word;
            previous_end = t.span.end;
        }
        i = i + 1;
    }
    format_line(parts, line, indent);
    let compact = make_context(strings_join(parts, ""), c.source_name, c.json_mode);
    lex(compact);
    parse_module(compact);
    let formatted = format_wrap(compact);
    let checked = make_context(formatted, c.source_name, c.json_mode);
    lex(checked);
    parse_module(checked);
    if list_len(checked.tokens) != list_len(c.tokens) || list_len(checked.comments) != list_len(c.comments) {
        eprint("velac: internal formatter token mismatch");
        exit(70);
    }
    i = 0;
    while i < list_len(c.tokens) {
        let a = list_get(c.tokens, i);
        let b = list_get(checked.tokens, i);
        if a.kind != b.kind || a.text != b.text || str_slice(c.source_text, a.span.start, a.span.end) != str_slice(formatted, b.span.start, b.span.end) {
            eprint("velac: internal formatter token mismatch");
            exit(70);
        }
        i = i + 1;
    }
    i = 0;
    while i < list_len(c.comments) {
        if list_get(c.comments, i).text != list_get(checked.comments, i).text {
            eprint("velac: internal formatter comment mismatch");
            exit(70);
        }
        i = i + 1;
    }
    return formatted;
}


fn record_query_use(c: Context, span: Span, symbol: SymbolId, type_id: TypeId,
    role: String) -> Unit effects { state } {
    if c.query_mode {
        list_push(c.query_uses, QueryUse(span: span, symbol: symbol, type_id: type_id, role: role));
    }
}
fn query_point(c: Context, unit: SourceUnit, offset: Int) -> String effects { state } {
    let line = global_line_at(c, offset);
    var character = 0;
    for i in list_get(c.lines, line - 1) .. offset {
        let b = str_byte(c.source_text, i);
        if b < 128 || b >= 192 {
            character = character + 1;
        }
        if b >= 240 {
            character = character + 1;
        }
    }
    return f"{{\"line\":{line - unit.line_base - 1:d},\"character\":{character:d},\"byte\":{offset - unit.start:d}}}";
}
fn query_range(c: Context, span: Span) -> String effects { state } {
    let module = source_unit_at(c, span.start);
    let unit = list_get(c.source_units, module);
    return f"{{\"document\":{module:d},\"start\":{query_point(c, unit, span.start):s},\"end\":{query_point(c, unit, span.end):s}}}";
}
fn query_key(c: Context, span: Span, kind: String) -> String effects { state } {
    let module = source_unit_at(c, span.start);
    return f"{module:d}:{span.start - list_get(c.source_units, module).start:d}:{kind:s}";
}
fn query_decl_span(c: Context, span: Span, name: String) -> Span effects { state, io,
    process } {
    for d in c.declarations {
        if d.span.start >= span.start && d.span.end <= span.end && d.canonical == name {
            return d.span;
        }
    }
    return empty_span();
}
fn query_type_template(c: Context, id: TypeId) -> TypeInfo effects { state, io, process } {
    let t = type_info(c, id);
    if t.template_index >= 0 {
        let template = list_get(c.bound_types, t.template_index);
        return type_info(c, find_type(c, template.name));
    }
    return t;
}
fn query_symbol_kind(symbol: Symbol) -> String {
    if symbol.kind == 73 {
        return "function";
    }
    if symbol.kind == 61 {
        return "binding";
    }
    return "member";
}
fn query_symbol_span(c: Context, symbol: Symbol) -> Span effects { state, io, process } {
    if has_symbol(symbol.capture_origin) {
        return query_symbol_span(c, symbol_info(c, symbol.capture_origin));
    }
    if symbol.builtin || symbol.span.end == 0 || symbol.name == "result" {
        return empty_span();
    }
    if symbol.kind == 73 {
        if symbol.method_span.end > 0 {
            return symbol.method_span;
        }
        if symbol.template_index >= 0 {
            let template = list_get(c.bound_functions, symbol.template_index);
            return query_decl_span(c, template.span, template.name);
        }
        return query_decl_span(c, symbol.span, symbol.name);
    }
    let end = symbol.span.start + str_len(symbol.name);
    if end <= symbol.span.end && str_slice(c.source_text, symbol.span.start, end) == symbol.name {
        return Span(start: symbol.span.start, end: end);
    }
    return empty_span();
}
fn query_type_name(c: Context, id: TypeId) -> String effects { state, io, process } {
    if !has_type(id) {
        return "";
    }
    return display_type(c, id);
}
fn query_target(c: Context, site: QueryUse) -> Span effects { state, io, process } {
    if has_symbol(site.symbol) {
        return query_symbol_span(c, symbol_info(c, site.symbol));
    }
    return empty_span();
}
fn query_open(p: Project, overlays: List<QueryOverlay>) -> Context effects { state, io,
    process } {
    return query_open_mode(p, overlays, "", -1);
}
fn query_open_mode(p: Project, overlays: List<QueryOverlay>, revision: String,
    document: Int) -> Context effects { state, io, process } {
    var code = "";
    match query_source_text(p.entry, overlays) {
        Result::Ok(text) => {
            code = text;
        }
        Result::Err(message) => {
            source_error(message, true);
        }
    }
    var c = project_overlay_context(p.entry, p.entry, code, true, p.dependencies, overlays);
    c.query_mode = true;
    if revision != "" {
        repair_validate(c, revision, document);
        c.repair_mode = true;
        c.repair_document = document;
        c.repair_overlays = overlays;
        c.repair_root = p.entry;
        if p.manifest != "" {
            c.repair_root = p.manifest;
        }
    }
    parse_program(c);
    analyze_mode(c, false);
    return c;
}
fn query_overlay_args(start: Int) -> List<QueryOverlay> effects { args, state, io, process } {
    let overlays = list_new<QueryOverlay>();
    var i = start;
    var total = 0;
    while i < arg_count() {
        if io_value(arg(i)) != "--overlay" || i + 2 >= arg_count() || list_len(overlays) >= 32 {
            source_error("Expected up to 32 --overlay SOURCE CONTENT_FILE pairs.", true);
        }
        let path = io_value(absolute_path(io_value(arg(i + 1))));
        let data = io_value(arg(i + 2));
        var code = "";
        match read_file_bounded(data, 2097152) {
            ReadResult::Ok(text) => {
                code = text;
            }
            ReadResult::Limit => {
                source_error("Overlay exceeds 2 MiB.", true);
            }
            ReadResult::Err(message) => {
                source_error(message, true);
            }
        }
        total = total + str_len(code);
        if total > 8388608 {
            source_error("Overlay byte budget exceeded.", true);
        }
        if !source_inside_boundary(path) {
            source_error("Overlay escapes source root.", true);
        }
        list_push(overlays, QueryOverlay(path: path, code: normalized(code)));
        i = i + 3;
    }
    return overlays;
}
struct PlanEdit {
    span: Span,
    text: String
}
fn plan_reject(c: Context, message: String) -> Unit effects { state, io, process } {
    bad(c, "E231", message, empty_span());
}
fn plan_integer(raw: String) -> Int effects { io, process, state } {
    match parse_int(raw) {
        IntResult::Ok(value) => {
            return value;
        }
        IntResult::Err(_) => {
            source_error("Expected an integer plan coordinate.", true);
        }
    }
    return -1;
}
fn plan_symbol(c: Context, offset: Int) -> SymbolId effects { state, io, process } {
    for site in c.query_uses {
        if site.span.start <= offset && offset < site.span.end && has_symbol(site.symbol) {
            return site.symbol;
        }
    }
    for i in 0 .. list_len(c.symbols) {
        let symbol = list_get(c.symbols, i);
        let span = query_symbol_span(c, symbol);
        if span.start <= offset && offset < span.end {
            return symbol_at(i);
        }
    }
    return no_symbol();
}
fn plan_offset(c: Context, span: Span, edits: List<PlanEdit>) -> Int effects { state } {
    let owner = source_unit_at(c, span.start);
    let unit = list_get(c.source_units, owner);
    var pos = span.start - unit.start;
    for edit in edits {
        if edit.span.start < span.start && edit.span.start >= unit.start {
            pos = pos + str_len(edit.text) - (edit.span.end - edit.span.start);
        }
    }
    return pos;
}
fn plan_binding_graph(c: Context, edits: List<PlanEdit>) -> Dict<String, Bool> effects { state,
    io, process } {
    let graph = dict_new<String, Bool>();
    for site in c.query_uses {
        if !has_symbol(site.symbol) {
            continue;
        }
        let sym = symbol_info(c, site.symbol);
        let target = query_symbol_span(c, sym);
        var key = "";
        if target.end > 0 {
            key =
                f"{source_unit_at(c, target.start):d}:{plan_offset(c, target, edits):d}:{query_symbol_kind(sym):s}";
        } else if sym.builtin {
            key = "builtin:" + sym.name;
        }
        dict_set(graph,
            f"{source_unit_at(c, site.span.start):d}:{plan_offset(c, site.span, edits):d}:{site.role:s}:{key:s}",
            true);
    }
    return graph;
}
fn interface_rename_group(c: Context, symbol: Symbol) -> String effects { state } {
    if symbol.interface_operation {
        return symbol.name;
    }
    if symbol.kind != 73 || symbol.method_span.end == 0 {
        return "";
    }
    var name = symbol.name;
    if symbol.template_index >= 0 {
        name = list_get(c.bound_functions, symbol.template_index).name;
    }
    let parts = split_text(name, 35);
    if list_len(parts) == 3 {
        return list_get(parts, 1) + "::" + list_get(parts, 2);
    }
    return "";
}
fn plan_rename(c: Context, offset: Int, name: String) -> List<PlanEdit> effects { state, io,
    process } {
    let edits = list_new<PlanEdit>();
    if !project_identifier(name) || keyword(name) || name == "_" || name == "result" || name
        == "main" {
        plan_reject(c, "Replacement must be a non-reserved identifier.");
    }
    let id = plan_symbol(c, offset);
    if !has_symbol(id) {
        plan_reject(c, "Position has no renameable symbol.");
    }
    let symbol = symbol_info(c, id);
    let span = query_symbol_span(c, symbol);
    if span.end == 0 || symbol.kind != 73 && symbol.kind != 61 || symbol.foreign_library != ""
        || symbol.name == "main" {
        plan_reject(c, "This symbol kind cannot be renamed.");
    }
    let original = str_slice(c.source_text, span.start, span.end);
    if original == name {
        return edits;
    }
    let declarations = dict_new<Int, Bool>();
    list_push(edits, PlanEdit(span: span, text: name));
    dict_set(declarations, span.start, true);
    let group = interface_rename_group(c, symbol);
    if group != "" {
        for candidate in c.symbols {
            if interface_rename_group(c, candidate) == group {
                let declaration = query_symbol_span(c, candidate);
                if declaration.end > 0 && !dict_has(declarations, declaration.start) {
                    list_push(edits, PlanEdit(span: declaration, text: name));
                    dict_set(declarations, declaration.start, true);
                }
            }
        }
    }
    if symbol.kind == 73 {
        // An uninstantiated body does not have checked references. Reject a
        // potential use there rather than return an incomplete rename.
        for i in 0 .. list_len(c.bound_functions) {
            let f = list_get(c.bound_functions, i);
            if list_len(f.type_parameters) == 0 {
                continue;
            }
            var instantiated = false;
            for instance in c.instances {
                if instance.syntax_index == i {
                    instantiated = true;
                    break;
                }
            }
            if instantiated {
                continue;
            }
            for j in f.span.start .. f.span.end - str_len(original) + 1 {
                if str_slice(c.source_text, j, j + str_len(original)) == original && (j
                    == f.span.start || !is_alpha(str_byte(c.source_text, j - 1)) && !is_digit(
                    str_byte(c.source_text, j - 1))) && (j + str_len(original) == f.span.end
                    || !is_alpha(str_byte(c.source_text, j + str_len(original))) && !is_digit(
                    str_byte(c.source_text, j + str_len(original)))) {
                    if !dict_has(declarations, j) {
                        plan_reject(c, "Potential reference in an uninstantiated generic body.");
                    }
                }
            }
        }
    }
    let seen = dict_new<Int, Bool>();
    for site in c.query_uses {
        let target = query_target(c, site);
        if target.end > 0 && dict_has(declarations, target.start) && !dict_has(seen,
            site.span.start) && !dict_has(declarations, site.span.start) {
            if str_slice(c.source_text, site.span.start, site.span.end) != original {
                plan_reject(c, "Inconsistent reference spelling.");
            }
            dict_set(seen, site.span.start, true);
            list_push(edits, PlanEdit(span: site.span, text: name));
        }
    }
    return edits;
}
fn plan_preview(p: Project, c: Context, overlays: List<QueryOverlay>, edits: List<PlanEdit>,
    rename: Bool) -> String effects { state, io, process } {
    let proposed = list_new<QueryOverlay>();
    let changes = strings_new();
    let edit_by_offset = dict_new<Int, Int>();
    for i in 0 .. list_len(edits) {
        dict_set(edit_by_offset, list_get(edits, i).span.start, i);
    }
    for unit in c.source_units {
        let parts = strings_new();
        let unit_edits = strings_new();
        var previous = unit.start;
        var pos = unit.start;
        while pos < unit.end {
            if dict_has(edit_by_offset, pos) {
                let edit = list_get(edits, dict_get(edit_by_offset, pos));
                strings_push(parts, str_slice(c.source_text, previous, pos));
                strings_push(parts, edit.text);
                strings_push(unit_edits,
                    f"{{\"range\":{query_range(c, edit.span):s},\"new_text\":{json_string(edit.text):s}}}");
                pos = edit.span.end;
                previous = pos;
            } else {
                pos = pos + 1;
            }
        }
        if strings_len(unit_edits) > 0 {
            strings_push(parts, str_slice(c.source_text, previous, unit.end));
            let revision = sha256(unit.code);
            strings_push(changes,
                f"{{\"path\":{json_string(unit.path):s},\"revision\":\"{revision:s}\",\"edits\":[{strings_join(unit_edits, ","):s}]}}");
            list_push(proposed, QueryOverlay(path: unit.path, code: strings_join(parts, "")));
        }
    }
    for overlay in overlays {
        list_push(proposed, overlay);
    }
    if list_len(edits) > 0 {
        let checked = query_open(p, proposed);
        if rename {
            let expected = plan_binding_graph(c, edits);
            let actual = plan_binding_graph(checked, list_new<PlanEdit>());
            if dict_len(expected) != dict_len(actual) {
                plan_reject(c, "Rename changes reference resolution.");
            }
            for site in checked.query_uses {
                if !has_symbol(site.symbol) {
                    continue;
                }
                let sym = symbol_info(checked, site.symbol);
                let target = query_symbol_span(checked, sym);
                var key = "";
                if target.end > 0 {
                    key = query_key(checked, target, query_symbol_kind(sym));
                } else if sym.builtin {
                    key = "builtin:" + sym.name;
                }
                let unit = list_get(checked.source_units, source_unit_at(checked, site.span.start));
                let item =
                    f"{source_unit_at(checked, site.span.start):d}:{site.span.start - unit.start:d}:{site.role:s}:{key:s}";
                if !dict_has(expected, item) {
                    plan_reject(c, "Rename changes reference resolution.");
                }
            }
        }
    }
    return f"{{\"schema_version\":1,\"ok\":true,\"revision\":\"{query_revision(c):s}\",\"scope\":{query_scope(p):s},\"diagnostics\":[],\"changes\":[{strings_join(changes, ","):s}]}}";
}
fn query_scope(p: Project) -> String effects { state } {
    return f"{{\"root\":\"entry\",\"excluded_test_roots\":{list_len(p.tests):d}}}";
}
fn query_page(p: Project, start: Int) -> Int effects { args, state, io, process } {
    if start + 1 >= arg_count() {
        source_error(
            "Usage: vela query ROOT --page LIMIT [--offset OFFSET --revision PAGE_REVISION]", true);
    }
    let limit = plan_integer(io_value(arg(start + 1)));
    var offset = 0;
    var expected = "";
    if arg_count() != start + 2 {
        if arg_count() != start + 6 || io_value(arg(start + 2)) != "--offset" || io_value(arg(start
            + 4)) != "--revision" {
            source_error("Invalid query continuation arguments.", true);
        }
        offset = plan_integer(io_value(arg(start + 3)));
        expected = io_value(arg(start + 5));
        if str_len(expected) != 64 {
            source_error("Invalid query continuation revision.", true);
        }
    }
    if limit < 1 || limit > 10000 || offset < 0 || offset > 2147483647 {
        source_error("Query limit must be 1..10000 and offset must be nonnegative.", true);
    }
    let c = query_open(p, list_new<QueryOverlay>());
    let revision = analysis_cache_key(c, p, "query-page-v1");
    if expected != "" && expected != revision {
        plan_reject(c, "Stale query continuation.");
    }
    print(query_json_at(c, -1, query_scope(p), offset, limit, revision));
    return 0;
}
fn query_command(command: String, input: String) -> Int effects { args, state, io, process } {
    let root = io_value(absolute_path(input));
    if command == "query" {
        var start = 2;
        if arg_count() > 2 && io_value(arg(2)) == "--json" {
            start = 3;
        }
        if start < arg_count() && io_value(arg(start)) == "--page" {
            let p = project_load(root, true);
            project_verify_lock(p, true);
            return query_page(p, start);
        }
        var at = false;
        var validate = false;
        var overlay_start = start;
        if start + 3 < arg_count() && io_value(arg(start)) == "--at" {
            at = true;
            overlay_start = start + 4;
        }
        if start < arg_count() && io_value(arg(start)) == "--validate" {
            validate = true;
            overlay_start = start + 1;
        }
        let overlays = query_overlay_args(overlay_start);
        let p = project_load_with(root, true, overlays, fn [ root, overlays ](code: String,
            message: String, text: String) -> Unit effects { state, io, process } {
            repair_project_reject(root, "", -1, overlays, code, message, text);
        });
        project_verify_lock(p, true);
        let c = query_open(p, overlays);
        if validate {
            print(
                f"{{\"schema_version\":1,\"ok\":true,\"revision\":\"{query_revision(c):s}\",\"diagnostics\":[]}}");
            return 0;
        }
        if at {
            let target = path_key(io_value(absolute_path(io_value(arg(start + 1)))));
            let line = plan_integer(io_value(arg(start + 2)));
            let character = plan_integer(io_value(arg(start + 3)));
            for unit in c.source_units {
                if path_key(unit.path) == target {
                    print(query_json_at(c, query_coordinate(c, unit, line, character), query_scope(
                        p), 0, 0, ""));
                    return 0;
                }
            }
            plan_reject(c, "Document is outside the analysis graph.");
        }
        print(query_json_at(c, -1, query_scope(p), 0, 0, ""));
        return 0;
    }
    if arg_count() < 5 {
        source_error("Usage: vela plan ROOT REVISION DOCUMENT fmt | diagnose | BYTE NEW_NAME",
            true);
    }
    let format = io_value(arg(4)) == "fmt";
    let diagnose = io_value(arg(4)) == "diagnose";
    var option_start = 5;
    if !format && !diagnose {
        if arg_count() < 6 {
            source_error("Rename requires NEW_NAME.", true);
        }
        option_start = 6;
    }
    let overlays = query_overlay_args(option_start);
    let expected = io_value(arg(2));
    let doc = plan_integer(io_value(arg(3)));
    var diagnostic_revision = "";
    if diagnose {
        if str_len(expected) != 64 {
            plan_reject(make_context("", root, true), "Invalid analysis revision.");
        }
        diagnostic_revision = expected;
    }
    let p = project_load_with(root, true, overlays, fn [ root, diagnostic_revision, doc, overlays ](
        code: String, message: String, text: String) -> Unit effects { state, io, process } {
        repair_project_reject(root, diagnostic_revision, doc, overlays, code, message, text);
    });
    project_verify_lock(p, true);
    let c = query_open_mode(p, overlays, diagnostic_revision, doc);
    if query_revision(c) != expected {
        plan_reject(c, "Stale analysis revision.");
    }
    if doc < 0 || doc >= list_len(c.source_units) {
        plan_reject(c, "Unknown document.");
    }
    if diagnose {
        print(
            f"{{\"schema_version\":1,\"ok\":true,\"revision\":\"{query_revision(c):s}\",\"documents\":{repair_documents(c):s},\"validated\":true,\"reason\":\"no_diagnostics\",\"diagnostics\":[],\"explanations\":[],\"changes\":[]}}");
        return 0;
    }
    let unit = list_get(c.source_units, doc);
    if format {
        let single = make_context(unit.code, unit.path, true);
        lex(single);
        parse_module(single);
        let formatted = format_source(single);
        let edits = list_new<PlanEdit>();
        if formatted != unit.code && unit.start < unit.end {
            list_push(edits, PlanEdit(span: Span(start: unit.start, end: unit.end),
                text: formatted));
        }
        print(plan_preview(p, c, overlays, edits, false));
        return 0;
    }
    let byte = plan_integer(io_value(arg(4)));
    if byte < 0 || byte >= str_len(unit.code) || str_byte(unit.code, byte) >= 128 && str_byte(
        unit.code, byte) < 192 {
        plan_reject(c, "Invalid byte position.");
    }
    print(plan_preview(p, c, overlays, plan_rename(c, unit.start + byte, io_value(arg(5))), true));
    return 0;
}
fn query_coordinate(c: Context, unit: SourceUnit, line: Int,
    character: Int) -> Int effects { state, io, process } {
    if line >= 0 && line < list_len(c.lines) - unit.line_base && character >= 0 {
        var offset = list_get(c.lines, unit.line_base + line);
        var column = 0;
        while offset <= unit.end {
            if column == character {
                return offset;
            }
            if offset == unit.end || str_byte(c.source_text, offset) == 10 {
                break;
            }
            let width = utf8_width(str_byte(c.source_text, offset));
            column = column + 1;
            if width == 4 {
                column = column + 1;
            }
            if column > character {
                break;
            }
            offset = offset + width;
        }
    }
    plan_reject(c, "Invalid UTF-16 position.");
    return -2;
}
fn query_revision(c: Context) -> String effects { state } {
    let revisions = strings_new();
    for unit in c.source_units {
        strings_push(revisions, sha256(unit.code));
    }
    // Fixed-width hashes in deterministic traversal order, independent of snapshot mount.
    return sha256(strings_join(revisions, ""));
}
fn query_enclosing_function(c: Context, offset: Int) -> Int effects { state } {
    var low = 0;
    var high = list_len(c.bound_functions);
    while low < high {
        let middle = (low + high) / 2;
        if list_get(c.bound_functions, middle).span.start <= offset {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low > 0 && offset < list_get(c.bound_functions, low - 1).span.end {
        return low - 1;
    }
    return -1;
}
fn query_type_site(c: Context, site: SyntaxName) -> TypeId effects { state, io, process } {
    let owner = source_unit_at(c, site.span.start);
    let enclosing = query_enclosing_function(c, site.span.start);
    if enclosing >= 0 {
        for parameter in list_get(c.bound_functions, enclosing).type_parameters {
            if parameter.name == site.name {
                return no_type();
            }
        }
    } else {
        for declaration in c.bound_types {
            if declaration.span.start <= site.span.start && site.span.start < declaration.span.end {
                for parameter in declaration.type_parameters {
                    if parameter.name == site.name {
                        return no_type();
                    }
                }
                break;
            }
        }
    }
    for i in 0 .. str_len(site.name) - 1 {
        if str_byte(site.name, i) == 58 && str_byte(site.name, i + 1) == 58 {
            let target = module_alias(c, str_slice(site.name, 0, i), site.span);
            if target < 0 {
                return no_type();
            }
            let found = module_declaration(c, target, str_slice(site.name, i + 2, str_len(
                site.name)));
            if found < 0 || !list_get(c.declarations, found).exported {
                return no_type();
            }
            return find_type(c, list_get(c.declarations, found).canonical);
        }
    }
    let own = module_declaration(c, owner, site.name);
    if own >= 0 {
        return find_type(c, list_get(c.declarations, own).canonical);
    }
    var imported = -1;
    for edge in c.imports {
        if edge.owner == owner && edge.alias == "" {
            let found = module_declaration(c, edge.target, site.name);
            if found >= 0 && list_get(c.declarations, found).exported {
                if imported >= 0 && imported != found {
                    return no_type();
                }
                imported = found;
            }
        }
    }
    if imported >= 0 {
        return find_type(c, list_get(c.declarations, imported).canonical);
    }
    return find_type(c, site.name);
}
fn query_site_key(c: Context, site: QueryUse) -> String effects { state, io, process } {
    if has_symbol(site.symbol) {
        let symbol = symbol_info(c, site.symbol);
        if symbol.builtin {
            return "builtin:" + symbol.name;
        }
        let span = query_symbol_span(c, symbol);
        if span.end != 0 {
            return query_key(c, span, query_symbol_kind(symbol));
        }
    } else if has_type(site.type_id) {
        let t = query_type_template(c, site.type_id);
        let span = query_decl_span(c, t.span, t.name);
        if span.end != 0 {
            return query_key(c, span, "type");
        }
    }
    return "";
}
fn query_page_row(index: Int, first: Int, limit: Int) -> Bool {
    return limit == 0 || (index >= first && index - first < limit);
}
fn query_json_at(c: Context, offset: Int, scope: String, first: Int, limit: Int,
    continuation_revision: String) -> String effects { state, io, process } {
    let documents = strings_new();
    let definitions = strings_new();
    let references = strings_new();
    let imports = strings_new();
    let seen = dict_new<String, Bool>();
    let targets = dict_new<String, Bool>();
    var row = 0;
    for site in c.query_types {
        record_query_use(c, site.span, no_symbol(), query_type_site(c, site), "type");
    }
    if offset >= 0 {
        for site in c.query_uses {
            if site.span.start <= offset && offset < site.span.end {
                dict_set(targets, query_site_key(c, site), true);
            }
        }
        let symbol = plan_symbol(c, offset);
        if has_symbol(symbol) {
            let sym = symbol_info(c, symbol);
            let span = query_symbol_span(c, sym);
            if span.end != 0 {
                dict_set(targets, query_key(c, span, query_symbol_kind(sym)), true);
            }
        }
        for d in c.declarations {
            if d.span.start <= offset && offset < d.span.end && has_type(find_type(c,
                d.canonical)) {
                dict_set(targets, query_key(c, d.span, "type"), true);
            }
        }
    }
    for i in 0 .. list_len(c.source_units) {
        let unit = list_get(c.source_units, i);
        strings_push(documents,
            f"{{\"id\":{i:d},\"path\":{json_string(unit.path):s},\"revision\":\"{sha256(unit.code):s}\"}}");
    }
    for d in c.declarations {
        let id = find_type(c, d.canonical);
        if has_type(id) {
            let key = query_key(c, d.span, "type");
            if offset >= 0 && !dict_has(targets, key) {
                continue;
            }
            let include = query_page_row(row, first, limit);
            row = row + 1;
            if !include {
                continue;
            }
            var opacity = "";
            if type_info(c, id).opaque {
                opacity = "\"opaque\":true,";
            }
            strings_push(definitions,
                f"{{{opacity:s}\"id\":\"{key:s}\",\"name\":{json_string(d.name):s},\"kind\":\"type\",\"type\":{json_string(d.name):s},\"effects\":[],\"range\":{query_range(c, d.span):s}}}");
        }
    }
    for symbol in c.symbols {
        let span = query_symbol_span(c, symbol);
        if span.end == 0 {
            continue;
        }
        let kind = query_symbol_kind(symbol);
        let key = query_key(c, span, kind);
        if offset >= 0 && !dict_has(targets, key) {
            continue;
        }
        if dict_has(seen, key) {
            continue;
        }
        dict_set(seen, key, true);
        let include = query_page_row(row, first, limit);
        row = row + 1;
        if !include {
            continue;
        }
        let name = str_slice(c.source_text, span.start, span.end);
        var visibility = "";
        if symbol.kind == 72 && has_type(symbol.owner) && type_info(c, symbol.owner).opaque {
            visibility = "\"visibility\":\"module\",";
        }
        if symbol.method_span.end > 0 {
            visibility = "\"method\":true,";
            if !symbol.method_exported {
                visibility = visibility + "\"visibility\":\"module\",";
            }
        }
        if symbol.kind == 73 && symbol.foreign_library == "" && !symbol.interface_operation {
            var status = "checked_body";
            if symbol.template_index >= 0 {
                status = "deferred";
                if symbol.constraints_checked {
                    status = "checked_constraints";
                }
            }
            visibility = visibility + "\"analysis_status\":" + json_string(status) + ",";
        }
        strings_push(definitions,
            f"{{{visibility:s}\"id\":\"{key:s}\",\"name\":{json_string(name):s},\"kind\":\"{kind:s}\",\"type\":{json_string(query_type_name(c, symbol.type_id)):s},\"effects\":{effect_json(symbol.effect_mask):s},\"range\":{query_range(c, span):s}}}");
    }
    for site in c.query_uses {
        let key = query_site_key(c, site);
        if offset >= 0 && (key == "" && !(site.span.start <= offset && offset < site.span.end)
            || key != "" && !dict_has(targets, key)) {
            continue;
        }
        var effect_mask = 0;
        var analysis = "";
        if has_symbol(site.symbol) {
            let symbol = symbol_info(c, site.symbol);
            effect_mask = symbol.effect_mask;
            if site.role == "call" && symbol.kind == 73 && !symbol.builtin
                && !symbol.interface_operation && symbol.foreign_library == "" {
                analysis = "\"analysis_status\":\"checked_body\",";
                if symbol.template_index >= 0 {
                    analysis = "\"analysis_status\":\"checked_instance\",";
                }
            }
        }
        var caller = "";
        if site.role == "call" {
            let enclosing = query_enclosing_function(c, site.span.start);
            if enclosing >= 0 {
                let f = list_get(c.bound_functions, enclosing);
                var span = query_decl_span(c, f.span, f.name);
                if f.impl_index >= 0 {
                    span = f.name_span;
                }
                if span.end != 0 {
                    caller = query_key(c, span, "function");
                }
            }
        }
        let value =
            f"{{{analysis:s}\"id\":{json_string(key):s},\"caller\":{json_string(caller):s},\"role\":\"{site.role:s}\",\"type\":{json_string(query_type_name(c, site.type_id)):s},\"effects\":{effect_json(effect_mask):s},\"range\":{query_range(c, site.span):s}}}";
        if !dict_has(seen, value) {
            dict_set(seen, value, true);
            if query_page_row(row, first, limit) {
                strings_push(references, value);
            }
            row = row + 1;
        }
    }
    for edge in c.imports {
        if query_page_row(row, first, limit) {
            strings_push(imports,
                f"{{\"from\":{edge.owner:d},\"to\":{edge.target:d},\"alias\":{json_string(edge.alias):s},\"range\":{query_range(c, edge.span):s}}}");
        }
        row = row + 1;
    }
    var page = "";
    if limit > 0 {
        if first > row {
            plan_reject(c, "Query continuation offset is out of range.");
        }
        var next = "null";
        if first + limit < row {
            next = to_string(first + limit);
        }
        page =
            f",\"page\":{{\"revision\":\"{continuation_revision:s}\",\"offset\":{first:d},\"total\":{row:d},\"next_offset\":{next:s}}}";
    }
    return f"{{\"schema_version\":1,\"ok\":true,\"revision\":\"{query_revision(c):s}\",\"scope\":{scope:s},\"diagnostics\":[],\"documents\":[{strings_join(documents, ","):s}],\"definitions\":[{strings_join(definitions, ","):s}],\"references\":[{strings_join(references, ","):s}],\"imports\":[{strings_join(imports, ","):s}]{page:s}}}";
}


// Diagnostic rendering and one-edit candidates. No invalid checked IR is emitted.
fn repair_documents(c: Context) -> String effects { state } {
    let parts = strings_new();
    for i in 0 .. list_len(c.source_units) {
        let unit = list_get(c.source_units, i);
        strings_push(parts,
            f"{{\"id\":{i:d},\"path\":{json_string(unit.path):s},\"revision\":\"{sha256(unit.code):s}\"}}");
    }
    return "[" + strings_join(parts, ",") + "]";
}
fn repair_validate(c: Context, revision: String, document: Int) -> Unit effects { state, io,
    process } {
    if query_revision(c) != revision {
        plan_reject(c, "Stale analysis revision.");
    }
    if document < 0 || document >= list_len(c.source_units) {
        plan_reject(c, "Unknown document.");
    }
}
fn repair_project_reject(root: String, revision: String, document: Int,
    overlays: List<QueryOverlay>, code: String, message: String,
    text: String) -> Unit effects { state, io, process } {
    var c = repair_project_error_context(text, root, true);
    if revision != "" {
        if str_len(text) > 1048576 {
            plan_reject(c, "Manifest exceeds the diagnostic-plan byte budget.");
        }
        repair_validate(c, revision, document);
        c.repair_mode = true;
        c.repair_root = root;
        c.repair_document = document;
        c.repair_overlays = overlays;
    }
    bad(c, code, message, repair_project_span(c, message));
}
fn repair_project_error_context(text: String, path: String,
    json_mode: Bool) -> Context effects { state } {
    if str_len(text) > 1048576 {
        return make_context("", path, json_mode);
    }
    return make_context(text, path, json_mode);
}
fn repair_alias(c: Context, code: String, message: String, span: Span) -> String effects { state,
    io, process } {
    if code == "E222" && repair_prefix(message, "Unknown module alias: ") {
        return str_slice(message, str_len("Unknown module alias: "), str_len(message));
    }
    // Unknown enum means the qualifier already resolved to a non-enum type.
    // An import must not reinterpret that known type as a module namespace.
    if code == "E200" && repair_prefix(message, "Unknown type: ") {
        for expression in c.syntax_exprs {
            if expression.kind == 7 && expression.span.start == span.start && expression.span.end
                == span.end {
                let target = ast_expr(c, expression.left);
                if project_identifier(target.qualifier) {
                    return target.qualifier;
                }
            }
        }
    }
    return "";
}
fn repair_explanation(c: Context, code: String, message: String, span: Span,
    details: DiagnosticDetails) -> String effects { state, io, process } {
    var category = "general";
    var expected = details.expected_type;
    var actual = details.actual_type;
    var guidance = "Inspect the original diagnostic and related source positions.";
    if code == "E201" {
        category = "types";
        guidance =
            "Choose whether the value or its declared type is wrong. No implicit cast or literal replacement is proposed.";
    }
    if code == "E209" {
        category = "effects";
        expected = effect_json(details.required_effects);
        actual = effect_json(details.allowed_effects);
        guidance =
            "The call requires the listed effects. Only private ordinary root main may receive args/io/state; public, callable, async and process expansion need an explicit edit.";
    }
    if code == "E222" || repair_alias(c, code, message, span) != "" {
        category = "imports";
        guidance =
            "The qualifier must name a declared type or explicit import. A unique checked sibling or installed module can be proposed; bare names, conflicting aliases and ambiguous files are not guessed.";
    }
    if code == "E225" {
        category = "project";
        expected =
            "vela-project|1; name|identifier; entry|relative path; dep|alias|path; native/resource/test fields";
        actual = message;
        if repair_prefix(message, "Invalid project name.") {
            expected = "ASCII identifier";
            actual = str_slice(c.source_text, span.start, span.end);
        } else if repair_prefix(message, "Unknown, duplicate or malformed manifest field: ")
            && span.end > span.start {
            expected = "name, entry, dep, native, resource or test";
            actual = str_slice(c.source_text, span.start, span.end);
        }
        guidance =
            "Project names use ASCII identifiers. Review a deterministic name normalization or a unique one-character field spelling; dependency locks are never updated by a plan.";
    }
    return f"{{\"category\":{json_string(category):s},\"root_cause\":{json_string(message):s},\"expected\":{json_string(expected):s},\"actual\":{json_string(actual):s},\"guidance\":{json_string(guidance):s}}}";
}
fn repair_diagnostic(c: Context, code: String, message: String, span: Span,
    details: DiagnosticDetails) -> String effects { state, io, process } {
    let related = strings_new();
    for item in details.related {
        strings_push(related,
            f"{{\"message\":{json_string(item.message):s},\"source\":{json_string(filename_at(c,item.span.start)):s},\"span\":{span_json(c,item.span):s},\"range\":{query_range(c,item.span):s}}}");
    }
    return f"{{\"severity\":\"error\",\"code\":{json_string(code):s},\"message\":{json_string(message):s},\"source\":{json_string(filename_at(c,span.start)):s},\"span\":{span_json(c,span):s},\"range\":{query_range(c,span):s},\"notes\":[],\"details\":{details_json(details):s},\"related\":[{strings_join(related,","):s}],\"explanation\":{repair_explanation(c,code,message,span,details):s}}}";
}
fn repair_project_span(c: Context, message: String) -> Span effects { state } {
    var position = 0;
    for line in project_split(c.source_text, 10) {
        if repair_prefix(message, "Invalid project name.") && repair_prefix(line, "name|") {
            return Span(start: position + 5, end: position + str_len(line));
        }
        let prefix = "Unknown, duplicate or malformed manifest field: ";
        if repair_prefix(message, prefix) {
            let key = str_slice(message, str_len(prefix), str_len(message));
            if key != "name" && key != "entry" && key != "dep" && key != "native" && key
                != "resource" && key != "test" && repair_prefix(line, key + "|") {
                return Span(start: position, end: position + str_len(key));
            }
        }
        position = position + str_len(line) + 1;
    }
    return empty_span();
}
fn repair_one_character(a: String, b: String) -> Bool {
    let n = str_len(a);
    let m = str_len(b);
    if n > m + 1 || m > n + 1 || a == b {
        return false;
    }
    var i = 0;
    while i < n && i < m && str_byte(a, i) == str_byte(b, i) {
        i = i + 1;
    }
    if n == m {
        return str_slice(a, i + 1, n) == str_slice(b, i + 1, m) || i + 1 < n && str_byte(a, i)
            == str_byte(b, i + 1) && str_byte(a, i + 1) == str_byte(b, i) && str_slice(a, i + 2, n)
            == str_slice(b, i + 2, m);
    }
    if n < m {
        return str_slice(a, i, n) == str_slice(b, i + 1, m);
    }
    return str_slice(a, i + 1, n) == str_slice(b, i, m);
}
fn repair_candidate(c: Context, code: String, message: String, span: Span,
    details: DiagnosticDetails) -> List<PlanEdit> effects { state, io, process } {
    let edits = list_new<PlanEdit>();
    let owner = source_unit_at(c, span.start);
    let unit = list_get(c.source_units, owner);
    if code == "E225" && project_is_manifest(unit.path) && span.end >= span.start {
        let current = str_slice(c.source_text, span.start, span.end);
        if repair_prefix(message, "Invalid project name.") {
            list_push(edits, PlanEdit(span: span, text: project_suggest_name(current)));
            return edits;
        }
        if repair_prefix(message, "Unknown, duplicate or malformed manifest field: ") {
            var replacement = "";
            var matches = 0;
            for key in project_split("name|entry|dep|native|resource|test", 124) {
                if repair_one_character(current, key) {
                    replacement = key;
                    matches = matches + 1;
                }
            }
            if matches == 1 {
                list_push(edits, PlanEdit(span: span, text: replacement));
            }
        }
        return edits;
    }
    let alias = repair_alias(c, code, message, span);
    if alias != "" {
        if !project_identifier(alias) {
            return edits;
        }
        let candidates = list_new<String>();
        for relative in project_split(alias + ".vela|vela-stdlib/" + alias + ".vela", 124) {
            let path = io_value(absolute_path(parent_path(unit.path) + "/" + relative));
            if source_inside_boundary(path) {
                match query_source_text(path, c.repair_overlays) {
                    Result::Ok(_) => {
                        list_push(candidates, relative);
                    }
                    Result::Err(_) => {}
                }
            }
        }
        if list_len(candidates) == 1 && str_len(unit.code) > 0 {
            let width = utf8_width(str_byte(unit.code, 0));
            let first = str_slice(unit.code, 0, width);
            list_push(edits, PlanEdit(span: Span(start: unit.start, end: unit.start + width),
                text: "import " + json_string(list_get(candidates, 0)) + " as " + alias + ";\n"
                + first));
        }
        return edits;
    }
    if code == "E209" && details.missing_effects > 0 && details.missing_effects < 8
        && details.effect_parameter == "" && owner == 0 {
        let index = query_enclosing_function(c, span.start);
        if index < 0 {
            return edits;
        }
        let fnc = list_get(c.bound_functions, index);
        if fnc.name != "main" || fnc.suspending || fnc.foreign_library != "" || fnc.test_name != ""
            || list_len(fnc.parameters) != 0 || list_len(fnc.type_parameters) != 0
            || fnc.return_name != "Int" && fnc.return_name != "Unit" {
            return edits;
        }
        for declaration in c.declarations {
            if declaration.canonical == fnc.name && declaration.exported {
                return edits;
            }
        }
        var mask = fnc.effect_mask;
        for bit in project_split("1|2|4", 124) {
            let value = plan_integer(bit);
            if details.missing_effects / value % 2 == 1 && mask / value % 2 == 0 {
                mask = mask + value;
            }
        }
        var lexical = c;
        lexical.tokens = list_new<Token>();
        lexical.comments = list_new<Token>();
        lex_range(lexical, unit.start, unit.end);
        let names = effect_names(mask);
        let text = "effects {" + strings_join(names, ", ") + "}";
        var i = 0;
        while i < list_len(lexical.tokens) {
            let token = list_get(lexical.tokens, i);
            if token.span.start > fnc.name_span.end && token.span.start < fnc.span.end {
                if token.text == "requires" || token.text == "ensures" {
                    return edits;
                }
                if token.text == "effects" {
                    let start = token.span.start;
                    i = i + 1;
                    while i < list_len(lexical.tokens) && list_get(lexical.tokens, i).text != "}" {
                        i = i + 1;
                    }
                    if i < list_len(lexical.tokens) {
                        list_push(edits, PlanEdit(span: Span(start: start, end: list_get(
                            lexical.tokens, i).span.end), text: text));
                    }
                    return edits;
                }
                if token.text == "{" {
                    list_push(edits, PlanEdit(span: token.span, text: text + " {"));
                    return edits;
                }
            }
            i = i + 1;
        }
    }
    return edits;
}
fn repair_recheck(c: Context, edit: PlanEdit) -> Bool effects { state, io, process } {
    let directory_result = temp_dir("");
    var directory = "";
    match directory_result {
        StringResult::Ok(value) => {
            directory = value;
        }
        StringResult::Err(_) => {
            return false;
        }
    }
    let files = list_new<String>();
    let overlays = list_new<QueryOverlay>();
    let unit = list_get(c.source_units, source_unit_at(c, edit.span.start));
    let text = str_slice(unit.code, 0, edit.span.start - unit.start) + edit.text + str_slice(
        unit.code, edit.span.end - unit.start, str_len(unit.code));
    list_push(overlays, QueryOverlay(path: unit.path, code: text));
    for overlay in c.repair_overlays {
        if path_key(overlay.path) != path_key(unit.path) {
            list_push(overlays, overlay);
        }
    }
    var ok = list_len(overlays) <= 32;
    let args = strings_new();
    match executable_path() {
        StringResult::Ok(exe) => {
            strings_push(args, exe);
        }
        StringResult::Err(_) => {
            ok = false;
        }
    }
    strings_push(args, "query");
    strings_push(args, c.repair_root);
    strings_push(args, "--validate");
    var i = 0;
    for overlay in overlays {
        let file = directory + "/overlay-" + to_string(i);
        list_push(files, file);
        match write_file(file, overlay.code) {
            WriteResult::Ok => {}
            WriteResult::Err(_) => {
                ok = false;
            }
        }
        strings_push(args, "--overlay");
        strings_push(args, overlay.path);
        strings_push(args, file);
        i = i + 1;
    }
    let output = directory + "/stdout";
    let errors = directory + "/stderr";
    if ok {
        list_push(files, output);
        list_push(files, errors);
        ok = process_run_files(args, output, errors, 15000) == 0;
    }
    for file in files {
        match remove_file(file) {
            WriteResult::Ok => {}
            WriteResult::Err(_) => {
                ok = false;
            }
        }
    }
    match remove_dir(directory) {
        WriteResult::Ok => {}
        WriteResult::Err(_) => {
            ok = false;
        }
    }
    return ok;
}
fn repair_plan(c: Context, code: String, message: String, span: Span,
    details: DiagnosticDetails) -> String effects { state, io, process } {
    let original = repair_diagnostic(c, code, message, span, details);
    let explanations = "[" + repair_explanation(c, code, message, span, details) + "]";
    let revision = query_revision(c);
    if c.repair_document != source_unit_at(c, span.start) {
        var rejected = c;
        rejected.repair_mode = false;
        plan_reject(rejected, "First diagnostic is in a different document.");
    }
    let edits = repair_candidate(c, code, message, span, details);
    var changes = "[]";
    var validated = false;
    var reason = "explanation_only";
    if list_len(edits) == 1 {
        let edit = list_get(edits, 0);
        if repair_recheck(c, edit) {
            validated = true;
            reason = "checked_preview";
            let unit = list_get(c.source_units, source_unit_at(c, edit.span.start));
            changes =
                f"[{{\"path\":{json_string(unit.path):s},\"revision\":\"{sha256(unit.code):s}\",\"edits\":[{{\"range\":{query_range(c,edit.span):s},\"new_text\":{json_string(edit.text):s}}}]}}]";
        } else {
            reason = "preview_rejected_or_cleanup_failed";
        }
    }
    return f"{{\"schema_version\":1,\"ok\":true,\"revision\":\"{revision:s}\",\"documents\":{repair_documents(c):s},\"validated\":{validated:b},\"reason\":{json_string(reason):s},\"diagnostics\":[{original:s}],\"explanations\":{explanations:s},\"changes\":{changes:s}}}";
}
fn repair_prefix(value: String, prefix: String) -> Bool {
    return str_len(value) >= str_len(prefix) && str_slice(value, 0, str_len(prefix)) == prefix;
}


// This is a frontend interface serializer, never a source-consuming backend.
fn compiler_version() -> String {
    return "1.2.0";
}
fn api_public(c: Context, owner: Int, name: String) -> Bool effects { state } {
    for declaration in c.declarations {
        if declaration.owner == owner && declaration.name == name {
            return declaration.exported;
        }
    }
    return false;
}
fn api_parameters(parameters: List<TypeParameter>) -> String effects { state } {
    let out = strings_new();
    for parameter in parameters {
        var item = parameter.name;
        if parameter.bound == "$effect" {
            item = "effect " + item;
        } else if parameter.bound != "" && parameter.bound != "Any" {
            item = item + ":" + parameter.bound;
        }
        strings_push(out, item);
    }
    if strings_len(out) == 0 {
        return "";
    }
    return "<" + strings_join(out, ",") + ">";
}
fn api_effects(pattern: String) -> String effects { state } {
    let terms = split_text(pattern, 43);
    let mask = match parse_int(list_get(terms, 0)) {
        IntResult::Ok(value) => value,
        IntResult::Err(_) => 0
    };
    let names = effect_names(mask % 16);
    for i in 1 .. list_len(terms) {
        strings_push(names, list_get(terms, i));
    }
    if strings_len(names) == 0 {
        return "";
    }
    return " effects {" + strings_join(names, ",") + "}";
}
fn api_type(name: String) -> String effects { state } {
    let parts = type_parts(name);
    let base = list_get(parts, 0);
    if str_len(base) >= 4 && str_slice(base, 0, 4) == "@fn:" {
        let parameters = strings_new();
        for i in 2 .. list_len(parts) {
            strings_push(parameters, api_type(list_get(parts, i)));
        }
        let pattern = str_slice(base, 4, str_len(base));
        let bits = match parse_int(list_get(split_text(pattern, 43), 0)) {
            IntResult::Ok(value) => value,
            IntResult::Err(_) => 0
        };
        var prefix = "fn(";
        if bits >= 16 {
            prefix = "async fn(";
        }
        return prefix + strings_join(parameters, ",") + ")->" + api_type(list_get(parts, 1))
            + api_effects(pattern);
    }
    if str_len(base) >= 5 && str_slice(base, 0, 5) == "@dyn:" {
        return "dyn " + str_slice(base, 5, str_len(base));
    }
    if list_len(parts) == 1 {
        return base;
    }
    let parameters = strings_new();
    for i in 1 .. list_len(parts) {
        strings_push(parameters, api_type(list_get(parts, i)));
    }
    return base + "<" + strings_join(parameters, ",") + ">";
}
fn api_interface(c: Context) -> String effects { state, io, process } {
    let items = strings_new();
    for declaration in c.syntax_types {
        let owner = source_unit_at(c, declaration.span.start);
        if owner == 0 && api_public(c, owner, declaration.name) {
            var kind = "enum";
            var opacity = "false";
            if declaration.opaque {
                opacity = "true";
            }
            if declaration.kind == 76 {
                kind = "struct";
            }
            if declaration.kind == 77 {
                kind = "distinct";
            }
            let fields = strings_new();
            if !declaration.opaque {
                for field in declaration.fields {
                    strings_push(fields, json_string(field.name + ":" + api_type(
                        field.annotation)));
                }
            }
            let variants = strings_new();
            for variant in declaration.variants {
                let payloads = strings_new();
                for field in variant.fields {
                    strings_push(payloads, api_type(field));
                }
                strings_push(variants, json_string(variant.name + "(" + strings_join(payloads, ",")
                    + ")"));
            }
            strings_push(items, "{\"name\":" + json_string(declaration.name) + ",\"kind\":"
                + json_string(kind) + ",\"signature\":" + json_string(kind + " " + declaration.name
                + api_parameters(declaration.type_parameters)) + ",\"base\":" + json_string(
                api_type(declaration.base)) + ",\"opaque\":" + opacity + ",\"fields\":["
                + strings_join(fields, ",") + "],\"variants\":[" + strings_join(variants, ",")
                + "],\"effects\":[],\"span\":" + span_json(c, declaration.span) + "}");
        }
    }
    for declaration in c.syntax_interfaces {
        let owner = source_unit_at(c, declaration.span.start);
        if owner == 0 && api_public(c, owner, declaration.name) {
            strings_push(items, "{\"name\":" + json_string(declaration.name)
                + ",\"kind\":\"interface\",\"signature\":" + json_string("interface "
                + declaration.name) + ",\"effects\":[]}");
            for operation in declaration.operations {
                let parameters = strings_new();
                for parameter in operation.parameters {
                    strings_push(parameters, parameter.name + ":" + api_type(parameter.annotation));
                }
                let name = declaration.name + "::" + operation.name;
                strings_push(items, "{\"name\":" + json_string(name)
                    + ",\"kind\":\"operation\",\"signature\":" + json_string("fn " + name + "("
                    + strings_join(parameters, ",") + ")->" + api_type(operation.return_name)
                    + api_effects(to_string(operation.effect_mask))) + ",\"effects\":"
                    + effect_json(operation.effect_mask) + ",\"span\":" + span_json(c,
                    operation.span) + "}");
            }
        }
    }
    for declaration in c.syntax_functions {
        let owner = source_unit_at(c, declaration.span.start);
        var visible = owner == 0 && declaration.test_name == "";
        var name = declaration.name;
        if declaration.impl_index < 0 {
            visible = visible && api_public(c, owner, name);
        } else {
            let implementation = list_get(c.syntax_impls, declaration.impl_index);
            let type_name = list_get(type_parts(implementation.owner), 0);
            visible = visible && declaration.method_exported && api_public(c, owner, type_name);
            name = implementation.owner + "::" + name;
        }
        if visible {
            var prefix = "fn ";
            if declaration.suspending {
                prefix = "async fn ";
            }
            let parameters = strings_new();
            for parameter in declaration.parameters {
                strings_push(parameters, parameter.name + ":" + api_type(parameter.annotation));
            }
            strings_push(items, "{\"name\":" + json_string(name)
                + ",\"kind\":\"function\",\"signature\":" + json_string(prefix + name
                + api_parameters(declaration.type_parameters) + "(" + strings_join(parameters, ",")
                + ")->" + api_type(declaration.return_name) + api_effects(
                declaration.effect_pattern)) + ",\"effects\":" + effect_json(
                declaration.effect_mask) + ",\"effect_parameters\":" + json_string(
                declaration.effect_pattern) + ",\"span\":" + span_json(c, declaration.span) + "}");
        }
    }
    return "{\"schema_version\":1,\"version\":" + json_string(compiler_version()) + ",\"items\":["
        + strings_join(items, ",") + "]}";
}
fn api_builtins() -> String effects { state } {
    let items = strings_new();
    for line in split_text(builtin_source(), 10) {
        if str_len(line) > 0 && str_byte(line, 0) != 35 {
            let row = split_text(line, 124);
            if list_len(row) == 8 {
                let parameters = strings_new();
                for parameter in split_text(list_get(row, 3), 59) {
                    if parameter != "" {
                        strings_push(parameters, api_type(parameter));
                    }
                }
                var variables = "";
                if list_get(row, 2) != "" {
                    let names = strings_new();
                    for name in split_text(list_get(row, 2), 59) {
                        strings_push(names, name);
                    }
                    variables = "<" + strings_join(names, ",") + ">";
                }
                var signature = "fn " + list_get(row, 1) + variables + "(" + strings_join(
                    parameters, ",") + ")->" + api_type(list_get(row, 4));
                if list_get(row, 0) == "enum" {
                    signature = "enum " + list_get(row, 1) + variables;
                }
                strings_push(items, "{\"name\":" + json_string(list_get(row, 1)) + ",\"kind\":"
                    + json_string(list_get(row, 0)) + ",\"signature\":" + json_string(signature)
                    + ",\"effect_parameters\":" + json_string(list_get(row, 5)) + ",\"since\":"
                    + json_string(list_get(row, 7)) + "}");
            }
        }
    }
    return "{\"schema_version\":1,\"version\":" + json_string(compiler_version()) + ",\"items\":["
        + strings_join(items, ",") + "]}";
}


fn scaffold_path(value: StringResult, target: String, json_mode: Bool) -> String effects { state,
    io, process } {
    match value {
        StringResult::Ok(path) => {
            return path;
        }
        StringResult::Err(cause) => {
            project_fail(target, "E900", cause, json_mode);
            return "";
        }
    }
}
fn scaffold_cleanup(stage: String, names: List<String>) -> Bool effects { state, io } {
    var clean = true;
    for name in names {
        match remove_file(stage + "/" + name) {
            WriteResult::Ok => {}
            WriteResult::Err(_) => {
                clean = false;
            }
        }
    }
    match remove_dir(stage) {
        WriteResult::Ok => {}
        WriteResult::Err(_) => {
            clean = false;
        }
    }
    return clean;
}
fn scaffold_error(stage: String, names: List<String>, target: String, message: String,
    json_mode: Bool) -> Unit effects { state, io, process } {
    var details = message;
    if !scaffold_cleanup(stage, names) {
        details = details + " Staging cleanup incomplete: " + stage;
    }
    project_fail(target, "E900", details, json_mode);
}
fn scaffold_command(input: String) -> Int effects { args, state, io, process } {
    if input == "--help" {
        var json = false;
        for index in 2 .. arg_count() {
            if io_value(arg(index)) != "--json" || json {
                project_fail(input, "E225", "init help accepts only one --json.", false);
            }
            json = true;
        }
        let help = "Usage: vela init NEW_DIRECTORY [--name NAME] [--kind cli|library] [--json]";
        if json {
            print("{\"schema_version\":1,\"ok\":true,\"help\":" + json_string(help) + "}");
        } else {
            print(help);
        }
        return 0;
    }
    var json_mode = false;
    for i in 2 .. arg_count() {
        if io_value(arg(i)) == "--json" {
            json_mode = true;
        }
    }
    var name = "";
    var kind = "cli";
    var has_name = false;
    var has_kind = false;
    var has_json = false;
    var i = 2;
    while i < arg_count() {
        let option = io_value(arg(i));
        if option == "--json" && !has_json {
            has_json = true;
        } else if (option == "--name" && !has_name || option == "--kind" && !has_kind) && i + 1
            < arg_count() {
            i = i + 1;
            let value = io_value(arg(i));
            if option == "--name" {
                name = value;
                has_name = true;
            } else {
                kind = value;
                has_kind = true;
            }
        } else {
            project_fail(input, "E225", "Unknown/repeated option or missing value: " + option,
                json_mode);
        }
        i = i + 1;
    }
    if input == "" {
        project_fail(input, "E225", "init requires a new directory.", json_mode);
    }
    if kind != "cli" && kind != "library" {
        project_fail(input, "E225", "Project kind must be cli or library.", json_mode);
    }
    var target = scaffold_path(absolute_path(input), input, json_mode);
    while str_len(target) > 1 && (str_byte(target, str_len(target) - 1) == 47 || str_byte(target,
        str_len(target) - 1) == 92) {
        target = str_slice(target, 0, str_len(target) - 1);
    }
    let parent = parent_path(target);
    if !has_name {
        name = project_suggest_name(str_slice(target, str_len(parent), str_len(target)));
    }
    if !project_identifier(name) {
        project_fail(target, "E225", "Invalid project name. Suggested name: "
            + project_suggest_name(name), json_mode);
    }
    if scaffold_path(file_identity(target), target, json_mode) != "" {
        project_fail(target, "E225", "Destination already exists; choose a new directory.",
            json_mode);
    }
    let names = list_new<String>();
    let contents = list_new<String>();
    list_push(names, "vela.project");
    list_push(contents, "vela-project|1\nname|" + name + "\nentry|main.vela\ntest|tests.vela\n");
    list_push(names, "main.vela");
    var main = "pub fn answer() -> Int {\n    return 42;\n}\n";
    var test_import = "main.vela";
    if kind == "library" {
        main = "import \"lib.vela\";\n";
        test_import = "lib.vela";
    }
    list_push(contents, main + "fn main() -> Unit effects { io } {\n    print(answer());\n}\n");
    list_push(names, "tests.vela");
    list_push(contents, "import \"" + test_import
        + "\";\ntest \"answer is 42\" {\n    assert_true(answer() == 42, \"answer\");\n}\n");
    list_push(names, "README.md");
    list_push(contents, "# " + name
        + "\n\nvela check vela.project\nvela build vela.project -o app.exe\nvela test vela.project --json\nvela run vela.project\n\n"
        + "A source-module " + kind + " example; expected stdout: 42.\n");
    if kind == "library" {
        list_push(names, "lib.vela");
        list_push(contents, "pub fn answer() -> Int {\n    return 42;\n}\n");
    }
    let stage = scaffold_path(temp_dir(parent), target, json_mode);
    let written = list_new<String>();
    for j in 0 .. list_len(names) {
        let file = list_get(names, j);
        list_push(written, file);
        match write_file(stage + "/" + file, list_get(contents, j)) {
            WriteResult::Ok => {}
            WriteResult::Err(cause) => {
                scaffold_error(stage, written, target, cause, json_mode);
            }
        }
    }
    let p = project_load(stage + "/vela.project", json_mode);
    list_push(written, "vela.project.lock");
    match write_file(stage + "/vela.project.lock", project_lock_text(p, json_mode)) {
        WriteResult::Ok => {}
        WriteResult::Err(cause) => {
            scaffold_error(stage, written, target, cause, json_mode);
        }
    }
    match install_file(stage, target) {
        WriteResult::Ok => {}
        WriteResult::Err(cause) => {
            match file_identity(target) {
                StringResult::Ok(identity) => {
                    if identity != "" {
                        let clean = scaffold_cleanup(stage, written);
                        if clean {
                            project_fail(target, "E225",
                                "Destination already exists; choose a new directory.", json_mode);
                        }
                        project_fail(target, "E900",
                            "Destination exists and staging cleanup failed: " + stage, json_mode);
                    }
                }
                StringResult::Err(_) => {}
            }
            scaffold_error(stage, written, target, cause, json_mode);
        }
    }
    if json_mode {
        let files = strings_new();
        for file in written {
            strings_push(files, json_string(file));
        }
        print("{\"schema_version\":1,\"ok\":true,\"command\":\"init\",\"kind\":" + json_string(kind)
            + ",\"name\":" + json_string(name) + ",\"directory\":" + json_string(target)
            + ",\"manifest\":" + json_string(target + "/vela.project") + ",\"files\":["
            + strings_join(files, ",") + "],\"diagnostics\":[]}");
    } else {
        print("Created " + kind + " project: " + target + "/vela.project");
    }
    return 0;
}


fn io_value(r: StringResult) -> String effects { io, process } {
    return io_result(from_string(r), "");
}
fn io_done(r: WriteResult) -> Unit effects { io, process } {
    let success = io_result(from_write(r), false);
}
fn ignored_write(result_value: WriteResult) -> Unit {
    match result_value {
        WriteResult::Ok => {}
        WriteResult::Err(_) => {}
    }
}
fn symbol_index(c: Context) -> String effects { state, io, process } {
    let enums = strings_new();
    let records = strings_new();
    let distincts = strings_new();
    var i = 0;
    while i < list_len(c.type_order) {
        let id = list_get(c.type_order, i);
        let t = type_info(c, id);
        if t.kind == 77 {
            strings_push(distincts, "{\"name\":" + json_string(display_root_name(t.name))
                + ",\"base\":" + json_string(display_type(c, t.base)) + "}");
        } else if t.kind == 76 {
            var opacity = "";
            if t.opaque {
                opacity = "\"opaque\":true,";
            }
            let fields = strings_new();
            var j = 0;
            while j < list_len(t.fields) {
                let field = symbol_info(c, list_get(t.fields, j));
                strings_push(fields, "{\"name\":" + json_string(field.name) + ",\"type\":"
                    + json_string(display_type(c, field.type_id)) + "}");
                j = j + 1;
            }
            strings_push(records, "{" + opacity + "\"name\":" + json_string(display_root_name(
                t.name)) + ",\"fields\":[" + strings_join(fields, ",") + "]}");
        } else {
            let variants = strings_new();
            var j = 0;
            while j < list_len(t.variants) {
                let v = symbol_info(c, list_get(t.variants, j));
                let fields = strings_new();
                var k = 0;
                while k < list_len(v.parameters) {
                    strings_push(fields, json_string(display_type(c, symbol_info(c, list_get(
                        v.parameters, k)).type_id)));
                    k = k + 1;
                }
                strings_push(variants, "{\"name\":" + json_string(v.name) + ",\"fields\":["
                    + strings_join(fields, ",") + "]}");
                j = j + 1;
            }
            strings_push(enums, "{\"name\":" + json_string(display_root_name(t.name))
                + ",\"variants\":[" + strings_join(variants, ",") + "]}");
        }
        i = i + 1;
    }
    let functions = strings_new();
    let tests = strings_new();
    i = 0;
    while i < list_len(c.functions) {
        let f = list_get(c.functions, i);
        let sig = symbol_info(c, f.symbol);
        if sig.name == "@closure" {
            i = i + 1;
            continue;
        }
        var test_name = "";
        for declaration in c.bound_functions {
            if declaration.name == sig.name {
                test_name = declaration.test_name;
            }
        }
        if test_name != "" {
            strings_push(tests, "{\"name\":" + json_string(test_name) + ",\"source\":"
                + json_string(filename_at(c, f.span.start)) + ",\"module_id\":" + to_string(
                source_unit_at(c, f.span.start)) + ",\"span\":" + span_json(c, f.span)
                + ",\"effects\":" + effect_json(sig.effect_mask) + "}");
            i = i + 1;
            continue;
        }
        let params = strings_new();
        var j = 0;
        while j < list_len(f.parameters) {
            let b = symbol_info(c, list_get(f.parameters, j));
            strings_push(params, "{\"name\":" + json_string(b.name) + ",\"type\":" + json_string(
                display_type(c, b.type_id)) + "}");
            j = j + 1;
        }
        var method = "";
        if sig.method_span.end > 0 {
            method = "\"method\":true,";
            if !sig.method_exported {
                method = method + "\"visibility\":\"module\",";
            }
        }
        strings_push(functions, "{" + method + "\"source\":" + json_string(filename_at(c,
            f.span.start)) + ",\"module_id\":" + to_string(source_unit_at(c, f.span.start))
            + ",\"name\":" + json_string(display_root_name(sig.name)) + ",\"parameters\":["
            + strings_join(params, ",") + "],\"returns\":" + json_string(display_type(c,
            sig.type_id)) + ",\"effects\":" + effect_json(sig.effect_mask) + ",\"line\":" + num(
            line_at(c, f.span.start)) + ",\"contracts\":{\"verification\":\"runtime\",\"requires\":"
            + num(list_len(f.preconditions)) + ",\"ensures\":" + num(list_len(f.postconditions))
            + "}}");
        i = i + 1;
    }
    for sig_id in c.signatures {
        let sig = symbol_info(c, sig_id);
        if sig.foreign_library != "" {
            let params = strings_new();
            for id in sig.parameters {
                let parameter = symbol_info(c, id);
                strings_push(params, "{\"name\":" + json_string(parameter.name) + ",\"type\":"
                    + json_string(display_type(c, parameter.type_id)) + "}");
            }
            strings_push(functions, "{\"source\":" + json_string(filename_at(c, sig.span.start))
                + ",\"module_id\":" + to_string(source_unit_at(c, sig.span.start)) + ",\"name\":"
                + json_string(display_root_name(sig.name)) + ",\"parameters\":[" + strings_join(
                params, ",") + "],\"returns\":" + json_string(display_type(c, sig.type_id))
                + ",\"effects\":" + effect_json(sig.effect_mask) + ",\"line\":" + num(line_at(c,
                sig.span.start)) + ",\"foreign\":{\"library\":" + json_string(sig.foreign_library)
                + ",\"symbol\":" + json_string(sig.foreign_name) + "}}");
        }
    }
    let modules = strings_new();
    for i in 0 .. list_len(c.source_units) {
        let unit = list_get(c.source_units, i);
        strings_push(modules, "{\"id\":" + to_string(i) + ",\"source\":" + json_string(unit.name)
            + "}");
    }
    return "{\"schema_version\":1,\"modules\":[" + strings_join(modules, ",") + "],\"source\":"
        + json_string(c.source_name) + ",\"enums\":[" + strings_join(enums, ",") + "],\"structs\":["
        + strings_join(records, ",") + "],\"distinct_types\":[" + strings_join(distincts, ",")
        + "],\"functions\":[" + strings_join(functions, ",") + "],\"tests\":[" + strings_join(tests,
        ",") + "]}";
}
fn parent_path(path: String) -> String {
    var i = str_len(path);
    while i > 0 {
        i = i - 1;
        let ch = str_byte(path, i);
        if ch == 47 || ch == 92 {
            return str_slice(path, 0, i + 1);
        }
    }
    return ".";
}
fn path_key(path: String) -> String effects { state } {
    if platform() != "windows" {
        return path;
    }
    let chars = strings_new();
    var i = 0;
    while i < str_len(path) {
        var b = str_byte(path, i);
        if b >= 65 && b <= 90 {
            b = b + 32;
        }
        if b == 47 {
            b = 92;
        }
        strings_push(chars, str_from_byte(b));
        i = i + 1;
    }
    return strings_join(chars, "");
}
fn compile_native(cfile: String, executable: String,
    object_file: String) -> Int effects { state, process } {
    var cc = env("VELA_CC");
    var kind = env("VELA_CC_KIND");
    if cc == "" {
        if platform() == "windows" {
            cc = "cl.exe";
        } else {
            cc = "cc";
        }
    }
    if kind == "" {
        if platform() == "windows" {
            kind = "msvc";
        } else {
            kind = "cc";
        }
    }
    let args = strings_new();
    strings_push(args, cc);
    if kind == "msvc" {
        strings_push(args, "/nologo");
        strings_push(args, "/TC");
        strings_push(args, "/std:c11");
        strings_push(args, "/utf-8");
        strings_push(args, "/O2");
        strings_push(args, "/fp:strict");
        strings_push(args, "/W3");
        strings_push(args, "/wd4102");
        strings_push(args, "/MT");
        strings_push(args, cat("/Fo", object_file));
        strings_push(args, cat("/Fe", executable));
        strings_push(args, cfile);
        strings_push(args, "/link");
        strings_push(args, "/INCREMENTAL:NO");
    } else {
        strings_push(args, "-std=c11");
        strings_push(args, "-O2");
        strings_push(args, "-ffp-contract=off");
        strings_push(args, cfile);
        strings_push(args, "-o");
        strings_push(args, executable);
        strings_push(args, "-lm");
    }
    return process_run_to_stderr(args);
}
fn write_atomic_result(path: String, code: String) -> Result<Bool, String> effects { state,
    io } {
    let absolute = from_string(absolute_path(path))?;
    let dir = from_string(temp_dir(parent_path(absolute)))?;
    let temp_path = dir + "/program.c";
    var saved = from_write(write_file(temp_path, code));
    match saved {
        Result::Ok(_) => {
            saved = from_write(replace_file(temp_path, absolute));
        }
        Result::Err(_) => {}
    }
    ignored_write(remove_file(temp_path));
    ignored_write(remove_dir(dir));
    return saved;
}
fn write_atomic(path: String, code: String) -> Unit effects { state, io, process } {
    let success = io_result(write_atomic_result(path, code), false);
}
fn build_or_run(code: String, output_path: String, arguments: StringList,
    running: Bool) -> Int effects { state, io, process } {
    return build_or_run_native(code, output_path, arguments, running, list_new<NativeDependency>(),
        list_new<Resource>());
}
fn build_or_run_native(code: String, output_path: String, arguments: StringList, running: Bool,
    natives: List<NativeDependency>, assets: List<Resource>) -> Int effects { state, io, process } {
    var parent = "";
    if !running {
        parent = parent_path(output_path);
    }
    let dir = io_value(temp_dir(parent));
    let cfile = cat(dir, "/program.c");
    let exe = cat(dir, "/program.exe");
    let obj = cat(dir, "/program.obj");
    io_done(write_file(cfile, code));
    var status = compile_native(cfile, exe, obj);
    if status != 0 {
        status = 2;
    }
    if status == 0 {
        var destination = parent_path(output_path);
        if running {
            destination = dir;
        }
        match stage_artifacts(natives, assets, destination) {
            Result::Ok(_) => {}
            Result::Err(message) => {
                eprint(message);
                status = 2;
            }
        }
    }
    if status == 0 {
        if running {
            let args = strings_new();
            strings_push(args, exe);
            var i = 0;
            while i < strings_len(arguments) {
                strings_push(args, strings_get(arguments, i));
                i = i + 1;
            }
            status = process_run(args);
        } else {
            match replace_file(exe, output_path) {
                WriteResult::Ok => {}
                WriteResult::Err(message) => {
                    eprint(message);
                    status = 2;
                }
            }
        }
    }
    ignored_write(remove_file(cfile));
    ignored_write(remove_file(obj));
    ignored_write(remove_file(exe));
    if running {
        for native in natives {
            ignored_write(remove_file(dir + "/" + native.name));
        }
        unstage_assets(assets, dir);
    }
    ignored_write(remove_dir(dir));
    if status < 0 || status > 255 {
        eprint("velac: cannot run compiler or program; configure VELA_CC and its environment");
        return 2;
    }
    return status;
}
fn checked_output(input: String, source_name: String, json_mode: Bool) -> Int effects { io,
    state } {
    if json_mode {
        print(cat(cat("{\"schema_version\":1,\"ok\":true,\"diagnostics\":[],\"source\":",
            json_string(source_name)), "}"));
    } else {
        print(cat("OK: ", input));
    }
    return 0;
}
fn generated_output(command: String, generated: String, output_path: String,
    arguments: StringList, p: Project) -> Int effects { io, state, process } {
    if command == "emit-c" {
        if output_path == "" {
            print(generated);
        } else {
            write_atomic(output_path, generated);
        }
        return 0;
    }
    return build_or_run_native(generated, output_path, arguments, command == "run", p.natives,
        p.assets);
}
fn main() -> Int effects { args, state, io, process } {
    if arg_count() == 1 {
        let option = io_value(arg(0));
        if option == "--version" {
            print("Vela " + compiler_version() + " (self-hosted)");
            return 0;
        }
        if option == "--help" {
            print(
                "Usage: vela check|symbols|api|query|plan|emit-c|build|run|test|fmt|lock SOURCE_OR_PROJECT");
            print("       vela api --builtins");
            print("       vela init DIRECTORY [--name NAME] [--kind cli|library] [--json]");
            return 0;
        }
    }
    if arg_count() < 2 {
        eprint(
            "Usage: vela check|symbols|api|query|plan|emit-c|build|run|test|fmt|lock SOURCE_OR_PROJECT");
        eprint("       vela api --builtins");
        eprint("       vela init DIRECTORY [--name NAME] [--kind cli|library] [--json]");
        return 2;
    }
    let command = io_value(arg(0));
    let input = io_value(arg(1));
    if command == "init" {
        return scaffold_command(input);
    }
    if command == "api" && input == "--builtins" && arg_count() == 2 {
        print(api_builtins());
        return 0;
    }
    if command == "query" || command == "plan" {
        return query_command(command, input);
    }
    var output_path = "";
    var source_name = "";
    var cache_directory = "";
    var cache_report = false;
    var debug_codegen = false;
    var json_mode = false;
    let arguments = strings_new();
    var index = 2;
    var rest = false;
    var format_check = false;
    var format_write = false;
    while index < arg_count() {
        let option = io_value(arg(index));
        if rest {
            strings_push(arguments, option);
        } else if option == "--" {
            rest = true;
        } else if option == "--json" {
            json_mode = true;
        } else if command == "emit-c" && option == "--debug" {
            debug_codegen = true;
        } else if command == "fmt" && option == "--check" {
            format_check = true;
        } else if command == "fmt" && option == "--write" {
            format_write = true;
        } else if option == "--cache" && (command == "check" || command == "emit-c" || command
            == "build") {
            index = index + 1;
            if index >= arg_count() {
                eprint("--cache requires a directory");
                return 2;
            }
            cache_directory = io_value(absolute_path(io_value(arg(index))));
        } else if option == "--cache-report" && (command == "check" || command == "emit-c"
            || command == "build") {
            cache_report = true;
        } else if option == "-o" || option == "--output" || option == "--source-name" {
            index = index + 1;
            let value = io_value(arg(index));
            if option == "--source-name" {
                source_name = value;
            } else {
                output_path = value;
            }
        } else if command == "run" {
            rest = true;
            strings_push(arguments, option);
        } else {
            eprint(cat("Unknown option: ", option));
            return 2;
        }
        index = index + 1;
    }
    if command != "check" && command != "symbols" && command != "emit-c" && command != "build"
        && command != "run" && command != "fmt" && command != "lock" && command != "test" && command
        != "api" {
        eprint("Unknown compiler command.");
        return 2;
    }
    if command == "fmt" && (output_path != "" || (format_check && format_write) || strings_len(
        arguments) > 0) {
        eprint("Usage: velac fmt SOURCE [--check|--write]");
        return 2;
    }
    if command == "build" && output_path == "" {
        eprint("build requires -o OUTPUT");
        return 2;
    }
    let p = project_load(io_value(absolute_path(input)), json_mode);
    if command == "lock" {
        return project_write_lock(p, json_mode);
    }
    project_verify_lock(p, json_mode);
    if command == "test" {
        return project_test(p, json_mode);
    }
    if command == "fmt" && p.manifest != "" {
        return project_format(p, format_check, format_write, json_mode);
    }
    let input_path = p.entry;
    if source_name == "" {
        source_name = input_path;
    }
    if output_path != "" {
        output_path = io_value(absolute_path(output_path));
        if p.manifest != "" {
            let target_id = io_value(file_identity(output_path));
            let protected = list_new<String>();
            list_push(protected, p.manifest);
            list_push(protected, p.manifest + ".lock");
            for test in p.tests {
                list_push(protected, test);
            }
            for dep in p.dependencies {
                let graph = project_module_context(dep.path, dep.path, load_source(dep.path,
                    json_mode), json_mode, p.dependencies);
                for unit in graph.source_units {
                    list_push(protected, unit.path);
                }
            }
            for native in p.natives {
                list_push(protected, native.path);
                list_push(protected, artifact_join(parent_path(output_path), native.name));
            }
            for asset in p.assets {
                list_push(protected, asset.path);
            }
            for path in protected {
                if path_key(output_path) == path_key(path) || target_id != "" && target_id
                    == io_value(file_identity(path)) {
                    eprint("Output must not overwrite project metadata.");
                    return 2;
                }
            }
        }
        let input_identity = io_value(file_identity(input_path));
        let output_identity = io_value(file_identity(output_path));
        if path_key(output_path) == path_key(input_path) || (input_identity != "" && input_identity
            == output_identity) {
            eprint("Output must not overwrite source.");
            return 2;
        }
    }
    let cache = cache_prepare(cache_directory, cache_report);
    let code = load_source(input_path, json_mode);
    var c = make_context(code, source_name, json_mode);
    if command != "fmt" {
        c = project_cached_context(input_path, source_name, code, json_mode, p.dependencies,
            list_new<QueryOverlay>(), cache);
    }
    c.debug_codegen = debug_codegen;
    if output_path != "" {
        let output_identity = io_value(file_identity(output_path));
        for unit in c.source_units {
            if path_key(output_path) == path_key(unit.path) || (output_identity != ""
                && output_identity == unit.identity) {
                eprint("Output must not overwrite source.");
                return 2;
            }
        }
    }
    var key = "";
    var kind = "c-v1";
    if command == "check" {
        kind = "check-v1";
    }
    if debug_codegen {
        kind = "debug-c-v1";
    }
    if cache.directory != "" {
        key = analysis_cache_key(c, p, kind);
        match cache_read(cache, key, kind) {
            Option::None => {}
            Option::Some(saved) => {
                if command == "check" {
                    if saved == "ok" {
                        cache_event(cache, "read", kind, "hit", "reused", key, "", false);
                        return checked_output(input, source_name, json_mode);
                    }
                    cache_event(cache, "read", kind, "miss", "invalid_check", key, "", false);
                } else {
                    cache_event(cache, "read", kind, "hit", "reused", key, "", false);
                    return generated_output(command, saved, output_path, arguments, p);
                }
            }
        }
    }
    if command == "fmt" {
        lex(c);
        parse_module(c);
    } else {
        parse_program(c);
    }
    if command == "fmt" {
        let formatted = format_source(c);
        if format_check {
            if io_value(read_file(input_path)) == formatted {
                return 0;
            }
            eprint("Needs formatting: " + input);
            return 1;
        }
        if format_write {
            if io_value(read_file(input_path)) != formatted {
                write_atomic(input_path, formatted);
            }
            return 0;
        }
        write_stdout(formatted);
        return 0;
    }
    analyze_mode(c, command != "symbols" && command != "api");
    if command == "api" {
        print(api_interface(c));
        return 0;
    }
    if command == "check" {
        cache_store(cache, key, "ok", kind);
        return checked_output(input, source_name, json_mode);
    }
    if command == "symbols" {
        print(symbol_index(c));
        return 0;
    }
    let generated = generate(c);
    cache_store(cache, key, generated, kind);
    return generated_output(command, generated, output_path, arguments, p);
}


fn builtin_source() -> String { return "# Vela builtin catalog v1. UTF-8, pipe-delimited; no quoting. Empty columns are significant.\n# kind|name|type variables|parameter types separated by ;|return type|effects separated by ;|ABI|since\nenum|IntResult||Ok:Int;Err:String||||0.2\nenum|StringResult||Ok:String;Err:String||||0.2\nenum|WriteResult||Ok:;Err:String||||0.2\nenum|FloatResult||Ok:Float64;Err:String||||0.7\nenum|Int32Result||Ok:Int32;Err:String||||0.7\nenum|ReadResult||Ok:String;Limit:;Err:String||||0.7\nenum|StreamResult||Ok:ForeignHandle;Limit:;Err:String||||0.10\nenum|CallbackResult||Ok:CallbackHandle;Err:String||||0.10\nenum|ProcessResult||Exited:Int;TimedOut:;Err:String||||0.7\nenum|Option|T|Some:T;None:||||0.5\nenum|Result|T;E|Ok:T;Err:E||||0.5\nfn|arg_count|||Int|args|plain|0.2\nfn|arg_int||Int|IntResult|args|int_result|0.2\nfn|parse_int||String|IntResult||int_result|0.2\nfn|str_len||String|Int||located|0.2\nfn|str_byte||String;Int|Int||located|0.2\nfn|str_slice||String;Int;Int|String||located|0.2\nfn|str_concat||String;String|String||located|0.2\nfn|str_from_byte||Int|String||located|0.2\nfn|int_to_string||Int|String||located|0.2\nfn|ints_new|||IntList|state|located|0.2\nfn|ints_len||IntList|Int|state|located|0.2\nfn|ints_get||IntList;Int|Int|state|located|0.2\nfn|ints_set||IntList;Int;Int|Unit|state|located|0.2\nfn|ints_push||IntList;Int|Unit|state|located|0.2\nfn|ints_truncate||IntList;Int|Unit|state|located|0.2\nfn|strings_new|||StringList|state|located|0.2\nfn|strings_len||StringList|Int|state|located|0.2\nfn|strings_get||StringList;Int|String|state|located|0.2\nfn|strings_set||StringList;Int;String|Unit|state|located|0.2\nfn|strings_push||StringList;String|Unit|state|located|0.2\nfn|strings_truncate||StringList;Int|Unit|state|located|0.2\nfn|strings_join||StringList;String|String|state|located|0.2\nfn|arg||Int|StringResult|args|string_result|0.2\nfn|read_file||String|StringResult|io|string_result|0.2\nfn|absolute_path||String|StringResult|io|string_result|0.2\nfn|temp_dir||String|StringResult|io|string_result|0.2\nfn|write_file||String;String|WriteResult|io|write_result|0.2\nfn|remove_file||String|WriteResult|io|write_result|0.2\nfn|replace_file||String;String|WriteResult|io|write_result|0.2\nfn|remove_dir||String|WriteResult|io|write_result|0.2\nfn|eprint||String|Unit|io|located|0.2\nfn|exit||Int|Unit|process|located|0.2\nfn|env||String|String|process|located|0.2\nfn|process_run||StringList|Int|process;state|located|0.2\nfn|process_run_to_stderr||StringList|Int|process;state|located|0.2\nfn|platform|||String||located|0.2\nfn|print|T|T|Unit|io|print|0.3\nfn|to_string|T|T|String||format|0.3\nfn|list_new|T||List<T>|state|list_new|0.3\nfn|list_len|T|List<T>|Int|state|list_len|0.3\nfn|list_get|T|List<T>;Int|T|state|list_get|0.3\nfn|list_set|T|List<T>;Int;T|Unit|state|list_set|0.3\nfn|list_push|T|List<T>;T|Unit|state|list_push|0.3\nfn|list_truncate|T|List<T>;Int|Unit|state|list_truncate|0.3\nfn|dict_new|K;V||Dict<K,V>|state|dict_new|0.3\nfn|dict_len|K;V|Dict<K,V>|Int|state|dict_len|0.3\nfn|dict_has|K;V|Dict<K,V>;K|Bool|state|dict_has|0.3\nfn|dict_get|K;V|Dict<K,V>;K|V|state|dict_get|0.3\nfn|dict_get_or|K;V|Dict<K,V>;K;V|V|state|dict_get_or|0.3\nfn|dict_set|K;V|Dict<K,V>;K;V|Unit|state|dict_set|0.3\nfn|dict_remove|K;V|Dict<K,V>;K|Bool|state|dict_remove|0.3\nfn|process_run_files||StringList;String;String;Int|Int|process;state;io|located|0.3\nfn|make_dir||String|WriteResult|io|write_result|0.3\nfn|set_env||String;String|Unit|process|located|0.3\nfn|set_current_dir||String|WriteResult|io;process|write_result|0.3\nfn|file_identity||String|StringResult|io|string_result|0.4\nfn|write_stdout||String|Unit|io|located|0.4\nfn|sha256||String|String||located|0.6\nfn|parse_float||String|FloatResult||float_result|0.7\nfn|float_text_valid||String|Bool||located|0.7\nfn|float_from_int||Int|Float64||plain|0.7\nfn|float_to_int||Float64|IntResult||int_result|0.7\nfn|float_to_string||Float64|String||located|0.7\nfn|float_to_fixed||Flo