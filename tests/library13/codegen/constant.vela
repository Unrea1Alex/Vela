import "input.vela" as input;

fn sum(n: Int) -> Int {
    var total = n + (2 * 3 + (4 - 1)) * (3 + 2);
    if 2 + 2 == 4 && 5 < 8 {
        total = total + (9 / 3) + (17 % 5);
    } else {
        total = total - (28 + 35) * 4;
    }
    if true || 2 > 3 { total = total + (12 - 1) * (5 + 4); }
    if false && (7 - 3 > 1) { total = total + 1000; }
    return total;
}

fn main() -> Unit effects { args, io, process } {
    let count = input::iterations();
    var total = 0;
    for n in 0 .. count { total = total + sum(n); }
    print(total);
}
