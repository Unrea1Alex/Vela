import "../../../std/parallel.vela" as p;
import "../../../std/task_group.vela" as group;
async fn action(scope:group::Scope,value:Int,index:Int)->Result<Int,Int>{return Result<Int,Int>::Ok(value);}
fn start(values:List<Int>)->Unit{let job=p::create(values,2,0,100,p::Policy::Collect,action);}
fn main()->Unit{}
