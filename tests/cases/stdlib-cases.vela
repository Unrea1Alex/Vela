import "../../tools/test.vela";
fn process_tree(s: Suite, exe: String) -> Outcome effects { state, io, process } {
    let args = command(env("VELA_CC"));
    for flag in split("/nologo|/std:c11|/MT|/O2", 124) { strings_push(args, flag); }
    strings_push(args, "/Fo" + s.dir + "/process-tree.obj");
    strings_push(args, "/Fe" + exe);
    strings_push(args, s.root + "/tests/stdlib/process-tree.c");
    return invoke(s, args, 30000);
}
pub fn stdlib_checks(suite: Suite) -> Suite effects { state, io, process } {
    var s = suite;
    let child = s.dir + "/stdlib-child.exe";
    let child_build = build(s, s.root + "/tests/stdlib/child.vela", child);
    s = record(s, "stdlib_child_build", child_build.code == 0, child_build.out + child_build.err);
    for name in split("decode|builder|services|json-budget|replay|event-loop|tasks|task-group|group-process|http-api", 124) {
        let program = s.dir + "/stdlib-" + name + ".exe";
        let compile = build(s, s.root + "/tests/stdlib/" + name + ".vela", program);
        if compile.code != 0 {
            s = record(s, "stdlib_" + name, false, compile.out + compile.err);
            continue;
        }
        let args = command(program);
        if name == "services" { strings_push(args, child); }
        if name == "group-process" { strings_push(args, child); strings_push(args, s.dir); }
        let run = invoke(s, args, 10000);
        var expected = "builder passed\n";
        if name == "decode" { expected = "JSON decode passed\n"; }
        if name == "services" { expected = "services passed\n"; }
        if name == "replay" { expected = "replay passed\n"; }
        if name == "event-loop" { expected = "event loop passed\n"; }
        if name == "task-group" { expected = "task groups passed\n"; if platform() != "windows" { expected = "task groups host passed\n"; } }
        if name == "http-api" { expected = "HTTP API passed\n"; }
        if name == "group-process" { expected = "group process passed\n"; if platform() != "windows" { expected = "group process unsupported\n"; } }
        if name == "tasks" {
            expected = "typed tasks passed\n";
            if platform() != "windows" { expected = "typed tasks unsupported\n"; }
        }
        if name == "json-budget" {
            expected = "ok\nJSON byte limit exceeded (5)\nJSON depth limit exceeded (0)\nJSON node limit exceeded (1)\nInvalid JSON limits\n$.ok: expected boolean\n";
        }
        s = record(s, "stdlib_" + name, run.code == 0 && run.out == expected && run.err == "", run.out + run.err);
    }
    let dir = s.dir + "/stdlib 😀";
    done(make_dir(dir));
    let async_program = s.dir + "/stdlib-async-process.exe";
    let async_build = build(s, s.root + "/tests/stdlib/async-process.vela", async_program);
    if async_build.code != 0 || child_build.code != 0 {
        s = record(s, "stdlib_async_process", false, async_build.out + async_build.err);
    } else {
        let async_args = command(async_program);
        strings_push(async_args, child);
        strings_push(async_args, dir);
        var async_expected = "async process passed\n";
        var fixture_ok = true;
        if platform() == "windows" {
            let tree = s.dir + "/process-tree.exe";
            let tree_build = process_tree(s, tree);
            fixture_ok = tree_build.code == 0;
            s = record(s, "stdlib_process_tree_build", fixture_ok, tree_build.out + tree_build.err);
            strings_push(async_args, tree);
        } else {
            async_expected = "async process unsupported\n";
        }
        if fixture_ok {
            let async_run = invoke(s, async_args, 20000);
            s = record(s, "stdlib_async_process", async_run.code == 0 && async_run.out == async_expected
                && async_run.err == "", async_run.out + async_run.err);
        }
    }
    let executable = s.dir + "/stdlib.exe";
    let built = build(s, s.root + "/tests/stdlib/main.vela", executable);
    s = record(s, "stdlib_build", built.code == 0, built.out + built.err);
    if child_build.code == 0 && built.code == 0 {
        let args = command(executable);
        strings_push(args, dir);
        strings_push(args, child);
        let actual = invoke(s, args, 30000);
        let expected = "text/path passed\nJSON/config passed\nCLI/collections passed\nfiles passed\nprocesses passed\nstdlib checks passed\n";
        s = record(s, "stdlib_behavior", actual.code == 0 && actual.out == expected && actual.err == "", actual.out + actual.err);
        // A failed publish must remove its private sibling temporary directory.
        // Directory inventory is checked separately by the host acceptance script.
    }
    let app = s.dir + "/config-report.exe";
    let app_build = build(s, s.root + "/apps/config-report/main.vela", app);
    s = record(s, "config_report_build", app_build.code == 0, app_build.out + app_build.err);
    if app_build.code != 0 {
        return s;
    }
    let file = dir + "/config.json";
    done(write_file(file, "{\"name\":\"Vela 😀\",\"count\":3,\"enabled\":true,\"scale\":1.25}"));
    let args = command(app);
    strings_push(args, "--increment");
    strings_push(args, file);
    strings_push(args, file);
    let success = invoke(s, args, 10000);
    let expected = "{\"name\":\"Vela 😀\",\"count\":4,\"enabled\":true,\"scale\":1.25}\n";
    s = record(s, "config_report_atomic_in_place", success.code == 0 && success.out == "name=Vela 😀 count=4 enabled=true scale=1.25\n" && success.err == ""&& value(read_file(file)) == expected, success.out + success.err);
    let invalid = list_new<String>();
    list_push(invalid, "{\"name\":\"x\",\"name\":\"y\"}");
    list_push(invalid, "{\"name\":\"x\",\"count\":0,\"enabled\":true,\"scale\":1.0,\"unknown\":0}");
    list_push(invalid, "{\"name\":\"x\",\"count\":9223372036854775807,\"enabled\":true,\"scale\":1.0}");
    list_push(invalid, "{\"name\":\"x\",\"count\":0,\"enabled\":true,\"scale\":1}");
    list_push(invalid, "{\"name\":\"x\",\"count\":0,\"enabled\":true,\"scale\":1e309}");
    list_push(invalid, str_from_byte(255));
    for i in 0 .. list_len(invalid) {
        let original = list_get(invalid, i);
        done(write_file(file, original));
        let rejected = invoke(s, args, 10000);
        s = record(s, "config_report_preserves_invalid_" + to_string(i), rejected.code == 2 && rejected.out == ""&& rejected.err != ""&& value(read_file(file)) == original, rejected.out + rejected.err);
    }
    return s;
}
