import "../../tools/test.vela";
pub fn project_checks(suite: Suite) -> Suite effects { state, io, process } {
    var s = suite;
    let dir = s.dir + "/проект with space";
    done(make_dir(dir));
    let manifest = dir + "/vela.project";
    let main = dir + "/main.vela";
    let dep = dir + "/dep.vela";
    let leaf = dir + "/leaf.vela";
    let text = "vela-project|1\nname|sample\nentry|main.vela\ndep|math|dep.vela\ntest|main.vela\n";
    done(write_file(manifest, text));
    done(write_file(main, "import \"@math\" as m; fn main()->Unit effects{io}{print(m::answer());}"));
    done(write_file(dep, "import \"leaf.vela\"; pub fn answer()->Int{return leaf();}"));
    done(write_file(leaf, "pub fn leaf()->Int{return 42;}"));
    let check = compiler_command(s, "check", manifest);
    strings_push(check, "--json");
    let lock = compiler_command(s, "lock", manifest);
    strings_push(lock, "--json");
    let missing = invoke(s, check, 15000);
    s = record(s, "project_missing_lock", missing.code == 1 && contains(missing.out, "E226"), missing.out + missing.err);
    let locked = invoke(s, lock, 15000);
    s = record(s, "project_lock", locked.code == 0, locked.out + locked.err);
    let baseline = value(read_file(manifest + ".lock"));
    let saved_main = value(read_file(main));
    done(write_file(main, "fn main()->Unit{}"));
    let unused = compiler_command(s, "emit-c", manifest);
    strings_push(unused, "-o");
    strings_push(unused, dep);
    let guarded = invoke(s, unused, 15000);
    s = record(s, "project_unused_dependency_output_guard", guarded.code == 2 && value(read_file(dep)) == "import \"leaf.vela\"; pub fn answer()->Int{return leaf();}", guarded.out + guarded.err);
    done(write_file(main, saved_main));
    let checked = invoke(s, check, 15000);
    s = record(s, "project_check", checked.code == 0, checked.out + checked.err);
    let exe = dir + "/app.exe";
    let built = build(s, manifest, exe);
    s = record(s, "project_build", built.code == 0, built.out + built.err);
    if built.code == 0 {
        let ran = invoke(s, command(exe), 15000);
        s = record(s, "project_run", ran.code == 0 && ran.out == "42\n", ran.out + ran.err);
    }
    done(write_file(main, value(read_file(main)) + "\n// own change\n"));
    let own = invoke(s, check, 15000);
    s = record(s, "project_own_change", own.code == 0 && baseline == value(read_file(manifest + ".lock")), own.out + own.err);
    done(write_file(leaf, "pub fn leaf()->Int{return 43;}"));
    let stale = invoke(s, check, 15000);
    s = record(s, "project_transitive_change", stale.code == 1 && contains(stale.out, "E226") && baseline == value(read_file(manifest + ".lock")), stale.out + stale.err);
    let renewed = invoke(s, lock, 15000);
    s = record(s, "project_relock", renewed.code == 0 && baseline != value(read_file(manifest + ".lock")), renewed.out + renewed.err);
    done(write_file(manifest + ".lock", "vela-lock|1\nmanifest|forged\n"));
    let forged = invoke(s, check, 15000);
    s = record(s, "project_forged_lock", forged.code == 1 && contains(forged.out, "E226"), forged.out + forged.err);
    done(write_file(leaf, "pub fn leaf()->Int{return 42;}"));
    done(write_file(manifest + ".lock", baseline));
    let other = s.dir + "/relocated";
    done(make_dir(other));
    done(write_file(other + "/vela.project", text));
    done(write_file(other + "/vela.project.lock", baseline));
    done(write_file(other + "/main.vela", value(read_file(main))));
    done(write_file(other + "/dep.vela", value(read_file(dep))));
    done(write_file(other + "/leaf.vela", value(read_file(leaf))));
    let relocated = invoke(s, compiler_command(s, "check", other + "/vela.project"), 15000);
    s = record(s, "project_relocated_lock", relocated.code == 0, relocated.out + relocated.err);
    let invalid = list_new<String>();
    list_push(invalid, "vela-project|2\nname|x\nentry|main.vela\n");
    list_push(invalid, "vela-project|1\nentry|main.vela\n");
    list_push(invalid, text + "name|again\n");
    list_push(invalid, text + "dep|math|leaf.vela\n");
    list_push(invalid, text + "unknown|value\n");
    list_push(invalid, "vela-project|1\nname|x\nentry|../main.vela\n");
    list_push(invalid, "vela-project|1\nname|x\nentry|G:/main.vela\n");
    list_push(invalid, text + "test|main.vela\n");
    list_push(invalid, text + "dep|bad-name|leaf.vela\n");
    for broken in invalid {
        done(write_file(manifest, broken));
        let outcome = invoke(s, check, 15000);
        s = record(s, "project_invalid_manifest", outcome.code == 1 && contains(outcome.out, "E225") && outcome.err == "", outcome.out + outcome.err);
    }
    done(write_file(manifest, text));
    done(write_file(main, "import \"@unknown\"; fn main()->Unit{}"));
    let alias = invoke(s, check, 15000);
    s = record(s, "project_unknown_alias", alias.code == 1 && contains(alias.out, "E221"), alias.out + alias.err);
    done(write_file(main, "import \"@math\"; fn main()->Unit{}"));
    let single = compiler_command(s, "check", main);
    strings_push(single, "--json");
    let direct = invoke(s, single, 15000);
    s = record(s, "project_alias_without_manifest", direct.code == 1 && contains(direct.out, "E221"), direct.out + direct.err);
    done(remove_file(leaf));
    let absent = invoke(s, check, 15000);
    s = record(s, "project_missing_transitive", absent.code == 1 && contains(absent.out, "E221"), absent.out + absent.err);
    return project_cli_checks(s);
}
pub fn project_cli_checks(suite: Suite) -> Suite effects { state, io, process } {
    var s = suite;
    let dir = s.dir + "/cli-project";
    done(make_dir(dir));
    let manifest = dir + "/vela.project";
    done(write_file(manifest, "vela-project|1\nname|cli\nentry|main.vela\ntest|one.vela\ntest|two.vela\n"));
    done(write_file(dir + "/main.vela", "fn main()->Unit effects{io}{print(42);}"));
    done(write_file(dir + "/one.vela", "fn main()->Int effects{io}{print(\"first\");return 0;}"));
    done(write_file(dir + "/two.vela", "fn main()->Int effects{io}{eprint(\"second\");return 0;}"));
    let test = compiler_command(s, "test", manifest);
    strings_push(test, "--json");
    let passed = invoke(s, test, 30000);
    s = record(s, "cli_test_pass_capture", passed.code == 0 && contains(passed.out, "first") && contains(passed.out, "second") && contains(passed.out, "\"ok\":true"), passed.out + passed.err);
    done(write_file(dir + "/two.vela", "fn main()->Int{return 7;}"));
    let failed = invoke(s, test, 30000);
    s = record(s, "cli_test_failure", failed.code == 1 && contains(failed.out, "\"exit_code\":7") && contains(failed.out, "\"ok\":false"), failed.out + failed.err);
    let fmt = compiler_command(s, "fmt", manifest);
    strings_push(fmt, "--check");
    let dirty = invoke(s, fmt, 15000);
    s = record(s, "cli_fmt_dirty", dirty.code == 1, dirty.out + dirty.err);
    let write = compiler_command(s, "fmt", manifest);
    strings_push(write, "--write");
    let written = invoke(s, write, 15000);
    let clean = invoke(s, fmt, 15000);
    s = record(s, "cli_fmt_project", written.code == 0 && clean.code == 0, written.err + clean.err);
    let symbols = invoke(s, compiler_command(s, "symbols", manifest), 15000);
    s = record(s, "cli_symbols_modules", symbols.code == 0 && contains(symbols.out, "\"modules\":[") && contains(symbols.out, "\"module_id\":0"), symbols.out + symbols.err);
    let run = invoke(s, compiler_command(s, "run", manifest), 30000);
    s = record(s, "cli_run_project", run.code == 0 && run.out == "42\n" && !contains(run.err, "warning C4102"), run.out + run.err);
    let overwrite = compiler_command(s, "emit-c", manifest);
    strings_push(overwrite, "-o");
    strings_push(overwrite, manifest);
    let protection = invoke(s, overwrite, 15000);
    s = record(s, "cli_manifest_protection", protection.code == 2, protection.out + protection.err);
    return s;
}
