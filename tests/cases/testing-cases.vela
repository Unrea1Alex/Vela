import "../../tools/test.vela";
pub fn testing_checks(suite: Suite) -> Suite effects { state, io, process } {
    var s = suite;
    let file = s.dir + "/declarations.vela";
    let source = "fn main()->Int{return 99;}\ntest \"pass\" { assert_true(true,\"ok\"); }\ntest \"fail\" { assert_true(false,\"named failure\"); }\ntest \"after\" effects {io} {print(\"continued\");}\ntest \"raw\" effects {io} {write_stdout(str_from_byte(255));}\n";
    done(write_file(file, source));
    let args = compiler_command(s, "test", file);
    strings_push(args, "--json");
    let actual = invoke(s, args, 30000);
    s = record(s, "testing_report_and_continue", actual.code == 1 && contains(actual.out, "\"schema_version\":2") && contains(actual.out, "\"passed\":3,\"failed\":1") && contains(actual.out, "\"exit_code\":70") && contains(actual.out, "named failure") && contains(actual.out, "continued") && !contains(actual.out, "\"exit_code\":99") && contains(actual.out, "\"line\":3") && contains(actual.out, "\"stdout\":\"ff\"") && contains(actual.out, "\"stdout_encoding\":\"hex\""), actual.out + actual.err);
    s = record(s, "testing_preserves_source", value(read_file(file)) == source, "");
    let symbols = invoke(s, compiler_command(s, "symbols", file), 10000);
    s = record(s, "testing_symbols", symbols.code == 0 && contains(symbols.out, "\"tests\":[{\"name\":\"pass\"") && !contains(symbols.out, "@test"), symbols.out + symbols.err);
    done(write_file(file, "test \"only\" {assert_true(true,\"pass\");}"));
    let checked = invoke(s, compiler_command(s, "check", file), 10000);
    let built = build(s, file, s.dir + "/not-a-program.exe");
    s = record(s, "testing_only_check_and_build", checked.code == 0 && built.code == 1 && contains(built.err, "use vela test"), checked.out + built.err);
    let formatted = invoke(s, compiler_command(s, "fmt", file), 10000);
    done(write_file(file, formatted.out));
    let formatted_again = invoke(s, compiler_command(s, "fmt", file), 10000);
    s = record(s, "testing_formatter", formatted.code == 0 && formatted_again.code == 0 && formatted.out == formatted_again.out, formatted.err + formatted_again.err);
    done(write_file(file, "import \"imported-tests.vela\"; test \"root\" {}"));
    done(write_file(s.dir + "/imported-tests.vela", "test \"imported\" {assert_true(false,\"must not run\");}"));
    let imported = invoke(s, args, 30000);
    s = record(s, "testing_imported_not_run", imported.code == 0 && contains(imported.out, "\"passed\":1") && !contains(imported.out, "must not run"), imported.out + imported.err);
    done(write_file(file, "test \"timeout\" {while true{}} test \"after timeout\" {}"));
    let timed = invoke(s, args, 45000);
    s = record(s, "testing_timeout_continues", timed.code == 1 && contains(timed.out, "\"status\":\"timeout\"") && contains(timed.out, "\"passed\":1,\"failed\":1"), timed.out + timed.err);
    done(write_file(file, "test \"cwd\" effects {io} {match write_file(\"test-created.txt\",\"artifact\") {WriteResult::Ok=>{} WriteResult::Err(_)=>{assert_true(false,\"cwd\");}}}"));
    let artifact = invoke(s, args, 30000);
    s = record(s, "testing_cwd_artifact", artifact.code == 0 && contains(artifact.out, "\"artifact_dir\":") && !contains(artifact.out, "\"artifact_dir\":\"\""), artifact.out + artifact.err);
    let declarations = compiler_command(s, "test", s.root + "/tests/stdlib/declarations.vela");
    strings_push(declarations, "--json");
    let library = invoke(s, declarations, 30000);
    s = record(s, "testing_stdlib_declarations", library.code == 0 && contains(library.out, "\"passed\":3,\"failed\":0"), library.out + library.err);
    let cc = env("VELA_CC");
    set_env("VELA_CC", s.dir + "/missing-c-compiler.exe");
    let unavailable = invoke(s, args, 30000);
    set_env("VELA_CC", cc);
    s = record(s, "testing_build_error", unavailable.code == 2 && contains(unavailable.out, "\"status\":\"build_error\""), unavailable.out + unavailable.err);
    done(write_file(file, "import \"table.vela\"; test \"named table failure\" {table_failure();}"));
    done(write_file(s.dir + "/table.vela", "pub fn table_failure()->Unit{assert_true(false,\"case: negative input\");}"));
    let named = invoke(s, args, 30000);
    s = record(s, "testing_named_case_failure", named.code == 1 && contains(named.out, "case: negative input"), named.out + named.err);
    return s;
}
