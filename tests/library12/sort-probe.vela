import "../../std/algorithms.vela" as algorithms;
struct Item { key: Int, id: Int }
fn main() -> Int effects { state, args, io } {
    let items = list_new<Item>();
    for i in 0 .. arg_count() { match arg_int(i) {
        IntResult::Ok(key) => { list_push(items, Item(key: key, id: i)); }
        IntResult::Err(_) => { return 2; }
    } }
    let comparisons = list_new<Int>(); list_push(comparisons, 0);
    let sorted = algorithms::sort(items, fn [comparisons](a: Item, b: Item) -> Int effects { state } {
        list_set(comparisons, 0, list_get(comparisons, 0) + 1);
        if a.key < b.key { return -1; } if a.key > b.key { return 1; } return 0;
    });
    let ids = strings_new();
    for item in sorted { strings_push(ids, to_string(item.id)); }
    print("{\"ids\":[" + strings_join(ids, ",") + "],\"comparisons\":" + to_string(list_get(comparisons, 0)) + "}");
    return 0;
}
