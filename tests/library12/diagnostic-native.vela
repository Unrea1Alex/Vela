import "../../tools/test.vela" as testing;
import "../cases/diagnostic-cases.vela" as diagnostics;
fn main()->Int effects {args,state,io,process}{
 let root=testing::value(absolute_path(testing::value(arg(0))));let compiler=testing::value(absolute_path(testing::value(arg(1))));let directory=testing::value(temp_dir(root+"/build/stage12"));
 let suite=diagnostics::diagnostic_plan_checks(testing::Suite(root:root,compiler:compiler,dir:directory,passed:0,failed:0));print(f"{{\"schema_version\":1,\"passed\":{suite.passed:d},\"failed\":{suite.failed:d}}}");if suite.failed!=0{return 1;}return 0;
}
