fn argument(i: Int) -> String effects { args } {
    match arg(i) { StringResult::Ok(s) => { return s; } StringResult::Err(_) => { return ""; } }
}
fn main() -> Int effects { args, io } {
    let mode = argument(0);
    if mode == "hang" { while true {} }
    if mode == "streams" { print("child output"); eprint("child error"); return 0; }
    var i = 1;
    while i < arg_count() { let s = argument(i); print(str_len(s)); print(s); i = i + 1; }
    return 0;
}
